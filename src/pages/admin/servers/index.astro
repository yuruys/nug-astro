---
const title = 'サーバー管理';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} | NUGBASE 管理画面</title>
	</head>
	<body>
		<header class="topbar">
			<a class="brand" href="/admin/" aria-label="管理画面トップ">
				<span class="brand-mark">NUG</span>
				<span><strong>NUGBASE</strong><small>管理画面</small></span>
			</a>
			<button class="menu-toggle" id="menu-toggle" type="button" aria-controls="admin-nav" aria-expanded="false" aria-label="メニューを開く"><span></span><span></span><span></span></button>
			<a class="site-link" href="/">サイトを見る <span aria-hidden="true">↗</span></a>
		</header>
		<div class="shell">
			<aside class="sidebar" id="admin-nav" aria-label="管理メニュー">
				<p class="nav-label">管理メニュー</p>
				<nav>
					<a href="/admin/" class="nav-link"><span aria-hidden="true">▦</span> ダッシュボード</a>
					<a href="/admin/servers/" class="nav-link active" aria-current="page"><span aria-hidden="true">◈</span> サーバー管理</a>
					<a href="/admin/review/" class="nav-link"><span aria-hidden="true">✓</span> Wikiレビュー</a>
				</nav>
				<div class="sidebar-note"><span class="live-dot"></span> 管理者セッションで保護されています</div>
			</aside>
			<main class="main">
				<div class="page-heading">
					<div><p class="eyebrow">CONTENT SETTINGS</p><h1>サーバー管理</h1><p class="intro">攻略記事を分類するサーバー情報を管理します。削除の代わりに有効・無効を切り替えます。</p></div>
					<button class="button primary add-button" id="add-button" type="button"><span aria-hidden="true">＋</span> サーバーを追加</button>
				</div>

				<div class="notice" id="notice" role="status" aria-live="polite" hidden></div>

				<section class="panel form-panel" id="form-panel" aria-labelledby="form-title" hidden>
					<div class="panel-heading"><div><p class="eyebrow" id="form-eyebrow">NEW SERVER</p><h2 id="form-title">サーバーを追加</h2></div><button type="button" class="icon-button" id="close-form" aria-label="フォームを閉じる">×</button></div>
					<form id="server-form">
						<input type="hidden" id="server-id" />
						<div class="form-grid">
							<label class="field" id="slug-field"><span>Slug <em>必須</em></span><input id="slug" name="slug" autocomplete="off" required maxlength="80" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" aria-describedby="slug-help" /><small id="slug-help">URLなどに使う英小文字・数字・ハイフン。作成後は変更できません。</small></label>
							<label class="field"><span>名前 <em>必須</em></span><input id="name" name="name" required maxlength="120" /></label>
							<label class="field full"><span>説明 <small>任意</small></span><textarea id="description" name="description" rows="3" maxlength="1000"></textarea></label>
							<label class="field full" id="enabled-field" hidden><span>状態</span><span class="switch-row"><input id="enabled" type="checkbox" checked /><span>有効として表示する</span></span></label>
						</div>
						<div class="form-actions"><button type="button" class="button secondary" id="cancel-form">キャンセル</button><button type="submit" class="button primary" id="save-button">保存する</button></div>
					</form>
				</section>

				<section class="panel list-panel" aria-labelledby="list-title">
					<div class="panel-heading list-heading"><div><p class="eyebrow">SERVER DIRECTORY</p><h2 id="list-title">サーバー一覧</h2></div><span class="count" id="server-count">— 件</span></div>
					<div class="state" id="loading-state"><span class="spinner" aria-hidden="true"></span><p>サーバー一覧を読み込んでいます…</p></div>
					<div class="state" id="empty-state" hidden><span class="empty-icon" aria-hidden="true">◈</span><h3>サーバーがありません</h3><p>「サーバーを追加」から最初のサーバーを登録できます。</p></div>
					<div class="state error-state" id="error-state" hidden><span class="error-icon" aria-hidden="true">!</span><h3 id="error-title">読み込みに失敗しました</h3><p id="error-message"></p><button class="button secondary" id="retry-button" type="button">再読み込み</button></div>
					<div class="table-wrap" id="table-wrap" hidden>
						<table><thead><tr><th scope="col">ID</th><th scope="col">SLUG</th><th scope="col">名前</th><th scope="col">状態</th><th scope="col">記事数</th><th scope="col">更新日時</th><th scope="col"><span class="visually-hidden">操作</span></th></tr></thead><tbody id="server-rows"></tbody></table>
					</div>
					<div class="card-list" id="server-cards" hidden></div>
				</section>
				<footer class="page-footer">サーバーを無効にしても、登録済みの記事データは保持されます。</footer>
			</main>
		</div>

		<script>
			type Server = { id: number; slug: string; name: string; description: string | null; enabled: number | boolean; article_count: number; created_at: string; updated_at: string };
			type ApiResult = { ok?: boolean; error?: string; servers?: Server[]; server?: Server };
			type ElementByType = { HTMLElement: HTMLElement; HTMLFormElement: HTMLFormElement; HTMLTableSectionElement: HTMLTableSectionElement; HTMLInputElement: HTMLInputElement; HTMLTextAreaElement: HTMLTextAreaElement; HTMLButtonElement: HTMLButtonElement };
			const $ = <K extends keyof ElementByType>(kind: K) => { void kind; return (id: string) => document.getElementById(id) as ElementByType[K]; };
			const formPanel = $('HTMLElement')('form-panel');
			const form = $('HTMLFormElement')('server-form');
			const loading = $('HTMLElement')('loading-state');
			const empty = $('HTMLElement')('empty-state');
			const errorState = $('HTMLElement')('error-state');
			const tableWrap = $('HTMLElement')('table-wrap');
			const rows = $('HTMLTableSectionElement')('server-rows');
			const cards = $('HTMLElement')('server-cards');
			const notice = $('HTMLElement')('notice');
			let servers: Server[] = [];
			let editing = false;

			function announce(message: string, kind: 'success' | 'error' = 'success') {
				notice.textContent = message;
				notice.className = `notice ${kind}`;
				notice.hidden = false;
				if (kind === 'success') window.setTimeout(() => { notice.hidden = true; }, 5000);
			}
			function dateLabel(value: string) {
				const date = new Date(value);
				return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat('ja-JP', { dateStyle: 'medium', timeStyle: 'short' }).format(date);
			}
			function setView(view: 'loading' | 'empty' | 'error' | 'list') {
				loading.hidden = view !== 'loading'; empty.hidden = view !== 'empty'; errorState.hidden = view !== 'error';
				tableWrap.hidden = view !== 'list' || servers.length === 0; cards.hidden = view !== 'list' || servers.length === 0;
			}
			async function request(url: string, init?: RequestInit): Promise<{ response: Response; data: ApiResult }> {
				const response = await fetch(url, { credentials: 'same-origin', ...init });
				let data: ApiResult = {};
				try { data = await response.json() as ApiResult; } catch { /* status text below remains useful for non-JSON errors */ }
				if (!response.ok || !data.ok) {
					if (response.status === 401) throw new Error('ログイン状態を確認できません（401）。管理者として再ログインしてください。');
					if (response.status === 403) throw new Error('この操作を行う権限がありません（403）。管理者アカウントでログインしてください。');
					throw new Error(data.error || `サーバーとの通信に失敗しました（${response.status || 'ネットワーク'}）。`);
				}
				return { response, data };
			}
			async function loadServers() {
				setView('loading');
				try {
					const { data } = await request('/api/admin/servers');
					servers = Array.isArray(data.servers) ? data.servers : [];
					$('HTMLElement')('server-count').textContent = `${servers.length} 件`;
					if (!servers.length) { setView('empty'); return; }
					renderServers(); setView('list');
				} catch (error) {
					$('HTMLElement')('error-title').textContent = '一覧を読み込めませんでした';
					$('HTMLElement')('error-message').textContent = error instanceof Error ? error.message : '通信に失敗しました。時間をおいて再度お試しください。';
					setView('error');
				}
			}
			function makeCell(text: string, className = '') {
				const cell = document.createElement('td'); cell.textContent = text; if (className) cell.className = className; return cell;
			}
			function editButton(server: Server) {
				const button = document.createElement('button'); button.type = 'button'; button.className = 'button secondary edit-button'; button.textContent = '編集'; button.setAttribute('aria-label', `${server.name}を編集`); button.addEventListener('click', () => openEdit(server)); return button;
			}
			function renderServers() {
				rows.replaceChildren(); cards.replaceChildren();
				for (const server of servers) {
					const active = server.enabled === 1 || server.enabled === true;
					const row = document.createElement('tr');
					row.append(makeCell(String(server.id), 'id-cell'), makeCell(server.slug, 'slug-cell'), makeCell(server.name, 'name-cell'));
					const state = document.createElement('td'); const badge = document.createElement('span'); badge.className = `badge ${active ? 'is-enabled' : 'is-disabled'}`; badge.textContent = active ? '有効' : '無効'; state.append(badge); row.append(state);
					row.append(makeCell(String(server.article_count ?? 0), 'number-cell'), makeCell(dateLabel(server.updated_at), 'date-cell'));
					const action = document.createElement('td'); action.className = 'action-cell'; action.append(editButton(server)); row.append(action); rows.append(row);
					const card = document.createElement('article'); card.className = 'server-card';
					const top = document.createElement('div'); top.className = 'card-top'; const identity = document.createElement('div'); identity.className = 'card-identity';
					const id = document.createElement('span'); id.className = 'card-id'; id.textContent = `ID ${server.id}`; const name = document.createElement('h3'); name.textContent = server.name; identity.append(id, name);
					const cardBadge = document.createElement('span'); cardBadge.className = `badge ${active ? 'is-enabled' : 'is-disabled'}`; cardBadge.textContent = active ? '有効' : '無効'; top.append(identity, cardBadge); card.append(top);
					const slug = document.createElement('p'); slug.className = 'card-slug'; slug.textContent = server.slug; card.append(slug);
					const meta = document.createElement('dl'); meta.className = 'card-meta';
					for (const [label, value] of [['記事数', String(server.article_count ?? 0)], ['更新日時', dateLabel(server.updated_at)]] as const) { const item = document.createElement('div'); const dt = document.createElement('dt'); dt.textContent = label; const dd = document.createElement('dd'); dd.textContent = value; item.append(dt, dd); meta.append(item); }
					card.append(meta); const cardActions = document.createElement('div'); cardActions.className = 'card-actions'; cardActions.append(editButton(server)); card.append(cardActions); cards.append(card);
				}
			}
			function openCreate() {
				editing = false; form.reset(); $('HTMLInputElement')('server-id').value = '';
				$('HTMLElement')('form-title').textContent = 'サーバーを追加'; $('HTMLElement')('form-eyebrow').textContent = 'NEW SERVER';
				$('HTMLElement')('slug-field').hidden = false; $('HTMLInputElement')('slug').disabled = false; $('HTMLElement')('enabled-field').hidden = true;
				$('HTMLButtonElement')('save-button').textContent = '追加する'; formPanel.hidden = false; formPanel.scrollIntoView({ behavior: 'smooth', block: 'start' }); $('HTMLInputElement')('slug').focus();
			}
			function openEdit(server: Server) {
				editing = true; form.reset(); $('HTMLInputElement')('server-id').value = String(server.id);
				$('HTMLElement')('form-title').textContent = 'サーバーを編集'; $('HTMLElement')('form-eyebrow').textContent = `EDIT SERVER · ID ${server.id}`;
				$('HTMLElement')('slug-field').hidden = false; const slug = $('HTMLInputElement')('slug'); slug.value = server.slug; slug.disabled = true; slug.required = false;
				$('HTMLInputElement')('name').value = server.name; $('HTMLTextAreaElement')('description').value = server.description ?? '';
				$('HTMLInputElement')('enabled').checked = server.enabled === 1 || server.enabled === true; $('HTMLElement')('enabled-field').hidden = false;
				$('HTMLButtonElement')('save-button').textContent = '変更を保存'; formPanel.hidden = false; formPanel.scrollIntoView({ behavior: 'smooth', block: 'start' }); $('HTMLInputElement')('name').focus();
			}
			function closeForm() { formPanel.hidden = true; form.reset(); $('HTMLInputElement')('slug').disabled = false; $('HTMLInputElement')('slug').required = true; }

			$('HTMLButtonElement')('add-button').addEventListener('click', openCreate);
			$('HTMLButtonElement')('close-form').addEventListener('click', closeForm);
			$('HTMLButtonElement')('cancel-form').addEventListener('click', closeForm);
			$('HTMLButtonElement')('retry-button').addEventListener('click', () => void loadServers());
			$('HTMLButtonElement')('menu-toggle').addEventListener('click', (event) => {
				const button = event.currentTarget as HTMLButtonElement; const open = button.getAttribute('aria-expanded') !== 'true';
				button.setAttribute('aria-expanded', String(open)); button.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く'); $('HTMLElement')('admin-nav').classList.toggle('is-open', open);
			});
			form.addEventListener('submit', async (event) => {
				event.preventDefault(); if (!form.reportValidity()) return;
				const save = $('HTMLButtonElement')('save-button'); save.disabled = true; save.textContent = '保存中…';
				const payload = { name: $('HTMLInputElement')('name').value.trim(), description: $('HTMLTextAreaElement')('description').value.trim() || null };
				try {
					if (editing) {
						const id = $('HTMLInputElement')('server-id').value;
						await request(`/api/admin/servers/${encodeURIComponent(id)}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...payload, enabled: $('HTMLInputElement')('enabled').checked }) });
						announce('サーバー情報を更新しました。');
					} else {
						await request('/api/admin/servers', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...payload, slug: $('HTMLInputElement')('slug').value.trim() }) });
						announce('サーバーを追加しました。');
					}
					closeForm(); await loadServers();
				} catch (error) { announce(error instanceof Error ? error.message : '保存できませんでした。', 'error'); }
				finally { save.disabled = false; save.textContent = editing ? '変更を保存' : '追加する'; }
			});
			void loadServers();
		</script>
	</body>
</html>

<style is:global>
	:root{color-scheme:dark;--bg:#111416;--bg2:#171b1e;--panel:#202529;--panel2:#292f33;--line:#41494d;--line2:#586267;--text:#f1f4f2;--soft:#c4ccc7;--muted:#929d96;--green:#72ad55;--green2:#8bc96d;--red:#e27b78;--gold:#e2bd63;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Yu Gothic",Meiryo,sans-serif;background:var(--bg);color:var(--text)}
	*{box-sizing:border-box}html,body{margin:0;min-height:100%;max-width:100%;overflow-x:hidden}body{background:radial-gradient(ellipse at 65% -10%,rgba(114,173,85,.12),transparent 45%),linear-gradient(180deg,#151a1c,var(--bg) 450px);line-height:1.55}button,input,textarea{font:inherit}button,a{-webkit-tap-highlight-color:transparent}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--green2);outline-offset:3px}[hidden]{display:none!important}.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:20px;height:72px;padding:0 clamp(16px,3vw,40px);border-bottom:1px solid #343c3e;background:rgba(17,20,22,.95);backdrop-filter:blur(14px);box-shadow:0 4px 18px #0003}.brand{display:flex;align-items:center;gap:12px;min-width:0}.brand-mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid #568f43;border-radius:4px;background:linear-gradient(145deg,#6ea95a,#38642f);box-shadow:inset 0 2px #ffffff2e,0 4px #0005;font-size:12px;font-weight:950;letter-spacing:.04em}.brand strong,.brand small{display:block}.brand strong{font-size:14px;letter-spacing:.03em}.brand small{margin-top:1px;color:var(--muted);font-size:10px;letter-spacing:.08em}.site-link{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:44px;margin-left:auto;padding:0 14px;border:1px solid var(--line);border-radius:3px;background:var(--panel);color:var(--soft);font-size:12px;font-weight:750}.site-link:hover{border-color:var(--line2);color:white}.menu-toggle{display:none}.shell{display:grid;grid-template-columns:236px minmax(0,1fr);width:min(1440px,100%);min-height:calc(100vh - 72px);margin:0 auto}.sidebar{position:sticky;top:72px;display:flex;flex-direction:column;align-self:start;min-height:calc(100vh - 72px);padding:30px 16px 20px;border-right:1px solid #30373a;background:rgba(16,19,21,.4)}.nav-label,.eyebrow{margin:0;color:#88bf70;font-size:10px;font-weight:900;le