							id="activity-empty"
							class="state-card"
							hidden
						>
							<div class="state-title">
								履歴はありません
							</div>

							<div class="state-text">
								処理済みの申請はまだありません。
							</div>
						</div>

						<div
							id="activity-list"
							class="activity-list"
							hidden
						></div>

					</section>


					<section class="section">

						<div class="section-heading">
							<h2>管理メニュー</h2>
						</div>

						<div class="quick-links">

							<a
								href="/docs/"
								class="quick-link"
							>
								<div class="quick-link-title">
									Wikiを見る
								</div>

								<div class="quick-link-description">
									現在公開されているWikiを確認します。
								</div>
							</a>


							<a
								href="/wiki/requests/"
								class="quick-link"
							>
								<div class="quick-link-title">
									自分の申請
								</div>

								<div class="quick-link-description">
									自分が作成した下書き・レビュー申請を確認します。
								</div>
							</a>


							<a
								href="/account/"
								class="quick-link"
							>
								<div class="quick-link-title">
									アカウント
								</div>

								<div class="quick-link-description">
									アカウント情報と権限を確認します。
								</div>
							</a>

						</div>

					</section>

				</div>

	<div
		id="publish-notice"
		class="publish-notice"
		hidden
	>
		<div
			id="publish-notice-title"
			class="publish-notice-title"
		>
			公開処理
		</div>

		<div
			id="publish-notice-text"
			class="publish-notice-text"
		></div>
	</div>
	</AdminLayout>


	<script>
		type EditRequestStatus =
			| 'draft'
			| 'pending'
			| 'approved'
			| 'publishing'
			| 'published'
			| 'rejected';

		type EditRequest = {
			id: string;
			page_title?: string | null;
			page_path?: string | null;
			revision_number?: number | null;
			status: EditRequestStatus | string;
			message?: string | null;
			created_at?: string | null;
			reviewed_at?: string | null;
			user_display_name?: string | null;
			user_id?: string | null;
		};

		type RequestsResponse = {
			ok?: boolean;
			editRequests?: EditRequest[];
			requests?: EditRequest[];
			error?: string;
		};

		type PagesResponse = {
			ok?: boolean;
			pages?: unknown[];
			error?: string;
		};

		type PublishResponse = {
			ok?: boolean;
			error?: string;
			editRequest?: unknown;
			github?: {
				pullRequest?: {
					number?: number;
					html_url?: string;
				};
			};
		};


		/* ========================================
		   DOM helper
		======================================== */

		function getElement<T extends Element>(
			selector: string
		): T {
			const element =
				document.querySelector<T>(
					selector
				);

			if (!element) {
				throw new Error(
					`管理画面の要素が見つかりません: ${selector}`
				);
			}

			return element;
		}


		/* ========================================
		   DOM
		======================================== */

		const refreshButton =
			getElement<HTMLButtonElement>(
				'#refresh-button'
			);

		const pendingCount =
			getElement<HTMLElement>(
				'#pending-count'
			);

		const approvedCount =
			getElement<HTMLElement>(
				'#approved-count'
			);

		const publishingCount =
			getElement<HTMLElement>(
				'#publishing-count'
			);

		const pageCount =
			getElement<HTMLElement>(
				'#page-count'
			);

		const pendingLabel =
			getElement<HTMLElement>(
				'#pending-label'
			);

		const approvedLabel =
			getElement<HTMLElement>(
				'#approved-label'
			);

		const publishingLabel =
			getElement<HTMLElement>(
				'#publishing-label'
			);

		const loadingState =
			getElement<HTMLElement>(
				'#loading-state'
			);

		const errorState =
			getElement<HTMLElement>(
				'#error-state'
			);

		const errorMessage =
			getElement<HTMLElement>(
				'#error-message'
			);

		const dashboardContent =
			getElement<HTMLElement>(
				'#dashboard-content'
			);

		const pendingEmpty =
			getElement<HTMLElement>(
				'#pending-empty'
			);

		const approvedEmpty =
			getElement<HTMLElement>(
				'#approved-empty'
			);

		const publishingEmpty =
			getElement<HTMLElement>(
				'#publishing-empty'
			);

		const activityEmpty =
			getElement<HTMLElement>(
				'#activity-empty'
			);

		const pendingList =
			getElement<HTMLElement>(
				'#pending-list'
			);

		const approvedList =
			getElement<HTMLElement>(
				'#approved-list'
			);

		const publishingList =
			getElement<HTMLElement>(
				'#publishing-list'
			);

		const activityList =
			getElement<HTMLElement>(
				'#activity-list'
			);

		const publishNotice =
			getElement<HTMLElement>(
				'#publish-notice'
			);

		const publishNoticeTitle =
			getElement<HTMLElement>(
				'#publish-notice-title'
			);

		const publishNoticeText =
			getElement<HTMLElement>(
				'#publish-notice-text'
			);


		/* ========================================
		   Helpers
		======================================== */

		function escapeHtml(
			value: unknown
		): string {
			return String(value ?? '')
				.replaceAll(
					'&',
					'&amp;'
				)
				.replaceAll(
					'<',
					'&lt;'
				)
				.replaceAll(
					'>',
					'&gt;'
				)
				.replaceAll(
					'"',
					'&quot;'
				)
				.replaceAll(
					"'",
					'&#039;'
				);
		}


		function formatDate(
			value: string | null | undefined
		): string {
			if (!value) {
				return '—';
			}

			const date =
				new Date(value);

			if (
				Number.isNaN(
					date.getTime()
				)
			) {
				return value;
			}

			return new Intl.DateTimeFormat(
				'ja-JP',
				{
					dateStyle: 'medium',
					timeStyle: 'short',
				}
			).format(date);
		}


		function getRequests(
			data: RequestsResponse
		): EditRequest[] {
			if (
				Array.isArray(
					data.editRequests
				)
			) {
				return data.editRequests;
			}

			if (
				Array.isArray(
					data.requests
				)
			) {
				return data.requests;
			}

			return [];
		}


		function getStatusLabel(
			status: string
		): string {
			switch (status) {
				case 'draft':
					return '下書き';

				case 'pending':
					return 'レビュー申請中';

				case 'approved':
					return '承認済み';

				case 'publishing':
					return '公開処理中';

				case 'published':
					return '公開済み';

				case 'rejected':
					return '却下';

				default:
					return status;
			}
		}


		function showPublishNotice(
			type: 'success' | 'error',
			title: string,
			message: string
		): void {
			publishNotice.classList.remove(
				'success',
				'error'
			);

			publishNotice.classList.add(
				type
			);

			publishNoticeTitle.textContent =
				title;

			publishNoticeText.textContent =
				message;

			publishNotice.hidden = false;

			window.setTimeout(
				() => {
					publishNotice.hidden = true;
				},
				7000
			);
		}


		/* ========================================
		   Publish
		======================================== */

		async function publishRequest(
			requestId: string,
			button: HTMLButtonElement
		): Promise<void> {
			const confirmed =
				window.confirm(
					'この編集申請をGitHubへ公開処理します。\n\n' +
					'承認済みのRevisionをGitHubへ反映するためのPRを作成します。\n\n' +
					'公開処理を開始しますか？'
				);

			if (!confirmed) {
				return;
			}


			button.disabled = true;

			const originalText =
				button.textContent ||
				'公開する';

			button.textContent =
				'公開処理を開始しています…';


			try {
				const response =
					await fetch(
						`/api/wiki/edit-requests/${encodeURIComponent(requestId)}/publish`,
						{
							method: 'POST',
							credentials: 'include',
							headers: {
								'Content-Type':
									'application/json',
							},
						}
					);


				let data:
					PublishResponse = {};


				try {
					data =
						await response.json();
				} catch {
					data = {};
				}


				if (
					!response.ok ||
					data.ok !== true
				) {
					const message =
						data.error ||
						`公開処理に失敗しました。HTTP ${response.status}`;

					throw new Error(
						message
					);
				}


				const details: string[] =
					[];


				if (
					typeof data.github?.pullRequest?.number ===
					'number'
				) {
					details.push(
						`PR #${data.github.pullRequest.number}`
					);
				}


				if (
					typeof data.github?.pullRequest?.html_url ===
					'string' &&
					data.github.pullRequest.html_url.length > 0
				) {
					details.push(
						data.github.pullRequest.html_url
					);
				}


				showPublishNotice(
					'success',
					'公開処理を開始しました',
					details.length > 0
						? details.join('\n')
						: 'GitHubへの公開処理を開始しました。'
				);


				await loadDashboard();

			} catch (error: unknown) {
				console.error(
					'Publish request error:',
					error
				);


				showPublishNotice(
					'error',
					'公開処理に失敗しました',
					error instanceof Error
						? error.message
						: '公開処理中にエラーが発生しました。'
				);


				button.disabled = false;

				button.textContent =
					originalText;
			}
		}


		/* ========================================
		   Request card
		======================================== */

		function renderRequestCard(
			request: EditRequest
		): string {
			const validStatusClasses:
				string[] = [
					'pending',
					'approved',
					'publishing',
					'rejected',
					'published',
				];


			const statusClass =
				validStatusClasses.includes(
					request.status
				)
					? request.status
					: '';


			const detailUrl =
				`/wiki/edit-request/?id=${encodeURIComponent(
					request.id
				)}`;


			const publishButton =
				request.status === 'approved'
					? `
						<button
							type="button"
							class="publish-button"
							data-publish-id="${escapeHtml(
								request.id
							)}"
						>
							公開する
						</button>
					`
					: '';


			return `
				<article class="request-card">

					<div class="request-main">

						<div class="request-top">

							<div class="request-title">

								<h3>
									${escapeHtml(
										request.page_title ||
										'Wikiページ'
									)}
								</h3>

								<div class="request-path">
									${escapeHtml(
										request.page_path ||
										'—'
									)}
								</div>

							</div>

							<div class="status-badge ${statusClass}">
								${escapeHtml(
									getStatusLabel(
										request.status
									)
								)}
							</div>

						</div>


						<div class="request-meta">

							<span>
								Revision
								<strong>
									${escapeHtml(
										request.revision_number ??
										'—'
									)}
								</strong>
							</span>

							<span>
								申請者
								<strong>
									${escapeHtml(
										request.user_display_name ||
										request.user_id ||
										'—'
									)}
								</strong>
							</span>

							<span>
								申請日時
								<strong>
									${escapeHtml(
										formatDate(
											request.created_at
										)
									)}
								</strong>
							</span>

							${
								request.reviewed_at
									? `
										<span>
											レビュー日時
											<strong>
												${escapeHtml(
													formatDate(
														request.reviewed_at
													)
												)}
											</strong>
										</span>
									`
									: ''
							}

						</div>


						${
							request.message
								? `
									<div class="request-message">
										${escapeHtml(
											request.message
										)}
									</div>
								`
								: ''
						}

					</div>


					<div class="request-footer">

						<div
							class="request-id"
							title="${escapeHtml(
								request.id
							)}"
						>
							ID: ${escapeHtml(
								request.id
							)}
						</div>


						<div class="request-actions">

							<a
								class="secondary-button"
								href="${detailUrl}"
							>
								詳細を見る
							</a>

							${publishButton}

						</div>

					</div>

				</article>
			`;
		}


		/* ========================================
		   Publish button events
		======================================== */

		function bindPublishButtons(
			container: HTMLElement
		): void {
			const buttons =
				container.querySelectorAll<HTMLButtonElement>(
					'[data-publish-id]'
				);


			buttons.forEach(
				(
					button: HTMLButtonElement
				): void => {
					button.addEventListener(
						'click',
						(): void => {
							const requestId =
								button.dataset.publishId;

							if (
								!requestId
							) {
								return;
							}

							void publishRequest(
								requestId,
								button
							);
						}
					);
				}
			);
		}


		/* ========================================
		   Status section
		======================================== */

		function renderStatusSection(
			requests: EditRequest[],
			status: string,
			listElement: HTMLElement,
			emptyElement: HTMLElement,
			labelElement: HTMLElement
		): void {
			const filtered =
				requests.filter(
					(
						request: EditRequest
					): boolean =>
						request.status ===
						status
				);


			labelElement.textContent =
				`${filtered.length}件`;


			if (
				filtered.length === 0
			) {
				listElement.hidden = true;
				emptyElement.hidden = false;
				listElement.innerHTML = '';

				return;
			}


			emptyElement.hidden = true;
			listElement.hidden = false;


			listElement.innerHTML =
				filtered
					.map(
						(
							request: EditRequest
						): string =>
							renderRequestCard(
								request
							)
					)
					.join('');


			if (
				status === 'approved'
			) {
				bindPublishButtons(
					listElement
				);
			}
		}


		/* ========================================
		   Activity
		======================================== */

		function renderActivity(
			requests: EditRequest[]
		): void {
			const processed =
				requests
					.filter(
						(
							request: EditRequest
						): boolean =>
							[
								'rejected',
								'published',
							].includes(
								request.status
							)
					)
					.sort(
						(
							a: EditRequest,
							b: EditRequest
						): number =>
							new Date(
								b.reviewed_at ||
								b.created_at ||
								0
							).getTime() -
							new Date(
								a.reviewed_at ||
								a.created_at ||
								0
							).getTime()
					)
					.slice(
						0,
						10
					);


			if (
				processed.length === 0
			) {
				activityList.hidden = true;
				activityEmpty.hidden = false;
				activityList.innerHTML = '';

				return;
			}


			activityEmpty.hidden = true;
			activityList.hidden = false;


			activityList.innerHTML =
				processed
					.map(
						(
							request: EditRequest
						): string => `
							<article class="activity-card">

								<div class="activity-main">

									<div class="activity-title">
										${escapeHtml(
											request.page_title ||
											'Wikiページ'
										)}
									</div>

									<div class="activity-path">
										${escapeHtml(
											request.page_path ||
											'—'
										)}
									</div>

									<div class="activity-meta">
										${escapeHtml(
											getStatusLabel(
												request.status
											)
										)}
										・
										Revision
										${escapeHtml(
											request.revision_number ??
											'—'
										)}
										・
										${escapeHtml(
											formatDate(
												request.reviewed_at ||
												request.created_at
											)
										)}
									</div>

								</div>

								<a
									class="activity-action"
									href="/wiki/edit-request/?id=${encodeURIComponent(
										request.id
									)}"
								>
									詳細を見る
								</a>

							</article>
						`
					)
					.join('');
		}


		/* ========================================
		   Dashboard
		======================================== */

		function renderDashboard(
			requests: EditRequest[],
			pages: unknown[]
		): void {
			const pending =
				requests.filter(
					(
						request: EditRequest
					): boolean =>
						request.status ===
						'pending'
				);


			const approved =
				requests.filter(
					(
						request: EditRequest
					): boolean =>
						request.status ===
						'approved'
				);


			const publishing =
				requests.filter(
					(
						request: EditRequest
					): boolean =>
						request.status ===
						'publishing'
				);


			pendingCount.textContent =
				String(
					pending.length
				);

			approvedCount.textContent =
				String(
					approved.length
				);

			publishingCount.textContent =
				String(
					publishing.length
				);

			pageCount.textContent =
				String(
					pages.length
				);


			renderStatusSection(
				requests,
				'pending',
				pendingList,
				pendingEmpty,
				pendingLabel
			);


			renderStatusSection(
				requests,
				'approved',
				approvedList,
				approvedEmpty,
				approvedLabel
			);


			renderStatusSection(
				requests,
				'publishing',
				publishingList,
				publishingEmpty,
				publishingLabel
			);


			renderActivity(
				requests
			);
		}


		/* ========================================
		   Load dashboard
		======================================== */

		async function loadDashboard(): Promise<void> {
			loadingState.hidden = false;
			errorState.hidden = true;
			dashboardContent.hidden = true;


			refreshButton.disabled = true;
			refreshButton.textContent =
				'読み込み中…';


			try {
				const meResponse =
					await fetch(
						'/me',
						{
							credentials: 'include',
						}
					);


				if (
					!meResponse.ok
				) {
					throw new Error(
						'ログイン状態を確認できませんでした。'
					);
				}


				const me: {
					loggedIn?: boolean;
					user?: {
						role?: string;
					} | null;
				} =
					await meResponse.json();


				if (
					!me.loggedIn ||
					!me.user ||
					me.user.role !== 'admin'
				) {
					window.location.href =
						'/account/';

					return;
				}


				const [
					requestResponse,
					pageResponse,
				] =
					await Promise.all([
						fetch(
							'/api/wiki/edit-requests',
							{
								credentials:
									'include',
							}
						),

						fetch(
							'/api/wiki/pages',
							{
								credentials:
									'include',
							}
						),
					]);


				if (
					!requestResponse.ok
				) {
					throw new Error(
						'編集申請を取得できませんでした。'
					);
				}


				const requestData:
					RequestsResponse =
					await requestResponse.json();


				const requests =
					getRequests(
						requestData
					);


				let pages:
					unknown[] = [];


				if (
					pageResponse.ok
				) {
					const pageData:
						PagesResponse =
						await pageResponse.json();


					if (
						Array.isArray(
							pageData.pages
						)
					) {
						pages =
							pageData.pages;
					}
				}


				renderDashboard(
					requests,
					pages
				);


				loadingState.hidden =
					true;

				errorState.hidden =
					true;

				dashboardContent.hidden =
					false;

			} catch (
				error: unknown
			) {
				console.error(
					'Admin dashboard error:',
					error
				);


				loadingState.hidden =
					true;

				dashboardContent.hidden =
					true;

				errorState.hidden =
					false;


				errorMessage.textContent =
					error instanceof Error
						? error.message
						: '管理情報を取得できませんでした。';

			} finally {
				refreshButton.disabled =
					false;

				refreshButton.textContent =
					'再読み込み';
			}
		}


		/* ========================================
		   Events
		======================================== */

		refreshButton.addEventListener(
			'click',
			(): void => {
				void loadDashboard();
			}
		);


		void loadDashboard();
	</script>
</body>
</html>