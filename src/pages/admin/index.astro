					<section class="section">

						<div class="section-heading">
							<h2>公開待ち</h2>

							<span id="approved-label">
								0件
							</span>
						</div>

						<div
							id="approved-empty"
							class="state-card"
							hidden
						>
							<div class="state-title">
								公開待ちの申請はありません
							</div>

							<div class="state-text">
								承認済みで公開処理を待っている申請はありません。
							</div>
						</div>

						<div
							id="approved-list"
							class="request-list"
							hidden
						></div>

					</section>


					<section class="section">

						<div class="section-heading">
							<h2>公開処理中</h2>

							<span id="publishing-label">
								0件
							</span>
