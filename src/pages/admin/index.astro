---
import AdminLayout from '../../components/admin/AdminLayout.astro';
---

<!doctype html>
<html lang="ja">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />

	<title>NUGBASE 管理画面</title>

	<style>
	/* =========================================================
	   NUGBASE Admin Design System
	   ---------------------------------------------------------
	   Visual direction:
	   - Minecraft-inspired original UI
	   - Block / voxel geometry
	   - 8px spacing grid
	   - Grass / stone / sky inspired palette
	   - Strong top-left light
	   - Hard lower shadow
	   - Minimal rounding
	   - High readability
	   ========================================================= */


	/* =========================================================
	   01. Design Tokens
	   ========================================================= */

	:root {
		color-scheme: dark;

		/* Background */
		--bg: #111416;
		--bg-soft: #181c1f;
		--bg-elevated: #202529;

		/* Surface */
		--panel: #2b3034;
		--panel-soft: #32383c;
		--panel-hover: #383f43;

		/* Border */
		--border: #4a5155;
		--border-strong: #5b6469;

		/* Text */
		--text: #f1f4f2;
		--text-soft: #c3cac6;
		--text-muted: #929b96;

		/* NUGBASE green */
		--accent: #72ad55;
		--accent-dark: #568f43;
		--accent-light: #8bc96d;
		--accent-soft: rgba(114, 173, 85, 0.14);

		/* Status */
		--warning: #e2b85e;
		--warning-dark: #ad8433;
		--warning-soft: rgba(226, 184, 94, 0.14);

		--danger: #dc746b;
		--danger-dark: #a94e47;
		--danger-soft: rgba(220, 116, 107, 0.14);

		--info: #7ca9d8;
		--info-dark: #587fae;
		--info-soft: rgba(124, 169, 216, 0.14);

		--purple: #b594df;
		--purple-dark: #8060aa;
		--purple-soft: rgba(181, 148, 223, 0.14);

		/* Geometry */
		--radius: 6px;
		--radius-small: 4px;

		/* Shadows */
		--shadow-block:
			0 6px 0 rgba(0, 0, 0, 0.28),
			0 14px 28px rgba(0, 0, 0, 0.22);

		--shadow-card:
			0 4px 0 rgba(0, 0, 0, 0.24),
			0 10px 22px rgba(0, 0, 0, 0.18);

		--shadow-small:
			0 3px 0 rgba(0, 0, 0, 0.20);

	}


	/* =========================================================
	   02. Global
	   ========================================================= */

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	html {
		background: var(--bg);
	}

	body {
		background:
			/* Soft Minecraft-style sky light */
			linear-gradient(
				180deg,
				rgba(93, 130, 91, 0.12) 0,
				rgba(93, 130, 91, 0.04) 240px,
				transparent 520px
			),
			/* Very subtle terrain-like layers */
			linear-gradient(
				180deg,
				#111416 0%,
				#14181b 52%,
				#101315 100%
			);

		color: var(--text);

		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"Yu Gothic",
			"YuGothic",
			"Hiragino Kaku Gothic ProN",
			Meiryo,
			sans-serif;

		line-height: 1.6;
	}

	button,
	a {
		font: inherit;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	[hidden] {
		display: none !important;
	}


	/* =========================================================
	   03. Focus
	   ========================================================= */

	a:focus-visible,
	button:focus-visible {
		outline:
			3px solid
			var(--accent-light);

		outline-offset: 3px;
	}


	/* =========================================================
	   Page Heading
	   ========================================================= */

	.page-heading {
		position: relative;

		margin-bottom: 32px;

		padding-left: 16px;
	}

	.page-heading::before {
		content: "";

		position: absolute;

		top: 2px;
		bottom: 2px;
		left: 0;

		width: 5px;

		background:
			linear-gradient(
				180deg,
				var(--accent-light),
				var(--accent-dark)
			);

		box-shadow:
			2px 0 0 rgba(0, 0, 0, 0.20);
	}

	.page-heading-row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;

		gap: 24px;
	}

	.page-heading h1 {
		margin: 0;

		color: var(--text);

		font-size:
			clamp(
				26px,
				4vw,
				38px
			);

		font-weight: 900;

		line-height: 1.2;

		letter-spacing:
			-0.025em;
	}

	.page-heading p {
		margin: 8px 0 0;

		color: var(--text-soft);

		font-size: 13px;
	}


	/* =========================================================
	   09. Refresh Button
	   ========================================================= */

	.refresh-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		min-height: 40px;

		padding:
			0 14px;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius-small);

		background:
			var(--panel);

		color:
			var(--text-soft);

		font-size: 12px;
		font-weight: 800;

		cursor: pointer;

		box-shadow:
			var(--shadow-small);

		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease,
			opacity 0.15s ease;
	}

	.refresh-button:hover {
		background:
			var(--panel-hover);

		border-color:
			var(--border-strong);

		color:
			var(--text);

		transform:
			translateY(-1px);
	}

	.refresh-button:active {
		transform:
			translateY(2px);

		box-shadow:
			0 1px 0 rgba(0, 0, 0, 0.20);
	}

	.refresh-button:disabled {
		opacity: 0.55;

		cursor: wait;

		transform: none;
	}


	/* =========================================================
	   10. Dashboard Cards
	   ========================================================= */

	.dashboard-grid {
		display: grid;

		grid-template-columns:
			repeat(
				4,
				minmax(0, 1fr)
			);

		gap: 16px;

		margin-bottom: 44px;
	}

	.dashboard-card {
		position: relative;

		min-height: 156px;

		padding: 20px;

		overflow: hidden;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius);

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.045),
				rgba(255, 255, 255, 0)
			),
			var(--panel);

		box-shadow:
			var(--shadow-card);

		transition:
			transform 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}

	.dashboard-card::before {
		content: "";

		position: absolute;

		top: 0;
		left: 0;
		right: 0;

		height: 4px;

		background:
			var(--border-strong);
	}

	.dashboard-card::after {
		content: "";

		position: absolute;

		right: -30px;
		bottom: -34px;

		width: 100px;
		height: 100px;

		border-radius: 50%;

		background:
			rgba(255, 255, 255, 0.025);

		pointer-events: none;
	}

	.dashboard-card:hover {
		transform:
			translateY(-2px);

		border-color:
			var(--border-strong);
	}

	.dashboard-card-label {
		position: relative;
		z-index: 1;

		color:
			var(--text-muted);

		font-size: 11px;
		font-weight: 800;

		letter-spacing: 0.05em;
	}

	.dashboard-card-value {
		position: relative;
		z-index: 1;

		margin-top: 12px;

		font-size: 34px;
		font-weight: 900;

		line-height: 1;

		letter-spacing:
			-0.03em;
	}

	.dashboard-card-note {
		position: relative;
		z-index: 1;

		margin-top: 12px;

		color:
			var(--text-soft);

		font-size: 11px;

		line-height: 1.5;
	}


	/* =========================================================
	   11. Dashboard Status Colors
	   ========================================================= */

	.dashboard-card.pending {
		border-color:
			rgba(226, 184, 94, 0.38);

		background:
			linear-gradient(
				145deg,
				var(--warning-soft),
				transparent 65%
			),
			var(--panel);
	}

	.dashboard-card.pending::before {
		background:
			var(--warning);
	}

	.dashboard-card.pending .dashboard-card-value {
		color:
			var(--warning);
	}


	.dashboard-card.approved {
		border-color:
			rgba(114, 173, 85, 0.36);

		background:
			linear-gradient(
				145deg,
				var(--accent-soft),
				transparent 65%
			),
			var(--panel);
	}

	.dashboard-card.approved::before {
		background:
			var(--accent);
	}

	.dashboard-card.approved .dashboard-card-value {
		color:
			var(--accent-light);
	}


	.dashboard-card.publishing {
		border-color:
			rgba(124, 169, 216, 0.38);

		background:
			linear-gradient(
				145deg,
				var(--info-soft),
				transparent 65%
			),
			var(--panel);
	}

	.dashboard-card.publishing::before {
		background:
			var(--info);
	}

	.dashboard-card.publishing .dashboard-card-value {
		color:
			var(--info);
	}


	.dashboard-card.pages {
		border-color:
			rgba(181, 148, 223, 0.34);

		background:
			linear-gradient(
				145deg,
				var(--purple-soft),
				transparent 65%
			),
			var(--panel);
	}

	.dashboard-card.pages::before {
		background:
			var(--purple);
	}

	.dashboard-card.pages .dashboard-card-value {
		color:
			var(--purple);
	}


	/* =========================================================
	   12. Section
	   ========================================================= */

	.section {
		margin-top: 44px;
	}

	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;

		gap: 16px;

		margin-bottom: 16px;

		padding-bottom: 10px;

		border-bottom:
			1px solid
			var(--border);
	}

	.section-heading h2 {
		position: relative;

		margin: 0;

		padding-left: 12px;

		color: var(--text);

		font-size: 19px;
		font-weight: 850;

		line-height: 1.4;
	}

	.section-heading h2::before {
		content: "";

		position: absolute;

		left: 0;
		top: 4px;
		bottom: 4px;

		width: 4px;

		background:
			var(--accent);

		box-shadow:
			2px 0 0 rgba(0, 0, 0, 0.18);
	}

	.section-heading span {
		color:
			var(--text-muted);

		font-size: 11px;
		font-weight: 700;
	}


	/* =========================================================
	   13. Request Cards
	   ========================================================= */

	.request-list {
		display: grid;

		gap: 16px;
	}

	.request-card {
		overflow: hidden;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius);

		background:
			var(--panel);

		box-shadow:
			var(--shadow-card);

		transition:
			transform 0.15s ease,
			border-color 0.15s ease;
	}

	.request-card:hover {
		transform:
			translateY(-2px);

		border-color:
			var(--border-strong);
	}

	.request-main {
		padding: 22px;
	}

	.request-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;

		gap: 20px;
	}

	.request-title {
		min-width: 0;
	}

	.request-title h3 {
		margin: 0;

		color:
			var(--text);

		font-size: 16px;
		font-weight: 800;

		line-height: 1.45;
	}

	.request-path {
		margin-top: 6px;

		color:
			var(--text-muted);

		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;

		font-size: 11px;

		overflow-wrap: anywhere;
	}


	/* =========================================================
	   14. Status Badge
	   ========================================================= */

	.status-badge {
		flex: 0 0 auto;

		display: inline-flex;
		align-items: center;

		min-height: 28px;

		padding:
			0 10px;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius-small);

		background:
			var(--bg-soft);

		color:
			var(--text-soft);

		font-size: 10px;
		font-weight: 850;

		white-space: nowrap;

		box-shadow:
			0 2px 0 rgba(0, 0, 0, 0.16);
	}

	.status-badge.pending {
		border-color:
			rgba(226, 184, 94, 0.40);

		background:
			var(--warning-soft);

		color:
			var(--warning);
	}

	.status-badge.approved {
		border-color:
			rgba(114, 173, 85, 0.40);

		background:
			var(--accent-soft);

		color:
			var(--accent-light);
	}

	.status-badge.publishing {
		border-color:
			rgba(124, 169, 216, 0.40);

		background:
			var(--info-soft);

		color:
			var(--info);
	}

	.status-badge.rejected {
		border-color:
			rgba(220, 116, 107, 0.40);

		background:
			var(--danger-soft);

		color:
			var(--danger);
	}

	.status-badge.published {
		border-color:
			rgba(114, 173, 85, 0.40);

		background:
			var(--accent-soft);

		color:
			var(--accent-light);
	}


	/* =========================================================
	   15. Request Metadata
	   ========================================================= */

	.request-meta {
		display: flex;
		flex-wrap: wrap;

		gap: 8px 20px;

		margin-top: 18px;

		padding-top: 14px;

		border-top:
			1px solid
			rgba(255, 255, 255, 0.06);

		color:
			var(--text-muted);

		font-size: 11px;
	}

	.request-meta strong {
		margin-left: 4px;

		color:
			var(--text-soft);

		font-weight: 750;
	}


	/* =========================================================
	   16. Request Message
	   ========================================================= */

	.request-message {
		margin-top: 16px;

		padding:
			14px 16px;

		border:
			1px solid
			var(--border);

		border-left:
			4px solid
			var(--accent);

		background:
			rgba(255, 255, 255, 0.025);

		color:
			var(--text-soft);

		font-size: 12px;

		line-height: 1.7;

		white-space: pre-wrap;

		word-break: break-word;
	}


	/* =========================================================
	   17. Request Footer
	   ========================================================= */

	.request-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 16px;

		padding:
			13px 20px;

		border-top:
			1px solid
			var(--border);

		background:
			rgba(0, 0, 0, 0.13);
	}

	.request-id {
		min-width: 0;

		color:
			var(--text-muted);

		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;

		font-size: 9px;

		overflow: hidden;

		text-overflow: ellipsis;

		white-space: nowrap;
	}

	.request-actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;

		flex-wrap: wrap;

		gap: 8px;
	}


	/* =========================================================
	   18. Buttons
	   ========================================================= */

	.primary-button,
	.secondary-button,
	.publish-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		min-height: 38px;

		padding:
			0 14px;

		border-radius:
			var(--radius-small);

		font-size: 11px;
		font-weight: 800;

		cursor: pointer;

		box-shadow:
			0 3px 0 rgba(0, 0, 0, 0.20);

		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease,
			opacity 0.15s ease;
	}

	.primary-button {
		border:
			1px solid
			var(--accent-dark);

		background:
			var(--accent);

		color:
			#ffffff;
	}

	.primary-button:hover {
		background:
			var(--accent-light);

		border-color:
			var(--accent);

		transform:
			translateY(-1px);
	}

	.primary-button:active,
	.publish-button:active,
	.secondary-button:active {
		transform:
			translateY(2px);

		box-shadow:
			0 1px 0 rgba(0, 0, 0, 0.20);
	}

	.secondary-button {
		border:
			1px solid
			var(--border);

		background:
			var(--bg-soft);

		color:
			var(--text-soft);
	}

	.secondary-button:hover {
		background:
			var(--panel-hover);

		border-color:
			var(--border-strong);

		color:
			var(--text);

		transform:
			translateY(-1px);
	}

	.publish-button {
		border:
			1px solid
			var(--info-dark);

		background:
			var(--info-dark);

		color:
			#ffffff;
	}

	.publish-button:hover {
		background:
			var(--info);

		border-color:
			var(--info);

		transform:
			translateY(-1px);
	}

	.publish-button:disabled,
	.primary-button:disabled,
	.secondary-button:disabled {
		opacity: 0.55;

		cursor: wait;

		transform: none;
	}


	/* =========================================================
	   19. Activity
	   ========================================================= */

	.activity-list {
		display: grid;

		gap: 10px;
	}

	.activity-card {
		display: grid;

		grid-template-columns:
			minmax(0, 1fr)
			auto;

		gap: 20px;

		padding:
			16px 18px;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius);

		background:
			var(--panel);

		box-shadow:
			var(--shadow-small);

		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.activity-card:hover {
		background:
			var(--panel-hover);

		border-color:
			var(--border-strong);

		transform:
			translateY(-1px);
	}

	.activity-main {
		min-width: 0;
	}

	.activity-title {
		color:
			var(--text);

		font-size: 13px;
		font-weight: 800;
	}

	.activity-path {
		margin-top: 4px;

		color:
			var(--text-muted);

		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;

		font-size: 10px;

		overflow-wrap: anywhere;
	}

	.activity-meta {
		margin-top: 7px;

		color:
			var(--text-soft);

		font-size: 10px;
	}

	.activity-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		min-height: 34px;

		padding:
			0 12px;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius-small);

		background:
			var(--bg-soft);

		color:
			var(--text-soft);

		font-size: 10px;
		font-weight: 800;

		box-shadow:
			0 2px 0 rgba(0, 0, 0, 0.18);

		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease;
	}

	.activity-action:hover {
		background:
			var(--panel-hover);

		border-color:
			var(--border-strong);

		color:
			var(--text);

		transform:
			translateY(-1px);
	}


	/* =========================================================
	   20. State Cards
	   ========================================================= */

	.state-card {
		padding:
			40px 24px;

		border:
			1px dashed
			var(--border-strong);

		border-radius:
			var(--radius);

		background:
			rgba(255, 255, 255, 0.018);

		text-align:
			center;
	}

	.state-title {
		color:
			var(--text);

		font-weight:
			800;
	}

	.state-text {
		margin-top:
			6px;

		color:
			var(--text-muted);

		font-size:
			12px;
	}

	.error-card {
		border-color:
			rgba(220, 116, 107, 0.42);

		border-style:
			solid;

		background:
			var(--danger-soft);
	}

	.error-card .state-title {
		color:
			var(--danger);
	}


	/* =========================================================
	   21. Quick Links
	   ========================================================= */

	.quick-links {
		display: grid;

		grid-template-columns:
			repeat(
				3,
				minmax(0, 1fr)
			);

		gap:
			16px;
	}

	.quick-link {
		position: relative;

		padding:
			20px;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius);

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.035),
				transparent 70%
			),
			var(--panel);

		box-shadow:
			var(--shadow-card);

		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.quick-link::before {
		content: "";

		position: absolute;

		top: 0;
		left: 0;
		right: 0;

		height: 3px;

		background:
			var(--accent);
	}

	.quick-link:hover {
		background:
			var(--panel-hover);

		border-color:
			var(--border-strong);

		transform:
			translateY(-2px);

		box-shadow:
			0 6px 0 rgba(0, 0, 0, 0.24),
			0 14px 26px rgba(0, 0, 0, 0.18);
	}

	.quick-link:active {
		transform:
			translateY(2px);

		box-shadow:
			0 2px 0 rgba(0, 0, 0, 0.20);
	}

	.quick-link-title {
		color:
			var(--text);

		font-size:
			14px;

		font-weight:
			850;
	}

	.quick-link-description {
		margin-top:
			6px;

		color:
			var(--text-muted);

		font-size:
			11px;

		line-height:
			1.6;
	}


	/* =========================================================
	   22. Publish Notification
	   ========================================================= */

	.publish-notice {
		position: fixed;

		right: 24px;
		bottom: 24px;

		z-index: 100;

		width:
			min(
				420px,
				calc(100vw - 48px)
			);

		padding:
			16px 18px;

		border:
			1px solid
			var(--border);

		border-radius:
			var(--radius);

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.055),
				rgba(255, 255, 255, 0)
			),
			var(--panel);

		box-shadow:
			var(--shadow-block);

		font-size:
			12px;
	}

	.publish-notice::before {
		content: "";

		display: block;

		width: 32px;
		height: 3px;

		margin-bottom: 10px;

		background:
			var(--accent);
	}

	.publish-notice.success {
		border-color:
			rgba(114, 173, 85, 0.48);
	}

	.publish-notice.success::before {
		background:
			var(--accent);
	}

	.publish-notice.error {
		border-color:
			rgba(220, 116, 107, 0.48);
	}

	.publish-notice.error::before {
		background:
			var(--danger);
	}

	.publish-notice-title {
		color:
			var(--text);

		font-weight:
			850;
	}

	.publish-notice-text {
		margin-top:
			5px;

		color:
			var(--text-soft);

		line-height:
			1.6;

		white-space:
			pre-wrap;

		word-break:
			break-word;
	}


	/* =========================================================
	   23. Responsive - Tablet
	   ========================================================= */

	@media (max-width: 900px) {
		.dashboard-grid {
			grid-template-columns:
				repeat(
					2,
					minmax(0, 1fr)
				);
		}

		.quick-links {
			grid-template-columns:
				1fr;
		}
	}


	/* =========================================================
	   24. Responsive - Mobile
	   ========================================================= */

	@media (max-width: 640px) {
		.page-heading {
			margin-bottom:
				24px;

			padding-left:
				12px;
		}

		.page-heading-row {
			align-items:
				flex-start;

			flex-direction:
				column;

			gap:
				14px;
		}

		.page-heading h1 {
			font-size:
				28px;
		}

		.page-heading p {
			font-size:
				12px;
		}

		.refresh-button {
			width:
				100%;
		}

		.dashboard-grid {
			grid-template-columns:
				1fr 1fr;

			gap:
				10px;

			margin-bottom:
				36px;
		}

		.dashboard-card {
			min-height:
				140px;

			padding:
				16px;
		}

		.dashboard-card-value {
			font-size:
				27px;
		}

		.dashboard-card-note {
			font-size:
				10px;
		}

		.section {
			margin-top:
				36px;
		}

		.section-heading {
			align-items:
				flex-start;
		}

		.section-heading h2 {
			font-size:
				17px;
		}

		.request-main {
			padding:
				17px;
		}

		.request-top {
			flex-direction:
				column;

			gap:
				10px;
		}

		.status-badge {
			align-self:
				flex-start;
		}

		.request-meta {
			display:
				grid;

			grid-template-columns:
				1fr 1fr;

			gap:
				10px;

			margin-top:
				16px;
		}

		.request-footer {
			align-items:
				stretch;

			flex-direction:
				column;

			padding:
				13px 17px;
		}

		.request-actions {
			width:
				100%;

			flex-direction:
				column;
		}

		.request-actions > * {
			width:
				100%;
		}

		.primary-button,
		.secondary-button,
		.publish-button {
			width:
				100%;
		}

		.activity-card {
			grid-template-columns:
				1fr;
		}

		.activity-action {
			width:
				100%;
		}

		.publish-notice {
			right:
				10px;

			bottom:
				10px;

			width:
				calc(100vw - 20px);
		}
	}


	/* =========================================================
	   25. Responsive - Very Small
	   ========================================================= */

	@media (max-width: 420px) {
		.dashboard-grid {
			gap:
				8px;
		}

		.dashboard-card {
			min-height:
				128px;

			padding:
				14px;
		}

		.dashboard-card-label {
			font-size:
				10px;
		}

		.dashboard-card-value {
			margin-top:
				10px;

			font-size:
				24px;
		}

		.dashboard-card-note {
			margin-top:
				9px;

			font-size:
				9px;
		}

		.request-meta {
			grid-template-columns:
				1fr;
		}
	}


	/* =========================================================
	   26. Reduced Motion
	   ========================================================= */

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior:
				auto !important;

			transition-duration:
				0.01ms !important;

			animation-duration:
				0.01ms !important;

			animation-iteration-count:
				1 !important;
		}
	}
	</style>
</head>

<body>
	<AdminLayout active="dashboard">

				<section class="page-heading">
					<div class="page-heading-row">

						<div>
							<h1>管理ダッシュボード</h1>

							<p>
								NUGBASE Wikiの編集・レビュー・公開状況を管理します。
							</p>
						</div>

						<button
							id="refresh-button"
