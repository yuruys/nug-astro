						</div>
					</div>

				</section>


				<div
					id="loading-state"
					class="state-card"
				>
					<div class="state-title">
						管理情報を読み込んでいます
					</div>

					<div class="state-text">
						しばらくお待ちください。
					</div>
				</div>


				<div
					id="error-state"
					class="state-card error-card"
					hidden
				>
					<div class="state-title">
						読み込みに失敗しました
					</div>

					<div
						class="state-text"
						id="error-message"
					>
						管理情報を取得できませんでした。
					</div>
				</div>


				<div id="dashboard-content" hidden>

					<section class="section">

						<div class="section-heading">
							<h2>レビュー申請</h2>

							<span id="pending-label">
								0件
							</span>
						</div>

						<div
							id="pending-empty"
							class="state-card"
							hidden
						>
							<div class="state-title">
