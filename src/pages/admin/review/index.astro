						0,
						0.055
					);
			}


			.review-result > div {
				display: flex;

				flex-direction:
					column;

				gap: 5px;
			}


			.review-result span {
				color:
					var(--nug-muted);

				font-size:
					0.7rem;

				font-weight:
					700;
			}


			.review-result strong {
				color:
					var(--nug-text);

				font-size:
					0.9rem;
			}


			/* =========================================================
			   12. Review Actions
			========================================================= */

			.review-actions {
				margin-top:
					8px;

				margin-bottom:
					32px;
			}


			.review-warning {
				position: relative;

				margin-bottom:
					20px;

				padding:
					18px
					20px;

				border:
					1px solid
					rgba(
						232,
						204,
						118,
						0.42
					);

				border-left:
					4px solid
					var(--nug-gold);

				border-radius:
					3px;

				background:
					linear-gradient(
						135deg,
						rgba(
							232,
							204,
							118,
							0.095
						),
						rgba(
							232,
							204,
							118,
							0.025
						)
					);

				box-shadow:
					0 4px 0
					rgba(
						100,
						82,
						35,
						0.3
					);
			}


			.review-warning strong {
				color:
					var(--nug-gold);

				font-size:
					0.9rem;
			}


			.review-warning p {
				margin:
					8px
					0
					0;

				color:
					var(--nug-muted);

				font-size:
					0.85rem;

				line-height:
					1.75;
			}


			.action-buttons {
				display: flex;

				justify-content:
					flex-end;

				gap:
					16px;
			}


			/* =========================================================
			   13. Buttons
			========================================================= */

			.button {
				position: relative;

				display: inline-flex;

				align-items: center;

				justify-content: center;

				min-height:
					44px;

				padding:
					10px
					18px;

				border:
					1px solid
					transparent;

				border-radius:
					3px;

				cursor:
					pointer;

				font-weight:
					850;

				text-decoration:
					none;

				transition:
					transform 0.12s ease,
					filter 0.12s ease,
					opacity 0.12s ease,
					background-color 0.12s ease;
			}


			.button:hover:not(:disabled) {
				transform:
					translateY(-2px);

				filter:
					brightness(1.08);
			}


			.button:active:not(:disabled) {
				transform:
					translateY(3px);
			}


			.button:focus-visible {
				outline:
					2px solid
					var(--nug-warm);

				outline-offset:
					3px;
			}


			.button:disabled {
				opacity:
					0.5;

				cursor:
					not-allowed;

				filter:
					saturate(0.5);
			}


			.button-primary {
				border-color:
					#6fca69;

				background:
					linear-gradient(
						180deg,
						#83dc7b 0%,
						#5ab85a 100%
					);

				color:
					#0c170d;

				box-shadow:
					var(--nug-shadow-green);
			}


			.button-primary:hover:not(:disabled) {
				background:
					linear-gradient(
						180deg,
						#97e58e 0%,
						#68c665 100%
					);
			}


			.button-danger {
				border-color:
					#bd6562;

				background:
					linear-gradient(
						180deg,
						#e28782 0%,
						#c9615e 100%
					);

				color:
					#210b0a;

				box-shadow:
					var(--nug-shadow-danger);
			}


			.button-danger:hover:not(:disabled) {
				background:
					linear-gradient(
						180deg,
						#ed9690 0%,
						#d66c68 100%
					);
			}


			.button-secondary {
				border-color:
					var(--nug-border);

				background:
					linear-gradient(
						180deg,
						#30363b 0%,
						#252a2e 100%
					);

				color:
					var(--nug-text);

				box-shadow:
					0 3px 0
					#15191c,
					0 7px 14px
					rgba(
						0,
						0,
						0,
						0.18
					);
			}


			.button-secondary:hover:not(:disabled) {
				border-color:
					var(--nug-border-strong);

				background:
					linear-gradient(
						180deg,
						#3a4146 0%,
						#2b3035 100%
					);
			}


			.button-large {
				min-width:
					150px;

				min-height:
					50px;
			}


			/* =========================================================
			   14. Action Message
			========================================================= */

			.action-message {
				margin:
					0
					0
					24px;

				padding:
					14px
					16px;

				border:
					1px solid
					var(--nug-border);

				border-left:
					4px solid
					var(--nug-info);

				border-radius:
					3px;

				background:
					var(--nug-surface);

				font-size:
					0.9rem;

				line-height:
					1.65;

				box-shadow:
					var(--nug-shadow-small);
			}


			.action-message.success {
				border-color:
					rgba(
						112,
						201,
						107,
						0.45
					);

				border-left-color:
					var(--nug-green);

				background:
					rgba(
						112,
						201,
						107,
						0.08
					);

				color:
					var(--nug-green-bright);
			}


			.action-message.error {
				border-color:
					rgba(
						226,
						123,
						120,
						0.45
					);

				border-left-color:
					var(--nug-danger);

				background:
					rgba(
						226,
						123,
						120,
						0.08
					);

				color:
					var(--nug-danger);
			}


			.action-message.info {
				border-color:
					rgba(
						123,
						185,
						220,
						0.45
					);

				border-left-color:
					var(--nug-info);

				background:
					rgba(
						123,
						185,
						220,
						0.08
					);

				color:
					var(--nug-info);
			}


			/* =========================================================
			   15. Bottom
			========================================================= */

			.bottom-actions {
				display: flex;

				justify-content:
					flex-start;

				padding-top:
					4px;
			}


			/* =========================================================
			   16. Responsive
			========================================================= */

			@media (max-width: 900px) {
				.admin-page {
					padding:
						0
						0
						64px;
				}


				.admin-shell {
					width:
						min(
							1200px,
							calc(100% - 40px)
						);

					padding-top:
						32px;
				}


				.admin-header {
					align-items:
						flex-start;
				}


				.metadata-grid {
					grid-template-columns:
						1fr;
				}


				.metadata-item:nth-child(odd) {
					border-right: 0;
				}


				.metadata-item:nth-last-child(-n + 2) {
					border-bottom:
						1px solid
						var(--nug-border);
				}


				.metadata-item:last-child {
					border-bottom: 0;
				}
			}


			@media (max-width: 760px) {
				.admin-layout {
					display:
						block;

					min-height:
						auto;
				}


				.admin-shell {
					width:
						calc(100% - 28px);

					margin:
						0 auto;

					padding-top:
						24px;
				}
			}


			@media (max-width: 700px) {
				.admin-page {
					padding:
						0
						0
						56px;
				}


				.admin-shell {
					width:
						calc(100% - 28px);

					padding-top:
						24px;
				}


				.admin-header {
					flex-direction:
						column;

					gap:
						20px;

					margin-bottom:
						24px;

					padding-bottom:
						20px;
				}


				.header-actions {
					display:
						none;
				}


				h1 {
					font-size:
						2rem;
				}


				.description {
					font-size:
						0.9rem;

					line-height:
						1.7;
				}


				.status-banner {
					align-items:
						flex-start;

					flex-direction:
						column;

					gap:
						12px;

					padding:
						15px
						16px;
				}


				.status-banner > div {
					align-items:
						flex-start;

					flex-direction:
						column;

					gap:
						8px;
				}


				.panel-heading {
					align-items:
						flex-start;

					flex-direction:
						column;

					gap:
						12px;

					padding:
						18px;
				}


				.metadata-item {
					padding:
						16px
						18px;
				}


				.review-result {
					grid-template-columns:
						1fr;

					gap:
						16px;

					padding:
						18px;
				}


				.code-view {
					max-height:
						520px;

					padding:
						16px;

					font-size:
						0.76rem;

					line-height:
						1.65;
				}


				#message-panel .edit-message,
				#review-comment-panel .edit-message {
					margin:
						16px
						18px;
				}


				.review-warning {
					padding:
						16px;
				}


				.action-buttons {
					flex-direction:
						column;

					gap:
						12px;
				}


				.action-buttons .button {
					width:
						100%;
				}


				.bottom-actions .button {
					width:
						100%;
				}
			}


			@media (max-width: 420px) {
				.admin-shell {
					width:
						calc(100% - 20px);

					padding-top:
						20px;
				}


				h1 {
					font-size:
						1.75rem;
				}


				.status-banner {
					margin-bottom:
						16px;
				}


				.panel {
					margin-bottom:
						18px;
				}


				.panel-heading {
					padding:
						16px;
				}


				.code-view {
					font-size:
						0.7rem;
				}


				.button {
					min-height:
						46px;

					padding:
						10px
						14px;
				}


				.button-large {
					min-height:
						52px;
				}
			}


			/* =========================================================
			   17. Reduced Motion
			========================================================= */

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					scroll-behavior:
						auto !important;

					transition:
						none !important;

					animation:
						none !important;
				}
			}
		</style>
	</body>
</html>