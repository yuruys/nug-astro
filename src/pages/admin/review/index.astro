---
import AdminLayout from '../../../components/admin/AdminLayout.astro';

const requestedRequestId = Astro.url.searchParams.get('id')?.trim() || null;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<title>Wikiレビュー | NUGBASE</title>
		<meta
			name="description"
			content="NUGBASE Wikiの編集レビュー画面"
		/>
	</head>

	<body>
		<AdminLayout active="review">
			<div class="admin-page" data-request-id={requestedRequestId ?? ''}>
				<section id="list-state" class="list-page" hidden={Boolean(requestedRequestId)}>
					<div class="page-heading">
						<div>
							<p class="eyebrow">WIKI REVIEW</p>
							<h1>Wikiレビュー</h1>
							<p class="description">レビュー待ちの編集リクエストを確認します。</p>
						</div>
					</div>

					<section class="panel list-panel" aria-labelledby="list-title">
						<div class="panel-heading">
							<div>
								<p class="panel-eyebrow">PENDING REQUESTS</p>
								<h2 id="list-title">レビュー待ち一覧</h2>
							</div>
							<span class="count" id="request-count">— 件</span>
						</div>

						<div class="list-state" id="list-loading-state" aria-live="polite">
							<span class="spinner" aria-hidden="true"></span>
							<p>レビュー一覧を読み込んでいます…</p>
						</div>

						<div class="list-state" id="list-empty-state" hidden>
							<span class="empty-icon" aria-hidden="true">✓</span>
							<h3>レビュー待ちの申請はありません</h3>
						</div>

						<div class="list-state state-error" id="list-error-state" hidden role="alert">
							<span class="state-icon" aria-hidden="true">!</span>
							<h3>一覧を読み込めませんでした</h3>
							<p id="list-error-message"></p>
							<button class="button button-secondary" id="list-retry-button" type="button">再読み込み</button>
						</div>

						<div class="table-wrap" id="request-table-wrap" hidden>
							<table>
								<thead>
									<tr>
										<th>ID</th>
										<th>対象ページ</th>
										<th>申請者</th>
										<th>作成日時</th>
										<th>ステータス</th>
										<th><span class="visually-hidden">操作</span></th>
									</tr>
								</thead>
								<tbody id="request-rows"></tbody>
							</table>
						</div>

						<div class="request-cards" id="request-cards" hidden></div>
					</section>
				</section>

					<!-- ========================================
					     Loading
					======================================== -->

					<section
						id="loading-state"
						class="state-card"
						hidden={!requestedRequestId}
						aria-live="polite"
					>
						<p id="detail-before-state">レビュー詳細を準備しています…</p>
						<div id="detail-loading-state" hidden>
							<div class="spinner"></div>
							<p>レビュー内容を読み込んでいます…</p>
						</div>
					</section>


					<!-- ========================================
					     Error
					======================================== -->

					<section
						id="error-state"
						class="state-card state-error"
						hidden
						aria-live="assertive"
					>
						<div class="state-icon">
							!
						</div>

						<h2>
							読み込みに失敗しました
						</h2>

						<p id="error-message">
							レビュー内容を読み込めませんでした。
						</p>

						<div class="state-actions">

							<a
								href="/admin/review/"
								class="button button-secondary"
							>
								管理画面へ戻る
							</a>

						</div>
					</section>


					<!-- ========================================
					     Review
					======================================== -->

					<section
						id="review-state"
						hidden
					>

						<!-- ====================================
						     Status
						==================================== -->

						<div
							id="status-banner"
							class="status-banner"
						>


							<div>
								<span class="status-label">
									現在の状態
								</span>

								<strong id="status-text">
									-
								</strong>
							</div>

							<span id="revision-text">
								-
							</span>

						</div>


						<!-- ====================================
						     Page information
						==================================== -->

						<section class="panel">

							<div class="panel-heading">
								<div>
									<p class="panel-eyebrow">
										WIKI PAGE
									</p>

									<h2 id="page-title">
										-
									</h2>
								</div>
							</div>

							<div class="metadata-grid">

								<div class="metadata-item">
									<span>
										ページパス
									</span>

									<code id="page-path">
										-
									</code>
								</div>


								<div class="metadata-item">
									<span>
										ソース
									</span>

									<code id="source-path">
										-
									</code>
								</div>


								<div class="metadata-item">
									<span>
										編集者
									</span>

									<strong id="editor-name">
										-
									</strong>
								</div>


								<div class="metadata-item">
									<span>
										Revision
									</span>

									<strong id="revision-number">
										-
									</strong>
								</div>


								<div class="metadata-item">
									<span>
										申請日時
									</span>

									<strong id="created-at">
										-
									</strong>
								</div>


								<div class="metadata-item">
									<span>
										ベースRevision
									</span>

									<strong id="base-revision-number">
										-
									</strong>
								</div>

							</div>

						</section>

						<!-- ====================================
						     Message
						==================================== -->

						<section
							id="message-panel"
							class="panel"
							hidden
						>

							<div class="panel-heading">
								<div>
									<p class="panel-eyebrow">
										EDIT MESSAGE
									</p>

									<h2>
										編集メッセージ
									</h2>
								</div>
							</div>

							<p
								id="edit-message"
								class="edit-message"
							></p>

						</section>


						<!-- ====================================
						     Current published content
						==================================== -->

						<section class="panel">

							<div class="panel-heading">

								<div>
									<p class="panel-eyebrow">
										PUBLISHED REVISION
									</p>

									<h2>
										現在の公開内容
									</h2>
								</div>

								<span
									id="published-revision"
									class="revision-badge"
								>
									-
								</span>

							</div>

							<pre
								id="published-content"
								class="code-view"
							></pre>

						</section>


						<!-- ====================================
						     Proposed content
						==================================== -->

						<section class="panel panel-proposed">

							<div class="panel-heading">

								<div>
									<p class="panel-eyebrow">
										PROPOSED REVISION
									</p>

									<h2>
										申請された変更内容
									</h2>
								</div>

								<span
									id="proposed-revision"
									class="revision-badge proposed"
								>
									-
								</span>

							</div>

							<div class="preview-tabs" role="tablist" aria-label="申請内容の表示方法">
								<button class="preview-tab is-active" id="proposed-source-tab" type="button" role="tab" aria-selected="true">本文</button>
								<button class="preview-tab" id="proposed-preview-tab" type="button" role="tab" aria-selected="false">プレビュー</button>
							</div>
							<pre
								id="proposed-content"
								class="code-view"
								role="tabpanel"
								aria-labelledby="proposed-source-tab"
							></pre>
							<div id="proposed-preview-content" class="markdown-preview" role="tabpanel" aria-labelledby="proposed-preview-tab" tabindex="0" hidden></div>

						</section>


						<!-- ====================================
						     Review comment
						==================================== -->

						<section
							id="review-comment-panel"
							class="panel"
							hidden
						>

							<div class="panel-heading">
								<div>
									<p class="panel-eyebrow">
										REVIEW
									</p>

									<h2>
										レビュー結果
									</h2>
								</div>
							</div>

							<div class="review-result">

								<div>
									<span>
										レビュアー
									</span>

									<strong id="reviewer-name">
										-
									</strong>
								</div>

								<div>
									<span>
										レビュー日時
									</span>

									<strong id="reviewed-at">
										-
									</strong>
								</div>

							</div>

							<p
								id="review-comment"
								class="edit-message"
							></p>

						</section>


						<!-- ====================================
						     Action message
						==================================== -->

						<div
							id="action-message"
							class="action-message"
							hidden
							role="status"
							aria-live="polite"
						></div>


						<!-- ====================================
						     Review actions
						==================================== -->

						<section
							id="review-actions"
							class="review-actions"
						>

							<div class="review-warning">

								<strong>
									レビュー前に確認してください
								</strong>

								<p>
									申請内容と現在の公開内容を確認してください。
									承認すると、この申請は公開可能な状態になります。
									却下した場合、この申請は却下済みになります。
								</p>

							</div>


							<div class="action-buttons">

								<button
									type="button"
									id="reject-button"
									class="button button-danger button-large"
								>
									<span class="button-label">
										却下
									</span>

									<span
										class="button-loading"
										hidden
									>
										処理中…
									</span>
								</button>


								<button
									type="button"
									id="approve-button"
									class="button button-primary button-large"
								>
									<span class="button-label">
										承認
									</span>

									<span
										class="button-loading"
										hidden
									>
										処理中…
									</span>
								</button>

							</div>

						</section>


						<!-- ====================================
						     Back
						==================================== -->

						<section id="delete-actions" class="delete-actions" hidden aria-label="編集リクエストの削除">
							<div>
								<strong>編集リクエストを削除</strong>
								<p>この操作は取り消せません。対象内容を確認してから実行してください。</p>
							</div>
							<button id="delete-button" class="button button-danger" type="button">
								<span class="button-label">削除</span>
								<span class="button-loading" hidden>削除中…</span>
							</button>
						</section>

						<div class="bottom-actions">

							<a
								href="/admin/review/"
								class="button button-secondary"
							>
								レビュー一覧へ戻る
							</a>

						</div>

					</section>

			</div>


		<!-- ========================================
		     JavaScript
		======================================== -->

		<script>
			import { renderMarkdownPreview } from '../../../lib/markdown-preview';

			/* ========================================
			   Types
			======================================== */

			type EditRequestStatus =
				| 'draft'
				| 'pending'
				| 'approved'
				| 'rejected'
				| 'publishing'
				| 'published';


			interface Revision {
				id: string;
				page_id: string;
				revision_number: number;
				content: string;
				editor_id: string;
				created_at: string;
				editor_display_name?: string | null;
				editor_role?: string | null;
			}


			interface EditRequest {
				id: string;
				status: EditRequestStatus;

				message?: string | null;

				base_revision_id?: string | null;
				revision_id: string;

				user_id: string;
				reviewer_id?: string | null;

				review_comment?: string | null;

				created_at: string;
				reviewed_at?: string | null;

				page_id: string;
				page_path: string;
				page_title: string;
				source_path: string;

				published_revision_id?:
					| string
					| null;

				user_display_name?:
					| string
					| null;

				user_role?:
					| string
					| null;

				reviewer_display_name?:
					| string
					| null;

				reviewer_role?:
					| string
					| null;
			}


			interface DetailResponse {
				ok: boolean;
				error?: string;

				editRequest?: EditRequest;

				revision?: Revision | null;

				baseRevision?: Revision | null;

				publishedRevision?: Revision | null;
			}


			interface EditRequestSummary {
				id: string;
				status: EditRequestStatus;
				created_at: string;
				page_path: string;
				page_title: string;
				user_id: string;
				user_display_name?: string | null;
			}


			interface ListResponse {
				ok: boolean;
				error?: string;
				editRequests?: EditRequestSummary[];
			}


			interface ReviewResponse {
				ok: boolean;

				error?: string;

				editRequest?: EditRequest;
			}


			interface DeleteResponse {
				ok: boolean;
				deleted?: boolean;
				error?: string;
			}


			/* ========================================
			   URL
			======================================== */

			const pageRoot = document.querySelector<HTMLElement>('.admin-page')!;
			const editRequestId = pageRoot.dataset.requestId?.trim() || null;


			/* ========================================
			   DOM
			======================================== */

			const loadingState =
				document.querySelector<HTMLElement>(
					'#loading-state'
				)!;

			const errorState =
				document.querySelector<HTMLElement>(
					'#error-state'
				)!;

			const reviewState =
				document.querySelector<HTMLElement>(
					'#review-state'
				)!;

			const errorMessage =
				document.querySelector<HTMLElement>(
					'#error-message'
				)!;

			const statusBanner =
				document.querySelector<HTMLElement>(
					'#status-banner'
				)!;

			const statusText =
				document.querySelector<HTMLElement>(
					'#status-text'
				)!;

			const revisionText =
				document.querySelector<HTMLElement>(
					'#revision-text'
				)!;

			const pageTitle =
				document.querySelector<HTMLElement>(
					'#page-title'
				)!;

			const pagePath =
				document.querySelector<HTMLElement>(
					'#page-path'
				)!;

			const sourcePath =
				document.querySelector<HTMLElement>(
					'#source-path'
				)!;

			const editorName =
				document.querySelector<HTMLElement>(
					'#editor-name'
				)!;

			const revisionNumber =
				document.querySelector<HTMLElement>(
					'#revision-number'
				)!;

			const createdAt =
				document.querySelector<HTMLElement>(
					'#created-at'
				)!;

			const baseRevisionNumber =
				document.querySelector<HTMLElement>(
					'#base-revision-number'
				)!;

			const messagePanel =
				document.querySelector<HTMLElement>(
					'#message-panel'
				)!;

			const editMessage =
				document.querySelector<HTMLElement>(
					'#edit-message'
				)!;

			const publishedRevision =
				document.querySelector<HTMLElement>(
					'#published-revision'
				)!;

			const publishedContent =
				document.querySelector<HTMLElement>(
					'#published-content'
				)!;

			const proposedRevision =
				document.querySelector<HTMLElement>(
					'#proposed-revision'
				)!;

			const proposedContent =
				document.querySelector<HTMLElement>(
					'#proposed-content'
				)!;

			const reviewCommentPanel =
				document.querySelector<HTMLElement>(
					'#review-comment-panel'
				)!;

			const reviewerName =
				document.querySelector<HTMLElement>(
					'#reviewer-name'
				)!;

			const reviewedAt =
				document.querySelector<HTMLElement>(
					'#reviewed-at'
				)!;

			const reviewComment =
				document.querySelector<HTMLElement>(
					'#review-comment'
				)!;

			const actionMessage =
				document.querySelector<HTMLElement>(
					'#action-message'
				)!;

			const reviewActions =
				document.querySelector<HTMLElement>(
					'#review-actions'
				)!;

			const approveButton =
				document.querySelector<HTMLButtonElement>(
					'#approve-button'
				)!;

			const rejectButton =
				document.querySelector<HTMLButtonElement>(
					'#reject-button'
				)!;

			const detailBeforeState = document.querySelector<HTMLElement>('#detail-before-state')!;
			const detailLoadingState = document.querySelector<HTMLElement>('#detail-loading-state')!;
			const listLoadingState = document.querySelector<HTMLElement>('#list-loading-state')!;
			const listEmptyState = document.querySelector<HTMLElement>('#list-empty-state')!;
			const listErrorState = document.querySelector<HTMLElement>('#list-error-state')!;
			const listErrorMessage = document.querySelector<HTMLElement>('#list-error-message')!;
			const requestTableWrap = document.querySelector<HTMLElement>('#request-table-wrap')!;
			const requestRows = document.querySelector<HTMLTableSectionElement>('#request-rows')!;
			const requestCards = document.querySelector<HTMLElement>('#request-cards')!;
			const requestCount = document.querySelector<HTMLElement>('#request-count')!;
			const proposedSourceTab = document.querySelector<HTMLButtonElement>('#proposed-source-tab')!;
			const proposedPreviewTab = document.querySelector<HTMLButtonElement>('#proposed-preview-tab')!;
			const proposedPreviewContent = document.querySelector<HTMLElement>('#proposed-preview-content')!;
			const listRetryButton = document.querySelector<HTMLButtonElement>('#list-retry-button')!;
			const deleteActions = document.querySelector<HTMLElement>('#delete-actions')!;
			const deleteButton = document.querySelector<HTMLButtonElement>('#delete-button')!;


			/* ========================================
			   State
			======================================== */

			let currentRequest:
				EditRequest | null = null;
			let proposedSource = '';
			let previewRenderId = 0;


			/* ========================================
			   Helpers
			======================================== */

			function showError(
				text: string
			): void {
				setDetailState('error');
				errorState.hidden = false;

				errorMessage.textContent =
					text;
			}


			function showReview(): void {
				setDetailState('success');
			}


			function setDetailState(
				state: 'before' | 'loading' | 'success' | 'error'
			): void {
				loadingState.hidden = !['before', 'loading'].includes(state);
				detailBeforeState.hidden = state !== 'before';
				detailLoadingState.hidden = state !== 'loading';
				errorState.hidden = state !== 'error';
				reviewState.hidden = state !== 'success';
			}


			function setListState(
				state: 'loading' | 'empty' | 'error' | 'list'
			): void {
				listLoadingState.hidden = state !== 'loading';
				listEmptyState.hidden = state !== 'empty';
				listErrorState.hidden = state !== 'error';
				requestTableWrap.hidden = state !== 'list';
				requestCards.hidden = state !== 'list';
			}


			function setActionMessage(
				text: string,
				type:
					| 'success'
					| 'error'
					| 'info'
			): void {
				actionMessage.textContent =
					text;

				actionMessage.className =
					`action-message ${type}`;

				actionMessage.hidden = false;
			}


			function clearActionMessage(): void {
				actionMessage.hidden = true;
				actionMessage.textContent = '';
				actionMessage.className =
					'action-message';
			}


			function setButtonLoading(
				button: HTMLButtonElement,
				loading: boolean
			): void {
				const label =
					button.querySelector<HTMLElement>(
						'.button-label'
					);

				const loadingLabel =
					button.querySelector<HTMLElement>(
						'.button-loading'
					);

				button.disabled =
					loading;

				if (label) {
					label.hidden =
						loading;
				}

				if (loadingLabel) {
					loadingLabel.hidden =
						!loading;
				}
			}


			function setReviewActionsDisabled(
				disabled: boolean
			): void {
				approveButton.disabled =
					disabled;

				rejectButton.disabled =
					disabled;
			}


			function formatDate(
				value: string | null | undefined
			): string {
				if (!value) {
					return '-';
				}

				const date =
					new Date(value);

				if (
					Number.isNaN(
						date.getTime()
					)
				) {
					return value;
				}

				return new Intl.DateTimeFormat(
					'ja-JP',
					{
						dateStyle: 'medium',
						timeStyle: 'short',
					}
				).format(date);
			}


			function statusLabel(
				status: EditRequestStatus
			): string {
				switch (status) {
					case 'draft':
						return '下書き';

					case 'pending':
						return 'レビュー待ち';

					case 'approved':
						return '承認済み';

					case 'rejected':
						return '却下';

					case 'publishing':
						return '公開処理中';

					case 'published':
						return '公開済み';

					default:
						return status;
				}
			}


			function createCell(text: string, className = ''): HTMLTableCellElement {
				const cell = document.createElement('td');
				cell.textContent = text;
				if (className) cell.className = className;
				return cell;
			}


			function requestDetailUrl(id: string): string {
				return `/admin/review/?id=${encodeURIComponent(id)}`;
			}


			function renderRequests(requests: EditRequestSummary[]): void {
				requestRows.replaceChildren();
				requestCards.replaceChildren();

				for (const request of requests) {
					const row = document.createElement('tr');
					const idLink = document.createElement('a');
					idLink.href = requestDetailUrl(request.id);
					idLink.textContent = request.id;
					idLink.className = 'request-link';
					row.append(createCell('', 'id-cell'));
					row.cells[0].append(idLink);

					const pageCell = createCell('', 'page-cell');
					const pageLink = document.createElement('a');
					pageLink.href = requestDetailUrl(request.id);
					pageLink.textContent = request.page_title || request.page_path;
					pageLink.className = 'request-link';
					const pagePathText = document.createElement('small');
					pagePathText.textContent = request.page_path;
					pageCell.append(pageLink, pagePathText);
					row.append(
						pageCell,
						createCell(request.user_display_name || request.user_id, 'applicant-cell'),
						createCell(formatDate(request.created_at), 'date-cell'),
					);

					const statusCell = createCell(statusLabel(request.status), 'status-cell');
					statusCell.dataset.status = request.status;
					row.append(statusCell);

					const actionCell = createCell('', 'action-cell');
					const actionLink = document.createElement('a');
					actionLink.href = requestDetailUrl(request.id);
					actionLink.className = 'button button-secondary';
					actionLink.textContent = '確認';
					actionCell.append(actionLink);
					row.append(actionCell);
					requestRows.append(row);

					const card = document.createElement('article');
					card.className = 'request-card';
					const cardHeading = document.createElement('div');
					cardHeading.className = 'request-card-heading';
					const cardTitle = document.createElement('a');
					cardTitle.href = requestDetailUrl(request.id);
					cardTitle.className = 'request-link';
					cardTitle.textContent = request.page_title || request.page_path;
					const cardId = document.createElement('span');
					cardId.textContent = `ID ${request.id}`;
					cardHeading.append(cardTitle, cardId);
					const metadata = document.createElement('dl');
					metadata.className = 'request-card-meta';
					for (const [label, value] of [
						['対象ページ', request.page_path],
						['申請者', request.user_display_name || request.user_id],
						['作成日時', formatDate(request.created_at)],
						['ステータス', statusLabel(request.status)],
					] as Array<[string, string]>) {
						const term = document.createElement('dt');
						term.textContent = label;
						const valueElement = document.createElement('dd');
						valueElement.textContent = value;
						metadata.append(term, valueElement);
					}
					card.append(cardHeading, metadata);
					requestCards.append(card);
				}
			}


			async function loadRequests(): Promise<void> {
				setListState('loading');
				try {
					const response = await fetch('/api/wiki/edit-requests?status=pending', {
						credentials: 'same-origin',
					});
					const data = await response.json() as ListResponse;
					if (!response.ok || !data.ok) {
						throw new Error(data.error || `通信に失敗しました（${response.status}）。`);
					}

					const requests = Array.isArray(data.editRequests) ? data.editRequests : [];
					requestCount.textContent = `${requests.length} 件`;
					if (!requests.length) {
						setListState('empty');
						return;
					}

					renderRequests(requests);
					setListState('list');
				} catch (error) {
					listErrorMessage.textContent = error instanceof Error
						? error.message
						: 'レビュー一覧を読み込めませんでした。';
					setListState('error');
				}
			}


			function applyStatusStyle(
				status: EditRequestStatus
			): void {
				statusBanner.dataset.status =
					status;
			}


			async function setProposedMode(mode: 'source' | 'preview'): Promise<void> {
				const showingPreview = mode === 'preview';
				proposedContent.hidden = showingPreview;
				proposedPreviewContent.hidden = !showingPreview;
				proposedSourceTab.classList.toggle('is-active', !showingPreview);
				proposedPreviewTab.classList.toggle('is-active', showingPreview);
				proposedSourceTab.setAttribute('aria-selected', String(!showingPreview));
				proposedPreviewTab.setAttribute('aria-selected', String(showingPreview));
				if (!showingPreview) return;

				const renderId = ++previewRenderId;
				proposedPreviewContent.textContent = 'プレビューを生成しています…';
				try {
					const safeHtml = await renderMarkdownPreview(proposedSource);
					if (renderId === previewRenderId && !proposedPreviewContent.hidden) {
						proposedPreviewContent.innerHTML = safeHtml;
					}
				} catch {
					if (renderId === previewRenderId) {
						proposedPreviewContent.textContent = 'プレビューを表示できませんでした。本文を確認してください。';
					}
				}
			}


			/* ========================================
			   Render
			======================================== */

			function renderReview(
				data: DetailResponse
			): void {

				if (
					!data.editRequest
				) {
					throw new Error(
						'編集リクエスト情報がありません。'
					);
				}


				const request =
					data.editRequest;

				currentRequest =
					request;


				/* Status */

				statusText.textContent =
					statusLabel(
						request.status
					);

				revisionText.textContent =
					`申請ID: ${request.id}`;

				applyStatusStyle(
					request.status
				);


				/* Page */

				pageTitle.textContent =
					request.page_title ||
					'Wikiページ';

				pagePath.textContent =
					request.page_path ||
					'-';

				sourcePath.textContent =
					request.source_path ||
					'-';


				/* Editor */

				editorName.textContent =
					request.user_display_name ||
					request.user_id ||
					'-';


				/* Revision */

				revisionNumber.textContent =
					data.revision
						? String(
								data.revision
									.revision_number
							)
						: '-';


				createdAt.textContent =
					formatDate(
						request.created_at
					);


				baseRevisionNumber.textContent =
					data.baseRevision
						? String(
								data.baseRevision
									.revision_number
							)
						: '-';


				/* Message */

				if (
					request.message &&
					request.message.trim()
				) {
					messagePanel.hidden =
						false;

					editMessage.textContent =
						request.message;
				} else {
					messagePanel.hidden =
						true;

					editMessage.textContent =
						'';
				}


				/* Published */

				if (
					data.publishedRevision
				) {
					publishedRevision.textContent =
						`Revision ${data.publishedRevision.revision_number}`;

					publishedContent.textContent =
						data.publishedRevision.content;
				} else {
					publishedRevision.textContent =
						'未公開';

					publishedContent.textContent =
						'公開Revisionがありません。';
				}


				/* Proposed */

				if (
					data.revision
				) {
					proposedSource = data.revision.content;
					proposedRevision.textContent =
						`Revision ${data.revision.revision_number}`;

					proposedContent.textContent =
						data.revision.content;
					void setProposedMode('source');
				} else {
					proposedSource = '';
					proposedRevision.textContent =
						'-';

					proposedContent.textContent =
						'申請Revisionがありません。';
				}


				/* Review result */

				if (
					request.reviewer_id ||
					request.review_comment ||
					request.reviewed_at
				) {
					reviewCommentPanel.hidden =
						false;

					reviewerName.textContent =
						request.reviewer_display_name ||
						request.reviewer_id ||
						'-';

					reviewedAt.textContent =
						formatDate(
							request.reviewed_at
						);

					reviewComment.textContent =
						request.review_comment ||
						'レビューコメントはありません。';

				} else {
					reviewCommentPanel.hidden =
						true;
				}


				/* Actions */

				if (
					request.status ===
					'pending'
				) {
					reviewActions.hidden =
						false;

					setReviewActionsDisabled(
						false
					);

				} else {
					reviewActions.hidden =
						true;

					setReviewActionsDisabled(
						true
					);
				}

				deleteActions.hidden = ![
					'draft',
					'pending',
					'approved',
					'rejected',
				].includes(request.status);
			}


			/* ========================================
			   Load detail
			======================================== */

			async function loadReview():
				Promise<void> {
				if (!editRequestId) return;
				setDetailState('loading');


				try {

					const response =
						await fetch(
							`/api/wiki/edit-requests/${encodeURIComponent(
								editRequestId
							)}`,
							{
								credentials:
									'same-origin',
							}
						);


					const data =
						await response.json() as
							DetailResponse;


					if (
						!response.ok ||
						!data.ok
					) {
						throw new Error(
							data.error ||
								'レビュー内容を取得できませんでした。'
						);
					}


					renderReview(data);

					showReview();

				} catch (error) {

					console.error(
						'Review load error:',
						error
					);


					showError(
						error instanceof Error
							? error.message
							: 'レビュー内容を読み込めませんでした。'
					);
				}
			}


			/* ========================================
			   Review
			======================================== */

			async function reviewRequest(
				status:
					| 'approved'
					| 'rejected'
			): Promise<void> {

				if (!currentRequest) {
					return;
				}


				if (
					currentRequest.status !==
					'pending'
				) {
					setActionMessage(
						'この申請は現在レビューできる状態ではありません。',
						'error'
					);

					return;
				}


				const actionLabel =
					status === 'approved'
						? '承認'
						: '却下';


				const confirmed =
					window.confirm(
						`このWiki編集申請を${actionLabel}します。\n\n${currentRequest.page_title}\n${currentRequest.page_path}\n\n${actionLabel}しますか？`
					);


				if (!confirmed) {
					return;
				}


				clearActionMessage();


				const button =
					status === 'approved'
						? approveButton
						: rejectButton;

				const otherButton =
					status === 'approved'
						? rejectButton
						: approveButton;


				setButtonLoading(
					button,
					true
				);

				otherButton.disabled =
					true;


				try {

					const comment =
						status === 'rejected'
							? window.prompt(
									'却下理由を入力してください（任意）'
								) ?? ''
							: window.prompt(
									'レビューコメントを入力してください（任意）'
								) ?? '';


					const response =
						await fetch(
							`/api/wiki/edit-requests/${encodeURIComponent(
								currentRequest.id
							)}/review`,
							{
								method: 'POST',

								headers: {
									'Content-Type':
										'application/json',
								},

								credentials:
									'same-origin',

								body:
									JSON.stringify({
										status,
										comment:
											comment.trim() ||
											null,
									}),
							}
						);


					const data =
						await response.json() as
							ReviewResponse;


					if (
						!response.ok ||
						!data.ok
					) {
						throw new Error(
							data.error ||
								`${actionLabel}に失敗しました。`
						);
					}


					setActionMessage(
						status === 'approved'
							? 'レビューを承認しました。公開処理はまだ実行されていません。'
							: 'レビューを却下しました。',
						'success'
					);


					/*
					 * 画面上の状態を更新
					 */

					currentRequest = {
						...currentRequest,
						status,
						review_comment:
							comment.trim() ||
							null,
					};


					statusText.textContent =
						statusLabel(status);


					applyStatusStyle(
						status
					);


					reviewActions.hidden =
						true;


					if (
						data.editRequest
					) {
						currentRequest =
							data.editRequest;

						if (
							data.editRequest.reviewer_display_name
						) {
							reviewerName.textContent =
								data.editRequest
									.reviewer_display_name;
						}

						reviewedAt.textContent =
							formatDate(
								data.editRequest
									.reviewed_at
							);

						reviewComment.textContent =
							data.editRequest
								.review_comment ||
							'レビューコメントはありません。';

						reviewCommentPanel.hidden =
							false;
					}


				} catch (error) {

					console.error(
						'Review request error:',
						error
					);


					setActionMessage(
						error instanceof Error
							? error.message
							: `${actionLabel}に失敗しました。`,
						'error'
					);


					otherButton.disabled =
						false;

				} finally {

					setButtonLoading(
						button,
						false
					);
				}
			}


			async function deleteRequest(): Promise<void> {
				if (!currentRequest || deleteButton.disabled) return;
				const confirmed = window.confirm(
					`このWiki編集リクエストを削除します。この操作は取り消せません。\n\nID: ${currentRequest.id}\n${currentRequest.page_title}\n${currentRequest.page_path}\n\n削除しますか？`,
				);
				if (!confirmed) return;

				clearActionMessage();
				setButtonLoading(deleteButton, true);
				try {
					const response = await fetch(
						`/api/wiki/edit-requests/${encodeURIComponent(currentRequest.id)}`,
						{ method: 'DELETE', credentials: 'same-origin' },
					);
					const data = await response.json() as DeleteResponse;
					if (!response.ok || !data.ok) {
						throw new Error(data.error || `削除に失敗しました（${response.status}）。`);
					}
					window.location.assign('/admin/review/');
				} catch (error) {
					setActionMessage(
						error instanceof Error ? error.message : '削除に失敗しました。',
						'error',
					);
					setButtonLoading(deleteButton, false);
				}
			}


			/* ========================================
			   Events
			======================================== */

			approveButton.addEventListener(
				'click',
				() => {
					void reviewRequest(
						'approved'
					);
				}
			);

			proposedSourceTab.addEventListener('click', () => {
				void setProposedMode('source');
			});

			proposedPreviewTab.addEventListener('click', () => {
				void setProposedMode('preview');
			});

			listRetryButton.addEventListener('click', () => {
				void loadRequests();
			});


			rejectButton.addEventListener(
				'click',
				() => {
					void reviewRequest(
						'rejected'
					);
				}
			);

			deleteButton.addEventListener('click', () => {
				void deleteRequest();
			});


			/* ========================================
			   Initial load
			======================================== */

			if (editRequestId) {
				setDetailState('before');
				void loadReview();
			} else {
				void loadRequests();
			}
		</script>


