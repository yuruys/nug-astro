		color: var(--review-green-light);

		font-size: 0.72rem;
		font-weight: 900;

		letter-spacing: 0.14em;

		text-transform: uppercase;
	}


	h1 {
		margin: 0;

		color: var(--review-text);

		font-size: clamp(2rem, 5vw, 2.5rem);
		font-weight: 850;

		letter-spacing: -0.025em;

		line-height: 1.15;

		text-shadow:
			0 2px 0 rgba(0, 0, 0, 0.24);
	}


	.description {
		max-width: 700px;

		margin: 12px 0 0;

		color: var(--review-text-secondary);

		line-height: 1.75;
	}


	.header-actions {
		flex-shrink: 0;
	}


	/* =========================================================
	   05. State
	   ========================================================= */

	.state-card {
		position: relative;

		display: flex;

		flex-direction: column;

		align-items: center;
		justify-content: center;

		min-height: 300px;

		padding: 40px;

		border:
			1px solid
			var(--review-border);

		border-radius: 6px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.025),
				transparent 45%
			),
			var(--review-surface);

		box-shadow: var(--review-shadow);

		text-align: center;

		overflow: hidden;
	}


	.state-card::before {
		content: "";

		position: absolute;

		inset: 0 0 auto 0;

		height: 3px;

		background: var(--review-green);
	}


	.state-card p {
		color: var(--review-text-muted);
	}


	.state-card h2 {
		margin: 0 0 8px;

		color: var(--review-text);

		font-size: 1.25rem;
	}


	.state-error {
		border-color:
			rgba(216, 115, 112, 0.55);
	}


	.state-error::before {
		background: var(--review-danger);
	}


	.state-icon {
		display: grid;

		width: 48px;
		height: 48px;

		place-items: center;

		margin-bottom: 16px;

		border:
			1px solid
			rgba(216, 115, 112, 0.45);

		border-radius: 4px;

		background:
			rgba(216, 115, 112, 0.10);

		color: var(--review-danger);

		font-weight: 900;

		box-shadow:
			0 3px 0
			rgba(121, 63, 61, 0.55);
	}


	.spinner {
		width: 32px;
		height: 32px;

		margin-bottom: 16px;

		border:
			3px solid
			var(--review-border);

		border-top-color:
			var(--review-green);

		border-radius: 3px;

		animation:
			spin 0.8s
			linear infinite;
	}


	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}


	/* =========================================================
	   06. Status Banner
	   ========================================================= */

	.status-banner {
		position: relative;

		display: flex;

		align-items: center;
		justify-content: space-between;

		gap: 20px;

		margin-bottom: 24px;

		padding: 16px 20px;

		border:
			1px solid
			var(--review-border);

		border-left:
			4px solid
			var(--review-info);

		border-radius: 6px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.025),
				transparent 55%
			),
			var(--review-surface);

		box-shadow: var(--review-shadow-small);
	}


	.status-banner > div {
		display: flex;

		align-items: center;

		gap: 14px;
	}


	.status-label {
		color: var(--review-text-muted);

		font-size: 0.72rem;
		font-weight: 800;

		letter-spacing: 0.04em;
	}


	.status-banner strong {
		display: inline-flex;

		align-items: center;

		min-height: 30px;

		padding: 5px 10px;

		border:
			1px solid
			var(--review-info-dark);

		border-radius: 4px;

		background:
			rgba(121, 181, 213, 0.10);

		color: var(--review-info);

		font-size: 0.82rem;
		font-weight: 800;
	}


	.status-banner[data-status="approved"] {
		border-left-color:
			var(--review-green);
	}


	.status-banner[data-status="approved"] strong {
		border-color:
			var(--review-green-dark);

		background:
			rgba(114, 173, 85, 0.11);

		color:
			var(--review-green-light);
	}


	.status-banner[data-status="rejected"] {
		border-left-color:
			var(--review-danger);
	}


	.status-banner[data-status="rejected"] strong {
		border-color:
			var(--review-danger-dark);

		background:
			rgba(216, 115, 112, 0.10);

		color:
			var(--review-danger);
	}


	.status-banner[data-status="published"] {
		border-left-color:
			var(--review-green);
	}


	.status-banner[data-status="published"] strong {
		border-color:
			var(--review-green-dark);

		background:
			rgba(114, 173, 85, 0.11);

		color:
			var(--review-green-light);
	}


	.status-banner > span:last-child {
		overflow-wrap: anywhere;

		color: var(--review-text-muted);

		font-family:
			"Consolas",
			"SFMono-Regular",
			monospace;

		font-size: 0.7rem;
	}


	/* =========================================================
	   07. Panels
	   ========================================================= */

	.panel {
		position: relative;

		margin-bottom: 24px;

		border:
			1px solid
			var(--review-border);

		border-radius: 6px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.022),
				transparent 38%
			),
			var(--review-surface);

		box-shadow: var(--review-shadow);

		overflow: hidden;
	}


	.panel::after {
		content: "";

		position: absolute;

		top: 0;
		left: 0;

		width: 32px;
		height: 3px;

		background:
			var(--review-green);

		opacity: 0.9;
	}


	.panel-proposed {
		border-color:
			rgba(114, 173, 85, 0.52);

		box-shadow:
			0 5px 0
			rgba(54, 92, 44, 0.75),
			0 12px 28px
			rgba(0, 0, 0, 0.22);
	}


	.panel-proposed::after {
		width: 72px;

		background:
			var(--review-green-light);
	}


	.panel-heading {
		display: flex;

		align-items: center;
		justify-content: space-between;

		gap: 20px;

		padding: 20px 22px;

		border-bottom:
			1px solid
			var(--review-border);

		background:
			rgba(255, 255, 255, 0.018);
	}


	.panel-eyebrow {
		margin: 0 0 6px;

		color:
			var(--review-green);

		font-size: 0.68rem;
		font-weight: 900;

		letter-spacing: 0.14em;

		text-transform: uppercase;
	}


	.panel-heading h2 {
		margin: 0;

		color:
			var(--review-text);

		font-size: 1.15rem;
		font-weight: 850;
	}


	/* =========================================================
	   08. Metadata
	   ========================================================= */

	.metadata-grid {
		display: grid;

		grid-template-columns:
			repeat(
				2,
				minmax(0, 1fr)
			);
	}


	.metadata-item {
		position: relative;

		min-width: 0;

		padding: 18px 22px;

		border-bottom:
			1px solid
			var(--review-border);

		background:
			rgba(0, 0, 0, 0.055);
	}


	.metadata-item:nth-child(odd) {
		border-right:
			1px solid
			var(--review-border);
	}


	.metadata-item:nth-last-child(-n + 2) {
		border-bottom: 0;
	}


	.metadata-item > span {
		display: block;

		margin-bottom: 7px;

		color:
			var(--review-text-muted);

		font-size: 0.7rem;
		font-weight: 800;

		letter-spacing: 0.03em;
	}


	.metadata-item strong {
		color:
			var(--review-text);

		font-size: 0.9rem;
	}


	.metadata-item code {
		display: block;

		overflow-wrap: anywhere;

		color:
			var(--review-green-light);

		font-family:
			"Consolas",
			"SFMono-Regular",
			monospace;

		font-size: 0.8rem;

		line-height: 1.55;
	}


	/* =========================================================
	   09. Message
	   ========================================================= */

	.edit-message {
		margin: 0;

		padding: 18px 22px;

		color:
			var(--review-text-secondary);

		line-height: 1.8;

		white-space: pre-wrap;
	}


	#message-panel .edit-message,
	#review-comment-panel .edit-message {
		position: relative;

		margin:
			18px
			22px;

		padding:
			14px
			16px;

		border-left:
			3px solid
			var(--review-green);

		background:
			rgba(114, 173, 85, 0.055);
	}


	/* =========================================================
	   10. Code / Revision Viewer
	   ========================================================= */

	.code-view {
		max-height: 650px;

		margin: 0;

		padding: 20px;

		overflow: auto;

		border-top: 0;

		background:
			#171b1e;

		color:
			#dce8df;

		font-family:
			"Consolas",
			"SFMono-Regular",
			"Roboto Mono",
			monospace;

		font-size: 0.82rem;

		line-height: 1.7;

		white-space: pre-wrap;

		overflow-wrap: anywhere;

		tab-size: 4;
	}


	.code-view::-webkit-scrollbar {
		width: 10px;
		height: 10px;
	}


	.code-view::-webkit-scrollbar-track {
		background:
			#111416;
	}


	.code-view::-webkit-scrollbar-thumb {
		background:
			#4a5155;

		border:
			2px solid
			#111416;
	}


	.code-view::-webkit-scrollbar-thumb:hover {
		background:
			var(--review-green);
	}


	.revision-badge {
		display: inline-flex;

		align-items: center;

		min-height: 30px;

		padding: 5px 10px;

		border:
			1px solid
			var(--review-border);

		border-radius: 4px;

		background:
			rgba(255, 255, 255, 0.022);

		color:
			var(--review-text-muted);

		font-size: 0.75rem;
		font-weight: 800;
	}


	.revision-badge.proposed {
		border-color:
			var(--review-green-dark);

		background:
			rgba(114, 173, 85, 0.10);

		color:
			var(--review-green-light);

		box-shadow:
			0 2px 0
			rgba(54, 92, 44, 0.55);
	}


	/* =========================================================
	   11. Review Result
	   ========================================================= */

	.review-result {
		display: grid;

		grid-template-columns:
			repeat(
				2,
				minmax(0, 1fr)
			);

		padding: 18px 22px;

		border-bottom:
			1px solid
			var(--review-border);

		background:
			rgba(0, 0, 0, 0.05);
	}


	.review-result > div {
		display: flex;

		flex-direction: column;

		gap: 5px;
	}


	.review-result span {
		color:
			var(--review-text-muted);

		font-size: 0.7rem;
		font-weight: 700;
	}


	.review-result strong {
		color:
			var(--review-text);

		font-size: 0.9rem;
	}


	/* =========================================================
	   12. Review Actions
	   ========================================================= */

	.review-actions {
		margin-top: 8px;

		margin-bottom: 32px;
	}


	.delete-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 24px;
		padding: 16px 18px;
		border: 1px solid var(--review-border);
		border-radius: 6px;
		background: rgba(0, 0, 0, 0.12);
	}


	.delete-actions strong {
		color: var(--review-text-secondary);
		font-size: 0.85rem;
	}


	.delete-actions p {
		margin: 4px 0 0;
		color: var(--review-text-muted);
		font-size: 0.78rem;
	}


	.review-warning {
		position: relative;

		margin-bottom: 20px;

		padding: 18px 20px;

		border:
			1px solid
			rgba(216, 184, 95, 0.42);

		border-left:
			4px solid
			var(--review-gold);

		border-radius: 6px;

		background:
			linear-gradient(
				135deg,
				rgba(216, 184, 95, 0.085),
				rgba(216, 184, 95, 0.025)
			);

		box-shadow:
			0 4px 0
			rgba(120, 101, 47, 0.30);
	}


	.review-warning strong {
		color:
			var(--review-gold);

		font-size: 0.9rem;
	}


	.review-warning p {
		margin:
			8px
			0
			0;

		color:
			var(--review-text-muted);

		font-size: 0.85rem;

		line-height: 1.75;
	}


	.action-buttons {
		display: flex;

		justify-content: flex-end;

		gap: 16px;
	}


	/* =========================================================
	   13. Buttons
	   ========================================================= */

	.button {
		position: relative;

		display: inline-flex;

		align-items: center;
		justify-content: center;

		min-height: 40px;

		padding: 9px 18px;

		border:
			1px solid
			transparent;

		border-radius: 4px;

		cursor: pointer;

		font-weight: 800;

		text-decoration: none;

		transition:
			transform 0.12s ease,
			filter 0.12s ease,
			opacity 0.12s ease,
			background-color 0.12s ease;
	}


	.button:hover:not(:disabled) {
		transform: translateY(-2px);

		filter: brightness(1.06);
	}


	.button:active:not(:disabled) {
		transform: translateY(2px);
	}


	.button:focus-visible {
		outline:
			2px solid
			var(--review-green-light);

		outline-offset: 3px;
	}


	.button:disabled {
		opacity: 0.5;

		cursor: not-allowed;

		filter: saturate(0.5);
	}


	.button-primary {
		border-color:
			var(--review-green);

		background:
			linear-gradient(
				180deg,
				#7fba61 0%,
				#679f4d 100%
			);

		color:
			#111a0e;

		box-shadow:
			var(--review-shadow-green);
	}


	.button-primary:hover:not(:disabled) {
		background:
			linear-gradient(
				180deg,
				#8acb6b 0%,
				#72ad55 100%
			);
	}


	.button-danger {
		border-color:
			#ad5b58;

		background:
			linear-gradient(
				180deg,
				#d77b77 0%,
				#bf625e 100%
			);

		color:
			#210b0a;

		box-shadow:
			var(--review-shadow-danger);
	}


	.button-danger:hover:not(:disabled) {
		background:
			linear-gradient(
				180deg,
				#e48b87 0%,
				#cc6b66 100%
			);
	}


	.button-secondary {
		border-color:
			var(--review-border);

		background:
			linear-gradient(
				180deg,
				#353b3f 0%,
				#292e32 100%
			);

		color:
			var(--review-text);

		box-shadow:
			0 3px 0 #171b1e,
			0 7px 14px rgba(0, 0, 0, 0.18);
	}


	.button-secondary:hover:not(:disabled) {
		border-color:
			var(--review-border-strong);

		background:
			linear-gradient(
				180deg,
				#3d4448 0%,
				#30363a 100%
			);
	}


	.button-large {
		min-width: 150px;

		min-height: 44px;
	}


	/* =========================================================
	   14. Action Message
	   ========================================================= */

	.action-message {
		margin:
			0
			0
			24px;

		padding:
			14px
			16px;

		border:
			1px solid
			var(--review-border);

		border-left:
			4px solid
			var(--review-info);

		border-radius: 6px;

		background:
			var(--review-surface);

		font-size: 0.9rem;

		line-height: 1.65;

		box-shadow:
			var(--review-shadow-small);
	}


	.action-message.success {
		border-color:
			rgba(114, 173, 85, 0.45);

		border-left-color:
			var(--review-green);

		background:
			rgba(114, 173, 85, 0.075);

		color:
			var(--review-green-light);
	}


	.action-message.error {
		border-color:
			rgba(216, 115, 112, 0.45);

		border-left-color:
			var(--review-danger);

		background:
			rgba(216, 115, 112, 0.075);

		color:
			var(--review-danger);
	}


	.action-message.info {
		border-color:
			rgba(121, 181, 213, 0.45);

		border-left-color:
			var(--review-info);

		background:
			rgba(121, 181, 213, 0.075);

		color:
			var(--review-info);
	}


	/* =========================================================
	   15. Bottom
	   ========================================================= */

	.bottom-actions {
		display: flex;

		justify-content:
			flex-start;

		padding-top: 4px;
	}


	/* =========================================================
	   16. Responsive
	   ========================================================= */

	@media (max-width: 900px) {
		.metadata-grid {
			grid-template-columns: 1fr;
		}


		.metadata-item:nth-child(odd) {
			border-right: 0;
		}


		.metadata-item:nth-last-child(-n + 2) {
			border-bottom:
				1px solid
				var(--review-border);
		}


		.metadata-item:last-child {
			border-bottom: 0;
		}
	}


	@media (max-width: 760px) {
		.table-wrap {
			display: none;
		}


		.request-cards {
			display: grid;
		}
	}


	@media (max-width: 700px) {
		.header-actions {
			display: none;
		}


		h1 {
			font-size: 2rem;
		}


		.description {
			font-size: 0.9rem;

			line-height: 1.7;
		}


		.status-banner {
			align-items: flex-start;

			flex-direction: column;

			gap: 12px;

			padding: 15px 16px;
		}


		.status-banner > div {
			align-items: flex-start;

			flex-direction: column;

			gap: 8px;
		}


		.panel-heading {
			align-items: flex-start;

			flex-direction: column;

			gap: 12px;

			padding: 18px;
		}


		.metadata-item {
			padding: 16px 18px;
		}


		.review-result {
			grid-template-columns: 1fr;

			gap: 16px;

			padding: 18px;
		}


		.code-view {
			max-height: 520px;

			padding: 16px;

			font-size: 0.76rem;

			line-height: 1.65;
		}


		#message-panel .edit-message,
		#review-comment-panel .edit-message {
			margin:
				16px
				18px;
		}


		.review-warning {
			padding: 16px;
		}


		.action-buttons {
			flex-direction: column;

			gap: 12px;
		}


		.action-buttons .button {
			width: 100%;
		}


		.delete-actions {
			align-items: stretch;
			flex-direction: column;
			gap: 12px;
		}


		.bottom-actions .button {
			width: 100%;
		}
	}


	@media (max-width: 420px) {
		h1 {
			font-size: 1.75rem;
		}


		.status-banner {
			margin-bottom: 16px;
		}


		.panel {
			margin-bottom: 18px;
		}


		.panel-heading {
			padding: 16px;
		}


		.code-view {
			font-size: 0.7rem;
		}


		.button {
			min-height: 44px;

			padding:
				10px
				14px;
		}


		.button-large {
			min-height: 48px;
		}
	}


	/* =========================================================
	   17. Reduced Motion
	   ========================================================= */

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;

			transition: none !important;

			animation: none !important;
		}
	}
</style>
		</AdminLayout>
	</body>
</html>