---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const entries = await getCollection("wiki");
const sortedEntries = [...entries].sort((a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER));
---

<Layout title="攻略 | NUG" description="Nekozouneko Serverの攻略情報をまとめています。">
	<section class="listing-page">
		<header class="page-header">
			<p class="page-label">WIKI</p>
			<h1>攻略</h1>
			<p class="page-description">Nekozouneko Serverの仕様や攻略情報をまとめています。</p>
		</header>
		<div class="entry-list">
			{sortedEntries.map((entry) => (
				<a class="entry-card" href={`/wiki/${entry.id}/`}>
					<span class="entry-icon">{entry.data.icon ?? "📚"}</span>
					<span class="entry-content">
						<span class="entry-category">{entry.data.category ?? "攻略"}</span>
						<strong>{entry.data.title}</strong>
						<span>{entry.data.description}</span>
					</span>
					<span class="entry-arrow">→</span>
				</a>
			))}
		</div>
	</section>
</Layout>

<style>
	.listing-page { padding: 72px 0 100px; }
	.page-header { max-width: 760px; margin-bottom: 48px; }
	.page-label, .entry-category { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; color: var(--color-text-secondary); }
	.page-header h1 { margin-top: 8px; font-size: clamp(40px, 7vw, 64px); line-height: 1.1; }
	.page-description { margin-top: 16px; color: var(--color-text-secondary); }
	.entry-list { display: grid; gap: 12px; }
	.entry-card { display: flex; align-items: center; gap: 16px; padding: 24px; border: 1px solid var(--color-border); border-radius: var(--radius-medium); transition: transform var(--transition-normal), box-shadow var(--transition-normal); }
	.entry-card:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08); }
	.entry-icon { font-size: 24px; }
	.entry-content { display: grid; gap: 5px; flex: 1; }
	.entry-content strong { font-size: 20px; }
	.entry-content span:last-child { font-size: 14px; color: var(--color-text-secondary); }
	.entry-arrow { font-size: 20px; color: var(--color-text-secondary); }
	@media (max-width: 768px) { .listing-page { padding: 48px 0 72px; } }
</style>
