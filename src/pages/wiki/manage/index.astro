---
import WikiAdminHeader from '../../../components/layout/WikiAdminHeader.astro';
import AdminTheme from '../../../components/admin/AdminTheme.astro';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Wiki管理 | ゆるぽーと</title>
	</head>
	<body>
		<WikiAdminHeader active="manage" />
		<main class="manage-page">
			<header class="page-heading">
				<div>
					<p class="eyebrow">WIKI MANAGEMENT</p>
					<h1>Wikiページ管理</h1>
					<p>既存ページの編集、新しいページの下書き、PR申請を管理します。</p>
				</div>
				<a class="button primary" href="/wiki/manage/edit/?new=1">新しいページ</a>
			</header>

			<div id="notice" class="notice" role="status" aria-live="polite"></div>
			<section class="toolbar" aria-label="ページ検索">
				<label>
					<span>検索</span>
					<input id="search" type="search" placeholder="タイトル・パス・フォルダ" />
				</label>
				<label>
					<span>状態</span>
					<select id="status-filter">
						<option value="">すべて</option>
						<option value="published">公開中</option>
						<option value="draft">下書き</option>
						<option value="pending">PR申請済み</option>
						<option value="merged">マージ済み</option>
						<option value="closed">PR終了</option>
					</select>
				</label>
				<button id="refresh" class="button secondary" type="button">再読み込み</button>
			</section>

			<section class="panel" aria-labelledby="list-title">
				<div class="panel-heading">
					<div><p class="eyebrow">PAGES</p><h2 id="list-title">Wikiページ一覧</h2></div>
					<span id="count" class="count">読み込み中…</span>
				</div>
				<div id="loading" class="empty-state">ページ一覧を取得しています…</div>
				<div id="empty" class="empty-state" hidden>該当するページはありません。</div>
				<div class="table-wrap" id="table-wrap" hidden>
					<table>
						<thead><tr><th>ページ / パス</th><th>フォルダ</th><th>更新日時・担当</th><th>状態</th><th>操作</th></tr></thead>
						<tbody id="page-list"></tbody>
					</table>
				</div>
			</section>
		</main>
		<AdminTheme />
	</body>
</html>

<script>
	interface WikiPage {
		path: string;
		title: string;
		source_path: string;
		revision_created_at?: string | null;
	}

	interface WikiDraft {
		id: string;
		operation: 'create' | 'update' | 'delete';
		status: 'draft' | 'publishing' | 'pending' | 'merged' | 'closed';
		title: string;
		folder_path: string;
		page_path: string;
		source_path: string;
		updated_at: string;
		created_by_name: string;
		updated_by_name: string;
		github_pr_number?: number | null;
		github_pr_url?: string | null;
		github_pr_state?: string | null;
	}

	interface PagesResult { ok: boolean; pages?: WikiPage[]; error?: string }
	interface DraftsResult { ok: boolean; drafts?: WikiDraft[]; error?: string }
	interface Entry {
		key: string;
		title: string;
		path: string;
		folder: string;
		updated: string;
		owner: string;
		status: string;
		statusLabel: string;
		source: WikiPage | WikiDraft;
		draft?: WikiDraft;
	}

	const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
	const notice = $('#notice');
	const list = $('#page-list');
	const loading = $('#loading');
	const empty = $('#empty');
	const tableWrap = $('#table-wrap');
	let entries: Entry[] = [];
	const publishedPaths = new Set<string>();

	function formatDate(value: string | null | undefined): string {
		if (!value) return '—';
		const date = new Date(value);
		return Number.isNaN(date.valueOf()) ? value : date.toLocaleString('ja-JP');
	}

	function showNotice(message: string, type = '') {
		notice.textContent = message;
		notice.className = `notice ${type}`;
		notice.hidden = !message;
	}

	function createCell(text: string, className = '') {
		const cell = document.createElement('td');
		cell.textContent = text;
		if (className) cell.className = className;
		return cell;
	}

	function render() {
		const query = ($('#search') as HTMLInputElement).value.trim().toLocaleLowerCase();
		const status = ($('#status-filter') as HTMLSelectElement).value;
		const visible = entries.filter((entry) => {
			const matchesQuery = !query || `${entry.title} ${entry.path} ${entry.folder}`.toLocaleLowerCase().includes(query);
			const matchesStatus = !status || entry.status === status;
			return matchesQuery && matchesStatus;
		});
		list.replaceChildren();
		$('#count').textContent = `${visible.length}件`;
		empty.hidden = visible.length > 0;
		tableWrap.hidden = visible.length === 0;
		for (const entry of visible) {
			const row = document.createElement('tr');
			const titleCell = document.createElement('td');
			const title = document.createElement('strong');
			title.textContent = entry.title;
			const path = document.createElement('code');
			path.textContent = entry.path;
			titleCell.append(title, path);
			row.append(titleCell, createCell(entry.folder || 'Wikiトップ'));
			row.append(createCell(`${formatDate(entry.updated)}\n${entry.owner}`));

			const statusCell = document.createElement('td');
			const badge = document.createElement('span');
			badge.className = `status status-${entry.status}`;
			badge.textContent = entry.statusLabel;
			statusCell.append(badge);
			if (entry.draft?.github_pr_url) {
				const pr = document.createElement('a');
				pr.href = entry.draft.github_pr_url;
				pr.target = '_blank';
				pr.rel = 'noopener noreferrer';
				pr.textContent = `PR #${entry.draft.github_pr_number ?? ''}`;
				pr.className = 'pr-link';
				statusCell.append(document.createElement('br'), pr);
			}
			row.append(statusCell);

			const actions = document.createElement('td');
			const edit = document.createElement('a');
			edit.className = 'button small secondary';
			const historical = entry.draft?.status === 'merged' || entry.draft?.status === 'closed';
			if (entry.draft && !historical) {
				edit.textContent = '下書きを開く';
				edit.href = `/wiki/manage/edit/?draft=${encodeURIComponent(entry.draft.id)}`;
			} else if (publishedPaths.has(entry.path)) {
				edit.textContent = historical ? '新しい編集下書き' : '編集';
				edit.href = `/wiki/manage/edit/?path=${encodeURIComponent(entry.path)}`;
			} else if (entry.draft) {
				edit.textContent = '新しいページとして作成';
				const slug = entry.draft.source_path.endsWith('/index.md') || entry.draft.source_path.endsWith('/index.mdx')
					? 'index'
					: entry.path.replace(/\/$/, '').split('/').at(-1) ?? '';
				edit.href = `/wiki/manage/edit/?new=1&folder=${encodeURIComponent(entry.draft.folder_path)}&slug=${encodeURIComponent(slug)}&title=${encodeURIComponent(entry.draft.title)}`;
			}
			actions.append(edit);
			row.append(actions);
			list.append(row);
		}
	}

	async function load() {
		showNotice('');
		loading.hidden = false;
		empty.hidden = true;
		tableWrap.hidden = true;
		try {
			const [pagesResponse, draftsResponse] = await Promise.all([
				fetch('/api/wiki/pages', { credentials: 'same-origin' }),
				fetch('/api/wiki/drafts', { credentials: 'same-origin' }),
			]);
			if (draftsResponse.status === 401) {
				location.assign(`/api/auth/google?returnTo=${encodeURIComponent('/wiki/manage/')}`);
				return;
			}
			const pagesData = await pagesResponse.json() as PagesResult;
			const draftsData = await draftsResponse.json() as DraftsResult;
			if (!pagesResponse.ok || !pagesData.ok) throw new Error(pagesData.error || 'Wikiページ一覧を取得できませんでした。');
			if (!draftsResponse.ok || !draftsData.ok) throw new Error(draftsData.error || '下書き一覧を取得できませんでした。');

			const drafts = draftsData.drafts ?? [];
			const draftByPath = new Map<string, WikiDraft>();
			for (const draft of drafts) {
				if (!draftByPath.has(draft.page_path)) {
					draftByPath.set(draft.page_path, draft);
				}
			}
			publishedPaths.clear();
			entries = (pagesData.pages ?? []).map((page) => {
				publishedPaths.add(page.path);
				const draft = draftByPath.get(page.path);
				const status = draft?.status ?? 'published';
				return {
					key: `page:${page.path}`,
					title: draft?.title ?? page.title,
					path: page.path,
					folder: page.path.split('/').slice(0, -2).join('/') || 'Wikiトップ',
					updated: draft?.updated_at ?? page.revision_created_at ?? '',
					owner: draft
						? `${draft.created_by_name} / ${draft.updated_by_name}`
						: '—',
					status,
					statusLabel: status === 'published' ? '公開中' :
						status === 'pending' ? `PR申請済み${draft?.github_pr_state ? ` (${draft.github_pr_state})` : ''}` :
						status === 'merged' ? 'マージ済み' :
						status === 'closed' ? 'PR終了' :
						status === 'publishing' ? '申請処理中' : '下書き',
					source: draft ?? page,
					draft,
				};
			});
			for (const draft of drafts) {
				if (publishedPaths.has(draft.page_path)) continue;
				const status = draft.status;
				entries.push({
					key: `draft:${draft.id}`,
					title: draft.title,
					path: draft.page_path,
					folder: draft.page_path.split('/').slice(0, -2).join('/') || 'Wikiトップ',
					updated: draft.updated_at,
					owner: `${draft.created_by_name} / ${draft.updated_by_name}`,
					status,
					statusLabel: status === 'pending' ? `PR申請済み${draft.github_pr_state ? ` (${draft.github_pr_state})` : ''}` :
						status === 'merged' ? 'マージ済み' :
						status === 'closed' ? 'PR終了' :
						status === 'publishing' ? '申請処理中' : '下書き',
					source: draft,
					draft,
				});
			}
			entries.sort((a, b) => a.path.localeCompare(b.path, 'ja'));
			loading.hidden = true;
			render();
		} catch (error) {
			loading.hidden = true;
			showNotice(error instanceof Error ? error.message : '一覧を読み込めませんでした。', 'error');
		}
	}

	$('#search').addEventListener('input', render);
	$('#status-filter').addEventListener('change', render);
	$('#refresh').addEventListener('click', load);
	load();
</script>

<style>
	.manage-page { width: min(1180px, calc(100% - 32px)); margin: 38px auto 80px; color: var(--admin-text, #edf2ef); }
	.page-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 24px; }
	.eyebrow { margin: 0 0 5px; color: #84b66b; font-size: 11px; font-weight: 900; letter-spacing: .12em; }
	h1, h2, p { margin-top: 0; }
	h1 { margin-bottom: 7px; font-size: clamp(26px, 4vw, 36px); }
	.page-heading p:last-child { margin-bottom: 0; color: var(--admin-text-secondary, #bdc8c0); }
	.toolbar { display: flex; align-items: end; gap: 12px; margin: 18px 0; padding: 16px; border: 1px solid #49534d; border-radius: 7px; background: #222927; }
	.toolbar label { display: grid; flex: 1; gap: 5px; color: #c8d1cb; font-size: 12px; font-weight: 700; }
	input, select { min-width: 0; min-height: 40px; padding: 8px 10px; border: 1px solid #58635c; border-radius: 4px; background: #171d1a; color: #edf2ef; font: inherit; }
	.panel { overflow: hidden; border: 1px solid #49534d; border-radius: 7px; background: #222927; box-shadow: 0 6px 22px #0002; }
	.panel-heading { display: flex; justify-content: space-between; align-items: center; padding: 18px; border-bottom: 1px solid #49534d; }
	.panel-heading h2 { margin: 0; font-size: 20px; }
	.panel-heading .eyebrow { margin-bottom: 2px; }
	.count { color: #aeb9b1; font-size: 13px; }
	.table-wrap { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; text-align: left; }
	th, td { padding: 12px 14px; border-bottom: 1px solid #3c4540; vertical-align: middle; }
	th { color: #aeb9b1; font-size: 11px; white-space: nowrap; }
	td { color: #dce4de; font-size: 13px; white-space: pre-line; }
	td strong, td code { display: block; }
	td code { margin-top: 4px; color: #aeb9b1; font-size: 11px; overflow-wrap: anywhere; }
	.status { display: inline-block; padding: 3px 8px; border: 1px solid #5a675e; border-radius: 99px; font-size: 11px; white-space: nowrap; }
	.status-published { border-color: #4c7950; color: #a5d49d; }
	.status-draft { border-color: #64707a; color: #c3ced4; }
	.status-pending, .status-publishing { border-color: #8c7442; color: #f0d48b; }
	.status-merged { border-color: #4c7950; color: #a5d49d; }
	.status-closed { border-color: #8b5250; color: #e8a7a3; }
	.pr-link { display: inline-block; margin-top: 6px; color: #94c1ee; font-size: 12px; }
	.button { display: inline-flex; min-height: 40px; align-items: center; justify-content: center; padding: 0 14px; border: 1px solid transparent; border-radius: 4px; font: inherit; font-size: 13px; font-weight: 800; text-decoration: none; cursor: pointer; }
	.button.primary { background: #4c843b; color: white; }
	.button.secondary { border-color: #58635c; background: #303833; color: #e5ece7; }
	.button.small { min-height: 34px; padding: 0 10px; font-size: 12px; }
	.empty-state { padding: 38px 18px; color: #aeb9b1; text-align: center; }
	.notice { margin: 12px 0; padding: 12px 14px; border-radius: 5px; background: #263a2b; color: #b6e0a9; }
	.notice:empty { display: none; }
	.notice.error { border: 1px solid #8a504d; background: #3a2827; color: #f1b3ae; }
	html[data-admin-theme='light'] .manage-page { color: #202725; }
	html[data-admin-theme='light'] .toolbar, html[data-admin-theme='light'] .panel { border-color: #d3dcde; background: #fff; }
	html[data-admin-theme='light'] .toolbar label, html[data-admin-theme='light'] td { color: #46514b; }
	html[data-admin-theme='light'] input, html[data-admin-theme='light'] select { border-color: #b7c3c6; background: #fff; color: #202725; }
	html[data-admin-theme='light'] .panel-heading, html[data-admin-theme='light'] th, html[data-admin-theme='light'] td { border-color: #d3dcde; }
	html[data-admin-theme='light'] th, html[data-admin-theme='light'] .count, html[data-admin-theme='light'] td code { color: #64716a; }
	html[data-admin-theme='light'] .button.secondary { border-color: #b7c3c6; background: #f6f8f8; color: #36443a; }
	html[data-admin-theme='light'] .status-published, html[data-admin-theme='light'] .status-merged { color: #28531f; }
	html[data-admin-theme='light'] .status-pending, html[data-admin-theme='light'] .status-publishing { color: #573d0d; }
	html[data-admin-theme='light'] .status-closed { color: #74211e; }
	@media (max-width: 700px) {
		.manage-page { width: calc(100% - 24px); margin-top: 25px; }
		.page-heading { align-items: start; flex-direction: column; }
		.toolbar { align-items: stretch; flex-direction: column; }
		.table-wrap { overflow: visible; }
		table, tbody, tr, td { display: block; width: 100%; }
		thead { display: none; }
		tr { padding: 10px 14px; border-bottom: 1px solid #3c4540; }
		td { padding: 5px 0; border: 0; }
	}
</style>
