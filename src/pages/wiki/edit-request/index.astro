</head>

<body>
	<WikiAdminHeader active="requests" />

<main class="container">
	<div id="loading-state" class="state">
		申請情報を読み込んでいます…
	</div>

	<div id="error-state" class="state error-state" hidden>
		申請情報を読み込めませんでした。
	</div>

	<div id="content" hidden>
		<div class="page-title">
			<a class="detail-back" href="/wiki/requests/">
				<span aria-hidden="true">←</span>
				<span>申請一覧へ戻る</span>
			</a>
			<h1>Wiki編集申請</h1>
			<p>編集内容・レビュー状況・申請の進行状況を確認できます。</p>
		</div>

		<div class="stack">

			<!-- ========================================
			     Page Info
			======================================== -->

			<section class="card">
				<div class="card-header">
					<h2 class="card-title">対象ページ</h2>

					<span id="status-badge" class="status-badge">
						-
					</span>
				</div>

				<div class="card-body">
					<div class="page-info">
						<div class="info-item">
							<div class="info-label">ページタイトル</div>
							<div id="page-title" class="info-value">-</div>
						</div>

						<div class="info-item">
							<div class="info-label">申請者</div>
							<div id="requester" class="info-value">-</div>
						</div>

						<div class="info-item">
							<div class="info-label">ページパス</div>
							<div class="info-value">
								<code id="page-path">-</code>
							</div>
						</div>

						<div class="info-item">
							<div class="info-label">Revision</div>
							<div id="revision-number" class="info-value">-</div>
						</div>

						<div class="info-item">
							<div class="info-label">作成日時</div>
							<div id="created-at" class="info-value">-</div>
						</div>

						<div class="info-item">
							<div class="info-label">レビュー日時</div>
							<div id="reviewed-at" class="info-value">-</div>
						</div>

						<div class="info-item">
							<div class="info-label">レビュアー</div>
							<div id="reviewer" class="info-value">-</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ========================================
			     Status Flow
			======================================== -->

			<section class="card">
				<div class="card-header">
					<h2 class="card-title">進行状況</h2>
				</div>

				<div class="card-body">
					<div id="status-flow" class="status-flow">

						<div
							class="status-step"
							data-step="draft"
						>
							<span class="status-icon">○</span>
							<span class="status-label">編集</span>
						</div>

						<div
							class="status-step"
							data-step="pending"
						>
							<span class="status-icon">○</span>
							<span class="status-label">申請中</span>
						</div>

						<div
							class="status-step"
							data-step="approved"
						>
							<span class="status-icon">○</span>
							<span class="status-label">承認</span>
						</div>

						<div
							class="status-step"
							data-step="publishing"
						>
							<span class="status-icon">○</span>
							<span class="status-label">公開処理</span>
						</div>

						<div
							class="status-step"
							data-step="published"
						>
							<span class="status-icon">○</span>
							<span class="status-label">公開済み</span>
						</div>

					</div>
				</div>
			</section>

			<!-- ========================================
			     Review Controls
			======================================== -->

			<section
				id="review-controls"
				class="card review-controls"
				hidden
			>
				<div class="card-header">
					<h2 class="card-title">レビュー操作</h2>
				</div>

				<div class="card-body">
					<p class="review-description">
						この申請はレビュー待ちです。内容を確認したうえで、承認または却下してください。
					</p>

					<label for="review-comment">
						<div class="info-label">レビューコメント</div>
					</label>

					<textarea
						id="review-comment"
						class="review-textarea"
						placeholder="必要に応じてレビューコメントを入力してください。却下する場合は理由を入力してください。"
					></textarea>

					<div class="review-actions">
						<button
							id="approve-button"
							class="action-button approve-button"
							type="button"
						>
							承認する
						</button>

						<button
							id="reject-button"
							class="action-button reject-button"
							type="button"
						>
							却下する
						</button>
					</div>

					<div
						id="review-result"
						class="review-result"
						hidden
					></div>
				</div>
			</section>

			<!-- ========================================
			     Publish Controls
			======================================== -->

			<section
				id="publish-controls"
				class="card publish-controls"
				hidden
			>
				<div class="card-header">
					<h2 class="card-title">公開操作</h2>
				</div>

				<div class="card-body">
					<p id="publish-description" class="publish-description">
						この申請は承認済みです。GitHubに公開用ブランチを作成し、変更をコミットしてPull Requestを作成します。
					</p>

					<div class="publish-actions">
						<button
							id="publish-button"
							class="publish-button"
							type="button"
						>
							公開処理を開始
						</button>

						<a
							id="publish-pr-link"
							class="publish-pr-link"
							href="#"
							target="_blank"
							rel="noopener noreferrer"
							hidden
						>
							GitHub Pull Requestを開く
						</a>
					</div>

					<div
						id="publish-status"
						class="publish-status"
						hidden
					></div>
				</div>
			</section>

			<!-- ========================================
			     Message
			======================================== -->

			<section
				id="message-card"
				class="card"
				hidden
			>
				<div class="card-header">
					<h2 class="card-title">申請メッセージ</h2>
				</div>

				<div class="card-body">
					<div id="message" class="message-box"></div>
				</div>
			</section>

			<!-- ========================================
			     Review Comment
			======================================== -->

			<section
				id="review-comment-card"
				class="card"
				hidden
			>
				<div class="card-header">
					<h2 class="card-title">レビューコメント</h2>
				</div>

				<div class="card-body">
					<div
						id="review-comment-display"
						class="review-box"
					></div>
				</div>
			</section>

			<!-- ========================================
			     Markdown Source
			======================================== -->

			<div class="revision-grid" aria-label="申請内容とプレビュー">
				<section class="card">
					<div class="card-header">
						<h2 class="card-title">Markdown本文</h2>
					</div>

					<div class="card-body" style="padding: 0;">
						<pre id="markdown-source" class="markdown-source"></pre>
					</div>
				</section>

				<section class="card">
					<div class="card-header">
						<h2 class="card-title">プレビュー</h2>
					</div>

					<div id="preview" class="preview"></div>
				</section>
			</div>

			<!-- ========================================
			     Actions
			======================================== -->

			<section class="card">
				<div class="card-header">
					<h2 class="card-title">操作</h2>
				</div>

				<div class="card-body">
					<div class="page-actions">

						<a
							id="public-page-link"
							class="page-action"
							href="/docs/"
						>
							公開ページを見る
						</a>

						<a
							id="edit-link"
							class="page-action"
							href="#"
							hidden
						>
							編集に戻る
						</a>

						<button
							id="delete-draft-button"
							class="delete-draft-button"
							type="button"
							hidden
						>
							この下書きを削除
						</button>

						<button
							id="admin-delete-button"
							class="admin-delete-button"
							type="button"
							hidden
						>
							管理者としてこの申請を削除
						</button>

					</div>

					<div
						id="delete-draft-result"
						class="delete-draft-result"
						hidden
					></div>

					<div
						id="admin-delete-result"
						class="admin-delete-result"
						hidden
					></div>
				</div>
			</section>

		</div>
	</div>
</main>

<script type="module">
	import { marked } from 'marked';
	import DOMPurify from 'dompurify';

	const loadingState =
		document.querySelector('#loading-state');

	const errorState =
		document.querySelector('#error-state');

	const content =
		document.querySelector('#content');

	const statusBadge =
		document.querySelector('#status-badge');

	const pageTitle =
		document.querySelector('#page-title');

	const requester =
		document.querySelector('#requester');

	const pagePath =
		document.querySelector('#page-path');

	const revisionNumber =
		document.querySelector('#revision-number');

	const createdAt =
		document.querySelector('#created-at');

	const reviewedAt =
		document.querySelector('#reviewed-at');

	const reviewer =
		document.querySelector('#reviewer');

	const statusSteps =
		document.querySelectorAll('.status-step');

	const reviewControls =
		document.querySelector('#review-controls');

	const reviewCommentInput =
		document.querySelector('#review-comment');

	const approveButton =
		document.querySelector('#approve-button');

	const rejectButton =
		document.querySelector('#reject-button');

	const reviewResult =
		document.querySelector('#review-result');

	const publishControls =
		document.querySelector('#publish-controls');

	const publishDescription =
		document.querySelector('#publish-description');

	const publishButton =
		document.querySelector('#publish-button');

	const publishPrLink =
		document.querySelector('#publish-pr-link');

	const publishStatus =
		document.querySelector('#publish-status');

	const messageCard =
		document.querySelector('#message-card');

	const message =
		document.querySelector('#message');

	const reviewCommentCard =
		document.querySelector('#review-comment-card');

	const reviewCommentDisplay =
		document.querySelector('#review-comment-display');

	const markdownSource =
		document.querySelector('#markdown-source');

	const preview =
		document.querySelector('#preview');

	const publicPageLink =
		document.querySelector('#public-page-link');

	const editLink =
		document.querySelector('#edit-link');

	const deleteDraftButton =
		document.querySelector(
			'#delete-draft-button'
		);

	const deleteDraftResult =
		document.querySelector(
			'#delete-draft-result'
		);

	const adminDeleteButton =
		document.querySelector(
			'#admin-delete-button'
		);

	const adminDeleteResult =
		document.querySelector(
			'#admin-delete-result'
		);

	const params =
		new URLSearchParams(
			window.location.search
		);

	const id =
		params.get('id');

	let currentRequest = null;
	let currentUser = null;

	let reviewProcessing = false;
	let publishProcessing = false;
	let deleteDraftProcessing = false;
	let adminDeleteProcessing = false;

	function formatDate(value) {
		if (!value) {
			return '-';
		}

		const date =
			new Date(value);

		if (
			Number.isNaN(
				date.getTime()
			)
		) {
			return value;
		}

		return new Intl.DateTimeFormat(
			'ja-JP',
			{
				year: 'numeric',
				month: 'numeric',
				day: 'numeric',
				hour: '2-digit',
				minute: '2-digit',
			}
		).format(date);
	}

	function getStatusLabel(status) {
		switch (status) {
			case 'draft':
				return '下書き';

			case 'pending':
				return '申請中';

			case 'approved':
				return '承認済み';

			case 'publishing':
				return '公開処理中';

			case 'published':
				return '公開済み';

			case 'rejected':
				return '却下';

			default:
				return status || '不明';
		}
	}

	function updateStatusBadge(status) {
		statusBadge.textContent =
			getStatusLabel(status);

		statusBadge.className =
			'status-badge';

		if (
			status === 'pending' ||
			status === 'approved' ||
			status === 'publishing' ||
			status === 'published' ||
			status === 'rejected'
		) {
			statusBadge.classList.add(
				status
			);
		}
	}

	function updateStatusFlow(status) {
		const order = [
			'draft',
			'pending',
			'approved',
			'publishing',
			'published',
		];

		const currentIndex =
			order.indexOf(status);

		statusSteps.forEach(
			(step) => {
				const stepStatus =
					step.dataset.step;

				step.classList.remove(
					'done',
					'active',
					'rejected'
				);

				const icon =
					step.querySelector(
						'.status-icon'
					);

				if (
					status === 'rejected' &&
					stepStatus === 'pending'
				) {
					step.classList.add(
						'rejected'
					);

					if (icon) {
						icon.textContent = '×';
					}

					return;
				}

				const stepIndex =
					order.indexOf(
						stepStatus
					);

				if (
					currentIndex === -1 ||
					stepIndex === -1
				) {
					if (icon) {
						icon.textContent = '○';
					}

					return;
				}

				if (
					stepIndex < currentIndex
				) {
					step.classList.add(
						'done'
					);

					if (icon) {
						icon.textContent = '●';
					}
				} else if (
					stepIndex === currentIndex
				) {
					step.classList.add(
						'active'
					);

					if (icon) {
						icon.textContent = '●';
					}
				} else {
					if (icon) {
						icon.textContent = '○';
					}
				}
			}
		);
	}

	function showReviewResult(
		messageText,
		type
	) {
		reviewResult.hidden = false;

		reviewResult.textContent =
			messageText;

		reviewResult.className =
			`review-result ${type}`;
	}

	function setReviewButtonsDisabled(
		disabled
	) {
		approveButton.disabled =
			disabled;

		rejectButton.disabled =
			disabled;

		reviewCommentInput.disabled =
			disabled;
	}

	function showPublishStatus(
		messageText,
		type = ''
	) {
		publishStatus.hidden = false;

		publishStatus.textContent =
			messageText;

		publishStatus.className =
			'publish-status';

		if (type) {
			publishStatus.classList.add(
				type
			);
		}
	}

	function setPublishButtonDisabled(
		disabled
	) {
		publishButton.disabled =
			disabled;
	}

	async function loadCurrentUser() {
		try {
			const response =
				await fetch(
					'/me',
					{
						credentials:
							'include',
					}
				);

			if (!response.ok) {
				return null;
			}

			const data =
				await response.json();

			if (
				!data.loggedIn ||
				!data.user
			) {
				return null;
			}

			return data.user;
		} catch {
			return null;
		}
	}

	function updateReviewControls() {
		const isAdmin =
			currentUser &&
			currentUser.role === 'admin';

		const isPending =
			currentRequest &&
			currentRequest.status ===
				'pending';

		reviewControls.hidden =
			!(
				isAdmin &&
				isPending
			);
	}

	function updatePublishControls() {
		const isAdmin =
			currentUser &&
			currentUser.role === 'admin';

		const status =
			currentRequest?.status;

		const canPublish =
			isAdmin &&
			status === 'approved';

		publishControls.hidden =
			!canPublish;

		if (canPublish) {
			publishButton.hidden =
				false;

			publishPrLink.hidden =
				true;

			publishDescription.textContent =
				'この申請は承認済みです。GitHubに公開用ブランチを作成し、変更をコミットしてPull Requestを作成します。';

			publishStatus.hidden =
				true;
		} else if (
			status === 'publishing'
		) {
			publishControls.hidden =
				false;

			publishButton.hidden =
				true;

			publishDescription.textContent =
				'公開処理を実行中です。GitHub Pull Requestがmainへマージされるまで、この申請は公開処理中のままです。';

			if (
				publishStatus.hidden
			) {
				showPublishStatus(
					'GitHub Pull Requestのマージを待っています。'
				);
			}
		} else {
			publishControls.hidden =
				true;
		}
	}

	function updateDeleteDraftControl() {
		const isLoggedIn =
			Boolean(currentUser);

		const isOwner =
			isLoggedIn &&
			currentRequest &&
			currentRequest.user_id ===
				currentUser.id;

		const isDraft =
			currentRequest &&
			currentRequest.status ===
				'draft';

		deleteDraftButton.hidden =
			!(
				isOwner &&
				isDraft
			);
	}

	function updateAdminDeleteControl() {
		const isAdmin =
			currentUser &&
			currentUser.role === 'admin';

		const status =
			currentRequest?.status;

		const deletableStatuses = [
			'draft',
			'pending',
			'rejected',
			'approved',
		];

		const canDelete =
			Boolean(isAdmin) &&
			deletableStatuses.includes(
				status
			);

		adminDeleteButton.hidden =
			!canDelete;

		if (!canDelete) {
			adminDeleteResult.hidden =
				true;
		}
	}

	function escapeHtml(value) {
		return String(value ?? '')
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;')
			.replaceAll("'", '&#39;');
	}

	function sanitizePreviewHref(value) {
		const href = String(value ?? '').trim();

		if (!href) return '#';
		if (href.startsWith('/')) return href;
		if (href.startsWith('#')) return href;

		try {
			const url = new URL(href, window.location.origin);
			if (url.protocol === 'http:' || url.protocol === 'https:') {
				return url.href;
			}
		} catch {
			return '#';
		}

		return '#';
	}

	function renderStarlightLinkCard(attributes) {
		const titleMatch = attributes.match(/title\s*=\s*["']([^"']*)["']/i);
		const hrefMatch = attributes.match(/href\s*=\s*["']([^"']*)["']/i);
		const descriptionMatch = attributes.match(/description\s*=\s*["']([^"']*)["']/i);

		const title = titleMatch?.[1]?.trim() || 'リンク';
		const href = sanitizePreviewHref(hrefMatch?.[1] || '#');
		const description = descriptionMatch?.[1]?.trim() || '';

		return `
<a class="starlight-link-card" href="${escapeHtml(href)}">
	<span class="starlight-link-card-title">${escapeHtml(title)}</span>
	${description ? `<span class="starlight-link-card-description">${escapeHtml(description)}</span>` : ''}
	<span class="starlight-link-card-arrow" aria-hidden="true">→</span>
</a>`;
	}

	function transformStarlightLinkCards(source) {
		return source.replace(
			/<CardGrid\s*>\s*([\s\S]*?)\s*<\/CardGrid>/gi,
			(_match, body) => {
				const cards = [];
				const cardPattern = /<LinkCard\s+([\s\S]*?)\/\s*>/gi;
				let match;

				while ((match = cardPattern.exec(body)) !== null) {
					cards.push(renderStarlightLinkCard(match[1]));
				}

				if (!cards.length) return '';
				return `\n<div class="starlight-card-grid">${cards.join('')}</div>\n`;
			}
		);
	}

	async function transformStarlightAdmonitions(source) {
		const pattern = /^\s*:::(note|tip|caution|danger)(?:\[([^\]]*)\])?\s*\n([\s\S]*?)^\s*:::\s*$/gim;
		const matches = [...source.matchAll(pattern)];
		const defaultTitles = {
			note: '注記',
			tip: 'ヒント',
			caution: '注意',
			danger: '警告',
		};

		for (const match of matches.reverse()) {
			const [fullMatch, type, label, body] = match;
			const start = match.index;

			if (start === undefined) {
				continue;
			}

			const title = label?.trim() || defaultTitles[type] || type;
			const renderedBody = await marked.parse(
				body.trim(),
				{
					gfm: true,
					breaks: false,
				}
			);

			const replacement = `
<div class="starlight-admonition starlight-admonition-${type}" data-admonition="${type}">
<div class="starlight-admonition-title">${escapeHtml(title)}</div>
<div class="starlight-admonition-body">
${renderedBody}
</div>
</div>
`;

			source =
				source.slice(0, start) +
				replacement +
				source.slice(start + fullMatch.length);
		}

		return source;
	}

	async function prepareStarlightPreview(source) {
		let prepared = String(source ?? '');

		prepared = prepared.replace(
			/^\uFEFF?---[ \t]*\r?\n[\s\S]*?\r?\n---[ \t]*(?:\r?\n|$)/,
			''
		);

		// MDXのimportはプレビューでは実行せず、表示対象から除外します。
		prepared = prepared.replace(
			/^\s*import\s+[\s\S]*?from\s+["'][^"']+["']\s*;?\s*$/gim,
			''
		);

		prepared = transformStarlightLinkCards(prepared);
		prepared = await transformStarlightAdmonitions(prepared);

		return prepared;
	}

	async function loadRequest() {
		if (!id) {
			throw new Error(
				'申請IDが指定されていません。'
			);
		}

		const response =
			await fetch(
				`/api/wiki/edit-requests/${encodeURIComponent(id)}`,
				{
					credentials:
						'include',
				}
			);

		const data =
			await response
				.json()
				.catch(
					() => null
				);

		if (!response.ok) {
			throw new Error(
				data?.error ||
				'申請情報を取得できませんでした。'
			);
		}

		if (
			!data?.editRequest ||
			!data?.revision
		) {
			throw new Error(
				'申請情報の形式が正しくありません。'
			);
		}

		currentRequest =
			data.editRequest;

		const revision =
			data.revision;

		pageTitle.textContent =
			currentRequest.page_title ||
			currentRequest.pagePath ||
			'-';

		requester.textContent =
			currentRequest.user_display_name ||
			currentRequest.user_id ||
			'-';

		pagePath.textContent =
			currentRequest.page_path ||
			currentRequest.pagePath ||
			'-';

		revisionNumber.textContent =
			currentRequest.revision_number ??
			revision.revision_number ??
			'-';

		createdAt.textContent =
			formatDate(
				currentRequest.created_at
			);

		reviewedAt.textContent =
			formatDate(
				currentRequest.reviewed_at
			);

		reviewer.textContent =
			currentRequest.reviewer_display_name ||
			currentRequest.reviewer_id ||
			'-';

		updateStatusBadge(
			currentRequest.status
		);

		updateStatusFlow(
			currentRequest.status
		);

		const requestMessage =
			currentRequest.message ||
			'';

		if (requestMessage) {
			messageCard.hidden =
				false;

			message.textContent =
				requestMessage;
		} else {
			messageCard.hidden =
				true;
		}

		const requestReviewComment =
			currentRequest.review_comment ||
			'';

		if (
			requestReviewComment
		) {
			reviewCommentCard.hidden =
				false;

			reviewCommentDisplay.textContent =
				requestReviewComment;
		} else {
			reviewCommentCard.hidden =
				true;
		}

		const markdown =
			revision.content ||
			'';

		markdownSource.textContent =
			markdown;

		const previewSource =
			await prepareStarlightPreview(
				markdown
			);

		const renderedMarkdown =
			await marked.parse(
				previewSource,
				{
					gfm: true,
					breaks: false,
				}
			);

		preview.innerHTML =
			DOMPurify.sanitize(
				renderedMarkdown
			);

		const publicPath =
			currentRequest.page_path ||
			currentRequest.pagePath ||
			'/docs/';

		publicPageLink.href =
			publicPath;

		if (
			currentRequest.status ===
			'draft'
		) {
			editLink.hidden =
				false;

			editLink.href =
				`/wiki/edit/?path=${encodeURIComponent(publicPath)}&request=${encodeURIComponent(id)}`;
		} else {
			editLink.hidden =
				true;
		}

		updateReviewControls();
		updatePublishControls();
		updateDeleteDraftControl();
		updateAdminDeleteControl();
	}

	async function performReview(
		status
	) {
		if (reviewProcessing) {
			return;
		}

		if (!currentRequest) {
			return;
		}

		if (
			currentRequest.status !==
			'pending'
		) {
			showReviewResult(
				'この申請はすでに処理されています。',
				'error'
			);

			return;
		}

		const comment =
			reviewCommentInput.value.trim();

		if (
			status === 'rejected' &&
			!comment
		) {
			showReviewResult(
				'却下する場合は、レビューコメントに理由を入力してください。',
				'error'
			);

			reviewCommentInput.focus();

			return;
		}

		const actionLabel =
			status === 'approved'
				? '承認'
				: '却下';

		const confirmed =
			window.confirm(
				`この申請を「${actionLabel}」しますか？\n\n` +
				'この操作は申請の状態を変更します。'
			);

		if (!confirmed) {
			return;
		}

		reviewProcessing =
			true;

		setReviewButtonsDisabled(
			true
		);

		reviewResult.hidden =
			true;

		try {
			const response =
				await fetch(
					`/api/wiki/edit-requests/${encodeURIComponent(id)}/review`,
					{
						method:
							'POST',

						credentials:
							'include',

						headers: {
							'Content-Type':
								'application/json',
						},

						body:
							JSON.stringify({
								status,
								comment:
									comment ||
									undefined,
							}),
					}
				);

			const data =
				await response
					.json()
					.catch(
						() => null
					);

			if (!response.ok) {
				throw new Error(
					data?.error ||
					`レビュー処理に失敗しました。HTTP ${response.status}`
				);
			}

			showReviewResult(
				`申請を「${actionLabel}」しました。申請情報を更新しています…`,
				'success'
			);

			await loadRequest();

			reviewCommentInput.value =
				'';

			showReviewResult(
				`申請を「${actionLabel}」しました。`,
				'success'
			);
		} catch (error) {
			console.error(error);

			showReviewResult(
				error instanceof Error
					? error.message
					: 'レビュー処理に失敗しました。',
				'error'
			);

			setReviewButtonsDisabled(
				false
			);
		} finally {
			reviewProcessing =
				false;

			if (
				currentRequest &&
				currentRequest.status ===
					'pending'
			) {
				setReviewButtonsDisabled(
					false
				);
			}
		}
	}

	async function performPublish() {
		if (publishProcessing) {
			return;
		}

		if (!currentRequest) {
			return;
		}

		if (
			currentRequest.status !==
			'approved'
		) {
			showPublishStatus(
				'この申請は現在、公開処理を開始できる状態ではありません。',
				'error'
			);

			return;
		}

		const confirmed =
			window.confirm(
				'この申請の公開処理を開始しますか？\n\n' +
				'GitHubに公開用ブランチを作成し、変更をコミットしてPull Requestを作成します。\n\n' +
				'Pull Requestがmainへマージされるまで、申請は「公開処理中」になります。'
			);

		if (!confirmed) {
			return;
		}

		publishProcessing =
			true;

		setPublishButtonDisabled(
			true
		);

		publishPrLink.hidden =
			true;

		showPublishStatus(
			'公開処理を開始しています…'
		);

		try {
			const response =
				await fetch(
					`/api/wiki/edit-requests/${encodeURIComponent(id)}/publish`,
					{
						method:
							'POST',

						credentials:
							'include',

						headers: {
							'Content-Type':
								'application/json',
						},
					}
				);

			const data =
				await response
					.json()
					.catch(
						() => null
					);

			if (!response.ok) {
				throw new Error(
					data?.message ||
					data?.error ||
					`公開処理に失敗しました。HTTP ${response.status}`
				);
			}

			const pullRequest =
				data?.github?.pullRequest;

			if (
				pullRequest?.html_url
			) {
				publishPrLink.href =
					pullRequest.html_url;

				publishPrLink.hidden =
					false;
			}

			showPublishStatus(
				'GitHubへの公開処理が完了しました。Pull Requestが作成されています。mainへのマージ後、Webhookによって公開済みに更新されます。',
				'success'
			);

			await loadRequest();
		} catch (error) {
			console.error(error);

			showPublishStatus(
				error instanceof Error
					? error.message
					: '公開処理に失敗しました。',
				'error'
			);

			setPublishButtonDisabled(
				false
			);

			await loadRequest().catch(
				() => {}
			);
		} finally {
			publishProcessing =
				false;
		}
	}

	async function performDeleteDraft() {
		if (deleteDraftProcessing) {
			return;
		}

		if (!currentRequest) {
			return;
		}

		if (
			currentRequest.status !==
			'draft'
		) {
			deleteDraftResult.hidden =
				false;

			deleteDraftResult.textContent =
				'下書き状態の申請だけ削除できます。';

			return;
		}

		if (
			!currentUser ||
			currentRequest.user_id !==
				currentUser.id
		) {
			deleteDraftResult.hidden =
				false;

			deleteDraftResult.textContent =
				'自分が作成した下書きだけ削除できます。';

			return;
		}

		const confirmed =
			window.confirm(
				'この下書きを削除しますか？\n\n' +
				'削除した下書きは元に戻せません。'
			);

		if (!confirmed) {
			return;
		}

		deleteDraftProcessing =
			true;

		deleteDraftButton.disabled =
			true;

		deleteDraftResult.hidden =
			false;

		deleteDraftResult.textContent =
			'下書きを削除しています…';

		try {
			const response =
				await fetch(
					`/api/wiki/edit-requests/${encodeURIComponent(id)}`,
					{
						method:
							'DELETE',

						credentials:
							'include',
					}
				);

			const data =
				await response
					.json()
					.catch(
						() => null
					);

			if (!response.ok) {
				throw new Error(
					data?.error ||
					`下書きの削除に失敗しました。HTTP ${response.status}`
				);
			}

			deleteDraftResult.textContent =
				'下書きを削除しました。申請一覧へ移動します…';

			window.setTimeout(
				() => {
					window.location.href =
						'/wiki/requests/';
				},
				500
			);
		} catch (error) {
			console.error(error);

			deleteDraftResult.textContent =
				error instanceof Error
					? error.message
					: '下書きの削除に失敗しました。';

			deleteDraftButton.disabled =
				false;

			deleteDraftProcessing =
				false;
		}
	}

	async function performAdminDelete() {
		if (adminDeleteProcessing) {
			return;
		}

		if (!currentRequest) {
			return;
		}

		const isAdmin =
			currentUser &&
			currentUser.role === 'admin';

		if (!isAdmin) {
			adminDeleteResult.hidden =
				false;

			adminDeleteResult.textContent =
				'管理者のみ申請を削除できます。';

			return;
		}

		const deletableStatuses = [
			'draft',
			'pending',
			'rejected',
			'approved',
		];

		if (
			!deletableStatuses.includes(
				currentRequest.status
			)
		) {
			adminDeleteResult.hidden =
				false;

			adminDeleteResult.textContent =
				'この状態の申請は削除できません。';

			return;
		}

		const statusLabel =
			getStatusLabel(
				currentRequest.status
			);

		const confirmed =
			window.confirm(
				'この申請を管理者として削除しますか？\n\n' +
				`現在の状態：${statusLabel}\n\n` +
				'削除した申請は元に戻せません。\n' +
				'公開済みのページや公開済みRevisionは削除されません。'
			);

		if (!confirmed) {
			return;
		}

		adminDeleteProcessing =
			true;

		adminDeleteButton.disabled =
			true;

		adminDeleteResult.hidden =
			false;

		adminDeleteResult.textContent =
			'申請を削除しています…';

		try {
			const response =
				await fetch(
					`/api/wiki/edit-requests/${encodeURIComponent(id)}`,
					{
						method:
							'DELETE',

						credentials:
							'include',
					}
				);

			const data =
				await response
					.json()
					.catch(
						() => null
					);

			if (!response.ok) {
				throw new Error(
					data?.error ||
					`申請の削除に失敗しました。HTTP ${response.status}`
				);
			}

			adminDeleteResult.textContent =
				'申請を削除しました。申請一覧へ移動します…';

			window.setTimeout(
				() => {
					window.location.href =
						'/wiki/requests/';
				},
				500
			);
		} catch (error) {
			console.error(error);

			adminDeleteResult.textContent =
				error instanceof Error
					? error.message
					: '申請の削除に失敗しました。';

			adminDeleteButton.disabled =
				false;

			adminDeleteProcessing =
				false;
		}
	}

	approveButton.addEventListener(
		'click',
		() =>
			performReview(
				'approved'
			)
	);

	rejectButton.addEventListener(
		'click',
		() =>
			performReview(
				'rejected'
			)
	);

	publishButton.addEventListener(
		'click',
		performPublish
	);

	deleteDraftButton.addEventListener(
		'click',
		performDeleteDraft
	);

	adminDeleteButton.addEventListener(
		'click',
		performAdminDelete
	);

	async function initialize() {
		try {
			currentUser =
				await loadCurrentUser();

			await loadRequest();

			loadingState.hidden =
				true;

			errorState.hidden =
				true;

			content.hidden =
				false;
		} catch (error) {
			console.error(error);

			loadingState.hidden =
				true;

			errorState.hidden =
				false;

			errorState.textContent =
				error instanceof Error
					? error.message
					: '申請情報を読み込めませんでした。';
		}
	}

	initialize();
</script>

</body>
</html>