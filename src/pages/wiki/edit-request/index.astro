---
import WikiAdminHeader from '../../../components/WikiAdminHeader.astro';

const title = 'Wiki編集申請 | NUGBASE';
---

<!doctype html>

<html lang="ja">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content="NUGBASE Wiki編集申請の詳細" />
	<title>{title}</title>

<style>
/* =========================================================
   NUGBASE Wiki Edit Request
   ---------------------------------------------------------
   Visual system + Wiki edit request controls.
   ========================================================= */

:root {
	color-scheme: dark;

	--bg: #101315;
	--bg-soft: #171a1c;
	--bg-deep: #0d1012;

	--panel: #2f3438;
	--panel-soft: #383e42;
	--panel-raised: #42474b;

	--border: #565e63;
	--border-dark: #252a2e;

	--text: #f1f4f2;
	--text-soft: #b6beb9;
	--text-muted: #858e92;

	--accent: #55b85c;
	--accent-dark: #2f7137;
	--accent-deep: #214f27;

	--blue: #73b9e8;
	--yellow: #e4c66d;
	--red: #e57b7b;

	--shadow:
		0 4px 0 #0a0c0d,
		0 10px 18px rgba(0, 0, 0, 0.28);

	--shadow-small:
		0 3px 0 #0a0c0d;

	--shadow-inset:
		inset 0 1px 0 rgba(255, 247, 214, 0.035);

	--radius: 3px;
}

* {
	box-sizing: border-box;
}

html,
body {
	margin: 0;
	padding: 0;
	min-height: 100%;
}

html {
	background: var(--bg-deep);
}

body {
	position: relative;
	isolation: isolate;

	background:
		radial-gradient(
			circle at 10% 0%,
			rgba(85, 184, 92, 0.12),
			transparent 30%
		),
		radial-gradient(
			circle at 90% 10%,
			rgba(255, 247, 214, 0.035),
			transparent 26%
		),
		linear-gradient(
			180deg,
			#252a2d 0,
			#191d20 220px,
			#111416 520px,
			#0f1113 100%
		);

	color: var(--text);

	font-family:
		Inter,
		-apple-system,
		BlinkMacSystemFont,
		"Segoe UI",
		"Hiragino Kaku Gothic ProN",
		"Hiragino Sans",
		Meiryo,
		sans-serif;

	line-height: 1.7;
}

body::before {
	content: "";

	position: fixed;
	inset: 0;

	pointer-events: none;

	background:
		linear-gradient(
			135deg,
			rgba(255, 247, 214, 0.035),
			transparent 25%
		),
		repeating-linear-gradient(
			0deg,
			rgba(255, 255, 255, 0.008) 0,
			rgba(255, 255, 255, 0.008) 1px,
			transparent 1px,
			transparent 4px
		);

	opacity: 0.65;
	z-index: -1;
}

a {
	color: inherit;
}

button,
textarea {
	font: inherit;
}

button,
a,
textarea {
	-webkit-tap-highlight-color: transparent;
}

[hidden] {
	display: none !important;
}

:focus-visible {
	outline: 2px solid var(--yellow);
	outline-offset: 3px;
}

/* =========================================================
   Header
========================================================= */

.page-header {
	position: sticky;
	top: 0;
	z-index: 20;

	border-bottom: 1px solid var(--border-dark);

	background:
		linear-gradient(
			180deg,
			rgba(58, 64, 68, 0.97),
			rgba(31, 35, 38, 0.97)
		);

	box-shadow:
		0 2px 0 rgba(255, 247, 214, 0.035),
		0 5px 16px rgba(0, 0, 0, 0.28);

	backdrop-filter: blur(12px);
}

.header-inner {
	width: min(1200px, calc(100% - 32px));
	margin: 0 auto;

	padding: 12px 0;

	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 16px;
}

.brand {
	display: flex;
	align-items: center;
	gap: 12px;

	min-width: 0;

	text-decoration: none;
}

.brand-main {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-width: 58px;
	min-height: 38px;

	padding: 0 10px;

	border: 1px solid #697277;

	background:
		linear-gradient(
			135deg,
			#4a5155,
			#30363a
		);

	box-shadow:
		0 3px 0 #101214,
		inset 0 1px 0 rgba(255, 247, 214, 0.08);

	color: #f8f9f6;

	font-size: 21px;
	font-weight: 950;
	letter-spacing: 0.1em;
	line-height: 1;
}

.brand-sub {
	overflow: hidden;

	color: var(--text-muted);

	font-size: 12px;
	font-weight: 700;

	letter-spacing: 0.035em;

	white-space: nowrap;
	text-overflow: ellipsis;
}

.header-links {
	display: flex;
	align-items: center;
	gap: 8px;
}

.header-link {
	position: relative;

	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 38px;
	padding: 0 13px;

	border: 1px solid var(--border);
	border-radius: var(--radius);

	background:
		linear-gradient(
			180deg,
			#3b4145,
			#2b3034
		);

	box-shadow: var(--shadow-small);

	color: var(--text-soft);

	text-decoration: none;

	font-size: 13px;
	font-weight: 800;

	transition:
		transform 0.12s ease,
		filter 0.12s ease,
		border-color 0.12s ease;
}

.header-link:hover {
	border-color: #707a80;
	color: var(--text);
	filter: brightness(1.08);
	transform: translateY(-1px);
}

.header-link:active {
	transform: translateY(2px);

	box-shadow:
		0 1px 0 #0a0c0d;
}

/* =========================================================
   Layout
========================================================= */

.container {
	width: min(1200px, calc(100% - 32px));
	margin: 0 auto;

	padding: 40px 0 80px;
}

.page-title {
	position: relative;

	margin-bottom: 32px;

	padding-left: 18px;
}

.page-title::before {
	content: "";

	position: absolute;
	left: 0;
	top: 3px;
	bottom: 3px;

	width: 5px;

	background:
		linear-gradient(
			180deg,
			#79d779,
			var(--accent-dark)
		);

	box-shadow:
		2px 0 0 rgba(0, 0, 0, 0.3);
}

.page-title h1 {
	margin: 0 0 8px;

	color: #f7f8f5;

	font-size: clamp(28px, 4vw, 38px);
	line-height: 1.2;

	font-weight: 950;

	letter-spacing: -0.025em;

	text-shadow:
		0 2px 0 #0b0d0e;
}

.page-title p {
	margin: 0;

	color: var(--text-soft);

	font-size: 14px;
}

.stack {
	display: grid;
	gap: 20px;
}

/* =========================================================
   Cards
========================================================= */

.card {
	position: relative;

	overflow: hidden;

	border: 1px solid var(--border);
	border-radius: var(--radius);

	background:
		linear-gradient(
			135deg,
			rgba(255, 247, 214, 0.025),
			transparent 30%
		),
		linear-gradient(
			180deg,
			var(--panel-raised),
			var(--panel)
		);

	box-shadow:
		var(--shadow),
		var(--shadow-inset);
}

.card::before {
	content: "";

	position: absolute;
	left: 0;
	top: 0;

	width: 100%;
	height: 2px;

	background:
		linear-gradient(
			90deg,
			rgba(255, 247, 214, 0.08),
			transparent 55%
		);

	pointer-events: none;
}

.card-header {
	min-height: 56px;

	padding: 14px 18px;

	border-bottom: 1px solid var(--border-dark);

	background:
		linear-gradient(
			180deg,
			rgba(255, 255, 255, 0.035),
			rgba(0, 0, 0, 0.08)
		);

	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
}

.card-title {
	position: relative;

	margin: 0;
	padding-left: 12px;

	color: #f4f6f3;

	font-size: 15px;
	font-weight: 950;

	letter-spacing: 0.015em;
}

.card-title::before {
	content: "";

	position: absolute;
	left: 0;
	top: 50%;

	width: 4px;
	height: 18px;

	transform: translateY(-50%);

	background: var(--accent);

	box-shadow:
		1px 1px 0 #183d1d;
}

.card-body {
	padding: 20px;
}

/* =========================================================
   Loading / Error
========================================================= */

.state {
	position: relative;

	padding: 64px 20px;

	border: 1px solid var(--border);
	border-radius: var(--radius);

	background:
		linear-gradient(
			135deg,
			rgba(255, 247, 214, 0.025),
			transparent 35%
		),
		var(--panel);

	box-shadow: var(--shadow);

	text-align: center;

	color: var(--text-muted);
}

.error-state {
	border-color: rgba(229, 123, 123, 0.45);

	background:
		linear-gradient(
			135deg,
			rgba(229, 123, 123, 0.08),
			transparent 45%
		),
		var(--panel);

	color: var(--red);
}

/* =========================================================
   Page Info
========================================================= */

.page-info {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 12px;
}

.info-item {
	min-width: 0;

	padding: 14px;

	border: 1px solid var(--border);
	border-radius: 2px;

	background:
		linear-gradient(
			135deg,
			rgba(255, 247, 214, 0.025),
			transparent 45%
		),
		var(--bg-soft);

	box-shadow:
		inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

.info-label {
	margin-bottom: 5px;

	color: var(--text-muted);

	font-size: 11px;
	font-weight: 900;

	letter-spacing: 0.07em;
	text-transform: uppercase;
}

.info-value {
	overflow-wrap: anywhere;

	color: var(--text);

	font-size: 14px;
	font-weight: 650;
}

.info-value code {
	display: inline-block;

	max-width: 100%;

	padding: 3px 7px;

	border: 1px solid #353c40;
	border-radius: 2px;

	background: #111416;

	color: #b9d8bd;

	font-family:
		"SFMono-Regular",
		Consolas,
		"Liberation Mono",
		monospace;

	font-size: 12px;

	word-break: break-all;
}

.revision-grid {
	display: grid;
	grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
	align-items: start;
	gap: 16px;
}

.revision-grid > .card {
	min-width: 0;
}

.revision-grid .markdown-source,
.revision-grid .preview {
	min-height: 540px;
	max-height: 760px;
	overflow: auto;
}

.detail-back {
	display: inline-flex;
	align-items: center;
	gap: 8px;
	min-height: 38px;
	margin-bottom: 12px;
	color: var(--blue);
	font-size: 13px;
	font-weight: 800;
	text-decoration: none;
}

.detail-back:hover {
	color: #a1d4f3;
	text-decoration: underline;
}

.detail-back:focus-visible {
	outline: 2px solid var(--yellow);
	outline-offset: 3px;
}

/* =========================================================
   Status Flow
========================================================= */

.status-flow {
	display: grid;
	grid-template-columns: repeat(5, minmax(0, 1fr));
	gap: 10px;
}

.status-step {
	position: relative;

	min-height: 78px;

	padding: 14px 10px;

	border: 1px solid var(--border);
	border-radius: 2px;

	background:
		linear-gradient(
			180deg,
			#363c40,
			#292e32
		);

	box-shadow:
		0 3px 0 #0b0d0e;

	text-align: center;

	transition:
		transform 0.12s ease,
		border-color 0.12s ease,
		filter 0.12s ease;
}

.status-step::after {
	content: "›";

	position: absolute;
	right: -10px;
	top: 50%;

	z-index: 2;

	width: 20px;
	height: 20px;

	transform: translateY(-50%);

	color: var(--text-muted);

	font-size: 20px;
	font-weight: 900;
	line-height: 18px;

	text-shadow:
		0 2px 0 #0a0c0d;
}

.status-step:last-child::after {
	display: none;
}

.status-step.done {
	border-color: rgba(85, 184, 92, 0.62);

	background:
		linear-gradient(
			180deg,
			rgba(85, 184, 92, 0.19),
			rgba(47, 113, 55, 0.14)
		),
		#2b3430;

	box-shadow:
		0 3px 0 #17261a;
}

.status-step.active {
	border-color: rgba(115, 185, 232, 0.75);

	background:
		linear-gradient(
			180deg,
			rgba(115, 185, 232, 0.16),
			rgba(62, 92, 112, 0.12)
		),
		#2b3237;

	box-shadow:
		0 3px 0 #18242c;
}

.status-step.rejected {
	border-color: rgba(229, 123, 123, 0.7);

	background:
		linear-gradient(
			180deg,
			rgba(229, 123, 123, 0.16),
			rgba(120, 58, 58, 0.1)
		),
		#322b2d;

	box-shadow:
		0 3px 0 #261618;
}

.status-icon {
	display: block;

	margin-bottom: 5px;

	color: var(--text-muted);

	font-size: 17px;
	font-weight: 950;
	line-height: 1;
}

.status-step.done .status-icon {
	color: var(--accent);
}

.status-step.active .status-icon {
	color: var(--blue);
}

.status-step.rejected .status-icon {
	color: var(--red);
}

.status-label {
	display: block;

	color: var(--text-soft);

	font-size: 12px;
	font-weight: 850;
}

.status-step.done .status-label,
.status-step.active .status-label {
	color: var(--text);
}

/* =========================================================
   Status Badge
========================================================= */

.status-badge {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 30px;

	padding: 0 10px;

	border: 1px solid var(--border);
	border-radius: 2px;

	background: #252a2d;

	box-shadow:
		inset 0 1px 0 rgba(255, 255, 255, 0.025);

	color: var(--text-soft);

	font-size: 12px;
	font-weight: 900;
}

.status-badge.pending {
	border-color: rgba(115, 185, 232, 0.6);

	background: rgba(115, 185, 232, 0.11);

	color: var(--blue);
}

.status-badge.approved,
.status-badge.published {
	border-color: rgba(85, 184, 92, 0.62);

	background: rgba(85, 184, 92, 0.11);

	color: #83d887;
}

.status-badge.rejected {
	border-color: rgba(229, 123, 123, 0.62);

	background: rgba(229, 123, 123, 0.1);

	color: var(--red);
}

.status-badge.publishing {
	border-color: rgba(228, 198, 109, 0.62);

	background: rgba(228, 198, 109, 0.1);

	color: var(--yellow);
}

/* =========================================================
   Message
========================================================= */

.message-box {
	position: relative;

	padding: 15px 16px 15px 19px;

	border: 1px solid rgba(115, 185, 232, 0.24);
	border-left: 4px solid var(--blue);

	background:
		linear-gradient(
			135deg,
			rgba(115, 185, 232, 0.09),
			transparent 55%
		),
		#20272c;

	color: var(--text-soft);

	white-space: pre-wrap;
	word-break: break-word;
}

.review-box {
	position: relative;

	padding: 15px 16px 15px 19px;

	border: 1px solid rgba(228, 198, 109, 0.24);
	border-left: 4px solid var(--yellow);

	background:
		linear-gradient(
			135deg,
			rgba(228, 198, 109, 0.09),
			transparent 55%
		),
		#292720;

	color: var(--text-soft);

	white-space: pre-wrap;
	word-break: break-word;
}

/* =========================================================
   Markdown Source
========================================================= */

.markdown-source {
	margin: 0;

	min-height: 120px;

	padding: 20px;

	overflow-x: auto;

	background:
		linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.025),
			transparent 30%
		),
		#0b0e10;

	color: #d9e0e3;

	font-family:
		"SFMono-Regular",
		Consolas,
		"Liberation Mono",
		monospace;

	font-size: 13px;
	line-height: 1.75;

	white-space: pre-wrap;
	word-break: break-word;

	tab-size: 2;
}

/* =========================================================
   Preview
========================================================= */

:global(.preview) {
	min-height: 120px;

	padding: 24px;

	background:
		radial-gradient(
			circle at 0% 0%,
			rgba(255, 247, 214, 0.025),
			transparent 30%
		),
		linear-gradient(
			180deg,
			#272c30,
			#202528
		);

	overflow-wrap: anywhere;
}

:global(.preview > :first-child) {
	margin-top: 0;
}

:global(.preview > :last-child) {
	margin-bottom: 0;
}

:global(.preview h1, .preview h2, .preview h3, .preview h4) {
	color: #f3f5f2;

	line-height: 1.35;
	font-weight: 900;

	text-shadow:
		0 1px 0 #111416;
}

:global(.preview h1) {
	margin-top: 0;

	font-size: 28px;
}

:global(.preview h2) {
	position: relative;

	margin-top: 30px;
	padding: 10px 0 9px 12px;

	border-bottom: 1px solid var(--border);

	font-size: 22px;
}

:global(.preview h2::before) {
	content: "";

	position: absolute;
	left: 0;
	top: 9px;
	bottom: 9px;

	width: 4px;

	background: var(--accent);
}

:global(.preview h3) {
	margin-top: 24px;

	font-size: 18px;
}

:global(.preview h4) {
	margin-top: 20px;

	font-size: 15px;
}

:global(.preview p) {
	margin: 12px 0;
}

:global(.preview a) {
	color: var(--blue);

	text-decoration-thickness: 1px;
	text-underline-offset: 3px;
}

:global(.preview a:hover) {
	color: #a1d4f3;
}

:global(.preview strong) {
	color: #ffffff;
}

:global(.preview code) {
	padding: 2px 6px;

	border: 1px solid #3b4348;
	border-radius: 2px;

	background: #111416;

	color: #dce3e6;

	font-family:
		"SFMono-Regular",
		Consolas,
		"Liberation Mono",
		monospace;

	font-size: 0.92em;
}

:global(.preview pre) {
	overflow-x: auto;

	margin: 16px 0;
	padding: 16px;

	border: 1px solid #343b40;
	border-radius: 2px;

	background:
		linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.02),
			transparent 35%
		),
		#0b0e0f;

	box-shadow:
		inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

:global(.preview pre code) {
	padding: 0;

	border: 0;

	background: transparent;
}

:global(.preview blockquote) {
	margin: 16px 0;

	padding: 11px 15px 11px 17px;

	border: 1px solid #41494e;
	border-left: 4px solid var(--border);

	background: rgba(0, 0, 0, 0.14);

	color: var(--text-soft);
}

:global(.preview ul, .preview ol) {
	padding-left: 24px;
}

:global(.preview li + li) {
	margin-top: 4px;
}

:global(.preview hr) {
	margin: 24px 0;

	border: 0;
	border-top: 1px solid var(--border);
}

:global(.preview img) {
	max-width: 100%;
	height: auto;

	border: 1px solid var(--border);
	border-radius: 2px;

	box-shadow: var(--shadow-small);
}

:global(.preview table) {
	width: 100%;

	margin: 18px 0;

	border-collapse: collapse;

	background: #252a2d;
}

:global(.preview th, .preview td) {
	padding: 9px 11px;

	border: 1px solid var(--border);

	text-align: left;
	vertical-align: top;
}

:global(.preview th) {
	background:
		linear-gradient(
			180deg,
			#3a4145,
			#30363a
		);

	color: var(--text);

	font-weight: 900;
}

:global(.preview tr:nth-child(even) td) {
	background: rgba(255, 255, 255, 0.015);
}

/* =========================================================
   Starlight Preview Extensions
========================================================= */

:global(.preview .starlight-admonition) {
	position: relative;
	margin: 20px 0;
	padding: 0 16px 14px;
	border: 1px solid #4a5358;
	border-left: 4px solid var(--blue);
	border-radius: 2px;
	background: linear-gradient(135deg, rgba(115, 185, 232, 0.08), transparent 48%), #20272b;
	box-shadow: 0 3px 0 #111416, inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

:global(.preview .starlight-admonition-title) {
	margin: 0 -16px 12px -16px;
	padding: 10px 14px;
	border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	color: #eef7fb;
	font-weight: 900;
	line-height: 1.4;
}

:global(.preview .starlight-admonition-body > :first-child) { margin-top: 0; }
:global(.preview .starlight-admonition-body > :last-child) { margin-bottom: 0; }
:global(.preview .starlight-admonition-note) { border-left-color: var(--blue); }
:global(.preview .starlight-admonition-tip) {
	border-left-color: var(--accent);
	background: linear-gradient(135deg, rgba(85, 184, 92, 0.09), transparent 48%), #202821;
}
:global(.preview .starlight-admonition-caution) {
	border-left-color: var(--yellow);
	background: linear-gradient(135deg, rgba(228, 198, 109, 0.09), transparent 48%), #292720;
}
:global(.preview .starlight-admonition-danger) {
	border-left-color: var(--red);
	background: linear-gradient(135deg, rgba(229, 123, 123, 0.09), transparent 48%), #2a2224;
}

:global(.preview .starlight-card-grid) {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 14px;
	margin: 20px 0;
}

:global(.preview .starlight-link-card) {
	position: relative;
	display: flex;
	flex-direction: column;
	gap: 7px;
	min-height: 116px;
	padding: 16px 42px 16px 16px;
	border: 1px solid var(--border);
	border-radius: 3px;
	background: linear-gradient(135deg, rgba(255, 247, 214, 0.035), transparent 38%), linear-gradient(180deg, #373e42, #2c3236);
	box-shadow: 0 3px 0 #0b0d0e, inset 0 1px 0 rgba(255, 247, 214, 0.04);
	color: var(--text);
	text-decoration: none;
	transition: transform 0.12s ease, border-color 0.12s ease, filter 0.12s ease;
}

:global(.preview .starlight-link-card:hover) {
	border-color: #758087;
	filter: brightness(1.08);
	transform: translateY(-1px);
}

:global(.preview .starlight-link-card-title) {
	color: #f3f5f2;
	font-size: 16px;
	font-weight: 950;
	line-height: 1.4;
}

:global(.preview .starlight-link-card-description) {
	color: var(--text-soft);
	font-size: 13px;
	line-height: 1.6;
}

:global(.preview .starlight-link-card-arrow) {
	position: absolute;
	right: 16px;
	top: 50%;
	transform: translateY(-50%);
	color: var(--blue);
	font-size: 20px;
	font-weight: 900;
}

/* =========================================================
   Review Controls
========================================================= */

.review-controls {
	border-color: rgba(228, 198, 109, 0.4);

	background:
		linear-gradient(
			135deg,
			rgba(228, 198, 109, 0.08),
			transparent 38%
		),
		linear-gradient(
			180deg,
			#393733,
			#2e2e2b
		);
}

.review-controls .card-title::before {
	background: var(--yellow);

	box-shadow:
		1px 1px 0 #5a4b20;
}

.review-description {
	margin: 0 0 18px;

	color: var(--text-soft);

	font-size: 13px;
}

.review-textarea {
	display: block;

	width: 100%;
	min-height: 130px;

	padding: 13px 14px;

	border: 1px solid var(--border);
	border-radius: 2px;

	background:
		linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.018),
			transparent 30%
		),
		#111416;

	color: var(--text);

	resize: vertical;

	outline: none;

	box-shadow:
		inset 0 2px 5px rgba(0, 0, 0, 0.28);

	transition:
		border-color 0.12s ease,
		box-shadow 0.12s ease;
}

.review-textarea::placeholder {
	color: #687278;
}

.review-textarea:focus {
	border-color: rgba(115, 185, 232, 0.75);

	box-shadow:
		0 0 0 2px rgba(115, 185, 232, 0.11),
		inset 0 2px 5px rgba(0, 0, 0, 0.28);
}

.review-textarea:disabled {
	opacity: 0.55;

	cursor: not-allowed;
}

.review-actions {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;

	margin-top: 16px;
}

.action-button {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 42px;

	padding: 0 17px;

	border: 1px solid var(--border);
	border-radius: 2px;

	box-shadow: var(--shadow-small);

	cursor: pointer;

	font-size: 13px;
	font-weight: 900;

	transition:
		transform 0.1s ease,
		filter 0.12s ease,
		opacity 0.12s ease;
}

.action-button:hover:not(:disabled) {
	filter: brightness(1.1);

	transform: translateY(-1px);
}

.action-button:active:not(:disabled) {
	transform: translateY(2px);

	box-shadow:
		0 1px 0 #0a0c0d;
}

.action-button:disabled {
	cursor: not-allowed;

	opacity: 0.5;
}

.approve-button {
	border-color: rgba(85, 184, 92, 0.68);

	background:
		linear-gradient(
			180deg,
			#3f9147,
			#2f7137
		);

	color: #f4fff3;

	box-shadow:
		0 3px 0 #1d4722;
}

.approve-button:hover:not(:disabled) {
	background:
		linear-gradient(
			180deg,
			#4ba854,
			#367d3e
		);
}

.reject-button {
	border-color: rgba(229, 123, 123, 0.62);

	background:
		linear-gradient(
			180deg,
			#633b3d,
			#4c2d2f
		);

	color: #ffdede;

	box-shadow:
		0 3px 0 #281719;
}

.reject-button:hover:not(:disabled) {
	background:
		linear-gradient(
			180deg,
			#754447,
			#5a3235
		);
}

/* =========================================================
   Publish Controls
========================================================= */

.publish-controls {
	border-color: rgba(85, 184, 92, 0.42);

	background:
		linear-gradient(
			135deg,
			rgba(85, 184, 92, 0.08),
			transparent 40%
		),
		linear-gradient(
			180deg,
			#343c36,
			#2c332e
		);
}

.publish-controls .card-title::before {
	background: var(--accent);

	box-shadow:
		1px 1px 0 #183d1d;
}

.publish-description {
	margin: 0;

	color: var(--text-soft);

	font-size: 13px;
}

.publish-actions {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;

	margin-top: 18px;
}

.publish-button {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 44px;

	padding: 0 19px;

	border: 1px solid rgba(85, 184, 92, 0.72);
	border-radius: 2px;

	background:
		linear-gradient(
			180deg,
			#4ba854,
			#2f7137
		);

	box-shadow:
		0 3px 0 #1d4722;

	color: #f4fff3;

	cursor: pointer;

	font-size: 13px;
	font-weight: 950;

	transition:
		transform 0.1s ease,
		filter 0.12s ease,
		opacity 0.12s ease;
}

.publish-button:hover:not(:disabled) {
	filter: brightness(1.1);

	transform: translateY(-1px);
}

.publish-button:active:not(:disabled) {
	transform: translateY(2px);

	box-shadow:
		0 1px 0 #0a0c0d;
}

.publish-button:disabled {
	cursor: not-allowed;

	opacity: 0.55;
}

.publish-status {
	margin-top: 14px;

	padding: 11px 13px;

	border: 1px solid rgba(85, 184, 92, 0.28);
	border-radius: 2px;

	background: rgba(85, 184, 92, 0.07);

	color: var(--text-soft);

	font-size: 13px;

	white-space: pre-wrap;
}

.publish-status.success {
	border-color: rgba(85, 184, 92, 0.45);

	background: rgba(85, 184, 92, 0.09);

	color: #8bd98f;
}

.publish-status.error {
	border-color: rgba(229, 123, 123, 0.45);

	background: rgba(229, 123, 123, 0.09);

	color: #f09191;
}

.publish-pr-link {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 40px;

	padding: 0 15px;

	border: 1px solid rgba(115, 185, 232, 0.55);
	border-radius: 2px;

	background:
		linear-gradient(
			180deg,
			#3b5362,
			#2c3e49
		);

	box-shadow: var(--shadow-small);

	color: #d5edff;

	text-decoration: none;

	font-size: 13px;
	font-weight: 850;

	transition:
		transform 0.1s ease,
		filter 0.12s ease;
}

.publish-pr-link:hover {
	filter: brightness(1.08);

	transform: translateY(-1px);
}

.publish-pr-link:active {
	transform: translateY(2px);

	box-shadow:
		0 1px 0 #0a0c0d;
}

/* =========================================================
   Review Result
========================================================= */

.review-result {
	margin-top: 14px;

	padding: 11px 13px;

	border-radius: 2px;

	font-size: 13px;

	white-space: pre-wrap;
}

.review-result.success {
	border: 1px solid rgba(85, 184, 92, 0.42);

	background:
		rgba(85, 184, 92, 0.09);

	color: #8bd98f;
}

.review-result.error {
	border: 1px solid rgba(229, 123, 123, 0.42);

	background:
		rgba(229, 123, 123, 0.09);

	color: #f09191;
}

/* =========================================================
   Delete Draft
========================================================= */

.delete-draft-button {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 40px;

	padding: 0 15px;

	border: 1px solid rgba(229, 123, 123, 0.62);
	border-radius: 2px;

	background:
		linear-gradient(
			180deg,
			#633b3d,
			#4c2d2f
		);

	box-shadow:
		0 3px 0 #281719;

	color: #ffdede;

	cursor: pointer;

	font-size: 13px;
	font-weight: 900;

	transition:
		transform 0.1s ease,
		filter 0.12s ease,
		opacity 0.12s ease;
}

.delete-draft-button:hover:not(:disabled) {
	filter: brightness(1.1);

	transform: translateY(-1px);
}

.delete-draft-button:active:not(:disabled) {
	transform: translateY(2px);

	box-shadow:
		0 1px 0 #0a0c0d;
}

.delete-draft-button:disabled {
	cursor: not-allowed;

	opacity: 0.5;
}

.delete-draft-result {
	margin-top: 12px;

	padding: 11px 13px;

	border: 1px solid rgba(229, 123, 123, 0.42);
	border-radius: 2px;

	background:
		rgba(229, 123, 123, 0.09);

	color: #f09191;

	font-size: 13px;

	white-space: pre-wrap;
}

/* =========================================================
   Admin Delete
========================================================= */

.admin-delete-button {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 40px;

	padding: 0 15px;

	border: 1px solid rgba(229, 123, 123, 0.72);
	border-radius: 2px;

	background:
		linear-gradient(
			180deg,
			#754447,
			#4c2d2f
		);

	box-shadow:
		0 3px 0 #281719;

	color: #ffe5e5;

	cursor: pointer;

	font-size: 13px;
	font-weight: 950;

	transition:
		transform 0.1s ease,
		filter 0.12s ease,
		opacity 0.12s ease;
}

.admin-delete-button:hover:not(:disabled) {
	filter: brightness(1.1);

	transform: translateY(-1px);
}

.admin-delete-button:active:not(:disabled) {
	transform: translateY(2px);

	box-shadow:
		0 1px 0 #0a0c0d;
}

.admin-delete-button:disabled {
	cursor: not-allowed;

	opacity: 0.5;
}

.admin-delete-result {
	margin-top: 12px;

	padding: 11px 13px;

	border: 1px solid rgba(229, 123, 123, 0.42);
	border-radius: 2px;

	background:
		rgba(229, 123, 123, 0.09);

	color: #f09191;

	font-size: 13px;

	white-space: pre-wrap;
}

/* =========================================================
   Footer Links / Page Actions
========================================================= */

.page-actions {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
}

.page-action {
	display: inline-flex;
	align-items: center;
	justify-content: center;

	min-height: 40px;

	padding: 0 15px;

	border: 1px solid var(--border);
	border-radius: 2px;

	background:
		linear-gradient(
			180deg,
			#3b4145,
			#2d3337
		);

	box-shadow: var(--shadow-small);

	color: var(--text-soft);

	text-decoration: none;

	font-size: 13px;
	font-weight: 850;

	transition:
		transform 0.1s ease,
		filter 0.12s ease,
		border-color 0.12s ease;
}

.page-action:hover {
	border-color: #727c82;

	color: var(--text);

	filter: brightness(1.08);

	transform: translateY(-1px);
}

.page-action:active {
	transform: translateY(2px);

	box-shadow:
		0 1px 0 #0a0c0d;
}

/* =========================================================
   Responsive
========================================================= */

@media (max-width: 760px) {
	.revision-grid {
		grid-template-columns: minmax(0, 1fr);
	}

	.revision-grid .markdown-source,
	.revision-grid .preview {
		min-height: 320px;
		max-height: 560px;
	}
	.header-inner {
		width: min(100% - 20px, 1200px);

		padding: 10px 0;
	}

	.brand-sub {
		display: none;
	}

	.brand-main {
		min-width: 54px;
		min-height: 36px;

		font-size: 19px;
	}

	.header-links {
		gap: 6px;
	}

	.header-link {
		min-height: 36px;

		padding: 0 10px;

		font-size: 12px;
	}

	.container {
		width: min(100% - 20px, 1200px);

		padding-top: 28px;
		padding-bottom: 56px;
	}

	.page-title {
		margin-bottom: 24px;

		padding-left: 14px;
	}

	.page-title h1 {
		font-size: 28px;
	}

	.page-title p {
		font-size: 13px;
	}

	.stack {
		gap: 16px;
	}

	.card-header {
		min-height: 52px;

		padding: 13px 14px;
	}

	.card-body {
		padding: 14px;
	}

	.page-info {
		grid-template-columns: 1fr;
	}

	.status-flow {
		grid-template-columns: 1fr;

		gap: 10px;
	}

	.status-step {
		min-height: 68px;

		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;

		padding: 12px 14px;
	}

	.status-icon {
		margin: 0;

		font-size: 15px;
	}

	.status-step::after {
		content: "↓";

		right: auto;
		top: auto;
		bottom: -15px;
		left: 50%;

		width: 20px;
		height: 20px;

		transform: translateX(-50%);

		font-size: 18px;
		line-height: 20px;
	}

	.status-step:last-child::after {
		display: none;
	}

	.message-box,
	.review-box {
		padding: 13px 13px 13px 16px;
	}

	.markdown-source {
		padding: 16px;

		font-size: 12px;
	}

	.preview {
		padding: 18px;
	}

	:global(.preview h1) {
		font-size: 24px;
	}

	:global(.preview h2) {
		font-size: 20px;
	}

	:global(.preview table) {
		display: block;

		overflow-x: auto;

		white-space: nowrap;
	}

	.review-actions,
	.publish-actions {
		display: grid;
		grid-template-columns: 1fr;
	}

	.action-button,
	.publish-button,
	.publish-pr-link {
		width: 100%;
	}

	.page-actions {
		display: grid;
		grid-template-columns: 1fr;
	}

	.page-action,
	.delete-draft-button,
	.admin-delete-button {
		width: 100%;
	}
}

/* =========================================================
   Reduced Motion
========================================================= */

@media (prefers-reduced-motion: reduce) {
	*,
	*::before,
	*::after {
		scroll-behavior: auto !important;

		transition-duration: 0.01ms !important;
		animation-duration: 0.01ms !important;
		animation-iteration-count: 1 !important;
	}
}
