			20px;

		color:
			var(--nug-muted);

		text-decoration:
			none;

		font-size:
			0.85rem;

		font-weight:
			700;

		transition:
			color 0.15s ease,
			transform 0.15s ease;
	}


	.back-link:hover {
		color:
			var(--nug-text-strong);

		transform:
			translateX(-2px);
	}


	.back-link:focus-visible {
		outline:
			2px solid
			var(--nug-green-bright);

		outline-offset:
			4px;
	}


	.eyebrow {
		margin:
			0 0 8px;

		color:
			var(--nug-green-bright);

		font-size:
			0.7rem;

		font-weight:
			900;

		letter-spacing:
			0.16em;
	}


	h1 {
		margin:
			0;

		color:
			var(--nug-text-strong);

		font-size:
			clamp(2rem, 5vw, 3rem);

		font-weight:
			900;

		line-height:
			1.08;

		letter-spacing:
			-0.025em;

		text-shadow:
			0 2px 0 rgba(0, 0, 0, 0.3);
	}


	.description {
		max-width:
			760px;

		margin:
			12px 0 0;

		color:
			var(--nug-muted);

		line-height:
			1.75;
	}


	/* =========================================================
	   05. Shared block surface
	   ========================================================= */

	.status-card,
	.page-info-card,
	.state-card {
		position:
			relative;

		border:
			var(--nug-border-width)
			solid
			var(--nug-border);

		border-radius:
			var(--nug-radius);

		background:
			linear-gradient(
				145deg,
				var(--nug-surface-raised) 0%,
				var(--nug-surface) 100%
			);

		box-shadow:
			var(--nug-shadow-block);

		overflow:
			hidden;
	}


	.status-card::before,
	.page-info-card::before,
	.state-card::before {
		content:
			"";

		position:
			absolute;

		inset:
			0;

		pointer-events:
			none;

		background:
			linear-gradient(
				135deg,
				rgba(255, 247, 214, 0.035),
				transparent 30%
			);
	}


	/* =========================================================
	   06. Status
	   ========================================================= */

	.status-card {
		margin-bottom:
			24px;

		padding:
			20px 24px;
	}


	.status-heading {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			16px;

		margin-bottom:
			20px;
	}


	.status-heading strong {
		display:
			block;

		margin-top:
			2px;

		color:
			var(--nug-text-strong);

		font-size:
			1rem;

		font-weight:
			850;
	}


	.dirty-indicator {
		padding:
			6px 9px;

		border:
			1px solid
			rgba(227, 198, 106, 0.42);

		border-radius:
			var(--nug-radius-small);

		background:
			rgba(227, 198, 106, 0.09);

		color:
			var(--nug-gold);

		font-size:
			0.75rem;

		font-weight:
			850;
	}


	.status-stepper {
		display:
			flex;

		align-items:
			center;

		width:
			100%;

		overflow-x:
			auto;

		padding:
			4px 0 6px;

		scrollbar-width:
			thin;
	}


	.status-step {
		display:
			flex;

		align-items:
			center;

		gap:
			8px;

		flex:
			0 0 auto;

		color:
			var(--nug-muted-dark);

		font-size:
			0.78rem;

		font-weight:
			800;

		white-space:
			nowrap;

		transition:
			color 0.15s ease;
	}


	.status-step.active {
		color:
			var(--nug-green-bright);
	}


	.status-step.completed {
		color:
			var(--nug-text);
	}


	.status-dot {
		color:
			currentColor;

		font-size:
			0.8rem;

		line-height:
			1;
	}


	.status-step.completed .status-dot {
		color:
			var(--nug-green);
	}


	.status-line {
		flex:
			1 1 50px;

		height:
			2px;

		min-width:
			30px;

		margin:
			0 10px;

		background:
			linear-gradient(
				90deg,
				var(--nug-border),
				var(--nug-border-dark)
			);
	}


	/* =========================================================
	   07. Page information
	   ========================================================= */

	.page-info-card {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			24px;

		margin-bottom:
			24px;

		padding:
			20px 24px;
	}


	.page-info-main {
		min-width:
			0;
	}


	.info-label {
		display:
			block;

		margin-bottom:
			6px;

		color:
			var(--nug-muted);

		font-size:
			0.7rem;

		font-weight:
			850;

		letter-spacing:
			0.08em;

		text-transform:
			uppercase;
	}


	.page-info-card h2 {
		margin:
			0;

		color:
			var(--nug-text-strong);

		font-size:
			1.3rem;

		font-weight:
			850;

		line-height:
			1.35;
	}


	.page-info-card code {
		display:
			block;

		margin-top:
			8px;

		overflow-wrap:
			anywhere;

		color:
			var(--nug-green-bright);

		font-family:
			"Consolas",
			"SFMono-Regular",
			monospace;

		font-size:
			0.8rem;
	}


	.revision-info {
		flex:
			0 0 auto;

		min-width:
			140px;

		padding-left:
			24px;

		border-left:
			1px solid
			var(--nug-border);

		text-align:
			right;
	}


	.revision-info strong {
		color:
			var(--nug-text-strong);

		font-size:
			0.9rem;

		font-weight:
			850;
	}


	/* =========================================================
	   08. Content toolbar
	   ========================================================= */

	.content-toolbar {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			16px;

		margin-bottom:
			8px;
	}


	.content-toolbar > div:first-child {
		display:
			flex;

		align-items:
			center;

		gap:
			10px;
	}


	label {
		color:
			var(--nug-text-strong);

		font-size:
			0.9rem;

		font-weight:
			850;
	}


	.content-status {
		display:
			inline-flex;

		align-items:
			center;

		min-height:
			24px;

		padding:
			2px 8px;

		border:
			1px solid
			var(--nug-border);

		border-radius:
			var(--nug-radius-small);

		background:
			var(--nug-surface-dark);

		color:
			var(--nug-muted);

		font-size:
			0.68rem;

		font-weight:
			850;

		letter-spacing:
			0.04em;
	}


	.editor-meta {
		display:
			flex;

		align-items:
			center;

		gap:
			12px;

		color:
			var(--nug-muted);

		font-size:
			0.74rem;

		font-weight:
			700;
	}


	.live-status {
		color:
			var(--nug-green-bright);

		font-weight:
			800;
	}


	/* =========================================================
	   09. Workspace
	   ========================================================= */

	.content-workspace {
		display:
			grid;

		grid-template-columns:
			minmax(0, 1fr)
			minmax(0, 1fr);

		min-height:
			700px;

		border:
			1px solid
			var(--nug-border);

		border-radius:
			var(--nug-radius);

		overflow:
			hidden;

		background:
			#0b0e10;

		box-shadow:
			0 5px 0 #070809,
			0 16px 32px rgba(0, 0, 0, 0.26);
	}


	.editor-pane,
	.preview-pane {
		min-width:
			0;
	}


	.editor-pane {
		border-right:
			1px solid
			var(--nug-border);
	}


	.pane-header {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		min-height:
			44px;

		padding:
			0 14px;

		border-bottom:
			1px solid
			var(--nug-border);

		background:
			linear-gradient(
				180deg,
				#303639,
				#282d30
			);

		color:
			var(--nug-muted);

		font-size:
			0.72rem;

		font-weight:
			800;

		letter-spacing:
			0.02em;
	}


	.pane-header span:last-child {
		color:
			var(--nug-green-bright);
	}


	/* =========================================================
	   10. Markdown editor
	   ========================================================= */

	textarea {
		display:
			block;

		width:
			100%;

		height:
			calc(100% - 44px);

		min-height:
			656px;

		padding:
			20px;

		border:
			0;

		outline:
			none;

		resize:
			none;

		background:
			linear-gradient(
				180deg,
				#0d1113,
				#0a0d0f
			);

		color:
			var(--nug-text);

		font-family:
			"Consolas",
			"SFMono-Regular",
			"Roboto Mono",
			monospace;

		font-size:
			0.88rem;

		line-height:
			1.8;

		tab-size:
			2;

		caret-color:
			var(--nug-green-bright);
	}


	textarea::selection {
		background:
			rgba(105, 201, 107, 0.3);
	}


	textarea:focus {
		box-shadow:
			inset 0 0 0 2px
			var(--nug-green-dark);
	}


	textarea:disabled {
		opacity:
			0.55;

		cursor:
			not-allowed;
	}


	/* =========================================================
	   11. Markdown preview
	   ========================================================= */

	.markdown-preview {
		height:
			calc(100% - 44px);

		min-height:
			656px;

		overflow:
			auto;

		padding:
			28px;

		background:
			linear-gradient(
				180deg,
				#1b2022,
				#14191b
			);

		color:
			var(--nug-text);

		line-height:
			1.8;

		scrollbar-color:
			#4a5255 #161a1c;
	}


	.preview-placeholder {
		margin:
			0;

		color:
			var(--nug-muted);
	}


	.markdown-preview h1,
	.markdown-preview h2,
	.markdown-preview h3,
	.markdown-preview h4,
	.markdown-preview h5,
	.markdown-preview h6 {
		margin-top:
			1.5em;

		margin-bottom:
			0.6em;

		color:
			var(--nug-text-strong);

		line-height:
			1.3;
	}


	.markdown-preview h1 {
		font-size:
			1.8rem;
	}


	.markdown-preview h2 {
		padding-bottom:
			8px;

		border-bottom:
			2px solid
			var(--nug-border);

		font-size:
			1.4rem;
	}


	.markdown-preview h3 {
		font-size:
			1.15rem;
	}


	.markdown-preview h1:first-child,
	.markdown-preview h2:first-child,
	.markdown-preview h3:first-child {
		margin-top:
			0;
	}


	.markdown-preview p {
		margin:
			0 0 1em;
	}


	.markdown-preview a {
		color:
			var(--nug-green-bright);

		text-decoration:
			underline;

		text-decoration-thickness:
			1px;

		text-underline-offset:
			2px;
	}


	.markdown-preview a:hover {
		color:
			#b1efaa;
	}


	.markdown-preview strong {
		color:
			var(--nug-text-strong);
	}


	.markdown-preview blockquote {
		margin:
			1em 0;

		padding:
			12px 16px;

		border-left:
			4px solid
			var(--nug-green);

		background:
			rgba(105, 201, 107, 0.065);

		color:
			var(--nug-muted);
	}


	.markdown-preview ul,
	.markdown-preview ol {
		padding-left:
			1.5rem;
	}


	.markdown-preview li + li {
		margin-top:
			4px;
	}


	.markdown-preview code {
		padding:
			2px 6px;

		border:
			1px solid
			#353b3e;

		border-radius:
			var(--nug-radius-small);

		background:
			#0b0f11;

		color:
			#d9ebd8;

		font-family:
			"Consolas",
			"SFMono-Regular",
			monospace;

		font-size:
			0.88em;
	}


	.markdown-preview pre {
		overflow-x:
			auto;

		margin:
			1em 0;

		padding:
			16px;

		border:
			1px solid
			var(--nug-border);

		border-radius:
			var(--nug-radius);

		background:
			#090c0e;

		box-shadow:
			inset 0 1px 0
			rgba(255, 255, 255, 0.025);
	}


	.markdown-preview pre code {
		padding:
			0;

		border:
			0;

		background:
			transparent;
	}


	.markdown-preview table {
		width:
			100%;

		margin:
			24px 0;

		border-collapse:
			collapse;

		border:
			1px solid
			var(--nug-border);

		font-size:
			0.88rem;
	}


	.markdown-preview th,
	.markdown-preview td {
		padding:
			9px 12px;

		border:
			1px solid
			var(--nug-border);

		text-align:
			left;

		vertical-align:
			top;
	}


	.markdown-preview th {
		background:
			#2a3033;

		color:
			var(--nug-text-strong);

		font-weight:
			850;
	}


	.markdown-preview td {
		background:
			rgba(255, 255, 255, 0.012);
	}


	/* =========================================================
	   Starlight preview components
	   ========================================================= */

	:global(.markdown-preview .starlight-admonition) {
		position: relative;
		margin: 20px 0;
		padding: 0 16px 14px;
		border: 1px solid var(--nug-border);
		border-left: 4px solid var(--nug-sky);
		border-radius: var(--nug-radius-small);
		background: linear-gradient(135deg, rgba(111, 171, 193, 0.12), transparent 48%), #20272b;
		box-shadow: 0 3px 0 #090b0c, inset 0 1px 0 rgba(255, 255, 255, 0.025);
	}

	:global(.markdown-preview .starlight-admonition-title) {
		margin: 0 -16px 12px;
		padding: 10px 14px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		color: var(--nug-text-strong);
		font-weight: 900;
		line-height: 1.4;
	}

	:global(.markdown-preview .starlight-admonition-body > :first-child) {
		margin-top: 0;
	}

	:global(.markdown-preview .starlight-admonition-body > :last-child) {
		margin-bottom: 0;
	}

	:global(.markdown-preview .starlight-admonition-note) {
		border-left-color: var(--nug-sky);
	}

	:global(.markdown-preview .starlight-admonition-tip) {
		border-left-color: var(--nug-green);
		background: linear-gradient(135deg, rgba(105, 201, 107, 0.12), transparent 48%), #202a23;
	}

	:global(.markdown-preview .starlight-admonition-caution) {
		border-left-color: var(--nug-gold);
		background: linear-gradient(135deg, rgba(227, 198, 106, 0.12), transparent 48%), #2b2921;
	}

	:global(.markdown-preview .starlight-admonition-danger) {
		border-left-color: var(--nug-danger);
		background: linear-gradient(135deg, rgba(228, 123, 123, 0.12), transparent 48%), #2c2325;
	}

	:global(.markdown-preview .starlight-card-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
		margin: 20px 0;
	}

	:global(.markdown-preview .starlight-link-card) {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 7px;
		min-width: 0;
		min-height: 116px;
		padding: 16px 42px 16px 16px;
		border: 1px solid var(--nug-border);
		border-radius: var(--nug-radius-small);
		background: linear-gradient(135deg, rgba(255, 247, 214, 0.04), transparent 38%), linear-gradient(180deg, #30373a, #252b2e);
		box-shadow: 0 3px 0 #090b0c, inset 0 1px 0 rgba(255, 255, 255, 0.04);
		color: var(--nug-text);
		text-decoration: none;
		transition: transform 120ms ease, border-color 120ms ease, filter 120ms ease;
	}

	:global(.markdown-preview .starlight-link-card:hover) {
		border-color: var(--nug-gold);
		filter: brightness(1.08);
		transform: translateY(-1px);
	}

	:global(.markdown-preview .starlight-link-card:focus-visible) {
		outline: 2px solid var(--nug-gold);
		outline-offset: 3px;
	}

	:global(.markdown-preview .starlight-link-card-title) {
		color: var(--nug-text-strong);
		font-size: 1rem;
		font-weight: 900;
		line-height: 1.4;
	}

	:global(.markdown-preview .starlight-link-card-description) {
		color: var(--nug-muted);
		font-size: 0.82rem;
		line-height: 1.6;
	}

	:global(.markdown-preview .starlight-link-card-arrow) {
		position: absolute;
		right: 16px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--nug-green-bright);
		font-size: 20px;
		font-weight: 900;
	}


	.preview-error {
		padding:
			16px;

		border:
			1px solid
			rgba(228, 123, 123, 0.45);

		border-left:
			4px solid
			var(--nug-danger);

		border-radius:
			var(--nug-radius);

		background:
			rgba(228, 123, 123, 0.08);

		color:
			var(--nug-danger);
	}


	/* =========================================================
	   12. Mobile tabs
	   ========================================================= */

	.mobile-view-tabs {
		display:
			none;
	}


	/* =========================================================
	   13. Help
	   ========================================================= */

	.field-help {
		margin:
			8px 0 24px;

		color:
			var(--nug-muted);

		font-size:
			0.78rem;

		line-height:
			1.65;
	}


	/* =========================================================
	   14. Form
	   ========================================================= */

	.field-group {
		margin-top:
			28px;

		margin-bottom:
			24px;
	}


	.field-heading {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			16px;

		margin-bottom:
			8px;
	}


	.field-heading span {
		color:
			var(--nug-muted);

		font-size:
			0.72rem;

		font-weight:
			700;
	}


	input[type="text"] {
		display:
			block;

		width:
			100%;

		min-height:
			48px;

		padding:
			12px 14px;

		border:
			1px solid
			var(--nug-border);

		border-radius:
			var(--nug-radius);

		outline:
			none;

		background:
			#121719;

		color:
			var(--nug-text);

		box-shadow:
			inset 0 1px 0
			rgba(255, 255, 255, 0.025);

		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			background 0.15s ease;
	}


	input[type="text"]::placeholder {
		color:
			#69736f;
	}


	input[type="text"]:focus {
		border-color:
			var(--nug-green);

		background:
			#151a1c;

		box-shadow:
			0 0 0 2px
			rgba(105, 201, 107, 0.14);
	}


	input[type="text"]:disabled {
		opacity:
			0.55;

		cursor:
			not-allowed;
	}


	/* =========================================================
	   15. Buttons
	   ========================================================= */

	.header-actions {
		flex:
			0 0 auto;
	}


	.button {
		display:
			inline-flex;

		align-items:
			center;

		justify-content:
			center;

		min-height:
			44px;

		padding:
			10px 18px;

		border:
			1px solid
			transparent;

		border-radius:
			var(--nug-radius);

		cursor:
			pointer;

		font-weight:
			850;

		text-decoration:
			none;

		transition:
			transform 0.12s ease,
			filter 0.12s ease,
			background 0.12s ease,
			border-color 0.12s ease,
			opacity 0.12s ease;
	}


	.button:hover:not(:disabled) {
		transform:
			translateY(-2px);

		filter:
			brightness(1.08);
	}


	.button:active:not(:disabled) {
		transform:
			translateY(2px);
	}


	.button:focus-visible {
		outline:
			2px solid
			var(--nug-green-bright);

		outline-offset:
			3px;
	}


	.button:disabled {
		opacity:
			0.48;

		cursor:
			not-allowed;
	}


	.button-primary {
		border-color:
			#72ca72;

		background:
			linear-gradient(
				180deg,
				#7bd77a 0%,
				#54b657 100%
			);

		color:
			#081008;

		box-shadow:
			0 4px 0
			#326f35;
	}


	.button-primary:hover:not(:disabled) {
		box-shadow:
			0 5px 0
			#326f35;
	}


	.button-primary:active:not(:disabled) {
		box-shadow:
			0 1px 0
			#326f35;
	}


	.button-secondary {
		border-color:
			var(--nug-border);

		background:
			linear-gradient(
				180deg,
				#363d40,
				#2a3033
			);

		color:
			var(--nug-text);

		box-shadow:
			var(--nug-shadow-block-small);
	}


	.button-secondary:hover:not(:disabled) {
		border-color:
			#5b6568;

		background:
			linear-gradient(
				180deg,
				#41494c,
				#303639
			);
	}


	.button-secondary:active:not(:disabled) {
		box-shadow:
			0 1px 0
			#090b0c;
	}


	.button-large {
		min-width:
			150px;

		min-height:
			50px;
	}


	/* =========================================================
	   16. Form actions
	   ========================================================= */

	.form-actions {
		display:
			flex;

		justify-content:
			flex-end;

		gap:
			12px;

		margin-top:
			28px;
	}


	/* =========================================================
	   17. State cards
	   ========================================================= */

	.state-card {
		display:
			flex;

		flex-direction:
			column;

		align-items:
			center;

		justify-content:
			center;

		min-height:
			300px;

		padding:
			40px;

		text-align:
			center;
	}


	.state-card p {
		color:
			var(--nug-muted);
	}


	.state-error {
		border-color:
			rgba(228, 123, 123, 0.45);
	}


	.state-icon {
		display:
			grid;

		width:
			48px;

		height:
			48px;

		place-items:
			center;

		margin-bottom:
			12px;

		border:
			1px solid
			rgba(228, 123, 123, 0.42);

		border-radius:
			var(--nug-radius);

		background:
			rgba(228, 123, 123, 0.12);

		color:
			var(--nug-danger);

		font-weight:
			900;

		box-shadow:
			0 3px 0
			rgba(0, 0, 0, 0.3);
	}


	.state-card h2 {
		margin:
			0;

		color:
			var(--nug-text-strong);
	}


	.state-actions {
		margin-top:
			16px;
	}


	/* =========================================================
	   18. Spinner
	   ========================================================= */

	.spinner {
		width:
			32px;

		height:
			32px;

		margin-bottom:
			16px;

		border:
			3px solid
			var(--nug-border);

		border-top-color:
			var(--nug-green);

		border-radius:
			50%;

		animation:
			spin 0.8s linear infinite;
	}


	@keyframes spin {
		to {
			transform:
				rotate(360deg);
		}
	}


	/* =========================================================
	   19. Action message
	   ========================================================= */

	.action-message {
		margin-top:
			20px;

		padding:
			14px 16px;

		border:
			1px solid
			var(--nug-border);

		border-left:
			4px solid
			var(--nug-border);

		border-radius:
			var(--nug-radius);

		background:
			var(--nug-surface-dark);

		font-size:
			0.9rem;

		line-height:
			1.6;
	}


	.action-message.success {
		border-color:
			rgba(105, 201, 107, 0.38);

		border-left-color:
			var(--nug-green);

		background:
			rgba(105, 201, 107, 0.08);

		color:
			var(--nug-green-bright);
	}


	.action-message.error {
		border-color:
			rgba(228, 123, 123, 0.42);

		border-left-color:
			var(--nug-danger);

		background:
			rgba(228, 123, 123, 0.08);

		color:
			var(--nug-danger);
	}


	.action-message.info {
		border-color:
			rgba(119, 185, 223, 0.4);

		border-left-color:
			var(--nug-info);

		background:
			rgba(119, 185, 223, 0.08);

		color:
			var(--nug-info);
	}


	/* =========================================================
	   20. Scrollbars
	   ========================================================= */

	textarea,
	.markdown-preview,
	.status-stepper {
		scrollbar-width:
			thin;

		scrollbar-color:
			#4a5255 #15191b;
	}


	textarea::-webkit-scrollbar,
	.markdown-preview::-webkit-scrollbar,
	.status-stepper::-webkit-scrollbar {
		width:
			10px;

		height:
			10px;
	}


	textarea::-webkit-scrollbar-track,
	.markdown-preview::-webkit-scrollbar-track,
	.status-stepper::-webkit-scrollbar-track {
		background:
			#15191b;
	}


	textarea::-webkit-scrollbar-thumb,
	.markdown-preview::-webkit-scrollbar-thumb,
	.status-stepper::-webkit-scrollbar-thumb {
		background:
			#4a5255;

		border:
			2px solid
			#15191b;
	}


	textarea::-webkit-scrollbar-thumb:hover,
	.markdown-preview::-webkit-scrollbar-thumb:hover,
	.status-stepper::-webkit-scrollbar-thumb:hover {
		background:
			#606a6d;
	}


	/* =========================================================
	   21. Responsive — Tablet
	   ========================================================= */

	@media (max-width: 900px) {

		.content-workspace {
			grid-template-columns:
				1fr;
		}


		.editor-pane {
			border-right:
				0;

			border-bottom:
				1px solid
				var(--nug-border);
		}


		.editor-pane,
		.preview-pane {
			min-height:
				500px;
		}


		textarea,
		.markdown-preview {
			min-height:
				458px;
		}


		.editor-header {
			align-items:
				stretch;
		}
	}


	/* =========================================================
	   22. Responsive — Mobile
	   ========================================================= */

	@media (max-width: 700px) {
		:global(.markdown-preview .starlight-card-grid) {
			grid-template-columns: minmax(0, 1fr);
		}

		.editor-page {
			padding:
				20px 12px 56px;
		}


		.editor-header {
			align-items:
				stretch;

			flex-direction:
				column;

			gap:
				20px;

			margin-bottom:
				24px;

			padding:
				20px 16px;
		}


		.header-actions {
			display:
				flex;

			width:
				100%;
		}


		.back-link {
			margin-bottom:
				16px;
		}


		h1 {
			font-size:
				clamp(1.8rem, 9vw, 2.35rem);
		}


		.description {
			font-size:
				0.86rem;

			line-height:
				1.7;
		}


		.status-card {
			padding:
				16px;
		}


		.status-heading {
			align-items:
				flex-start;

			flex-direction:
				column;

			gap:
				8px;
		}


		.status-stepper {
			display:
				block;

			overflow:
				visible;
		}


		.status-step {
			min-height:
				30px;
		}


		.status-line {
			width:
				2px;

			height:
				20px;

			min-width:
				2px;

			margin:
				2px 0 2px 7px;

			background:
				var(--nug-border);
		}


		.page-info-card {
			align-items:
				stretch;

			flex-direction:
				column;

			padding:
				18px;
		}


		.revision-info {
			padding-top:
				16px;

			padding-left:
				0;

			border-top:
				1px solid
				var(--nug-border);

			border-left:
				0;

			text-align:
				left;
		}


		.content-toolbar {
			align-items:
				flex-start;

			flex-direction:
				column;

			gap:
				8px;
		}


		.editor-meta {
			width:
				100%;

			justify-content:
				space-between;
		}


		.mobile-view-tabs {
			display:
				grid;

			grid-template-columns:
				1fr 1fr;

			margin-bottom:
				8px;

			border:
				1px solid
				var(--nug-border);

			border-radius:
				var(--nug-radius);

			overflow:
				hidden;

			box-shadow:
				0 3px 0
				#090b0c;
		}


		.mobile-view-tab {
			min-height:
				44px;

			border:
				0;

			background:
				#252b2e;

			color:
				var(--nug-muted);

			cursor:
				pointer;

			font-weight:
				850;

			transition:
				background 0.12s ease,
				color 0.12s ease,
				transform 0.12s ease;
		}


		.mobile-view-tab
		+ .mobile-view-tab {
			border-left:
				1px solid
				var(--nug-border);
		}


		.mobile-view-tab:hover {
			background:
				#30373a;

			color:
				var(--nug-text);
		}


		.mobile-view-tab:active {
			transform:
				translateY(1px);
		}


		.mobile-view-tab:focus-visible {
			outline:
				2px solid
				var(--nug-green-bright);

			outline-offset:
				-3px;
		}


		.mobile-view-tab.active {
			background:
				var(--nug-green);

			color:
				#081008;
		}


		.content-workspace {
			display:
				block;

			min-height:
				0;

			box-shadow:
				0 4px 0
				#070809;
		}


		.editor-pane,
		.preview-pane {
			display:
				none;

			border:
				0;

			min-height:
				0;
		}


		.editor-pane.mobile-active,
		.preview-pane.mobile-active {
			display:
				block;
		}


		textarea,
		.markdown-preview {
			height:
				500px;

			min-height:
				500px;
		}


		textarea {
			padding:
				16px;

			font-size:
				0.84rem;
		}


		.markdown-preview {
			padding:
				20px;
		}


		.form-actions {
			flex-direction:
				column;

			gap:
				10px;
		}


		.button-large {
			width:
				100%;
		}

		.header-actions .button {
			width:
				100%;
		}
	}


	/* =========================================================
	   23. Responsive — Small phones
	   ========================================================= */

	@media (max-width: 420px) {

		.editor-page {
			padding:
				12px 8px 48px;
		}


		.editor-header {
			padding:
				16px 14px;
		}


		.status-card,
		.page-info-card {
			border-radius:
				2px;
		}


		.status-card {
			padding:
				14px;
		}


		.page-info-card {
			padding:
				16px;
		}


		.content-status {
			font-size:
				0.64rem;
		}


		.editor-meta {
			font-size:
				0.7rem;
		}


		.markdown-preview {
			padding:
				16px;
		}
	}


	/* =========================================================
	   24. Accessibility
	   ========================================================= */
		
			@media (prefers-reduced-motion: reduce) {

				*,
				*::before,
				*::after {
					scroll-behavior:
						auto !important;

					animation-duration:
						0.01ms !important;

					animation-iteration-count:
						1 !important;

					transition-duration:
						0.01ms !important;
				}
			}
		</style>
	</body>
</html>