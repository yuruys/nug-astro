---
import WikiAdminHeader from '../../../components/WikiAdminHeader.astro';

const pagePath = Astro.url.searchParams.get('path') ?? '';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>
		<title>Wiki編集 | NUGBASE</title>
		<meta
			name="description"
			content="NUGBASE Wikiの編集画面"
		/>
	</head>

	<body>
		<WikiAdminHeader active="editor" />

		<main class="editor-page">
			<div class="editor-shell">

				<!-- ========================================
				     Header
				======================================== -->

				<header class="editor-header">
					<div>
						<a href="/docs/" class="back-link">
							← Wikiへ戻る
						</a>

						<p class="eyebrow">
							NUGBASE WIKI
						</p>

						<h1>Wiki編集</h1>

						<p class="description">
							Wikiページの内容を編集し、プレビューを確認してから下書き保存・レビュー申請できます。
						</p>
					</div>

					<div class="header-actions">
						<a
							id="preview-link"
							class="button button-secondary"
							href="/docs/"
							target="_blank"
							rel="noopener noreferrer"
						>
							公開ページを見る
						</a>
					</div>
				</header>


				<!-- ========================================
				     Loading
				======================================== -->

				<section
					id="loading-state"
					class="state-card"
					aria-live="polite"
				>
					<div class="spinner"></div>

					<p>
						Wikiページを読み込んでいます…
					</p>
				</section>


				<!-- ========================================
				     Error
				======================================== -->

				<section
					id="error-state"
					class="state-card state-error"
					hidden
					aria-live="assertive"
				>
					<div class="state-icon">
						!
					</div>

					<h2>
						読み込みに失敗しました
					</h2>

					<p id="error-message">
						Wikiページを読み込めませんでした。
					</p>

					<div class="state-actions">
						<a
							href="/docs/"
							class="button button-secondary"
						>
							Wikiへ戻る
						</a>
					</div>
				</section>


				<!-- ========================================
				     Editor
				======================================== -->

				<section
					id="editor-state"
					hidden
				>

					<!-- ====================================
					     Status
					==================================== -->

					<section
						class="status-card"
						aria-label="編集ステータス"
					>
						<div class="status-heading">
							<div>
								<span class="info-label">
									編集ステータス
								</span>

								<strong id="status-text">
									編集前
								</strong>
							</div>

							<span
								id="dirty-indicator"
								class="dirty-indicator"
								hidden
							>
								● 未保存の変更
							</span>
						</div>

						<div class="status-stepper">

							<div
								class="status-step active"
								data-status-step="draft"
							>
								<span class="status-dot">
									●
								</span>

								<span>
									編集・下書き
								</span>
							</div>

							<div class="status-line"></div>

							<div
								class="status-step"
								data-status-step="pending"
							>
								<span class="status-dot">
									○
								</span>

								<span>
									申請中
								</span>
							</div>

							<div class="status-line"></div>

							<div
								class="status-step"
								data-status-step="approved"
							>
								<span class="status-dot">
									○
								</span>

								<span>
									承認
								</span>
							</div>

							<div class="status-line"></div>

							<div
								class="status-step"
								data-status-step="published"
							>
								<span class="status-dot">
									○
								</span>

								<span>
									公開
								</span>
							</div>

						</div>
					</section>


					<!-- ====================================
					     Page information
					==================================== -->

					<div class="page-info-card">
						<div class="page-info-main">

							<span class="info-label">
								編集対象
							</span>

							<h2 id="page-title">
								Wikiページ
							</h2>

							<code id="page-path"></code>

						</div>

						<div class="revision-info">

							<span class="info-label">
								公開Revision
							</span>

							<strong id="revision-number">
								-
							</strong>

						</div>
					</div>


					<!-- ====================================
					     Editor form
					==================================== -->

					<form id="editor-form">

						<!-- ==================================
						     Content heading
						================================== -->

						<div class="content-toolbar">

							<div>
								<label for="content">
									本文
								</label>

								<span
									id="content-status"
									class="content-status"
								>
									MDX
								</span>
							</div>

							<div class="editor-meta">
								<span id="character-count">
									0文字
								</span>

								<span
									id="live-status"
									class="live-status"
								>
									プレビュー
								</span>
							</div>

						</div>


						<!-- ==================================
						     Mobile tabs
						================================== -->

						<div
							class="mobile-view-tabs"
							role="tablist"
							aria-label="編集画面表示"
						>
							<button
								type="button"
								class="mobile-view-tab active"
								id="edit-tab"
								role="tab"
								aria-selected="true"
								aria-controls="edit-pane"
								data-view="edit"
							>
								編集
							</button>

							<button
								type="button"
								class="mobile-view-tab"
								id="preview-tab"
								role="tab"
								aria-selected="false"
								aria-controls="preview-pane"
								data-view="preview"
							>
								プレビュー
							</button>
						</div>


						<!-- ==================================
						     Editor / Preview
						================================== -->

						<div
							id="content-workspace"
							class="content-workspace"
						>

							<!-- Markdown -->

							<div
								id="edit-pane"
								class="editor-pane"
								data-pane="edit"
								role="tabpanel"
								aria-labelledby="edit-tab"
							>
								<div class="pane-header">
									<span>
										Markdown / MDX
									</span>

									<span>
										編集
									</span>
								</div>

								<textarea
									id="content"
									name="content"
									spellcheck="false"
									autocomplete="off"
									aria-label="Wiki本文"
									placeholder="Wiki本文を入力してください"
								></textarea>
							</div>


							<!-- Preview -->

							<div
								id="preview-pane"
								class="preview-pane"
								data-pane="preview"
								role="tabpanel"
								aria-labelledby="preview-tab"
							>
								<div class="pane-header">
									<span>
										プレビュー
									</span>

									<span id="preview-state">
										リアルタイム
									</span>
								</div>

								<article
									id="markdown-preview"
									class="markdown-preview"
									aria-label="Markdownプレビュー"
								>
									<p class="preview-placeholder">
										本文を入力するとここにプレビューが表示されます。
									</p>
								</article>
							</div>

						</div>


						<p class="field-help">
							Markdown / MDX形式で編集します。プレビューでは基本的なMarkdown記法を確認できます。
							Starlight固有の記法は公開ページで最終確認してください。
						</p>


						<!-- ==================================
						     Edit message
						================================== -->

						<div class="field-group">

							<div class="field-heading">

								<label for="message">
									編集メッセージ
								</label>

								<span>
									任意
								</span>

							</div>

							<input
								id="message"
								name="message"
								type="text"
								maxlength="500"
								placeholder="例：Landsのコマンド一覧を更新しました"
							/>

							<p class="field-help">
								レビュー担当者に伝えたい変更内容を入力できます。
							</p>

						</div>


						<!-- ==================================
						     Action message
						================================== -->

						<div
							id="action-message"
							class="action-message"
							hidden
							role="status"
							aria-live="polite"
						></div>


						<!-- ==================================
						     Buttons
						================================== -->

						<div class="form-actions">

							<button
								type="button"
								id="save-draft"
								class="button button-secondary button-large"
							>
								<span class="button-label">
									下書き保存
								</span>

								<span
									class="button-loading"
									hidden
								>
									保存中…
								</span>
							</button>


							<button
								type="button"
								id="submit-review"
								class="button button-primary button-large"
							>
								<span class="button-label">
									レビュー申請
								</span>

								<span
									class="button-loading"
									hidden
								>
									申請中…
								</span>
							</button>

						</div>

					</form>
				</section>

			</div>
		</main>


		<!-- ========================================
		     JavaScript
		======================================== -->

		<script>
			import { marked } from 'marked';
			import DOMPurify from 'dompurify';


			/* ========================================
			   Types
			======================================== */

			type EditRequestStatus =
				| 'draft'
				| 'pending'
				| 'approved'
				| 'rejected'
				| 'publishing'
				| 'published';

			interface WikiPage {
				title?: string;
				path?: string;
				revision_number?: number | null;
				content?: string | null;
			}

			interface WikiPageResponse {
				ok: boolean;
				error?: string;
				page?: WikiPage;
			}

			interface EditRequest {
				id: string;
				status: EditRequestStatus;
			}

			interface EditRequestResponse {
				ok: boolean;
				error?: string;
				changed?: boolean;
				editRequest?: EditRequest;
			}

			interface EditRequestDetailResponse {
				ok: boolean;
				error?: string;
				editRequest?: {
					id: string;
					status: EditRequestStatus;
					message?: string | null;
					page_path: string;
				};
				revision?: {
					content: string;
				};
			}


			/* ========================================
			   URL
			======================================== */

			const pagePath =
				new URLSearchParams(
					window.location.search
				).get('path') || '';

			let draftRequestId =
				new URLSearchParams(
					window.location.search
				).get('request');


			/* ========================================
			   DOM
			======================================== */

			const loadingState =
				document.querySelector<HTMLElement>(
					'#loading-state'
				)!;

			const errorState =
				document.querySelector<HTMLElement>(
					'#error-state'
				)!;

			const editorState =
				document.querySelector<HTMLElement>(
					'#editor-state'
				)!;

			const errorMessage =
				document.querySelector<HTMLElement>(
					'#error-message'
				)!;

			const pageTitle =
				document.querySelector<HTMLElement>(
					'#page-title'
				)!;

			const pagePathElement =
				document.querySelector<HTMLElement>(
					'#page-path'
				)!;

			const revisionNumber =
				document.querySelector<HTMLElement>(
					'#revision-number'
				)!;

			const content =
				document.querySelector<HTMLTextAreaElement>(
					'#content'
				)!;

			const message =
				document.querySelector<HTMLInputElement>(
					'#message'
				)!;

			const previewLink =
				document.querySelector<HTMLAnchorElement>(
					'#preview-link'
				)!;

			const saveDraftButton =
				document.querySelector<HTMLButtonElement>(
					'#save-draft'
				)!;

			const submitReviewButton =
				document.querySelector<HTMLButtonElement>(
					'#submit-review'
				)!;

			const actionMessage =
				document.querySelector<HTMLElement>(
					'#action-message'
				)!;

			const liveStatus =
				document.querySelector<HTMLElement>(
					'#live-status'
				)!;
			const markdownPreview =
				document.querySelector<HTMLElement>(
					'#markdown-preview'
				)!;

			const characterCount =
				document.querySelector<HTMLElement>(
					'#character-count'
				)!;

			const dirtyIndicator =
				document.querySelector<HTMLElement>(
					'#dirty-indicator'
				)!;

			const statusText =
				document.querySelector<HTMLElement>(
					'#status-text'
				)!;

			const previewState =
				document.querySelector<HTMLElement>(
					'#preview-state'
				)!;


			/* ========================================
			   State
			======================================== */

			let editRequestId: string | null = null;

			let currentStatus:
				EditRequestStatus | null = null;

			let originalContent = '';

			let originalMessage = '';

			let isSaving = false;


			/* ========================================
			   Status labels
			======================================== */

			const statusLabels:
				Record<EditRequestStatus, string> = {
					draft:
						'下書き',

					pending:
						'申請中',

					approved:
						'承認済み',

					publishing:
						'公開処理中',

					published:
						'公開済み',

					rejected:
						'却下',
				};


			/* ========================================
			   State display
			======================================== */

			function showError(
				text: string
			): void {
				loadingState.hidden = true;
				editorState.hidden = true;
				errorState.hidden = false;

				errorMessage.textContent = text;
			}


			function showEditor(): void {
				loadingState.hidden = true;
				errorState.hidden = true;
				editorState.hidden = false;
			}


			/* ========================================
			   Action message
			======================================== */

			function setActionMessage(
				text: string,
				type:
					| 'success'
					| 'error'
					| 'info' = 'success'
			): void {
				actionMessage.textContent = text;

				actionMessage.className =
					`action-message ${type}`;

				actionMessage.hidden = false;
			}


			function clearActionMessage(): void {
				actionMessage.hidden = true;
				actionMessage.textContent = '';
				actionMessage.className =
					'action-message';
			}


			/* ========================================
			   Button loading
			======================================== */

			function setButtonLoading(
				button: HTMLButtonElement,
				loading: boolean
			): void {
				const label =
					button.querySelector<HTMLElement>(
						'.button-label'
					);

				const loadingLabel =
					button.querySelector<HTMLElement>(
						'.button-loading'
					);

				button.disabled = loading;

				if (label) {
					label.hidden = loading;
				}

				if (loadingLabel) {
					loadingLabel.hidden = !loading;
				}
			}


			/* ========================================
			   Form disabled
			======================================== */

			function setFormDisabled(
				disabled: boolean
			): void {
				content.disabled = disabled;
				message.disabled = disabled;

				saveDraftButton.disabled =
					disabled;

				submitReviewButton.disabled =
					disabled;
			}


			/* ========================================
			   Dirty state
			======================================== */

			function updateDirtyState(): void {
				const dirty =
					content.value !== originalContent ||
					message.value !== originalMessage;

				dirtyIndicator.hidden = !dirty;

				if (dirty) {
					liveStatus.textContent =
						'未保存';
				} else {
					liveStatus.textContent =
						'プレビュー';
				}
			}


			/* ========================================
			   Status stepper
			======================================== */

			function updateStatus(
				status: EditRequestStatus | null
			): void {

				const normalized =
					status ?? 'draft';

				currentStatus =
					status;


				statusText.textContent =
					statusLabels[normalized];


				const order:
					EditRequestStatus[] = [
						'draft',
						'pending',
						'approved',
						'published',
					];


				const statusIndex =
					normalized === 'rejected'
						? 0
						: normalized === 'publishing'
							? 2
							: order.indexOf(
								normalized
							);


				document
					.querySelectorAll<HTMLElement>(
						'[data-status-step]'
					)
					.forEach((step) => {

						const stepStatus =
							step.dataset.statusStep as
								EditRequestStatus;

						const stepIndex =
							order.indexOf(
								stepStatus
							);


						step.classList.toggle(
							'completed',
							stepIndex <
								statusIndex
						);


						step.classList.toggle(
							'active',
							stepIndex ===
								statusIndex
						);


						const dot =
							step.querySelector<HTMLElement>(
								'.status-dot'
							);


						if (!dot) {
							return;
						}


						if (
							stepIndex <
							statusIndex
						) {
							dot.textContent = '✓';

						} else if (
							stepIndex ===
							statusIndex
						) {
							dot.textContent = '●';

						} else {
							dot.textContent = '○';
						}
					});


				if (
					normalized ===
					'rejected'
				) {
					statusText.textContent =
						'却下';
				}
			}


			/* ========================================
			   Starlight preview preparation
			======================================== */

			function escapeHtml(value: unknown): string {
				return String(value ?? '')
					.replaceAll('&', '&amp;')
					.replaceAll('<', '&lt;')
					.replaceAll('>', '&gt;')
					.replaceAll('"', '&quot;')
					.replaceAll("'", '&#39;');
			}


			function sanitizePreviewHref(value: unknown): string {
				const href = String(value ?? '').trim();

				if (!href) return '#';
				if (href.startsWith('/')) return href;
				if (href.startsWith('#')) return href;

				try {
					const url = new URL(href, window.location.origin);
					if (url.protocol === 'http:' || url.protocol === 'https:') {
						return url.href;
					}
				} catch {
					return '#';
				}

				return '#';
			}


			function renderStarlightLinkCard(attributes: string): string {
				const titleMatch = attributes.match(/title\s*=\s*["']([^"']*)["']/i);
				const hrefMatch = attributes.match(/href\s*=\s*["']([^"']*)["']/i);
				const descriptionMatch = attributes.match(/description\s*=\s*["']([^"']*)["']/i);

				const title = titleMatch?.[1]?.trim() || 'リンク';
				const href = sanitizePreviewHref(hrefMatch?.[1] || '#');
				const description = descriptionMatch?.[1]?.trim() || '';

				return `
<a class="starlight-link-card" href="${escapeHtml(href)}">
	<span class="starlight-link-card-title">${escapeHtml(title)}</span>
	${description ? `<span class="starlight-link-card-description">${escapeHtml(description)}</span>` : ''}
	<span class="starlight-link-card-arrow" aria-hidden="true">→</span>
</a>`;
			}


			function transformStarlightLinkCards(source: string): string {
				return source.replace(
					/<CardGrid\s*>\s*([\s\S]*?)\s*<\/CardGrid>/gi,
					(_match, body: string) => {
						const cards: string[] = [];
						const cardPattern = /<LinkCard\s+([\s\S]*?)\/\s*>/gi;
						let match: RegExpExecArray | null;

						while ((match = cardPattern.exec(body)) !== null) {
							cards.push(renderStarlightLinkCard(match[1]));
						}

						if (!cards.length) return '';
						return `\n<div class="starlight-card-grid">${cards.join('')}</div>\n`;
					}
				);
			}


			async function transformStarlightAdmonitions(source: string): Promise<string> {
				const pattern = /^\s*:::(note|tip|caution|danger)(?:\[([^\]]*)\])?\s*\n([\s\S]*?)^\s*:::\s*$/gim;
				const matches = [...source.matchAll(pattern)];
				const defaultTitles: Record<string, string> = {
					note: '注記',
					tip: 'ヒント',
					caution: '注意',
					danger: '警告',
				};

				for (const match of matches.reverse()) {
					const [fullMatch, type, label, body] = match;
					const start = match.index;

					if (start === undefined) {
						continue;
					}

					const title = label?.trim() || defaultTitles[type] || type;
					const renderedBody = await marked.parse(
						body.trim(),
						{
							gfm: true,
							breaks: false,
						}
					);

					const replacement = `
<div class="starlight-admonition starlight-admonition-${type}" data-admonition="${type}">
<div class="starlight-admonition-title">${escapeHtml(title)}</div>
<div class="starlight-admonition-body">
${renderedBody}
</div>
</div>
`;

					source =
						source.slice(0, start) +
						replacement +
						source.slice(start + fullMatch.length);
				}

				return source;
			}


			async function prepareStarlightPreview(source: string): Promise<string> {
				let prepared = String(source ?? '');

				prepared = prepared.replace(
					/^\uFEFF?---[ \t]*\r?\n[\s\S]*?\r?\n---[ \t]*(?:\r?\n|$)/,
					''
				);

				// MDXのimportはプレビューでは実行せず、表示対象から除外します。
				prepared = prepared.replace(
					/^\s*import\s+[\s\S]*?from\s+["'][^"']+["']\s*;?\s*$/gim,
					''
				);

				prepared = transformStarlightLinkCards(prepared);
				prepared = await transformStarlightAdmonitions(prepared);

				return prepared;
			}


			/* ========================================
			   Markdown preview
			======================================== */

			async function updateMarkdownPreview():
				Promise<void> {

				const source =
					content.value;


				if (!source.trim()) {
					markdownPreview.innerHTML = `
						<p class="preview-placeholder">
							本文を入力するとここにプレビューが表示されます。
						</p>
					`;

					previewState.textContent =
						'リアルタイム';

					return;
				}


				try {
					const previewSource =
						await prepareStarlightPreview(source);

					const html =
						await marked.parse(
							previewSource,
							{
								gfm: true,
								breaks: false,
							}
						);


					markdownPreview.innerHTML =
						DOMPurify.sanitize(
							html
						);


					previewState.textContent =
						'リアルタイム';

				} catch (error) {

					console.error(
						'Markdown preview error:',
						error
					);


					markdownPreview.innerHTML = `
						<div class="preview-error">
							<p>
								プレビューを生成できませんでした。
							</p>
						</div>
					`;

					previewState.textContent =
						'エラー';
				}
			}


			/* ========================================
			   Character count
			======================================== */

			function updateCharacterCount(): void {
				characterCount.textContent =
					`${content.value.length.toLocaleString()}文字`;
			}


			/* ========================================
			   Preview link
			======================================== */

			function updatePreviewLink(
				path: string
			): void {
				if (!path) {
					return;
				}

				previewLink.href = path;
			}


			/* ========================================
			   Mobile view
			======================================== */

			function setMobileView(
				view: 'edit' | 'preview'
			): void {

				const editPane =
					document.querySelector<HTMLElement>(
						'[data-pane="edit"]'
					)!;

				const previewPane =
					document.querySelector<HTMLElement>(
						'[data-pane="preview"]'
					)!;

				const editTab =
					document.querySelector<HTMLButtonElement>(
						'#edit-tab'
					)!;

				const previewTab =
					document.querySelector<HTMLButtonElement>(
						'#preview-tab'
					)!;


				const isEdit =
					view === 'edit';


				editPane.classList.toggle(
					'mobile-active',
					isEdit
				);

				previewPane.classList.toggle(
					'mobile-active',
					!isEdit
				);


				editTab.classList.toggle(
					'active',
					isEdit
				);

				previewTab.classList.toggle(
					'active',
					!isEdit
				);


				editTab.setAttribute(
					'aria-selected',
					String(isEdit)
				);

				previewTab.setAttribute(
					'aria-selected',
					String(!isEdit)
				);
			}


			/* ========================================
			   Load published Wiki page
			======================================== */

			async function loadPage(): Promise<void> {
				if (!pagePath) {
					showError(
						'編集するWikiページのpathが指定されていません。'
					);

					return;
				}

				try {
					const response =
						await fetch(
							`/api/wiki/pages?path=${encodeURIComponent(
								pagePath
							)}`,
							{
								credentials:
									'same-origin',
							}
						);

					const data =
						await response.json() as
							WikiPageResponse;

					if (
						!response.ok ||
						!data.ok ||
						!data.page
					) {
						throw new Error(
							data.error ||
								'Wikiページを取得できませんでした。'
						);
					}

					const page =
						data.page;


					/* Page title */

					pageTitle.textContent =
						page.title ||
						'Wikiページ';


					/* Page path */

					pagePathElement.textContent =
						page.path ||
						pagePath;


					/* Revision */

					revisionNumber.textContent =
						page.revision_number
							? `Revision ${page.revision_number}`
							: '未公開';


					/* Content */

					content.value =
						typeof page.content === 'string'
							? page.content
							: '';


					/*
					 * requestがURLに指定されている場合は、
					 * その下書きを読み込む。
					 */
					if (draftRequestId) {
						const draftResponse = await fetch(
							`/api/wiki/edit-requests/${encodeURIComponent(draftRequestId)}`,
							{
								credentials: 'same-origin',
							}
						);

						const draftData = await draftResponse.json() as EditRequestDetailResponse;

						if (
							!draftResponse.ok ||
							!draftData.ok ||
							!draftData.editRequest ||
							!draftData.revision
						) {
							throw new Error(
								draftData.error || '下書きを取得できませんでした。'
							);
						}

						if (draftData.editRequest.status !== 'draft') {
							throw new Error('この編集リクエストは下書き状態ではありません。');
						}

						if (draftData.editRequest.page_path !== pagePath) {
							throw new Error('下書きの対象Wikiページが一致しません。');
						}

						editRequestId = draftData.editRequest.id;
						currentStatus = 'draft';
						content.value = draftData.revision.content;
						message.value = draftData.editRequest.message ?? '';

					/*
					 * requestがURLにない場合は、
					 * 現在のログインユーザー自身がこのWikiページに
					 * 保存しているdraftを探す。
					 */
					} else {
						const draftListResponse = await fetch(
							`/api/wiki/edit-requests?status=draft&pagePath=${encodeURIComponent(pagePath)}`,
							{
								credentials: 'same-origin',
							}
						);

						const draftListData = await draftListResponse.json() as {
							ok: boolean;
						error?: string;
						editRequests?: Array<{
							id: string;
							status: EditRequestStatus;
							page_path: string;
						}>;
					};

						if (!draftListResponse.ok || !draftListData.ok) {
							throw new Error(
								draftListData.error || '保存済みの下書きを確認できませんでした。'
							);
						}

						const existingDraft = draftListData.editRequests?.[0];

						if (existingDraft) {
							const existingDraftResponse = await fetch(
								`/api/wiki/edit-requests/${encodeURIComponent(existingDraft.id)}`,
								{
									credentials: 'same-origin',
								}
							);

							const existingDraftData =
								await existingDraftResponse.json() as EditRequestDetailResponse;

							if (
								!existingDraftResponse.ok ||
								!existingDraftData.ok ||
								!existingDraftData.editRequest ||
								!existingDraftData.revision
							) {
								throw new Error(
									existingDraftData.error ||
									'保存済みの下書きを取得できませんでした。'
								);
							}

							if (existingDraftData.editRequest.status !== 'draft') {
								throw new Error(
									'保存済みの編集リクエストは下書き状態ではありません。'
								);
							}

							if (existingDraftData.editRequest.page_path !== pagePath) {
								throw new Error(
									'保存済みの下書きの対象Wikiページが一致しません。'
								);
							}

							draftRequestId = existingDraftData.editRequest.id;
							editRequestId = existingDraftData.editRequest.id;
							currentStatus = 'draft';
							content.value = existingDraftData.revision.content;
							message.value = existingDraftData.editRequest.message ?? '';

							const editUrl = new URL(window.location.href);
							editUrl.searchParams.set('request', existingDraftData.editRequest.id);

							window.history.replaceState(
								null,
								'',
								`${editUrl.pathname}${editUrl.search}${editUrl.hash}`
							);
						}
					}

					originalContent =
						content.value;


					originalMessage =
						message.value;


					/* Preview */

					updatePreviewLink(
						page.path ||
						pagePath
					);


					/* UI */

					updateCharacterCount();

					updateDirtyState();

					await updateMarkdownPreview();

					updateStatus(currentStatus);


					/* Show editor */

					showEditor();

				} catch (error) {

					console.error(
						'Wiki editor page load error:',
						error
					);

					showError(
						error instanceof Error
							? error.message
							: 'Wikiページを読み込めませんでした。'
					);
				}
			}


			/* ========================================
			   Create draft
			======================================== */

			async function createDraft():
				Promise<EditRequestResponse> {

				const response =
					await fetch(
						'/api/wiki/edit-requests',
						{
							method: 'POST',

							headers: {
								'Content-Type':
									'application/json',
							},

							credentials:
								'same-origin',

							body:
								JSON.stringify({
									pagePath,

									content:
										content.value,

									message:
										message.value.trim() ||
										null,
								}),
						}
					);


				const data =
					await response.json() as
						EditRequestResponse;


				if (
					!response.ok ||
					!data.ok ||
					!data.editRequest
				) {
					throw new Error(
						data.error ||
							'下書きの保存に失敗しました。'
					);
				}


				const requestId =
					data.editRequest.id;

				editRequestId =
					requestId;

				const editUrl =
					new URL(window.location.href);

				editUrl.searchParams.set(
					'request',
					requestId
				);

				window.history.replaceState(
					null,
					'',
					`${editUrl.pathname}${editUrl.search}${editUrl.hash}`
				);

				currentStatus =
					data.editRequest.status;


				updateStatus(
					currentStatus
				);


				originalContent =
					content.value;

				originalMessage =
					message.value;


				updateDirtyState();


				return data;
			}


			/* ========================================
			   Update draft
			======================================== */

			async function updateDraft():
				Promise<EditRequestResponse> {

				if (!editRequestId) {
					return createDraft();
				}


				const response =
					await fetch(
						`/api/wiki/edit-requests/${encodeURIComponent(
							editRequestId
						)}`,
						{
							method: 'PUT',

							headers: {
								'Content-Type':
									'application/json',
							},

							credentials:
								'same-origin',

							body:
								JSON.stringify({
									content:
										content.value,

									message:
										message.value.trim() ||
										null,
								}),
						}
					);


				const data =
					await response.json() as
						EditRequestResponse;


				if (
					!response.ok ||
					!data.ok
				) {
					throw new Error(
						data.error ||
							'下書きの更新に失敗しました。'
					);
				}


				currentStatus =
					data.editRequest?.status ??
					currentStatus;


				originalContent =
					content.value;

				originalMessage =
					message.value;


				updateStatus(
					currentStatus
				);

				updateDirtyState();


				return data;
			}


			/* ========================================
			   Save draft
			======================================== */

			async function saveDraft():
				Promise<void> {

				if (isSaving) {
					return;
				}


				clearActionMessage();


				isSaving = true;


				setButtonLoading(
					saveDraftButton,
					true
				);


				setFormDisabled(true);


				try {

					if (
						currentStatus &&
						currentStatus !== 'draft'
					) {
						throw new Error(
							`この編集リクエストは現在「${currentStatus}」のため更新できません。`
						);
					}


					const data =
						await updateDraft();


					if (
						data.changed === false
					) {

						setActionMessage(
							'変更はありません。現在の下書きが保存されています。',
							'info'
						);

					} else {

						setActionMessage(
							'下書きを保存しました。',
							'success'
						);
					}

				} catch (error) {

					console.error(
						'Save draft error:',
						error
					);


					setActionMessage(
						error instanceof Error
							? error.message
							: '下書きの保存に失敗しました。',
						'error'
					);

				} finally {

					setButtonLoading(
						saveDraftButton,
						false
					);


					setFormDisabled(false);

					isSaving = false;
				}
			}


			/* ========================================
			   Submit review
			======================================== */

			async function submitReview():
				Promise<void> {

				clearActionMessage();


				const confirmed =
					window.confirm(
						'現在の内容をレビュー申請します。\n\n申請後はこの下書きを編集できなくなります。\n\nレビュー申請しますか？'
					);


				if (!confirmed) {
					return;
				}


				isSaving = true;


				setButtonLoading(
					submitReviewButton,
					true
				);


				setFormDisabled(true);


				try {

					/*
					 * Draftがまだ存在しない場合
					 */

					if (!editRequestId) {

						await createDraft();

					} else if (
						currentStatus !== 'draft'
					) {

						throw new Error(
							`この編集リクエストは現在「${currentStatus}」のため申請できません。`
						);

					} else {

						/*
						 * 最新内容を保存
						 */

						await updateDraft();
					}


					/*
					 * editRequestId が存在することを
					 * TypeScriptにも明示
					 */

					if (!editRequestId) {
						throw new Error(
							'編集リクエストIDを取得できませんでした。'
						);
					}


					/* Submit */

					const response =
						await fetch(
							`/api/wiki/edit-requests/${encodeURIComponent(
								editRequestId
							)}/submit`,
							{
								method: 'POST',

								credentials:
									'same-origin',
							}
						);


					const data =
						await response.json() as
							EditRequestResponse;


					if (
						!response.ok ||
						!data.ok
					) {
						throw new Error(
							data.error ||
								'レビュー申請に失敗しました。'
						);
					}


					currentStatus =
						'pending';


					updateStatus(
						'pending'
					);


					originalContent =
						content.value;

					originalMessage =
						message.value;


					updateDirtyState();


					setActionMessage(
						'レビュー申請しました。管理者による確認をお待ちください。',
						'success'
					);


					/*
					 * 申請後は編集不可
					 */

					content.disabled = true;
					message.disabled = true;

					saveDraftButton.disabled =
						true;

					submitReviewButton.disabled =
						true;


				} catch (error) {

					console.error(
						'Submit review error:',
						error
					);


					setActionMessage(
						error instanceof Error
							? error.message
							: 'レビュー申請に失敗しました。',
						'error'
					);


					setFormDisabled(false);

				} finally {

					setButtonLoading(
						submitReviewButton,
						false
					);

					isSaving = false;
				}
			}


			/* ========================================
			   Events
			======================================== */

			saveDraftButton.addEventListener(
				'click',
				saveDraft
			);


			submitReviewButton.addEventListener(
				'click',
				submitReview
			);


			content.addEventListener(
				'input',
				() => {

					updateCharacterCount();

					updateDirtyState();

					void updateMarkdownPreview();
				}
			);


			message.addEventListener(
				'input',
				updateDirtyState
			);


			window.addEventListener(
				'beforeunload',
				(event) => {

					const dirty =
						content.value !== originalContent ||
						message.value !== originalMessage;


					if (
						dirty &&
						!isSaving
					) {
						event.preventDefault();
						event.returnValue = '';
					}
				}
			);


			document
				.querySelector<HTMLButtonElement>(
					'#edit-tab'
				)!
				.addEventListener(
					'click',
					() => setMobileView('edit')
				);


			document
				.querySelector<HTMLButtonElement>(
					'#preview-tab'
				)!
				.addEventListener(
					'click',
					() => setMobileView('preview')
				);


			/* ========================================
			   Initial load
			======================================== */

			setMobileView('edit');

			loadPage();
		</script>


