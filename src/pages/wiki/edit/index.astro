						0,
						0.25
					);
			}


			.button-secondary {
				border-color:
					var(--nug-border);

				background:
					var(--nug-panel);

				color:
					var(--nug-text);
			}


			.button-large {
				min-width: 150px;

				min-height: 50px;
			}


			/* ========================================
			   State cards
			======================================== */

			.state-card {
				display: flex;

				flex-direction: column;

				align-items: center;
				justify-content: center;

				min-height: 300px;

				padding: 40px;

				border:
					1px solid
					var(--nug-border);

				border-radius: 8px;

				background:
					var(--nug-panel);

				box-shadow:
					var(--nug-shadow);

				text-align: center;
			}


			.state-card p {
				color:
					var(--nug-muted);
			}


			.state-error {
				border-color:
					rgba(
						229,
						121,
						121,
						0.4
					);
			}


			.state-icon {
				display: grid;

				width: 48px;
				height: 48px;

				place-items: center;

				margin-bottom: 12px;

				border-radius: 50%;

				background:
					rgba(
						229,
						121,
						121,
						0.15
					);

				color:
					var(--nug-danger);

				font-weight: 900;
			}


			.state-card h2 {
				margin: 0;
			}


			.state-actions {
				margin-top: 16px;
			}


			/* ========================================
			   Spinner
			======================================== */

			.spinner {
				width: 32px;
				height: 32px;

				margin-bottom: 16px;

				border:
					3px solid
					var(--nug-border);

				border-top-color:
					var(--nug-green);

				border-radius: 50%;

				animation:
					spin 0.8s
					linear infinite;
			}


			@keyframes spin {
				to {
					transform:
						rotate(360deg);
				}
			}


			/* ========================================
			   Action message
			======================================== */

			.action-message {
				margin-top: 20px;

				padding: 14px 16px;

				border:
					1px solid
					var(--nug-border);

				border-radius: 6px;

				font-size: 0.9rem;

				line-height: 1.6;
			}


			.action-message.success {
				border-color:
					rgba(
						114,
						213,
						114,
						0.4
					);

				background:
					rgba(
						114,
						213,
						114,
						0.08
					);

				color:
					var(--nug-green);
			}


			.action-message.error {
				border-color:
					rgba(
						229,
						121,
						121,
						0.4
					);

				background:
					rgba(
						229,
						121,
						121,
						0.08
					);

				color:
					var(--nug-danger);
			}


			.action-message.info {
				border-color:
					rgba(
						117,
						188,
						232,
						0.4
					);

				background:
					rgba(
						117,
						188,
						232,
						0.08
					);

				color:
					var(--nug-info);
			}


			/* ========================================
			   Mobile
			======================================== */

			@media (max-width: 900px) {

				.content-workspace {
					grid-template-columns:
						1fr;
				}


				.editor-pane {
					border-right: 0;

					border-bottom:
						1px solid
						var(--nug-border);
				}


				.editor-pane,
				.preview-pane {
					min-height: 500px;
				}


				textarea,
				.markdown-preview {
					min-height: 458px;
				}
			}


			@media (max-width: 700px) {

				.editor-page {
					padding:
						28px
						14px
						60px;
				}


				.editor-header {
					align-items: stretch;

					flex-direction:
						column;

					gap: 20px;
				}


				.header-actions {
					display: none;
				}


				.status-card {
					padding:
						16px;
				}


				.status-heading {
					align-items:
						flex-start;

					flex-direction:
						column;

					gap: 8px;
				}


				.status-stepper {
					display: block;

					overflow: visible;
				}


				.status-step {
					min-height: 30px;
				}


				.status-line {
					width: 1px;

					height: 20px;

					min-width: 1px;

					margin:
						2px 0
						2px 8px;
				}


				.page-info-card {
					align-items: stretch;

					flex-direction:
						column;
				}


				.revision-info {
					padding-top: 16px;

					padding-left: 0;

					border-top:
						1px solid
						var(--nug-border);

					border-left: 0;

					text-align: left;
				}


				.content-toolbar {
					align-items:
						flex-start;

					flex-direction:
						column;

					gap: 8px;
				}


				.mobile-view-tabs {
					display: grid;

					grid-template-columns:
						1fr 1fr;

					margin-bottom: 8px;

					border:
						1px solid
						var(--nug-border);

					border-radius: 6px;

					overflow: hidden;
				}


				.mobile-view-tab {
					min-height: 42px;

					border: 0;

					background:
						var(--nug-panel);

					color: var(--nug-muted);

					cursor: pointer;

					font-weight: 800;
				}


				.mobile-view-tab
				+ .mobile-view-tab {
					border-left:
						1px solid
						var(--nug-border);
				}


				.mobile-view-tab.active {
					background:
						var(--nug-green);

					color:
						#081008;
				}


				.content-workspace {
					display: block;

					min-height: 0;
				}


				.editor-pane,
				.preview-pane {
					display: none;

					border: 0;

					min-height: 0;
				}


				.editor-pane.mobile-active,
				.preview-pane.mobile-active {
					display: block;
				}


				textarea,
				.markdown-preview {
					height: 500px;

					min-height: 500px;
				}


				.markdown-preview {
					padding: 20px;
				}


				.form-actions {
					flex-direction:
						column;
				}


				.button-large {
					width: 100%;
				}
			}
		</style>
	</body>
</html>