---
const title = 'Wiki編集申請 | NUGBASE';
const description = 'NUGBASE Wikiの下書き・編集申請を管理します。';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>

		<title>{title}</title>

		<meta
			name="description"
			content={description}
		/>

		<style>
	/* =========================================================
	   NUGBASE Wiki Requests
	   ---------------------------------------------------------
	   Visual design only.
	   HTML / JavaScript / API / IDs / classes are unchanged.
	   ========================================================= */


	/* =========================================================
	   01. Design Tokens
	   ========================================================= */

	:root {
		color-scheme: light;

		/* -------------------------
		   Base
		   ------------------------- */

		--page-bg: #e8edef;
		--page-bg-deep: #dce3e5;

		--surface: #f8faf9;
		--surface-soft: #edf1f1;
		--surface-raised: #ffffff;

		--text: #202522;
		--text-soft: #4f5953;
		--text-muted: #707a74;

		--border: #aeb8b3;
		--border-dark: #7f8984;

		/* -------------------------
		   NUGBASE Green
		   ------------------------- */

		--accent: #3f873f;
		--accent-dark: #2d6630;
		--accent-deep: #214d26;
		--accent-soft: #e1efdf;

		/* -------------------------
		   Warm Highlight
		   ------------------------- */

		--highlight: #d7b85c;
		--highlight-soft: #f4edcf;

		/* -------------------------
		   Status
		   ------------------------- */

		--warning: #956d19;
		--warning-soft: #f4ecd4;

		--danger: #a6453d;
		--danger-dark: #84352f;
		--danger-soft: #f4e3e1;

		--info: #386d91;
		--info-soft: #e1edf4;

		/* -------------------------
		   Block Shadows
		   ------------------------- */

		--shadow:
			0 5px 0 rgba(31, 42, 35, 0.20),
			0 12px 24px rgba(31, 42, 35, 0.10);

		--shadow-small:
			0 3px 0 rgba(31, 42, 35, 0.16),
			0 8px 16px rgba(31, 42, 35, 0.08);

		--shadow-button:
			0 4px 0 var(--accent-dark);

		/* -------------------------
		   Geometry
		   ------------------------- */

		--radius: 3px;
		--radius-small: 2px;

		--max-width: 960px;

		/* -------------------------
		   Grid
		   ------------------------- */

		--space-1: 8px;
		--space-2: 16px;
		--space-3: 24px;
		--space-4: 32px;
		--space-5: 40px;
		--space-6: 48px;
	}


	/* =========================================================
	   02. Dark Theme
	   ========================================================= */

	html[data-theme="dark"] {
		color-scheme: dark;

		--page-bg: #111416;
		--page-bg-deep: #0f1113;

		--surface: #2f3438;
		--surface-soft: #272c30;
		--surface-raised: #3a4044;

		--text: #f1f4f2;
		--text-soft: #c4cbc7;
		--text-muted: #9ba49f;

		--border: #596166;
		--border-dark: #3f464b;

		--accent: #58ad5c;
		--accent-dark: #35783b;
		--accent-deep: #285b2d;
		--accent-soft: #233a27;

		--highlight: #dfc66c;
		--highlight-soft: #3c3521;

		--warning: #d0aa4c;
		--warning-soft: #3a3322;

		--danger: #d56d64;
		--danger-dark: #ae5049;
		--danger-soft: #3b2827;

		--info: #78add0;
		--info-soft: #273640;

		--shadow:
			0 5px 0 rgba(0, 0, 0, 0.42),
			0 14px 28px rgba(0, 0, 0, 0.28);

		--shadow-small:
			0 3px 0 rgba(0, 0, 0, 0.38),
			0 8px 18px rgba(0, 0, 0, 0.22);

		--shadow-button:
			0 4px 0 var(--accent-deep);
	}


	/* =========================================================
	   03. Base
	   ========================================================= */

	* {
		box-sizing: border-box;
	}

	html {
		min-height: 100%;

		background:
			linear-gradient(
				180deg,
				#d9e5e8 0,
				var(--page-bg) 300px
			);
	}

	html[data-theme="dark"] {
		background:
			linear-gradient(
				180deg,
				#252a2d 0,
				#171a1c 260px,
				#111416 100%
			);
	}

	body {
		position: relative;
		isolation: isolate;

		margin: 0;
		min-height: 100vh;

		background:
			radial-gradient(
				circle at 10% 0%,
				rgba(76, 143, 75, 0.14),
				transparent 30%
			),
			linear-gradient(
				180deg,
				transparent 0,
				var(--page-bg) 520px
			);

		color: var(--text);

		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"Yu Gothic",
			"YuGothic",
			"Hiragino Kaku Gothic ProN",
			Meiryo,
			sans-serif;

		line-height: 1.7;
	}

	html[data-theme="dark"] body {
		background:
			radial-gradient(
				circle at 8% 0%,
				rgba(83, 151, 80, 0.13),
				transparent 32%
			),
			linear-gradient(
				180deg,
				transparent 0,
				#111416 520px
			);
	}

	body::before {
		content: "";

		position: fixed;
		inset: 0;

		z-index: -1;

		pointer-events: none;

		background:
			linear-gradient(
				135deg,
				rgba(255, 255, 255, 0.045),
				transparent 24%
			);

		opacity: 0.7;
	}

	a,
	button {
		font: inherit;
	}

	a:focus-visible,
	button:focus-visible {
		outline:
			2px solid
			var(--highlight);

		outline-offset: 3px;
	}


	/* =========================================================
	   04. Page
	   ========================================================= */

	.requests-page {
		width: min(
			calc(100% - 32px),
			var(--max-width)
		);

		margin: 0 auto;

		padding: 48px 0 72px;
	}


	/* =========================================================
	   05. Topbar
	   ========================================================= */

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: var(--space-2);

		margin-bottom: var(--space-3);
	}

	.back-link {
		position: relative;

		display: inline-flex;
		align-items: center;
		gap: 8px;

		min-height: 40px;

		padding: 8px 14px;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius);

		background:
			linear-gradient(
				180deg,
				var(--surface-raised),
				var(--surface)
			);

		color: var(--text-soft);

		text-decoration: none;

		box-shadow: var(--shadow-small);

		transition:
			transform 0.12s ease,
			filter 0.12s ease,
			color 0.12s ease;
	}

	.back-link::before {
		content: "";

		position: absolute;
		top: 0;
		left: 0;
		right: 0;

		height: 2px;

		background:
			linear-gradient(
				90deg,
				var(--accent),
				transparent
			);
	}

	.back-link:hover {
		color: var(--text);

		filter: brightness(1.06);

		transform: translateY(-1px);
	}

	.back-link:active {
		transform: translateY(2px);

		box-shadow:
			0 1px 0
			rgba(0, 0, 0, 0.25);
	}


	/* =========================================================
	   06. Main Card
	   ========================================================= */

	.main-card {
		position: relative;

		overflow: hidden;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius);

		background:
			linear-gradient(
				135deg,
				var(--surface-raised),
				var(--surface)
			);

		box-shadow: var(--shadow);
	}

	.main-card::before {
		content: "";

		position: absolute;

		top: 0;
		left: 0;
		right: 0;

		height: 4px;

		background:
			linear-gradient(
				90deg,
				var(--accent-dark),
				var(--accent),
				#6aa96b
			);

		box-shadow:
			0 1px 0
			rgba(255, 247, 214, 0.18);
	}

	.main-card-inner {
		padding: var(--space-5);
	}


	/* =========================================================
	   07. Heading
	   ========================================================= */

	.page-heading {
		margin-bottom: 28px;
	}

	.page-heading-label {
		display: inline-flex;
		align-items: center;

		min-height: 28px;

		margin-bottom: 12px;

		padding: 4px 10px;

		border:
			1px solid
			color-mix(
				in srgb,
				var(--accent) 45%,
				var(--border)
			);

		border-radius: var(--radius-small);

		background: var(--accent-soft);

		color: var(--accent);

		font-size: 0.74rem;
		font-weight: 900;

		letter-spacing: 0.12em;

		box-shadow:
			0 2px 0
			color-mix(
				in srgb,
				var(--accent-dark) 25%,
				transparent
			);
	}

	.page-heading h1 {
		margin: 0;

		color: var(--text);

		font-size: clamp(
			1.8rem,
			4vw,
			2.45rem
		);

		font-weight: 900;

		letter-spacing: -0.02em;

		line-height: 1.2;

		text-shadow:
			0 1px 0
			rgba(255, 255, 255, 0.05);
	}

	.page-heading p {
		margin: 12px 0 0;

		max-width: 720px;

		color: var(--text-muted);

		font-size: 0.92rem;
	}


	/* =========================================================
	   08. Loading
	   ========================================================= */

	.loading {
		position: relative;

		padding: 20px;

		border:
			1px solid
			var(--border);

		border-left:
			4px solid
			var(--accent);

		border-radius: var(--radius);

		background:
			linear-gradient(
				135deg,
				var(--surface-soft),
				var(--surface)
			);

		color: var(--text-muted);

		box-shadow: var(--shadow-small);

		text-align: center;
	}

	.loading::before {
		content: "";

		display: inline-block;

		width: 9px;
		height: 9px;

		margin-right: 10px;

		background: var(--accent);

		box-shadow:
			0 0 0 3px
			var(--accent-soft);

		vertical-align: middle;
	}


	/* =========================================================
	   09. Error
	   ========================================================= */

	.error {
		padding: 18px 20px;

		border:
			1px solid
			var(--danger);

		border-left:
			5px solid
			var(--danger);

		border-radius: var(--radius);

		background:
			linear-gradient(
				135deg,
				var(--danger-soft),
				var(--surface)
			);

		color: var(--danger);

		box-shadow: var(--shadow-small);
	}


	/* =========================================================
	   10. Status Summary
	   ========================================================= */

	.status-summary {
		display: grid;

		grid-template-columns:
			repeat(4, minmax(0, 1fr));

		gap: var(--space-2);

		margin-bottom: 32px;
	}

	.summary-item {
		position: relative;

		overflow: hidden;

		padding: 18px 16px;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius);

		background:
			linear-gradient(
				135deg,
				var(--surface-raised),
				var(--surface-soft)
			);

		box-shadow: var(--shadow-small);

		text-align: center;
	}

	.summary-item::before {
		content: "";

		position: absolute;

		top: 0;
		left: 0;
		right: 0;

		height: 2px;

		background: var(--border);
	}

	.summary-item:first-child::before {
		background: var(--accent);
	}

	.summary-number {
		display: block;

		color: var(--text);

		font-size: 1.75rem;
		font-weight: 900;

		line-height: 1.2;
	}

	.summary-label {
		display: block;

		margin-top: 6px;

		color: var(--text-muted);

		font-size: 0.76rem;
		font-weight: 800;
	}


	/* =========================================================
	   11. Section
	   ========================================================= */

	.request-section {
		margin-top: 32px;
	}

	.request-section:first-of-type {
		margin-top: 0;
	}

	.section-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 12px;

		margin-bottom: 12px;

		padding-bottom: 10px;

		border-bottom:
			1px solid
			var(--border);
	}

	.section-heading h2 {
		position: relative;

		margin: 0;
		padding-left: 12px;

		color: var(--text);

		font-size: 1.08rem;
		font-weight: 900;

		line-height: 1.4;
	}

	.section-heading h2::before {
		content: "";

		position: absolute;

		top: 2px;
		bottom: 2px;
		left: 0;

		width: 4px;

		background: var(--accent);
	}

	.section-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		min-width: 32px;
		height: 28px;

		padding: 2px 8px;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius-small);

		background: var(--surface-soft);

		color: var(--text-muted);

		font-size: 0.76rem;
		font-weight: 900;

		box-shadow:
			0 2px 0
			rgba(0, 0, 0, 0.08);
	}


	/* =========================================================
	   12. Request List
	   ========================================================= */

	.request-list {
		display: grid;

		gap: 12px;
	}


	/* =========================================================
	   13. Request Card
	   ========================================================= */

	.request-card {
		position: relative;

		overflow: hidden;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius);

		background:
			linear-gradient(
				135deg,
				var(--surface-raised),
				var(--surface)
			);

		box-shadow: var(--shadow-small);

		transition:
			transform 0.12s ease,
			filter 0.12s ease,
			box-shadow 0.12s ease;
	}

	.request-card::before {
		content: "";

		position: absolute;

		top: 0;
		left: 0;

		width: 3px;
		height: 100%;

		background: var(--border);
	}

	.request-card:hover {
		filter: brightness(1.025);

		transform: translateY(-1px);

		box-shadow:
			0 4px 0 rgba(0, 0, 0, 0.18),
			0 10px 20px rgba(0, 0, 0, 0.12);
	}

	.request-card-main {
		padding: 18px 20px 20px;
	}

	.request-card-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;

		gap: 16px;
	}

	.request-title {
		margin: 0;

		color: var(--text);

		font-size: 1rem;
		font-weight: 900;

		line-height: 1.5;
	}

	.request-path {
		margin: 5px 0 0;

		color: var(--text-muted);

		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			"Liberation Mono",
			monospace;

		font-size: 0.76rem;

		overflow-wrap: anywhere;
	}


	/* =========================================================
	   14. Status Badge
	   ========================================================= */

	.status-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		flex: 0 0 auto;

		min-height: 30px;

		padding: 4px 10px;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius-small);

		background: var(--surface-soft);

		color: var(--text-soft);

		font-size: 0.73rem;
		font-weight: 900;

		white-space: nowrap;

		box-shadow:
			0 2px 0
			rgba(0, 0, 0, 0.10);
	}

	.status-badge.draft {
		border-color: var(--border);

		background: var(--surface-soft);

		color: var(--text-soft);
	}

	.status-badge.pending {
		border-color: var(--warning);

		background: var(--warning-soft);

		color: var(--warning);
	}

	.status-badge.approved {
		border-color: var(--info);

		background: var(--info-soft);

		color: var(--info);
	}

	.status-badge.rejected {
		border-color: var(--danger);

		background: var(--danger-soft);

		color: var(--danger);
	}

	.status-badge.publishing {
		border-color: var(--info);

		background: var(--info-soft);

		color: var(--info);
	}

	.status-badge.published {
		border-color: var(--accent);

		background: var(--accent-soft);

		color: var(--accent);
	}


	/* =========================================================
	   15. Request Meta
	   ========================================================= */

	.request-meta {
		display: flex;
		flex-wrap: wrap;

		gap: 8px 16px;

		margin-top: 14px;

		padding-top: 12px;

		border-top:
			1px solid
			var(--border-dark);

		color: var(--text-muted);

		font-size: 0.78rem;
	}

	.request-meta span {
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}


	/* =========================================================
	   16. Request Message
	   ========================================================= */

	.request-message {
		margin: 14px 0 0;

		padding: 11px 13px;

		border:
			1px solid
			var(--border);

		border-left:
			4px solid
			var(--highlight);

		border-radius: var(--radius-small);

		background:
			linear-gradient(
				135deg,
				var(--highlight-soft),
				var(--surface-soft)
			);

		color: var(--text-soft);

		font-size: 0.84rem;
	}

	.request-message strong {
		color: var(--text);
		font-weight: 900;
	}


	/* =========================================================
	   17. Request Actions
	   ========================================================= */

	.request-actions {
		display: flex;
		flex-wrap: wrap;

		gap: 8px;

		margin-top: 16px;
	}

	.request-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;

		min-height: 40px;

		padding: 8px 14px;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius);

		background:
			linear-gradient(
				180deg,
				var(--surface-raised),
				var(--surface-soft)
			);

		color: var(--text-soft);

		font-size: 0.82rem;
		font-weight: 800;

		text-decoration: none;

		box-shadow:
			0 3px 0
			rgba(0, 0, 0, 0.18);

		transition:
			transform 0.1s ease,
			filter 0.1s ease,
			color 0.1s ease;
	}

	.request-action:hover {
		color: var(--text);

		filter: brightness(1.08);

		transform: translateY(-1px);
	}

	.request-action:active {
		transform: translateY(2px);

		box-shadow:
			0 1px 0
			rgba(0, 0, 0, 0.18);
	}

	.request-action.primary {
		border-color: var(--accent-dark);

		background:
			linear-gradient(
				180deg,
				var(--accent),
				var(--accent-dark)
			);

		color: #ffffff;

		box-shadow: var(--shadow-button);
	}

	.request-action.primary:hover {
		color: #ffffff;

		filter: brightness(1.1);
	}

	.request-action.primary:active {
		box-shadow:
			0 1px 0
			var(--accent-deep);
	}


	/* =========================================================
	   18. Empty
	   ========================================================= */

	.empty {
		position: relative;

		padding: 20px;

		border:
			1px dashed
			var(--border);

		border-radius: var(--radius);

		background:
			linear-gradient(
				135deg,
				var(--surface-soft),
				var(--surface)
			);

		color: var(--text-muted);

		font-size: 0.86rem;

		text-align: center;
	}

	.empty::before {
		content: "";

		display: block;

		width: 8px;
		height: 8px;

		margin: 0 auto 8px;

		background: var(--border);
	}


	/* =========================================================
	   19. Bottom Actions
	   ========================================================= */

	.bottom-actions {
		display: grid;

		grid-template-columns:
			repeat(2, minmax(0, 1fr));

		gap: 12px;

		margin-top: 36px;

		padding-top: 24px;

		border-top:
			1px solid
			var(--border);
	}

	.bottom-action {
		position: relative;

		display: flex;
		align-items: center;
		justify-content: center;

		min-height: 46px;

		padding: 10px 16px;

		border:
			1px solid
			var(--border);

		border-radius: var(--radius);

		background:
			linear-gradient(
				180deg,
				var(--surface-raised),
				var(--surface-soft)
			);

		color: var(--text-soft);

		font-size: 0.84rem;
		font-weight: 800;

		text-decoration: none;

		box-shadow:
			0 3px 0
			rgba(0, 0, 0, 0.16);

		transition:
			transform 0.1s ease,
			filter 0.1s ease,
			color 0.1s ease;
	}

	.bottom-action:hover {
		color: var(--text);

		filter: brightness(1.07);

		transform: translateY(-1px);
	}

	.bottom-action:active {
		transform: translateY(2px);

		box-shadow:
			0 1px 0
			rgba(0, 0, 0, 0.16);
	}


	/* =========================================================
	   20. Responsive
	   ========================================================= */

	@media (max-width: 760px) {
		.requests-page {
			width: min(
				calc(100% - 24px),
				var(--max-width)
			);

			padding: 32px 0 56px;
		}

		.main-card-inner {
			padding: 32px 24px;
		}

		.status-summary {
			grid-template-columns:
				repeat(2, minmax(0, 1fr));
		}
	}


	@media (max-width: 650px) {
		.requests-page {
			width: min(
				calc(100% - 20px),
				var(--max-width)
			);

			padding: 24px 0 40px;
		}

		.main-card-inner {
			padding: 28px 18px;
		}

		.page-heading {
			margin-bottom: 24px;
		}

		.page-heading h1 {
			font-size: 1.75rem;
		}

		.status-summary {
			grid-template-columns:
				repeat(2, minmax(0, 1fr));

			gap: 10px;
		}

		.summary-item {
			padding: 15px 12px;
		}

		.summary-number {
			font-size: 1.55rem;
		}

		.request-card-top {
			flex-direction: column;

			gap: 12px;
		}

		.status-badge {
			align-self: flex-start;
		}

		.request-card-main {
			padding: 16px;
		}

		.bottom-actions {
			grid-template-columns: 1fr;
		}
	}


	@media (max-width: 420px) {
		.requests-page {
			width: min(
				calc(100% - 16px),
				var(--max-width)
			);
		}

		.main-card-inner {
			padding: 24px 14px;
		}

		.topbar {
			margin-bottom: 16px;
		}

		.back-link {
			min-height: 38px;

			padding: 7px 11px;

			font-size: 0.82rem;
		}

		.status-summary {
			gap: 8px;
		}

		.summary-item {
			padding: 14px 8px;
		}

		.summary-number {
			font-size: 1.4rem;
		}

		.summary-label {
			font-size: 0.7rem;
		}

		.request-meta {
			flex-direction: column;

			gap: 5px;
		}

		.request-actions {
			flex-direction: column;
		}

		.request-action {
			width: 100%;
		}
	}


	/* =========================================================
	   21. Reduced Motion
	   ========================================================= */

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
		}
	}
		</style>
	</head>

	<body>
		<main class="requests-page">

			<!-- =====================================================
			     Topbar
			     ===================================================== -->

			<div class="topbar">
				<a
					href="/account/"
					class="back-link"
				>
					<span aria-hidden="true">
						←
					</span>

					<span>
						アカウントへ戻る
					</span>
				</a>
			</div>


			<!-- =====================================================
			     Main
			     ===================================================== -->

			<section
				class="main-card"
				aria-labelledby="page-title"
			>
				<div class="main-card-inner">

					<header class="page-heading">
						<div class="page-heading-label">
							WIKI EDITING
						</div>

						<h1 id="page-title">
							自分の下書き・申請
						</h1>

						<p>
							自分が作成したWiki編集の下書きとレビュー申請を確認できます。
						</p>
					</header>


					<!-- =================================================
					     Loading
					     ================================================= -->

					<div
						id="loading"
						class="loading"
						role="status"
						aria-live="polite"
					>
						申請情報を読み込んでいます…
					</div>


					<!-- =================================================
					     Error
					     ================================================= -->

					<div
						id="error"
						class="error"
						role="alert"
						hidden
					></div>


					<!-- =================================================
					     Content
					     ================================================= -->

					<div
						id="content"
						hidden
					>

						<!-- Summary -->

						<div class="status-summary">
							<div class="summary-item">
								<span
									id="summary-draft"
									class="summary-number"
								>
									0
								</span>

								<span class="summary-label">
									下書き
								</span>
							</div>

							<div class="summary-item">
								<span
									id="summary-pending"
									class="summary-number"
								>
									0
								</span>

								<span class="summary-label">
									レビュー申請中
								</span>
							</div>

							<div class="summary-item">
								<span
									id="summary-rejected"
									class="summary-number"
								>
									0
								</span>

								<span class="summary-label">
									却下
								</span>
							</div>

							<div class="summary-item">
								<span
									id="summary-published"
									class="summary-number"
								>
									0
								</span>

								<span class="summary-label">
									公開済み
								</span>
							</div>
						</div>


						<!-- Draft -->

						<section class="request-section">
							<div class="section-heading">
								<h2>
									下書き
								</h2>

								<span
									id="count-draft"
									class="section-count"
								>
									0
								</span>
							</div>

							<div
								id="list-draft"
								class="request-list"
							></div>
						</section>


						<!-- Pending -->

						<section class="request-section">
							<div class="section-heading">
								<h2>
									レビュー申請中
								</h2>

								<span
									id="count-pending"
									class="section-count"
								>
									0
								</span>
							</div>

							<div
								id="list-pending"
								class="request-list"
							></div>
						</section>


						<!-- Approved -->

						<section class="request-section">
							<div class="section-heading">
								<h2>
									承認済み
								</h2>

								<span
									id="count-approved"
									class="section-count"
								>
									0
								</span>
							</div>

							<div
								id="list-approved"
								class="request-list"
							></div>
						</section>


						<!-- Rejected -->

						<section class="request-section">
							<div class="section-heading">
								<h2>
									却下
								</h2>

								<span
									id="count-rejected"
									class="section-count"
								>
									0
								</span>
							</div>

							<div
								id="list-rejected"
								class="request-list"
							></div>
						</section>


						<!-- Publishing -->

						<section class="request-section">
							<div class="section-heading">
								<h2>
									公開処理中
								</h2>

								<span
									id="count-publishing"
									class="section-count"
								>
									0
								</span>
							</div>

							<div
								id="list-publishing"
								class="request-list"
							></div>
						</section>


						<!-- Published -->

						<section class="request-section">
							<div class="section-heading">
								<h2>
									公開済み
								</h2>

								<span
									id="count-published"
									class="section-count"
								>
									0
								</span>
							</div>

							<div
								id="list-published"
								class="request-list"
							></div>
						</section>


						<!-- Bottom Actions -->

						<div class="bottom-actions">
							<a
								href="/docs/"
								class="bottom-action"
							>
								Wikiを見る
							</a>

							<a
								href="/account/"
								class="bottom-action"
							>
								アカウントへ戻る
							</a>
						</div>

					</div>
				</div>
			</section>
		</main>


		<script>
			/* =========================================================
			   Theme
			   ========================================================= */

			const applyTheme = (): void => {
				const storedTheme =
					localStorage.getItem("nug-theme");

				if (
					storedTheme === "light" ||
					storedTheme === "dark"
				) {
					document.documentElement.dataset.theme =
						storedTheme;

					return;
				}

				const prefersDark =
					window.matchMedia(
						"(prefers-color-scheme: dark)",
					).matches;

				document.documentElement.dataset.theme =
					prefersDark
						? "dark"
						: "light";
			};

			applyTheme();


			/* =========================================================
			   Types
			   ========================================================= */

			type User = {
				id?: string;
				role?: string;
			};

			type MeResponse = {
				ok?: boolean;
				loggedIn?: boolean;
				user?: User | null;
			};

			type EditRequest = {
				id?: string;
				page_id?: string;
				page_path?: string;
				page_title?: string;

				revision_id?: string;
				revision_number?: number;

				base_revision_id?: string | null;

				status?: string;
				message?: string | null;

				user_id?: string;

				created_at?: string;
				reviewed_at?: string | null;

				review_comment?: string | null;
			};

			type RequestsResponse = {
				ok?: boolean;
				editRequests?: EditRequest[];
				requests?: EditRequest[];
				error?: string;
			};


			/* =========================================================
			   Elements
			   ========================================================= */

			const loading =
				document.querySelector<HTMLElement>(
					"#loading",
				);

			const errorElement =
				document.querySelector<HTMLElement>(
					"#error",
				);

			const content =
				document.querySelector<HTMLElement>(
					"#content",
				);


			/* =========================================================
			   Status configuration
			   ========================================================= */

			const statusConfig: Record<
				string,
				{
					label: string;
					className: string;
					listId: string;
					countId: string;
				}
			> = {
				draft: {
					label: "下書き",
					className: "draft",
					listId: "list-draft",
					countId: "count-draft",
				},

				pending: {
					label: "レビュー申請中",
					className: "pending",
					listId: "list-pending",
					countId: "count-pending",
				},

				approved: {
					label: "承認済み",
					className: "approved",
					listId: "list-approved",
					countId: "count-approved",
				},

				rejected: {
					label: "却下",
					className: "rejected",
					listId: "list-rejected",
					countId: "count-rejected",
				},

				publishing: {
					label: "公開処理中",
					className: "publishing",
					listId: "list-publishing",
					countId: "count-publishing",
				},

				published: {
					label: "公開済み",
					className: "published",
					listId: "list-published",
					countId: "count-published",
				},
			};


			/* =========================================================
			   Helpers
			   ========================================================= */

			const escapeHtml = (
				value: string,
			): string => {
				return value
					.replaceAll("&", "&amp;")
					.replaceAll("<", "&lt;")
					.replaceAll(">", "&gt;")
					.replaceAll('"', "&quot;")
					.replaceAll("'", "&#039;");
			};


			const formatDate = (
				value?: string,
			): string => {
				if (!value) {
					return "日時不明";
				}

				const date =
					new Date(value);

				if (
					Number.isNaN(
						date.getTime(),
					)
				) {
					return "日時不明";
				}

				return new Intl.DateTimeFormat(
					"ja-JP",
					{
						year: "numeric",
						month: "numeric",
						day: "numeric",
						hour: "2-digit",
						minute: "2-digit",
					},
				).format(date);
			};


			const getRequests =
				(
					data: RequestsResponse,
				): EditRequest[] => {
					if (
						Array.isArray(
							data.editRequests,
						)
					) {
						return data.editRequests;
					}

					if (
						Array.isArray(
							data.requests,
						)
					) {
						return data.requests;
					}

					return [];
				};


			/* =========================================================
			   Empty
			   ========================================================= */

			const renderEmpty = (
				container: HTMLElement,
				message: string,
			): void => {
				container.innerHTML = "";

				const element =
					document.createElement("div");

				element.className =
					"empty";

				element.textContent =
					message;

				container.appendChild(
					element,
				);
			};


			/* =========================================================
			   Request Card
			   ========================================================= */

			const createRequestCard = (
				request: EditRequest,
			): HTMLElement => {
				const card =
					document.createElement("article");

				card.className =
					"request-card";


				const status =
					request.status || "draft";

				const config =
					statusConfig[status] ||
					statusConfig.draft;


				const pageTitle =
					request.page_title ||
					"無題のWikiページ";

				const pagePath =
					request.page_path ||
					"パス不明";

				const revisionNumber =
					request.revision_number ??
					"-";


				let actionHtml = "";

				if (request.id) {
					const requestId =
						encodeURIComponent(
							request.id,
						);

					if (
						status === "draft"
					) {
						actionHtml += `
							<a
								class="request-action primary"
								href="/wiki/edit-request/?id=${requestId}"
							>
								編集する
							</a>
						`;
					} else {
						actionHtml += `
							<a
								class="request-action"
								href="/wiki/edit-request/?id=${requestId}"
							>
								詳細を見る
							</a>
						`;
					}
				}


				if (
					status === "rejected" &&
					request.review_comment
				) {
					actionHtml += `
						<div class="request-message">
							<strong>却下理由：</strong>
							${escapeHtml(
								request.review_comment,
							)}
						</div>
					`;
				} else if (
					request.message
				) {
					actionHtml += `
						<div class="request-message">
							<strong>メッセージ：</strong>
							${escapeHtml(
								request.message,
							)}
						</div>
					`;
				}


				card.innerHTML = `
					<div class="request-card-main">

						<div class="request-card-top">

							<div>
								<h3 class="request-title">
									${escapeHtml(
										pageTitle,
									)}
								</h3>

								<p class="request-path">
									${escapeHtml(
										pagePath,
									)}
								</p>
							</div>

							<span
								class="status-badge ${config.className}"
							>
								${config.label}
							</span>

						</div>

						<div class="request-meta">
							<span>
								Revision ${escapeHtml(
									String(
										revisionNumber,
									),
								)}
							</span>

							<span>
								作成：
								${escapeHtml(
									formatDate(
										request.created_at,
									),
								)}
							</span>

							${
								request.reviewed_at
									? `
										<span>
											確認：
											${escapeHtml(
												formatDate(
													request.reviewed_at,
												),
											)}
										</span>
									`
									: ""
							}
						</div>

						${
							actionHtml
								? `
									<div class="request-actions">
										${actionHtml}
									</div>
								`
								: ""
						}

					</div>
				`;

				return card;
			};


			/* =========================================================
			   Render
			   ========================================================= */

			const renderRequests = (
				requests: EditRequest[],
			): void => {
				const grouped: Record<
					string,
					EditRequest[]
				> = {
					draft: [],
					pending: [],
					approved: [],
					rejected: [],
					publishing: [],
					published: [],
				};


				for (const request of requests) {
					const status =
						request.status ||
						"draft";

					if (
						grouped[status]
					) {
						grouped[status].push(
							request,
						);
					}
				}


				/* -------------------------
				   Lists
				   ------------------------- */

				for (
					const [
						status,
						items,
					] of Object.entries(grouped)
				) {
					const config =
						statusConfig[status];

					if (!config) {
						continue;
					}

					const list =
						document.querySelector<HTMLElement>(
							`#${config.listId}`,
						);

					const count =
						document.querySelector<HTMLElement>(
							`#${config.countId}`,
						);

					if (!list) {
						continue;
					}

					if (count) {
						count.textContent =
							String(items.length);
					}

					if (
						items.length === 0
					) {
						renderEmpty(
							list,
							"現在ありません。",
						);

						continue;
					}

					list.innerHTML = "";

					for (
						const request of items
					) {
						list.appendChild(
							createRequestCard(
								request,
							),
						);
					}
				}


				/* -------------------------
				   Summary
				   ------------------------- */

				const summaryDraft =
					document.querySelector<HTMLElement>(
						"#summary-draft",
					);

				const summaryPending =
					document.querySelector<HTMLElement>(
						"#summary-pending",
					);

				const summaryRejected =
					document.querySelector<HTMLElement>(
						"#summary-rejected",
					);

				const summaryPublished =
					document.querySelector<HTMLElement>(
						"#summary-published",
					);

				if (summaryDraft) {
					summaryDraft.textContent =
						String(
							grouped.draft.length,
						);
				}

				if (summaryPending) {
					summaryPending.textContent =
						String(
							grouped.pending.length,
						);
				}

				if (summaryRejected) {
					summaryRejected.textContent =
						String(
							grouped.rejected.length,
						);
				}

				if (summaryPublished) {
					summaryPublished.textContent =
						String(
							grouped.published.length,
						);
				}
			};


			/* =========================================================
			   Error
			   ========================================================= */

			const showError = (
				message: string,
			): void => {
				if (loading) {
					loading.hidden =
						true;
				}

				if (content) {
					content.hidden =
						true;
				}

				if (errorElement) {
					errorElement.textContent =
						message;

					errorElement.hidden =
						false;
				}
			};


			/* =========================================================
			   Load
			   ========================================================= */

			const loadPage =
				async (): Promise<void> => {
					try {
						/* -------------------------
						   Authentication
						   ------------------------- */

						const meResponse =
							await fetch(
								"/me",
								{
									credentials:
										"same-origin",

									headers: {
										Accept:
											"application/json",
									},
								},
							);

						if (
							!meResponse.ok
						) {
							throw new Error(
								`認証情報の取得に失敗しました（HTTP ${meResponse.status}）。`,
							);
						}

						const me =
							(await meResponse.json()) as MeResponse;

						if (
							!me.ok ||
							!me.loggedIn ||
							!me.user
						) {
							window.location.href =
								"/api/auth/google";

							return;
						}


						/* -------------------------
						   Permission
						   ------------------------- */

						if (
							me.user.role !==
								"editor" &&
							me.user.role !==
								"admin"
						) {
							showError(
								"このページはWiki編集者以上のみ利用できます。",
							);

							return;
						}


						/* -------------------------
						   Requests
						   ------------------------- */

						const response =
							await fetch(
								"/api/wiki/edit-requests",
								{
									credentials:
										"same-origin",

									headers: {
										Accept:
											"application/json",
									},
								},
							);

						if (
							!response.ok
						) {
							throw new Error(
								`編集申請の取得に失敗しました（HTTP ${response.status}）。`,
							);
						}

						const data =
							(await response.json()) as RequestsResponse;

						if (
							data.ok === false
						) {
							throw new Error(
								data.error ||
								"編集申請を取得できませんでした。",
							);
						}

						let requests =
							getRequests(data);


						/* -------------------------
						   Own requests only
						   ------------------------- */

						if (
							me.user.id
						) {
							requests =
								requests.filter(
									(request) =>
										request.user_id ===
										me.user?.id,
								);
						}


						/* -------------------------
						   Render
						   ------------------------- */

						renderRequests(
							requests,
						);

						if (loading) {
							loading.hidden =
								true;
						}

						if (errorElement) {
							errorElement.hidden =
								true;
						}

						if (content) {
							content.hidden =
								false;
						}
					} catch (error) {
						console.error(
							"NUG Wiki Requests Error:",
							error,
						);

						showError(
							error instanceof Error
								? error.message
								: "編集申請を読み込めませんでした。",
						);
					}
				};


			void loadPage();
		</script>
	</body>
</html>