---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/cards/ArticleCard.astro";
import { getCollection } from "astro:content";

const guides = await getCollection("guide");

const sortedGuides = [...guides]
	.filter((guide) => guide.id !== "index")
	.sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const categories = [...new Set(sortedGuides.map((guide) => guide.data.category ?? "攻略"))].sort((a, b) => a.localeCompare(b, "ja"));
const tags = [...new Set(sortedGuides.flatMap((guide) => guide.data.tags ?? []))].sort((a, b) => a.localeCompare(b, "ja"));
---

<Layout
	title="攻略 | ゆるぽーと"
	description="マイクラマルチサーバーの攻略情報をまとめています。"
>

	<section class="guide-header">

		<p class="eyebrow">
			GUIDE
		</p>

		<h1>
			攻略
		</h1>

		<p class="description">
			マイクラマルチサーバーの攻略情報をまとめています。
		</p>

	</section>


	<section class="guide-controls" aria-label="攻略記事の表示条件">
		<label class="guide-control">
			<span>並び替え</span>
			<select id="guide-sort">
				<option value="newest">新着順</option>
				<option value="updated">更新日順</option>
			</select>
		</label>
		<label class="guide-control">
			<span>カテゴリ</span>
			<select id="guide-category">
				<option value="">すべて</option>
				{categories.map((category) => <option value={category}>{category}</option>)}
			</select>
		</label>
		<label class="guide-control">
			<span>タグ</span>
			<select id="guide-tag">
				<option value="">すべて</option>
				{tags.map((tag) => <option value={tag}>{tag}</option>)}
			</select>
		</label>
		<p class="guide-result-count" id="guide-result-count" aria-live="polite"></p>
	</section>

	<p class="tag-filter-empty" id="tag-filter-empty" hidden></p>

	<section class="guide-list" id="guide-list" aria-label="攻略記事一覧">

		{
			sortedGuides.map((guide, index) => (

				<div
					class="guide-card-item"
					data-category={guide.data.category ?? "攻略"}
					data-tags={JSON.stringify(guide.data.tags ?? [])}
					data-created={guide.data.date?.valueOf() ?? 0}
					data-updated={guide.data.updatedAt?.valueOf() ?? guide.data.date?.valueOf() ?? 0}
				>
					<ArticleCard
						title={guide.data.title}
						description={guide.data.description}
						category={guide.data.category ?? "攻略"}
						date={guide.data.date}
						image={guide.data.image}
						icon={guide.data.icon}
						tags={guide.data.tags}
						href={`/guide/${guide.id}/`}
						number={String(index + 1).padStart(2, "0")}
					/>
				</div>

			))
		}

	</section>
	<p class="tag-filter-empty" id="tag-filter-empty" hidden></p>

</Layout>

<script>
	const key = (value: string) => value.normalize('NFKC').trim().toLocaleLowerCase('ja-JP');
	const list = document.getElementById('guide-list');
	const cards = [...document.querySelectorAll<HTMLElement>('.guide-card-item')];
	const sortSelect = document.getElementById('guide-sort') as HTMLSelectElement | null;
	const categorySelect = document.getElementById('guide-category') as HTMLSelectElement | null;
	const tagSelect = document.getElementById('guide-tag') as HTMLSelectElement | null;
	const count = document.getElementById('guide-result-count');
	const empty = document.getElementById('tag-filter-empty');
	const params = new URLSearchParams(window.location.search);
	const initialTag = params.get('tag') ?? '';
	let activeTag = initialTag;

	if (sortSelect && ['newest', 'updated'].includes(params.get('sort') ?? '')) {
		sortSelect.value = params.get('sort')!;
	}
	if (categorySelect) categorySelect.value = params.get('category') ?? '';
	if (tagSelect) tagSelect.value = initialTag;

	const applyFilters = () => {
		if (!list || !sortSelect || !categorySelect || !tagSelect) return;

		const selectedTag = activeTag;
		const sorted = [...cards].sort((a, b) => {
			const dateKey = sortSelect.value === 'updated' ? 'updated' : 'created';
			return Number(b.dataset[dateKey] ?? 0) - Number(a.dataset[dateKey] ?? 0);
		});
		let visibleCount = 0;

		for (const card of sorted) {
			const cardTags = JSON.parse(card.dataset.tags ?? '[]') as string[];
			const matchesCategory = !categorySelect.value || key(card.dataset.category ?? '') === key(categorySelect.value);
			const matchesTag = !selectedTag || cardTags.some((tag) => key(tag) === key(selectedTag));
			card.hidden = !(matchesCategory && matchesTag);
			if (!card.hidden) {
				visibleCount += 1;
				const number = card.querySelector('.article-number');
				if (number) number.textContent = String(visibleCount).padStart(2, '0');
			}
			list.append(card);
		}

		if (count) count.textContent = `${visibleCount}件`;
		if (empty) {
			empty.hidden = visibleCount > 0;
			empty.textContent = visibleCount > 0
				? ''
				: selectedTag
					? `「${selectedTag}」タグが付いた攻略記事はありません。`
					: '条件に一致する攻略記事はありません。';
			empty.setAttribute('role', 'status');
		}

		const nextParams = new URLSearchParams(window.location.search);
		if (sortSelect.value === 'newest') nextParams.delete('sort');
		else nextParams.set('sort', sortSelect.value);
		if (categorySelect.value) nextParams.set('category', categorySelect.value);
		else nextParams.delete('category');
		if (activeTag) nextParams.set('tag', activeTag);
		else nextParams.delete('tag');
		const query = nextParams.toString();
		window.history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`);
	};

	sortSelect?.addEventListener('change', applyFilters);
	categorySelect?.addEventListener('change', applyFilters);
	tagSelect?.addEventListener('change', () => {
		activeTag = tagSelect.value;
		applyFilters();
	});
	applyFilters();
</script>


<style>

	.guide-header {

		padding:
			72px 0 48px;

	}


	.eyebrow {

		font-size:
			11px;

		font-weight:
			700;

		letter-spacing:
			0.14em;

		color:
			var(--color-text-secondary);

	}


	h1 {

		margin-top:
			8px;

		font-size:
			42px;

		line-height:
			1.2;

		letter-spacing:
			-0.04em;

	}


	.description {

		max-width:
			680px;

		margin-top:
			16px;

		font-size:
			16px;

		color:
			var(--color-text-secondary);

	}

	.guide-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: 12px;
		margin-bottom: 24px;
		padding: 16px;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: var(--color-surface);
	}

	.guide-control {
		display: grid;
		min-width: 150px;
		gap: 6px;
		color: var(--color-text-secondary);
		font-size: 12px;
		font-weight: 700;
	}

	.guide-control select {
		width: 100%;
		min-height: 44px;
		padding: 0 34px 0 12px;
		border: 1px solid var(--color-border);
		border-radius: 7px;
		background: var(--color-surface-subtle);
		color: var(--color-text);
		font-size: 14px;
	}

	.guide-control select:focus-visible {
		outline: 3px solid var(--color-accent);
		outline-offset: 2px;
	}

	.guide-result-count {
		margin-left: auto;
		padding: 0 4px 12px;
		color: var(--color-text-secondary);
		font-size: 13px;
		font-weight: 700;
	}

	.tag-filter-empty {
		margin: 0 0 16px;
		color: var(--color-text-secondary);
	}

	.guide-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px 16px;

		padding-bottom:
			40px;

	}


	.guide-card-item[hidden] {
		display: none;
	}

	@media (max-width: 520px) {
		.guide-controls {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 10px;
			padding: 12px;
		}

		.guide-control:first-child {
			grid-column: 1 / -1;
		}

		.guide-control {
			min-width: 0;
		}

		.guide-result-count {
			grid-column: 1 / -1;
			margin-left: 0;
			padding: 0;
		}
	}

	@media (max-width: 768px) {

		.guide-header {

			padding:
				48px 0 32px;

		}


		h1 {

			font-size:
				34px;

		}


		.description {

			font-size:
				14px;

		}


		.guide-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

	}

	@media (max-width: 520px) {
		.guide-list {
			grid-template-columns: 1fr;
		}
	}

</style>