---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/cards/ArticleCard.astro";
import { getCollection } from "astro:content";

const guides = await getCollection("guide");

const sortedGuides = guides
	.filter((guide) => guide.id !== "index")
	.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<Layout
	title="攻略 | ゆるぽーと"
	description="Nekozouneko Serverの攻略情報をまとめています。"
>

	<section class="guide-header">

		<p class="eyebrow">
			GUIDE
		</p>

		<h1>
			攻略
		</h1>

		<p class="description">
			Nekozouneko Serverを楽しむための攻略情報をまとめています。
		</p>

	</section>


	<section class="guide-list">

		{
			sortedGuides.map((guide, index) => (

				<div
					class="guide-card"
					data-tags={JSON.stringify(guide.data.tags ?? [])}
				>
					<ArticleCard
						title={guide.data.title}
						description={guide.data.description}
						category={guide.data.category ?? "攻略"}
						date={guide.data.date}
						image={guide.data.image}
						icon={guide.data.icon}
						tags={guide.data.tags}
						href={`/guide/${guide.id}/`}
						number={String(index + 1).padStart(2, "0")}
					/>
				</div>

			))
		}

	</section>
	<p class="tag-filter-empty" id="tag-filter-empty" hidden></p>

</Layout>

<script>
	const filterTag = new URLSearchParams(window.location.search).get('tag');
	if (filterTag) {
		const key = (value: string) => value.normalize('NFKC').trim().toLocaleLowerCase('ja-JP');
		const cards = [...document.querySelectorAll<HTMLElement>('.guide-card')];
		let visibleCount = 0;
		for (const card of cards) {
			const tags = JSON.parse(card.dataset.tags ?? '[]') as string[];
			const visible = tags.some((tag) => key(tag) === key(filterTag));
			card.hidden = !visible;
			if (visible) visibleCount += 1;
		}
		const empty = document.getElementById('tag-filter-empty');
		if (empty) {
			empty.hidden = visibleCount > 0;
			empty.textContent = visibleCount > 0
				? ''
				: `「${filterTag}」タグが付いた攻略記事はありません。`;
			empty.setAttribute('role', 'status');
			empty.setAttribute('tabindex', '-1');
		}
	}
</script>


<style>

	.guide-header {

		padding:
			72px 0 48px;

	}


	.eyebrow {

		font-size:
			11px;

		font-weight:
			700;

		letter-spacing:
			0.14em;

		color:
			var(--color-text-secondary);

	}


	h1 {

		margin-top:
			8px;

		font-size:
			42px;

		line-height:
			1.2;

		letter-spacing:
			-0.04em;

	}


	.description {

		max-width:
			680px;

		margin-top:
			16px;

		font-size:
			16px;

		color:
			var(--color-text-secondary);

	}


	.guide-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px 16px;

		padding-bottom:
			40px;

	}


	.guide-card[hidden] {
		display: none;
	}

	@media (max-width: 768px) {

		.guide-header {

			padding:
				48px 0 32px;

		}


		h1 {

			font-size:
				34px;

		}


		.description {

			font-size:
				14px;

		}


		.guide-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

	}

	@media (max-width: 520px) {
		.guide-list {
			grid-template-columns: 1fr;
		}
	}

</style>