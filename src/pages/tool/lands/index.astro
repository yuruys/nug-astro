		color:
			var(--lands-text);

		text-decoration:
			none;

		font-size:
			13px;

		font-weight:
			700;

		transition:
			background .18s ease,
			color .18s ease;
	}


	.flow-navigation a:last-child {
		border-right:
			0;
	}


	.flow-navigation a:hover {
		background:
			var(--lands-green);

		color:
			white;
	}


	.flow-navigation a span {
		font-size:
			10px;

		font-weight:
			900;

		opacity:
			.65;
	}


	/* =====================================================
	   Sections
	   ===================================================== */

	.tool-section,
	.rules-section {
		margin-top:
			72px;
	}


	.section-heading {
		display:
			flex;

		align-items:
			flex-start;

		gap:
			16px;

		margin-bottom:
			28px;
	}


	.section-number {
		display:
			flex;

		align-items:
			center;

		justify-content:
			center;

		flex:
			0 0 42px;

		width:
			42px;

		height:
			42px;

		background:
			var(--lands-green);

		color:
			white;

		font-size:
			12px;

		font-weight:
			900;

		box-shadow:
			3px 3px 0 var(--lands-green-dark);
	}


	.section-eyebrow {
		margin:
			0 0 5px;

		color:
			var(--lands-green-dark);

		font-size:
			10px;

		font-weight:
			900;

		letter-spacing:
			.16em;
	}


	.section-heading h2 {
		margin:
			0;

		font-size:
			28px;

		line-height:
			1.3;

		letter-spacing:
			-.03em;
	}


	.section-heading h2 + p {
		margin:
			7px 0 0;

		color:
			var(--lands-text-secondary);

		font-size:
			14px;
	}


	/* =====================================================
	   Conditions
	   ===================================================== */

	.conditions-grid {
		display:
			grid;

		grid-template-columns:
			repeat(2, 1fr);

		gap:
			16px;
	}


	.input-block {
		padding:
			20px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-surface);

		box-shadow:
			var(--lands-shadow);
	}


	.input-block label {
		display:
			block;
	}


	.input-label {
		display:
			block;

		font-size:
			14px;

		font-weight:
			800;
	}


	.input-description {
		display:
			block;

		margin-top:
			4px;

		color:
			var(--lands-text-secondary);

		font-size:
			11px;
	}


	.number-control {
		display:
			grid;

		grid-template-columns:
			44px 1fr 44px;

		height:
			48px;

		margin-top:
			16px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-background);
	}


	.number-control input {
		width:
			100%;

		border:
			0;

		border-left:
			1px solid var(--lands-border);

		border-right:
			1px solid var(--lands-border);

		background:
			transparent;

		color:
			var(--lands-text);

		text-align:
			center;

		font-size:
			17px;

		font-weight:
			800;

		outline:
			none;
	}


	.number-control input:focus {
		background:
			rgba(90, 138, 58, .08);
	}


	.step-button {
		border:
			0;

		background:
			var(--lands-stone);

		color:
			var(--lands-text);

		font-size:
			20px;

		font-weight:
			800;

		cursor:
			pointer;

		transition:
			background .15s ease,
			transform .15s ease;
	}


	.step-button:hover {
		background:
			var(--lands-stone-dark);
	}


	.step-button:active {
		transform:
			translateY(2px);
	}


	/* =====================================================
	   Status
	   ===================================================== */

	.status-options {
		display:
			grid;

		grid-template-columns:
			repeat(2, 1fr);

		gap:
			8px;

		margin-top:
			16px;
	}


	.status-option {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			10px;

		min-height:
			44px;

		padding:
			0 12px;

		border:
			1px solid var(--lands-border);

		border-radius:
			0;

		background:
			var(--lands-background);

		color:
			var(--lands-text);

		cursor:
			pointer;

		text-align:
			left;

		transition:
			background .15s ease,
			border-color .15s ease,
			transform .15s ease;
	}


	.status-option:hover {
		border-color:
			var(--lands-green);
	}


	.status-option.active {
		border-color:
			var(--lands-green);

		background:
			var(--lands-green);

		color:
			white;

		box-shadow:
			2px 2px 0 var(--lands-green-dark);
	}


	.status-option span {
		font-size:
			12px;

		font-weight:
			800;
	}


	.status-option strong {
		font-size:
			10px;

		opacity:
			.8;
	}


	/* =====================================================
	   Currency
	   ===================================================== */

	.currency-input {
		display:
			flex;

		align-items:
			center;

		height:
			48px;

		margin-top:
			16px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-background);
	}


	.currency-input input {
		min-width:
			0;

		flex:
			1;

		height:
			100%;

		padding:
			0 14px;

		border:
			0;

		outline:
			0;

		background:
			transparent;

		color:
			var(--lands-text);

		font-size:
			16px;

		font-weight:
			800;
	}


	.currency-input span {
		padding:
			0 14px;

		color:
			var(--lands-text-secondary);

		font-size:
			13px;

		font-weight:
			900;
	}


	.input-error {
		margin:
			8px 0 0;

		color:
			#b42318;

		font-size:
			11px;
	}


	/* =====================================================
	   Costs
	   ===================================================== */

	.cost-grid {
		display:
			grid;

		grid-template-columns:
			repeat(4, 1fr);

		gap:
			12px;
	}


	.cost-card {
		min-height:
			148px;

		padding:
			20px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-surface);

		box-shadow:
			var(--lands-shadow);

		display:
			flex;

		flex-direction:
			column;

		justify-content:
			space-between;
	}


	.cost-card-primary {
		border-color:
			var(--lands-green);

		box-shadow:
			0 5px 0 var(--lands-green-dark);
	}


	.cost-label {
		color:
			var(--lands-text-secondary);

		font-size:
			11px;

		font-weight:
			800;

		letter-spacing:
			.04em;
	}


	.cost-card strong {
		margin:
			12px 0;

		font-size:
			27px;

		line-height:
			1;
	}


	.cost-card > span:last-child {
		color:
			var(--lands-text-secondary);

		font-size:
			11px;
	}


	/* =====================================================
	   Rule note
	   ===================================================== */

	.rule-note {
		display:
			flex;

		align-items:
			flex-start;

		gap:
			14px;

		margin-top:
			20px;

		padding:
			18px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-background);
	}


	.rule-note-icon {
		display:
			flex;

		align-items:
			center;

		justify-content:
			center;

		flex:
			0 0 28px;

		width:
			28px;

		height:
			28px;

		background:
			var(--lands-green);

		color:
			white;

		font-weight:
			900;
	}


	.rule-note strong {
		font-size:
			13px;
	}


	.rule-note p {
		margin:
			5px 0 0;

		color:
			var(--lands-text-secondary);

		font-size:
			12px;

		line-height:
			1.7;
	}


	/* =====================================================
	   Budget
	   ===================================================== */

	.budget-panel {
		display:
			grid;

		grid-template-columns:
			1fr 1fr;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-surface);

		box-shadow:
			var(--lands-shadow);
	}


	.budget-result,
	.payment-result {
		padding:
			28px;
	}


	.payment-result {
		border-left:
			1px solid var(--lands-border);
	}


	.result-label {
		display:
			block;

		color:
			var(--lands-text-secondary);

		font-size:
			11px;

		font-weight:
			800;

		letter-spacing:
			.06em;
	}


	.result-value {
		display:
			flex;

		align-items:
			baseline;

		gap:
			8px;

		margin-top:
			14px;
	}


	.result-value strong {
		font-size:
			48px;

		line-height:
			1;

		letter-spacing:
			-.05em;
	}


	.result-value span {
		font-size:
			14px;

		font-weight:
			800;
	}


	.budget-result p,
	.payment-result p {
		margin:
			12px 0 0;

		color:
			var(--lands-text-secondary);

		font-size:
			12px;
	}


	.payment-result > strong {
		display:
			block;

		margin-top:
			18px;

		font-size:
			24px;

		line-height:
			1.4;
	}


	/* =====================================================
	   Graph
	   ===================================================== */

	.graph-card {
		position:
			relative;

		margin-top:
			16px;

		border:
			1px solid color-mix(
				in srgb,
				var(--lands-border) 78%,
				white
			);

		background:
			linear-gradient(
				180deg,
				color-mix(
					in srgb,
					var(--lands-surface) 96%,
					white
				) 0%,
				var(--lands-surface) 100%
			);

		box-shadow:
			0 8px 24px rgba(54, 68, 60, .08),
			var(--lands-shadow);

		overflow:
		hidden;
	}


	.graph-header {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			16px;

		padding:
			18px 20px;

		border-bottom:
			1px solid color-mix(
				in srgb,
				var(--lands-border) 72%,
				transparent
			);

		background:
			linear-gradient(
				90deg,
				color-mix(
					in srgb,
					var(--lands-green) 5%,
					transparent
				),
				transparent 55%
			);
	}


	.graph-label,
	.countdown-label {
		display:
			block;

		color:
			var(--lands-green-dark);

		font-size:
			10px;

		font-weight:
			900;

		letter-spacing:
			.14em;
	}


	.graph-header h3 {
		margin:
			5px 0 0;

		font-size:
			16px;

		letter-spacing:
			-.02em;
	}


	#graph-summary {
		max-width:
			260px;

		padding:
			7px 10px;

		border:
			1px solid color-mix(
				in srgb,
				var(--lands-green) 22%,
				var(--lands-border)
			);

		background:
			color-mix(
				in srgb,
				var(--lands-green) 6%,
				var(--lands-surface)
			);

		color:
			var(--lands-green-dark);

		font-size:
			11px;

		font-weight:
			800;

		line-height:
			1.4;

		text-align:
			right;
	}


	.budget-graph {
		height:
			300px;

		padding:
			12px 16px 14px;

		background:
			radial-gradient(
				circle at 82% 8%,
				color-mix(
					in srgb,
					var(--lands-green) 7%,
					transparent
				) 0,
				transparent 34%
			);
	}


	.budget-graph svg {
		display:
			block;

		width:
			100%;

		height:
			100%;

		overflow:
			visible;
	}


	.graph-grid-line {
		stroke:
			var(--lands-border);

		stroke-width:
			1;

		stroke-dasharray:
			2 8;

		opacity:
			.52;
	}


	.graph-vertical-line {
		stroke:
			var(--lands-border);

		stroke-width:
			1;

		stroke-dasharray:
			2 8;

		opacity:
			.22;
	}


	.graph-area {
		fill:
			url(#lands-budget-fill);

		opacity:
			.95;
	}


	.graph-line {
		fill:
			none;

		stroke:
			var(--lands-green);

		stroke-width:
			4;

		stroke-linejoin:
			round;

		stroke-linecap:
			round;

		filter:
			drop-shadow(
				0 2px 5px
				rgba(90, 138, 58, .22)
			);
	}


	.graph-point {
		fill:
			var(--lands-surface);

		stroke:
			var(--lands-green);

		stroke-width:
			3;

		filter:
			drop-shadow(
				0 2px 4px
				rgba(54, 68, 60, .16)
			);
	}


	.graph-point-final {
		fill:
			var(--lands-green);

		stroke:
			var(--lands-surface);

		stroke-width:
			3;

		filter:
			drop-shadow(
				0 2px 5px
				rgba(54, 68, 60, .22)
			);
	}


	.graph-y-label,
	.graph-x-label,
	.graph-value-label {
		fill:
			var(--lands-text-secondary);

		font-family:
			inherit;

		font-variant-numeric:
			tabular-nums;
	}


	.graph-y-label,
	.graph-x-label {
		font-size:
			11px;

		font-weight:
			600;
	}


	.graph-value-label {
		fill:
			var(--lands-text);

		font-size:
			12px;

		font-weight:
			900;

		paint-order:
			stroke;

		stroke:
			var(--lands-surface);

		stroke-width:
			4px;

		stroke-linejoin:
			round;
	}


	.graph-empty {
		display:
			flex;

		align-items:
			center;

		justify-content:
			center;

		height:
			100%;

		border:
			1px dashed var(--lands-border);

		background:
			color-mix(
				in srgb,
				var(--lands-background) 55%,
				transparent
			);

		color:
			var(--lands-text-secondary);

		font-size:
			12px;
	}

	/* =====================================================
	   Countdown
	   ===================================================== */

	.countdown-card {
		display:
			flex;

		align-items:
			center;

		justify-content:
			space-between;

		gap:
			24px;

		margin-top:
			16px;

		padding:
			22px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-background);

		box-shadow:
			var(--lands-shadow);
	}


	.countdown-card h3 {
		margin:
			5px 0 0;

		font-size:
			18px;
	}


	.countdown-card p {
		margin:
			5px 0 0;

		color:
			var(--lands-text-secondary);

		font-size:
			12px;
	}


	.countdown-values {
		display:
			flex;

		gap:
			8px;
	}


	.countdown-values > div {
		display:
			flex;

		flex-direction:
			column;

		align-items:
			center;

		justify-content:
			center;

		min-width:
			62px;

		min-height:
			62px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-surface);
	}


	.countdown-values strong {
		font-size:
			22px;

		line-height:
			1;
	}


	.countdown-values span {
		margin-top:
			5px;

		color:
			var(--lands-text-secondary);

		font-size:
			9px;
	}


	/* =====================================================
	   Reverse
	   ===================================================== */

	.reverse-panel {
		padding:
			24px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-surface);

		box-shadow:
			var(--lands-shadow);
	}


	.reverse-inputs {
		display:
			grid;

		grid-template-columns:
			1fr 40px 1fr;

		align-items:
			end;

		gap:
			12px;
	}


	.date-field label {
		display:
			block;

		margin-bottom:
			8px;

		font-size:
			12px;

		font-weight:
			800;
	}


	.date-field input {
		width:
			100%;

		height:
			46px;

		padding:
			0 12px;

		border:
			1px solid var(--lands-border);

		border-radius:
			0;

		background:
			var(--lands-background);

		color:
			var(--lands-text);

		font-family:
			inherit;

		font-size:
			13px;

		outline:
			none;
	}


	.date-field input:focus {
		border-color:
			var(--lands-green);
	}


	.date-arrow {
		display:
			flex;

		align-items:
			center;

		justify-content:
			center;

		height:
			46px;

		color:
			var(--lands-text-secondary);

		font-size:
			18px;

		font-weight:
			900;
	}


	.reverse-info {
		display:
			flex;

		align-items:
			center;

		gap:
			8px;

		margin-top:
			18px;

		color:
			var(--lands-text-secondary);

		font-size:
			12px;

		font-weight:
			800;
	}


	.reverse-result {
		margin-top:
			22px;

		padding:
			22px;

		border:
			1px solid var(--lands-green);

		background:
			var(--lands-background);
	}


	.reverse-result > span {
		display:
			block;

		color:
			var(--lands-text-secondary);

		font-size:
			11px;

		font-weight:
			800;
	}


	.reverse-result > div {
		display:
			flex;

		align-items:
			baseline;

		gap:
			8px;

		margin-top:
			8px;
	}


	.reverse-result strong {
		font-size:
			42px;

		line-height:
			1;
	}


	.reverse-result > div span {
		font-size:
			13px;

		font-weight:
			800;
	}


	.reverse-result p {
		margin:
			10px 0 0;

		color:
			var(--lands-text-secondary);

		font-size:
			11px;
	}


	/* =====================================================
	   Rules
	   ===================================================== */

	.rules-grid {
		display:
			grid;

		grid-template-columns:
			repeat(4, 1fr);

		gap:
			12px;
	}


	.rules-card {
		padding:
			20px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-surface);
	}


	.rules-card > span {
		display:
			block;

		color:
			var(--lands-green);

		font-size:
			10px;

		font-weight:
			900;
	}


	.rules-card strong {
		display:
			block;

		margin-top:
			10px;

		font-size:
			14px;
	}


	.rules-card p {
		margin:
			8px 0 0;

		color:
			var(--lands-text-secondary);

		font-size:
			11px;

		line-height:
			1.6;
	}


	.multiplier-table {
		margin-top:
			16px;

		border:
			1px solid var(--lands-border);

		background:
			var(--lands-surface);
	}


	.multiplier-row {
		display:
			grid;

		grid-template-columns:
			1fr 120px;

		min-height:
			44px;

		border-bottom:
			1px solid var(--lands-border);
	}


	.multiplier-row:last-child {
		border-bottom:
			0;
	}


	.multiplier-row > * {
		display:
			flex;

		align-items:
			center;

		padding:
			0 16px;

		font-size:
			12px;
	}


	.multiplier-row strong {
		justify-content:
			flex-end;

		color:
			var(--lands-green-dark);
	}


	.multiplier-header {
		background:
			var(--lands-background);

		font-size:
			10px;

