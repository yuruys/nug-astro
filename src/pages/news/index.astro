---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/cards/ArticleCard.astro";

const entries = await getCollection("news");
const sortedEntries = [...entries].sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<Layout title="ニュース | ゆるぽーと" description="Nekozouneko Serverの最新情報を掲載します。">
	<section class="listing-page">
		<header class="page-header">
			<p class="page-label">NEWS</p>
			<h1>ニュース</h1>
			<p class="page-description">Nekozouneko Serverに関する最新情報を掲載します。</p>
		</header>
		<p class="tag-filter-empty" id="tag-filter-empty" hidden></p>
		<div class="entry-list">
			{sortedEntries.map((entry) => (
				<div class="entry-card" data-tags={JSON.stringify(entry.data.tags ?? [])}>
					<ArticleCard
						title={entry.data.title}
						description={entry.data.description}
						category={entry.data.category ?? "ニュース"}
						date={entry.data.date}
						image={entry.data.image}
						icon={entry.data.icon ?? "📰"}
						sourceUrl={entry.data.scbnewsSourceUrl}
						tags={entry.data.tags}
						href={`/news/${entry.id}/`}
					/>
				</div>
			))}
		</div>
	</section>
</Layout>

<script>
	const filterTag = new URLSearchParams(window.location.search).get('tag');
	if (filterTag) {
		const key = (value: string) => value.normalize('NFKC').trim().toLocaleLowerCase('ja-JP');
		const cards = [...document.querySelectorAll<HTMLElement>('.entry-card')];
		let visibleCount = 0;
		for (const card of cards) {
			const tags = JSON.parse(card.dataset.tags ?? '[]') as string[];
			const visible = tags.some((tag) => key(tag) === key(filterTag));
			card.hidden = !visible;
			if (visible) visibleCount += 1;
		}
		const empty = document.getElementById('tag-filter-empty');
		if (empty) {
			empty.hidden = visibleCount > 0;
			empty.textContent = visibleCount > 0
				? ''
				: `「${filterTag}」タグが付いたニュース記事はありません。`;
			empty.setAttribute('role', 'status');
			empty.setAttribute('tabindex', '-1');
		}
	}
</script>

<style>
	.listing-page { padding: 72px 0 100px; }
	.page-header { max-width: 760px; margin-bottom: 48px; }
	.page-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; color: var(--color-text-secondary); }
	.page-header h1 { margin-top: 8px; font-size: clamp(40px, 7vw, 64px); line-height: 1.1; }
	.page-description { margin-top: 16px; color: var(--color-text-secondary); }
	.entry-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px 16px; }
	.entry-card { min-width: 0; }
	.tag-filter-empty { margin: 0 0 16px; color: var(--color-text-secondary); }
	.entry-card[hidden] { display: none; }
	@media (max-width: 768px) { .listing-page { padding: 48px 0 72px; } }
	@media (max-width: 768px) { .entry-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 520px) { .entry-list { grid-template-columns: 1fr; } }
</style>
