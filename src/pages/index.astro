---
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/cards/ArticleCard.astro";


/* =========================================================
   Articles
========================================================= */

const guideEntries = await getCollection("guide");
const newsEntries = await getCollection("news");


const guides = guideEntries
	.filter(
		(entry) =>
			!entry.id.endsWith("/index") &&
			entry.id !== "index"
	)
	.map((entry) => ({
		...entry,
		kind: "guide" as const,
		kindLabel: "攻略",
		href: `/guide/${entry.id}/`,
		category:
			entry.data.category ??
			"攻略",
	}));


const news = newsEntries
	.filter(
		(entry) =>
			!entry.id.endsWith("/index") &&
			entry.id !== "index"
	)
	.map((entry) => ({
		...entry,
		kind: "news" as const,
		kindLabel: "ニュース",
		href: `/news/${entry.id}/`,
		category:
			entry.data.category ??
			"ニュース",
	}));


const articles = [
	...guides,
	...news,
].sort(
	(a, b) =>
		(b.data.date?.valueOf() ?? 0) -
		(a.data.date?.valueOf() ?? 0)
);


/* =========================================================
   Pickup
========================================================= */

const featuredArticles = articles.filter(
	(article) => article.data.featured === true
);


const pickupArticles =
	featuredArticles.length > 0
		? featuredArticles.slice(0, 3)
		: articles.slice(0, 3);


/* =========================================================
   Latest
========================================================= */

const latestArticles = articles.slice(0, 6);
const articleCategories = [...new Set(articles.map((article) => article.category))].sort((a, b) => a.localeCompare(b, "ja"));
const articleTags = new Map<string, number>();
for (const article of articles) {
	for (const tag of article.data.tags ?? []) {
		articleTags.set(tag, (articleTags.get(tag) ?? 0) + 1);
	}
}
---


<Layout
	title="ゆるぽーと｜マイクラマルチ情報局"
	description="マイクラマルチの攻略記事・Wiki・最新ニュースを発信。サーバー情報や便利ツールもまとめた、マインクラフトのマルチプレイを楽しむための総合情報メディア。"
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "ゆるぽーと",
		url: "https://yuruport.com/",
	}}
>


	<!-- =====================================================
	     Three Information Entrances
	===================================================== -->

	<section class="information-section">

		<div class="compact-container">

			<div class="section-heading compact-heading">

				<div>

					<p class="section-label">
						EXPLORE
					</p>

					<h2>
						知りたいことから探す
					</h2>

				</div>

			</div>


			<div class="information-grid">
				<a href="/guide/" class="information-card information-card-guide">
					<span class="information-icon" aria-hidden="true">🎮</span>
					<span class="information-label">GUIDE</span>
					<span class="information-title">攻略</span>
					<span class="information-arrow" aria-hidden="true">→</span>
				</a>

				<a href="/docs/" class="information-card information-card-wiki">
					<span class="information-icon" aria-hidden="true">📖</span>
					<span class="information-label">WIKI</span>
					<span class="information-title">Wiki</span>
					<span class="information-arrow" aria-hidden="true">→</span>
				</a>

				<a href="/news/" class="information-card information-card-news">
					<span class="information-icon" aria-hidden="true">📰</span>
					<span class="information-label">NEWS</span>
					<span class="information-title">ニュース</span>
					<span class="information-arrow" aria-hidden="true">→</span>
				</a>
			</div>

		</div>

	</section>


	<!-- =====================================================
	     Pickup
	===================================================== -->

	{pickupArticles.length > 0 && (

		<section class="media-section pickup-section">

			<div class="compact-container">

				<div class="media-section-heading">

					<div>

						<p class="section-label">
							PICKUP
						</p>

						<h2>
							おすすめの記事
						</h2>

					</div>

					<a
						href="/guide/"
						class="section-more"
					>
						攻略を見る
						<span>→</span>
					</a>

				</div>


				<div class="pickup-grid">

					{pickupArticles.map((article, index) => (

						<div
							class:list={["pickup-item", { "pickup-item-lead": index === 0 }]}
							data-article-kind={article.kind}
						>

							<ArticleCard
								title={article.data.title}
								description={article.data.description}
								category={article.category}
								date={article.data.date}
								image={article.data.image}
								sourceUrl={article.data.scbnewsSourceUrl}
								icon={article.data.icon}
								tags={article.data.tags}
								href={article.href}
								number={String(index + 1).padStart(2, "0")}
							/>

						</div>

					))}

				</div>

			</div>

		</section>

	)}


	<!-- =====================================================
	     Latest Articles
	===================================================== -->

	<section
		class="media-section article-list-section"
		id="articles"
	>

		<div class="compact-container">

			<div class="media-section-heading">

				<div>

					<p class="section-label">
						LATEST
					</p>

					<h2>
						最新の記事
					</h2>

					<p class="section-lead">
						攻略やニュースから、新しい情報をチェックできます。
					</p>

				</div>

			</div>


			<!-- ========================================
			     Category Filter
			======================================== -->

			<div class="article-layout">
				<div class="article-main">
					{latestArticles.length > 0 ? (
						<div class="article-grid">
							{articles.map((article, index) => (
								<div
									class="article-item"
									data-article-kind={article.kind}
									data-article-category={article.category}
									data-article-tags={JSON.stringify(article.data.tags ?? [])}
									data-article-latest={String(index < 6)}
									hidden={index >= 6}
								>
									<ArticleCard
										title={article.data.title}
										description={article.data.description}
										category={article.category}
										date={article.data.date}
										image={article.data.image}
										sourceUrl={article.data.scbnewsSourceUrl}
										icon={article.data.icon}
										tags={article.data.tags}
										href={article.href}
										number={String(index + 1).padStart(2, "0")}
									/>
								</div>
							))}
						</div>
					) : (

				<div class="empty-articles">

					<p>
						記事はまだありません。
					</p>

					<span>
						新しい記事が追加されると、ここに表示されます。
					</span>

				</div>

					)}

					<div class="article-list-footer">
						<a href="/guide/" class="media-more-button">攻略記事を見る <span>→</span></a>
						<a href="/news/" class="media-more-button">ニュースを見る <span>→</span></a>
					</div>
				</div>

				<aside class="article-sidebar" aria-label="記事を探す">
					<section class="sidebar-section">
						<p class="sidebar-label">SEARCH</p>
						<h3>サイト内検索</h3>
						<button class="sidebar-search" type="button" aria-label="サイト内検索を開く">
							<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16L21 21"></path></svg>
							検索を開く
						</button>
					</section>

					<section class="sidebar-section">
						<p class="sidebar-label">CATEGORY</p>
						<h3>カテゴリ</h3>
						<div class="sidebar-links">
							<button type="button" data-category-filter="all" aria-pressed="true">すべて <span>{latestArticles.length}</span></button>
							{articleCategories.map((category) => (
								<button type="button" data-category-filter={category} aria-pressed="false">{category} <span>{articles.filter((article) => article.category === category).length}</span></button>
							))}
						</div>
					</section>

					<section class="sidebar-section">
						<p class="sidebar-label">TAGS</p>
						<h3>タグ</h3>
						{articleTags.size > 0 ? (
							<div class="sidebar-tags">
								{[...articleTags.entries()].sort(([a], [b]) => a.localeCompare(b, "ja")).map(([tag, count]) => (
									<button type="button" data-tag-filter={tag} aria-pressed="false">{tag} <span>{count}</span></button>
								))}
							</div>
						) : <p class="sidebar-empty">タグ付きの記事はまだありません。</p>}
					</section>
				</aside>
			</div>
		</div>

	</section>


	<!-- =====================================================
	     Tools
	===================================================== -->

	<section class="media-section tools-section">

		<div class="compact-container">

			<div class="media-section-heading">

				<div>

					<p class="section-label">
						TOOLS
					</p>

					<h2>
						便利なツール
					</h2>

					<p class="section-lead">
						攻略やプレイに役立つゆるぽーとのツール。
					</p>

				</div>

				<a
					href="/tool/"
					class="section-more"
				>
					ツールを見る
					<span>→</span>
				</a>

			</div>


			<a
				href="/tool/"
				class="tool-card"
			>

				<span class="tool-icon">
					🛠
				</span>

				<div>

					<p class="tool-label">
						yuruport TOOLS
					</p>

					<h3>
						ゲームに役立つツールを使う
					</h3>

					<p>
						計算機など、プレイを少し便利にするツールを提供しています。
					</p>

				</div>

				<span class="tool-arrow">
					→
				</span>

			</a>

		</div>

	</section>


</Layout>


<script>

	const articleItems =
		document.querySelectorAll<HTMLElement>(
			".article-item"
		);
	const categoryButtons = document.querySelectorAll<HTMLButtonElement>("[data-category-filter]");
	const tagButtons = document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]");
	const sidebarSearch = document.querySelector<HTMLButtonElement>(".sidebar-search");
	let activeCategory = "all";
	let activeTag = "";

	function updateArticles() {
		articleItems.forEach((item) => {
			const categoryMatches = activeCategory === "all" || item.dataset.articleCategory === activeCategory;
			const tags = JSON.parse(item.dataset.articleTags ?? "[]") as string[];
			const tagMatches = activeTag === "" || tags.includes(activeTag);
			const hasFilter = activeCategory !== "all" || activeTag !== "";
			item.hidden = !categoryMatches || !tagMatches || (!hasFilter && item.dataset.articleLatest !== "true");
		});
	}

	categoryButtons.forEach((button) => {

		button.addEventListener(
			"click",
			() => {
				activeCategory = button.dataset.categoryFilter ?? "all";
				categoryButtons.forEach((item) => {
					const active = item === button;
					item.classList.toggle("is-active", active);
					item.setAttribute("aria-pressed", String(active));
				});
				updateArticles();
			}
		);
	});

	tagButtons.forEach((button) => button.addEventListener("click", () => {
		const selectedTag = button.dataset.tagFilter ?? "";
		activeTag = activeTag === selectedTag ? "" : selectedTag;
		tagButtons.forEach((item) => {
			const active = item.dataset.tagFilter === activeTag;
			item.classList.toggle("is-active", active);
			item.setAttribute("aria-pressed", String(active));
		});
		updateArticles();
	}));
	sidebarSearch?.addEventListener("click", () => document.dispatchEvent(new CustomEvent("nug:open-search")));
</script>


