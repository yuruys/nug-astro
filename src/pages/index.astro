---
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import SearchBox from "../components/SearchBox.astro";
import ArticleCard from "../components/ArticleCard.astro";


/* =========================================================
   Articles
========================================================= */

const guideEntries = await getCollection("guide");
const newsEntries = await getCollection("news");


const guides = guideEntries
	.filter(
		(entry) =>
			!entry.id.endsWith("/index") &&
			entry.id !== "index"
	)
	.map((entry) => ({
		...entry,
		kind: "guide" as const,
		kindLabel: "攻略",
		href: `/guide/${entry.id}/`,
		category:
			entry.data.category ??
			"攻略",
	}));


const news = newsEntries
	.filter(
		(entry) =>
			!entry.id.endsWith("/index") &&
			entry.id !== "index"
	)
	.map((entry) => ({
		...entry,
		kind: "news" as const,
		kindLabel: "ニュース",
		href: `/news/${entry.id}/`,
		category:
			entry.data.category ??
			"ニュース",
	}));


const articles = [
	...guides,
	...news,
].sort(
	(a, b) =>
		(b.data.date?.valueOf() ?? 0) -
		(a.data.date?.valueOf() ?? 0)
);


/* =========================================================
   Pickup
========================================================= */

const featuredArticles = articles.filter(
	(article) => article.data.featured === true
);


const pickupArticles =
	featuredArticles.length > 0
		? featuredArticles.slice(0, 2)
		: articles.slice(0, 2);


/* =========================================================
   Latest
========================================================= */

const latestArticles = articles.slice(0, 6);
---


<Layout
	title="NUG - Nekozouneko Unofficial Guide"
	description="Minecraft Serverの攻略・仕様・情報をまとめた非公式ガイド"
>


	<!-- =====================================================
	     Hero
	===================================================== -->

	<section class="media-hero">

		<div class="media-hero-inner">

			<div class="media-hero-copy">

				<p class="media-hero-brand">
					NUGBASE
				</p>

				<h1>
					もっと分かりやすく、
					<br />
					もっと楽しく。
				</h1>

				<p class="media-hero-description">
					Minecraftマルチサーバーの攻略・仕様・最新情報
				</p>

			</div>


			<div class="media-hero-image">

				<img
					src="/images/main.webp"
					alt=""
				/>

			</div>

		</div>

	</section>


	<!-- =====================================================
	     Search
	===================================================== -->

	<section class="search-section">

		<div class="compact-container">

			<SearchBox />

		</div>

	</section>


	<!-- =====================================================
	     Three Information Entrances
	===================================================== -->

	<section class="information-section">

		<div class="compact-container">

			<div class="section-heading compact-heading">

				<div>

					<p class="section-label">
						EXPLORE
					</p>

					<h2>
						知りたいことから探す
					</h2>

				</div>

			</div>


			<div class="information-grid">

				<!-- Guide -->

				<a
					href="/guide/"
					class="information-card information-card-guide"
				>

					<div class="information-icon">
						🎮
					</div>

					<div class="information-body">

						<p class="information-label">
							GUIDE
						</p>

						<h3>
							攻略－知る・遊ぶ
						</h3>

						<p>
							初心者向けの解説から実践的な攻略まで、
							新しい楽しみ方や魅力を見つけられます。
						</p>

					</div>

					<span class="information-arrow">
						→
					</span>

				</a>


				<!-- Wiki -->

				<a
					href="/docs/"
					class="information-card information-card-wiki"
				>

					<div class="information-icon">
						📖
					</div>

					<div class="information-body">

						<p class="information-label">
							WIKI
						</p>

						<h3>
							Wiki－調べる
						</h3>

						<p>
							プラグインの仕様やコマンドなど、
							遊んでいて気になった情報を調べられます。
						</p>

					</div>

					<span class="information-arrow">
						→
					</span>

				</a>


				<!-- News -->

				<a
					href="/news/"
					class="information-card information-card-news"
				>

					<div class="information-icon">
						📰
					</div>

					<div class="information-body">

						<p class="information-label">
							NEWS
						</p>

						<h3>
							NEWS－最新情報
						</h3>

						<p>
							サーバー内のイベントや仕様変更、
							Minecraftのアップデートをお知らせします。
						</p>

					</div>

					<span class="information-arrow">
						→
					</span>

				</a>
			</div>

		</div>

	</section>


	<!-- =====================================================
	     Pickup
	===================================================== -->

	{pickupArticles.length > 0 && (

		<section class="media-section pickup-section">

			<div class="compact-container">

				<div class="media-section-heading">

					<div>

						<p class="section-label">
							PICKUP
						</p>

						<h2>
							おすすめの記事
						</h2>

					</div>

					<a
						href="/guide/"
						class="section-more"
					>
						攻略を見る
						<span>→</span>
					</a>

				</div>


				<div class="pickup-grid">

					{pickupArticles.map((article, index) => (

						<div
							class="pickup-item"
							data-article-kind={article.kind}
						>

							<ArticleCard
								title={article.data.title}
								description={article.data.description}
								category={article.category}
								date={article.data.date}
								image={article.data.image}
								icon={article.data.icon}
								href={article.href}
								number={String(index + 1).padStart(2, "0")}
							/>

						</div>

					))}

				</div>

			</div>

		</section>

	)}


	<!-- =====================================================
	     Latest Articles
	===================================================== -->

	<section
		class="media-section article-list-section"
		id="articles"
	>

		<div class="compact-container">

			<div class="media-section-heading">

				<div>

					<p class="section-label">
						LATEST
					</p>

					<h2>
						最新の記事
					</h2>

					<p class="section-lead">
						攻略やニュースから、新しい情報をチェックできます。
					</p>

				</div>

			</div>


			<!-- ========================================
			     Category Filter
			======================================== -->

			<nav
				class="article-filter"
				aria-label="記事カテゴリ"
			>

				<button
					type="button"
					class="article-filter-button is-active"
					data-filter="all"
					aria-pressed="true"
				>
					すべて
				</button>

				<button
					type="button"
					class="article-filter-button"
					data-filter="guide"
					aria-pressed="false"
				>
					攻略
				</button>

				<button
					type="button"
					class="article-filter-button"
					data-filter="news"
					aria-pressed="false"
				>
					ニュース
				</button>

			</nav>


			{latestArticles.length > 0 ? (

				<div class="article-grid">

					{latestArticles.map((article, index) => (

						<div
							class="article-item"
							data-article-kind={article.kind}
						>

							<ArticleCard
								title={article.data.title}
								description={article.data.description}
								category={article.category}
								date={article.data.date}
								image={article.data.image}
								icon={article.data.icon}
								href={article.href}
								number={String(index + 1).padStart(2, "0")}
							/>

						</div>

					))}

				</div>

			) : (

				<div class="empty-articles">

					<p>
						記事はまだありません。
					</p>

					<span>
						新しい記事が追加されると、ここに表示されます。
					</span>

				</div>

			)}


			<div class="article-list-footer">

				<a
					href="/guide/"
					class="media-more-button"
				>
					攻略記事を見る
					<span>→</span>
				</a>

				<a
					href="/news/"
					class="media-more-button"
				>
					ニュースを見る
					<span>→</span>
				</a>

			</div>

		</div>

	</section>


	<!-- =====================================================
	     Tools
	===================================================== -->

	<section class="media-section tools-section">

		<div class="compact-container">

			<div class="media-section-heading">

				<div>

					<p class="section-label">
						TOOLS
					</p>

					<h2>
						便利なツール
					</h2>

					<p class="section-lead">
						攻略やプレイに役立つNUGBASEのツール。
					</p>

				</div>

				<a
					href="/tool/"
					class="section-more"
				>
					ツールを見る
					<span>→</span>
				</a>

			</div>


			<a
				href="/tool/"
				class="tool-card"
			>

				<span class="tool-icon">
					🛠
				</span>

				<div>

					<p class="tool-label">
						NUGBASE TOOLS
					</p>

					<h3>
						ゲームに役立つツールを使う
					</h3>

					<p>
						計算機など、プレイを少し便利にするツールを提供しています。
					</p>

				</div>

				<span class="tool-arrow">
					→
				</span>

			</a>

		</div>

	</section>


</Layout>


<script>

	const filterButtons =
		document.querySelectorAll<HTMLButtonElement>(
			".article-filter-button"
		);

	const articleItems =
		document.querySelectorAll<HTMLElement>(
			".article-item"
		);


	filterButtons.forEach((button) => {

		button.addEventListener(
			"click",
			() => {

				const filter =
					button.dataset.filter ?? "all";


				filterButtons.forEach((item) => {

					const active =
						item === button;

					item.classList.toggle(
						"is-active",
						active
					);

					item.setAttribute(
						"aria-pressed",
						String(active)
					);

				});


				articleItems.forEach((item) => {

					const kind =
						item.dataset.articleKind;

					const visible =
						filter === "all" ||
						kind === filter;

					item.hidden =
						!visible;

				});

			}
		);

	});

</script>


