---

<button
	class="wiki-sidebar-toggle"
	type="button"
	aria-label="Wikiサイドバーを開く"
	aria-expanded="false"
	aria-controls="starlight__sidebar"
>
	<span class="wiki-sidebar-toggle-icon" aria-hidden="true">›</span>
</button>

<script>
	const button = document.querySelector<HTMLButtonElement>('.wiki-sidebar-toggle');
	const sidebar = document.querySelector<HTMLElement>('.sidebar');
	const sidebarPane = document.querySelector<HTMLElement>('.sidebar-pane');
	const icon = button?.querySelector<HTMLElement>('.wiki-sidebar-toggle-icon');

	if (button && sidebar && sidebarPane) {
		const updateState = (isOpen: boolean) => {
			document.documentElement.classList.toggle('wiki-sidebar-open', isOpen);
			button.setAttribute('aria-expanded', String(isOpen));
			button.setAttribute(
				'aria-label',
				isOpen ? 'Wikiサイドバーを閉じる' : 'Wikiサイドバーを開く'
			);
			if (icon) icon.textContent = isOpen ? '‹' : '›';
		};

		const isOpen = () =>
			document.documentElement.classList.contains('wiki-sidebar-open');

		const openSidebar = () => updateState(true);
		const closeSidebar = () => updateState(false);

		button.addEventListener('click', () => {
			if (isOpen()) closeSidebar();
			else openSidebar();
		});

		sidebar.addEventListener('click', (event) => {
			const target = event.target as HTMLElement;
			if (target.closest('a')) closeSidebar();
		});

		document.addEventListener('click', (event) => {
			if (!isOpen()) return;
			const target = event.target as Node;
			if (!sidebar.contains(target) && !button.contains(target)) closeSidebar();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeSidebar();
		});

		let touchStartX = 0;
		let touchStartY = 0;

		document.addEventListener('touchstart', (event) => {
			const touch = event.touches[0];
			if (!touch) return;
			touchStartX = touch.clientX;
			touchStartY = touch.clientY;
		}, { passive: true });

		document.addEventListener('touchend', (event) => {
			const touch = event.changedTouches[0];
			if (!touch) return;

			const deltaX = touch.clientX - touchStartX;
			const deltaY = touch.clientY - touchStartY;
			if (Math.abs(deltaX) < 60 || Math.abs(deltaX) <= Math.abs(deltaY)) return;

			if (!isOpen() && touchStartX <= 24 && deltaX > 0) openSidebar();
			if (isOpen() && touchStartX <= sidebarPane.getBoundingClientRect().width && deltaX < 0) {
				closeSidebar();
			}
		}, { passive: true });

		updateState(false);
	}
</script>