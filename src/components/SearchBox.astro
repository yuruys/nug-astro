<script>

	const searchBox =
		document.querySelector<HTMLButtonElement>(
			".search-box"
		);


	searchBox?.addEventListener(
		"click",
		() => {

			document.dispatchEvent(
				new CustomEvent(
					"nug:open-search"
				)
			);

		}
	);

</script>


