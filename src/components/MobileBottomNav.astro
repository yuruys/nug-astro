	</a>

	<a href="/guide/" class="bottom-nav-item">
		<svg
			viewBox="0 0 24 24"
			aria-hidden="true"
			focusable="false"
		>
			<path d="M5 4.5h11a3 3 0 0 1 3 3V20H8a3 3 0 0 1-3-3V4.5Z" />
			<path d="M8 7h7" />
			<path d="M8 11h7" />
			<path d="M8 15h5" />
		</svg>

		<span>攻略</span>
	</a>

	<a href="/docs/" class="bottom-nav-item">
		<svg
			viewBox="0 0 24 24"
			aria-hidden="true"
			focusable="false"
		>
			<path d="M4 5h16v14H4z" />
			<path d="M8 9h8" />
			<path d="M8 13h8" />
			<path d="M8 17h5" />
		</svg>

