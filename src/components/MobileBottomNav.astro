---
const pathname = Astro.url.pathname;

const isHome = pathname === "/";
const isGuide = pathname.startsWith("/guide/");
const isWiki = pathname.startsWith("/docs/");
const isTool = pathname.startsWith("/tool/");
const isNews = pathname.startsWith("/news/");
const isAbout = pathname.startsWith("/about/");

const isMore = isNews || isAbout;

const activeIndex = isHome
	? 0
	: isGuide
		? 1
		: isWiki
			? 2
			: isTool
				? 3
				: 4;

/*
 * 選択インジケーターの移動量。
 *
 * 5列なので、
 * 1列 = 20%
 *
 * CSS側で複雑な計算を行わず、
 * Astro側で値を確定させます。
 */
const activeOffset = `${activeIndex * 20}%`;
---

<nav
	class="mobile-bottom-nav"
	aria-label="モバイルナビゲーション"
	style={`--active-index: ${activeIndex}; --active-offset: ${activeOffset};`}
>
	<!-- ======================================================
	     展開ツールバー

	     「その他」を押すと、
	     下部バーの真上へ展開します。

	     内容：
	     ・ニュース
	     ・NUGについて
	     ・× 閉じる
	====================================================== -->

	<div
		id="mobile-more-panel"
		class="mobile-more-panel"
		aria-hidden="true"
	>
		<div class="mobile-more-panel-inner">

			<!-- ================================================
			     ニュース
			================================================ -->

			<a
				href="/news/"
				class:list={[
					"mobile-more-item",
					{ "is-active": isNews },
				]}
				aria-current={isNews ? "page" : undefined}
			>
				<span class="mobile-more-item-icon">
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<path d="M4 5h16v14H4z" />
						<path d="M8 9h8" />
						<path d="M8 13h6" />
						<path d="M8 17h4" />
					</svg>
				</span>

				<span class="mobile-more-item-text">
					<strong>ニュース</strong>
					<small>NUGBASEの最新情報</small>
				</span>

				<svg
					class="mobile-more-item-arrow"
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="m9 18 6-6-6-6" />
				</svg>
			</a>


			<!-- ================================================
			     NUGについて
			================================================ -->

			<a
				href="/about/"
				class:list={[
					"mobile-more-item",
					{ "is-active": isAbout },
				]}
				aria-current={isAbout ? "page" : undefined}
			>
				<span class="mobile-more-item-icon">
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<circle cx="12" cy="12" r="9" />
						<path d="M12 10v6" />
						<path d="M12 7.5h.01" />
					</svg>
				</span>

				<span class="mobile-more-item-text">
					<strong>NUGについて</strong>
					<small>NUGBASEについて</small>
				</span>

				<svg
					class="mobile-more-item-arrow"
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="m9 18 6-6-6-6" />
				</svg>
			</a>


			<!-- ================================================
			     閉じる
			================================================ -->

			<button
				type="button"
				class="mobile-more-close"
				aria-label="その他のメニューを閉じる"
			>
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M6 6l12 12" />
					<path d="M18 6 6 18" />
				</svg>
			</button>

		</div>
	</div>


	<!-- ======================================================
	     メイン下部ナビゲーション
	====================================================== -->

	<div class="mobile-bottom-nav-track">

		<!-- ==================================================
		     選択インジケーター
		================================================== -->

		<div
			class="bottom-nav-indicator"
			aria-hidden="true"
		>
			<span class="bottom-nav-indicator-shine"></span>
		</div>


		<!-- ==================================================
		     ホーム
		================================================== -->

		<a
			href="/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isHome },
			]}
			aria-current={isHome ? "page" : undefined}
		>
			<span class="bottom-nav-icon">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M3 10.5 12 3l9 7.5" />
					<path d="M5 9.5V21h14V9.5" />
					<path d="M9 21v-6h6v6" />
				</svg>
			</span>

			<span class="bottom-nav-label">
				ホーム
			</span>
		</a>


		<!-- ==================================================
		     攻略
		================================================== -->

		<a
			href="/guide/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isGuide },
			]}
			aria-current={isGuide ? "page" : undefined}
		>
			<span class="bottom-nav-icon">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M5 4.5h11a3 3 0 0 1 3 3V20H8a3 3 0 0 1-3-3V4.5Z" />
					<path d="M8 7h7" />
					<path d="M8 11h7" />
					<path d="M8 15h5" />
				</svg>
			</span>

			<span class="bottom-nav-label">
				攻略
			</span>
		</a>


		<!-- ==================================================
		     Wiki
		================================================== -->

		<a
			href="/docs/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isWiki },
			]}
			aria-current={isWiki ? "page" : undefined}
		>
			<span class="bottom-nav-icon">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M4 5h16v14H4z" />
					<path d="M8 9h8" />
					<path d="M8 13h8" />
					<path d="M8 17h5" />
				</svg>
			</span>

			<span class="bottom-nav-label">
				Wiki
			</span>
		</a>


		<!-- ==================================================
		     ツール
		================================================== -->

		<a
			href="/tool/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isTool },
			]}
			aria-current={isTool ? "page" : undefined}
		>
			<span class="bottom-nav-icon">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="m14.5 5.5 4 4" />
					<path d="m13 7 4 4" />
					<path d="m4 20 6.5-6.5" />
					<path d="m7 21-4-4" />
					<path d="m10 14 4-4" />
					<path d="M14 4 16 2l6 6-2 2" />
				</svg>
			</span>

			<span class="bottom-nav-label">
				ツール
			</span>
		</a>


		<!-- ==================================================
		     その他
		================================================== -->

		<button
			type="button"
			class:list={[
				"bottom-nav-item",
				"bottom-nav-more",
				{ "is-active": isMore },
			]}
			aria-label="その他のメニュー"
			aria-expanded="false"
			aria-controls="mobile-more-panel"
		>
			<span class="bottom-nav-icon">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<circle cx="5" cy="12" r="1.5" />
					<circle cx="12" cy="12" r="1.5" />
					<circle cx="19" cy="12" r="1.5" />
				</svg>
			</span>

			<span class="bottom-nav-label">
				その他
			</span>
		</button>

	</div>

</nav>


<script>
	/* ========================================================
	   Elements
	======================================================== */

	const bottomNav =
		document.querySelector<HTMLElement>(
			".mobile-bottom-nav"
		);

	const moreButton =
		document.querySelector<HTMLButtonElement>(
			".bottom-nav-more"
		);

	const morePanel =
		document.querySelector<HTMLElement>(
			"#mobile-more-panel"
		);

	const moreClose =
		document.querySelector<HTMLButtonElement>(
			".mobile-more-close"
		);


	/* ========================================================
	   Move to body

	   Starlightのレイアウトから切り離して、
	   viewport固定ナビゲーションとして動作させます。
	======================================================== */

	if (
		bottomNav &&
		bottomNav.parentElement !== document.body
	) {
		document.body.appendChild(bottomNav);
	}


	/* ========================================================
	   More panel state
	======================================================== */

	const setMoreState =
		(open: boolean): void => {

			if (
				!moreButton ||
				!morePanel ||
				!bottomNav
			) {
				return;
			}

			moreButton.setAttribute(
				"aria-expanded",
				String(open)
			);

			morePanel.setAttribute(
				"aria-hidden",
				String(!open)
			);

			bottomNav.classList.toggle(
				"is-more-open",
				open
			);

			morePanel.classList.toggle(
				"is-open",
				open
			);

			document.documentElement.classList.toggle(
				"nug-bottom-nav-expanded",
				open
			);
		};


	/* ========================================================
	   More panel events
	======================================================== */

	if (
		moreButton &&
		morePanel &&
		bottomNav
	) {

		/* ----------------------------------------
		   その他ボタン
		---------------------------------------- */

		moreButton.addEventListener(
			"click",
			() => {

				const isOpen =
					moreButton.getAttribute(
						"aria-expanded"
					) === "true";

				setMoreState(!isOpen);
			}
		);


		/* ----------------------------------------
		   × ボタン
		---------------------------------------- */

		moreClose?.addEventListener(
			"click",
			() => {
				setMoreState(false);
				moreButton.focus();
			}
		);


		/* ----------------------------------------
		   ページリンクを押したら閉じる
		---------------------------------------- */

		morePanel
			.querySelectorAll<HTMLAnchorElement>("a")
			.forEach((link) => {

				link.addEventListener(
					"click",
					() => {
						setMoreState(false);
					}
				);
			});


		/* ----------------------------------------
		   ナビゲーション外をクリックしたら閉じる
		---------------------------------------- */

		document.addEventListener(
			"click",
			(event) => {

				const target =
					event.target;

				if (
					!(target instanceof Node)
				) {
					return;
				}

				if (
					!bottomNav.contains(target)
				) {
					setMoreState(false);
				}
			}
		);


		/* ----------------------------------------
		   Escape
		---------------------------------------- */

		document.addEventListener(
			"keydown",
			(event) => {

				if (
					event.key === "Escape"
				) {
					setMoreState(false);
				}
			}
		);
	}


	/* ========================================================
	   More panel swipe

	   上方向へ展開されたパネルなので、

	   下方向スワイプ
	   → 閉じる
	======================================================== */

	if (morePanel) {

		let startX = 0;
		let startY = 0;

		morePanel.addEventListener(
			"touchstart",
			(event) => {

				const touch =
					event.touches[0];

				if (!touch) {
					return;
				}

				startX =
					touch.clientX;

				startY =
					touch.clientY;
			},
			{
				passive: true,
			}
		);


		morePanel.addEventListener(
			"touchend",
			(event) => {

				const touch =
					event.changedTouches[0];

				if (!touch) {
					return;
				}

				const deltaX =
					touch.clientX -
					startX;

				const deltaY =
					touch.clientY -
					startY;

				if (
					deltaY > 45 &&
					Math.abs(deltaY) >
						Math.abs(deltaX) * 1.2
				) {
					setMoreState(false);
				}
			},
			{
				passive: true,
			}
		);
	}


	/* ========================================================
	   Desktop resize

	   PC幅になったら
	   「その他」を閉じます。
	======================================================== */

	const mediaQuery =
		window.matchMedia(
			"(min-width: 1024px)"
		);

	const handleDesktop =
		(event: MediaQueryListEvent): void => {

			if (!event.matches) {
				return;
			}

			setMoreState(false);
		};

	mediaQuery.addEventListener(
		"change",
		handleDesktop
	);
</script>


<style>
	/* ========================================================
	   NUGBASE Mobile Bottom Navigation
	   --------------------------------------------------------
	   Visual system:
	   - Minecraft / BSL inspired
	   - Square / block-like UI
	   - No rounded UI
	   - Global NUGBASE tokens
	   ======================================================== */


	/* ========================================================
	   Global shape rule

	   このコンポーネント内のUIは
	   すべて完全な角型に統一します。
	======================================================== */

	.mobile-bottom-nav,
	.mobile-bottom-nav *,
	.mobile-bottom-nav *::before,
	.mobile-bottom-nav *::after {

		border-radius: 0 !important;
	}


	/* ========================================================
	   Desktop
	======================================================== */

	.mobile-bottom-nav {
		display: none;
	}


	/* ========================================================
	   Tablet / Mobile
	======================================================== */

	@media (max-width: 1023px) {

		/* ======================================================
		   Navigation shell
		====================================================== */

		.mobile-bottom-nav {

			--nav-padding: 7px;

			position: fixed !important;

			left: 0 !important;
			right: 0 !important;
			bottom: 0 !important;
			top: auto !important;

			z-index: 10000 !important;

			display: flex;

			flex-direction: column;

			width: 100%;

			box-sizing: border-box;

			padding:
				7px
				var(--nav-padding)
				calc(
					7px +
					env(safe-area-inset-bottom)
				);

			background:
				linear-gradient(
					180deg,
					color-mix(
						in srgb,
						var(--nug-surface, #eeeeee)
						96%,
						var(--nug-background, #ffffff)
					),
					var(--nug-background, #ffffff)
				);

			border-top:
				2px solid
				color-mix(
					in srgb,
					var(--nug-accent, #c9962f)
					28%,
					var(--nug-border, #d8d8d8)
				);

			box-shadow:
				0 -4px 0
				color-mix(
					in srgb,
					var(--nug-border, #d8d8d8)
					55%,
					transparent
				),
				0 -10px 28px
				rgba(
					0,
					0,
					0,
					0.14
				);

			transition:
				padding 0.28s
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);
		}


		/* ======================================================
		   Main Track
		====================================================== */

		.mobile-bottom-nav-track {

			position: relative;

			display: grid;

			grid-template-columns:
				repeat(
					5,
					minmax(0, 1fr)
				);

			gap: 0;

			width: 100%;

			height: 58px;

			box-sizing: border-box;
		}


		/* ======================================================
		   Selection Indicator
		====================================================== */

		.bottom-nav-indicator {

			position: absolute;

			z-index: 0;

			top: 0;
			bottom: 0;

			left:
				var(--active-offset);

			width:
				20%;

			box-sizing: border-box;

			padding:
				0 2px;

			pointer-events: none;

			transition:
				left
				0.30s
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				);
		}


		.bottom-nav-indicator::before {

			content: "";

			position: absolute;

			inset:
				0 2px;

			border:
				1px solid
				color-mix(
					in srgb,
					var(--nug-accent, #c9962f)
					40%,
					var(--nug-border, #d8d8d8)
				);

			border-top:
				3px solid
				var(--nug-accent, #c9962f);

			background:
				linear-gradient(
					180deg,
					color-mix(
						in srgb,
						var(--nug-accent, #c9962f)
						14%,
						var(--nug-background, #ffffff)
					),
					color-mix(
						in srgb,
						var(--nug-accent, #c9962f)
						5%,
						var(--nug-background, #ffffff)
					)
				);

			box-shadow:
				0 2px 0
				color-mix(
					in srgb,
					var(--nug-accent, #c9962f)
					16%,
					transparent
				);
		}


		/* ======================================================
		   Indicator Shine
		====================================================== */

		.bottom-nav-indicator-shine {

			position: absolute;

			z-index: 1;

			top: 4px;
			left: 8px;
			right: 8px;

			height: 2px;

			background:
				linear-gradient(
					90deg,
					transparent,
					rgba(
						255,
						255,
						255,
						0.34
					),
					transparent
				);
		}


		/* ======================================================
		   Main Buttons
		====================================================== */

		.bottom-nav-item {

			position: relative;

			z-index: 1;

			min-width: 0;

			height: 58px;

			display: flex;

			flex-direction: column;

			align-items: center;

			justify-content: center;

			gap: 3px;

			box-sizing: border-box;

			padding:
				4px 2px;

			border:
				1px solid transparent;

			background:
				transparent;

			color:
				var(
					--nug-text-secondary,
					#666666
				);

			font: inherit;

			font-size: 10px;

			font-weight: 700;

			line-height: 1;

			text-decoration: none;

			cursor: pointer;

			-webkit-tap-highlight-color:
				transparent;

			touch-action:
				manipulation;

			transition:
				color 0.18s ease,
				background 0.18s ease,
				border-color 0.18s ease,
				transform 0.12s ease;
		}


		/* ======================================================
		   Icon
		====================================================== */

		.bottom-nav-icon {

			width: 23px;
			height: 23px;

			display: grid;

			place-items: center;

			flex-shrink: 0;
		}


		.bottom-nav-icon svg {

			width: 22px;
			height: 22px;

			fill: none;

			stroke:
				currentColor;

			stroke-width: 1.8;

			stroke-linecap: square;
			stroke-linejoin: miter;
		}


		.bottom-nav-more .bottom-nav-icon svg {

			fill:
				currentColor;

			stroke: none;
		}


		/* ======================================================
		   Active
		====================================================== */

		.bottom-nav-item.is-active {

			color:
				var(
					--nug-accent,
					#c9962f
				);
		}


		.bottom-nav-item.is-active
		.bottom-nav-icon svg {

			transform:
				translateY(-1px);
		}


		/* ======================================================
		   Hover / Focus
		====================================================== */

		.bottom-nav-item:hover {

			color:
				var(
					--nug-text,
					#222222
				);

			background:
				color-mix(
					in srgb,
					var(--nug-surface, #eeeeee)
					45%,
					transparent
				);
		}


		.bottom-nav-item:focus-visible {

			outline:
				2px solid
				var(
					--nug-accent,
					#c9962f
				);

			outline-offset:
				-2px;
		}


		.bottom-nav-item:active {

			transform:
				translateY(2px);
		}


		/* ======================================================
		   Expanded Toolbar
		====================================================== */

		.mobile-more-panel {

			order: -1;

			display: grid;

			grid-template-rows:
				0fr;

			width: 100%;

			overflow: hidden;

			opacity: 0;

			border-bottom:
				0 solid
				var(--nug-border, #d8d8d8);

			transition:
				grid-template-rows
				0.30s
				cubic-bezier(
					0.22,
					1,
					0.36,
					1
				),
				opacity
				0.20s ease,
				border-bottom-width
				0.20s ease;
		}


		.mobile-more-panel.is-open {

			grid-template-rows:
				1fr;

			opacity: 1;

			border-bottom-width:
				1px;
		}


		/* ======================================================
		   Expanded Panel Inner

		   上下の余白を縮小。
		   これにより、通常時に
		   ボタン上側へ生じていた余白を減らします。
		====================================================== */

		.mobile-more-panel-inner {

			min-height: 0;

			display: grid;

			grid-template-columns:
				minmax(0, 1fr)
				minmax(0, 1fr)
				44px;

			align-items: center;

			gap: 5px;

			padding:
				3px 0;

			box-sizing: border-box;
		}


		/* ======================================================
		   Expanded Items
		====================================================== */

		.mobile-more-item {

			min-width: 0;

			height: 42px;

			display: flex;

			align-items: center;

			gap: 7px;

			padding:
				4px 8px;

			box-sizing: border-box;

			border:
				1px solid
				var(--nug-border, #d8d8d8);

			border-left:
				3px solid
				color-mix(
					in srgb,
					var(--nug-accent, #c9962f)
					45%,
					var(--nug-border, #d8d8d8)
				);

			background:
				linear-gradient(
					180deg,
					color-mix(
						in srgb,
						var(--nug-surface, #eeeeee)
						94%,
