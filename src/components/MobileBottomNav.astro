---
const pathname = Astro.url.pathname;

const isHome = pathname === "/";
const isGuide = pathname.startsWith("/guide/");
const isWiki = pathname.startsWith("/docs/");
const isNews = pathname.startsWith("/news/");
const isTool = pathname.startsWith("/tool/");
const isAbout = pathname.startsWith("/about/");

/*
 * メイン5項目
 *
 * 1. ホーム
 * 2. 攻略
 * 3. Wiki
 * 4. ニュース
 * 5. その他
 *
 * ツール / NUGについて は
 * 「その他」からアクセスできます。
 */

const isMore =
	isTool ||
	isAbout;

const activeIndex = isHome
	? 0
	: isGuide
		? 1
		: isWiki
			? 2
			: isNews
				? 3
				: 4;

const activeOffset = `${activeIndex * 20}%`;
---

<nav
	class="mobile-bottom-nav"
	aria-label="NUGBASEメインナビゲーション"
	style={`--active-index: ${activeIndex}; --active-offset: ${activeOffset};`}
>

	<!-- ======================================================
	     その他パネル
	====================================================== -->

	<div
		id="mobile-more-panel"
		class="mobile-more-panel"
		aria-hidden="true"
	>
		<div class="mobile-more-panel-inner">

			<!-- ==================================================
			     ツール
			================================================== -->

			<a
				href="/tool/"
				class:list={[
					"mobile-more-item",
					{ "is-active": isTool },
				]}
				aria-current={isTool ? "page" : undefined}
			>

				<span class="mobile-more-item-icon">

					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<path d="m14.5 5.5 4 4" />
						<path d="m13 7 4 4" />
						<path d="m4 20 6.5-6.5" />
						<path d="m7 21-4-4" />
						<path d="m10 14 4-4" />
						<path d="M14 4 16 2l6 6-2 2" />
					</svg>

				</span>

				<span class="mobile-more-item-text">

					<strong>
						ツール
					</strong>

					<small>
						攻略に役立つ便利な機能
					</small>

				</span>

				<svg
					class="mobile-more-item-arrow"
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="m9 18 6-6-6-6" />
				</svg>

			</a>


			<!-- ==================================================
			     NUGについて
			================================================== -->

			<a
				href="/about/"
				class:list={[
					"mobile-more-item",
					{ "is-active": isAbout },
				]}
				aria-current={isAbout ? "page" : undefined}
			>

				<span class="mobile-more-item-icon">

					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
						focusable="false"
					>
						<circle cx="12" cy="12" r="9" />
						<path d="M12 10v6" />
						<path d="M12 7.5h.01" />
					</svg>

				</span>

				<span class="mobile-more-item-text">

					<strong>
						NUGについて
					</strong>

					<small>
						NUGBASEについて
					</small>

				</span>

				<svg
					class="mobile-more-item-arrow"
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="m9 18 6-6-6-6" />
				</svg>

			</a>


			<!-- ==================================================
			     閉じる
			================================================== -->

			<button
				type="button"
				class="mobile-more-close"
				aria-label="その他のメニューを閉じる"
			>

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M6 6l12 12" />
					<path d="M18 6 6 18" />
				</svg>

			</button>

		</div>
	</div>


	<!-- ======================================================
	     メインナビゲーション
	====================================================== -->

	<div class="mobile-bottom-nav-track">

		<!-- アクティブインジケーター -->

		<div
			class="bottom-nav-indicator"
			aria-hidden="true"
		>
			<span class="bottom-nav-indicator-top"></span>
		</div>


		<!-- ==================================================
		     ホーム
		================================================== -->

		<a
			href="/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isHome },
			]}
			aria-current={isHome ? "page" : undefined}
		>

			<span class="bottom-nav-icon">

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M3 10.5 12 3l9 7.5" />
					<path d="M5 9.5V21h14V9.5" />
					<path d="M9 21v-6h6v6" />
				</svg>

			</span>

			<span class="bottom-nav-label">
				ホーム
			</span>

		</a>


		<!-- ==================================================
		     攻略
		================================================== -->

		<a
			href="/guide/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isGuide },
			]}
			aria-current={isGuide ? "page" : undefined}
		>

			<span class="bottom-nav-icon">

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M5 4.5h11a3 3 0 0 1 3 3V20H8a3 3 0 0 1-3-3V4.5Z" />
					<path d="M8 7h7" />
					<path d="M8 11h7" />
					<path d="M8 15h5" />
				</svg>

			</span>

			<span class="bottom-nav-label">
				攻略
			</span>

		</a>


		<!-- ==================================================
		     Wiki
		================================================== -->

		<a
			href="/docs/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isWiki },
			]}
			aria-current={isWiki ? "page" : undefined}
		>

			<span class="bottom-nav-icon">

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M4 5h16v14H4z" />
					<path d="M8 9h8" />
					<path d="M8 13h8" />
					<path d="M8 17h5" />
				</svg>

			</span>

			<span class="bottom-nav-label">
				Wiki
			</span>

		</a>


		<!-- ==================================================
		     ニュース
		================================================== -->

		<a
			href="/news/"
			class:list={[
				"bottom-nav-item",
				{ "is-active": isNews },
			]}
			aria-current={isNews ? "page" : undefined}
		>

			<span class="bottom-nav-icon">

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<path d="M4 5h16v14H4z" />
					<path d="M8 9h8" />
					<path d="M8 13h6" />
					<path d="M8 17h4" />
				</svg>

			</span>

			<span class="bottom-nav-label">
				ニュース
			</span>

		</a>


		<!-- ==================================================
		     その他
		================================================== -->

		<button
			type="button"
			class:list={[
				"bottom-nav-item",
				"bottom-nav-more",
				{ "is-active": isMore },
			]}
			aria-label="その他のメニュー"
			aria-expanded="false"
			aria-controls="mobile-more-panel"
		>

			<span class="bottom-nav-icon">

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
					focusable="false"
				>
					<circle cx="5" cy="12" r="1.6" />
					<circle cx="12" cy="12" r="1.6" />
					<circle cx="19" cy="12" r="1.6" />
				</svg>

			</span>

			<span class="bottom-nav-label">
				その他
			</span>

		</button>

	</div>

</nav>


<script>
	/* ========================================================
	   Elements
	======================================================== */

	const bottomNav =
		document.querySelector<HTMLElement>(
			".mobile-bottom-nav"
		);

	const moreButton =
		document.querySelector<HTMLButtonElement>(
			".bottom-nav-more"
		);

	const morePanel =
		document.querySelector<HTMLElement>(
			"#mobile-more-panel"
		);

	const moreClose =
		document.querySelector<HTMLButtonElement>(
			".mobile-more-close"
		);


	/* ========================================================
	   Move navigation to body
	======================================================== */

	if (
		bottomNav &&
		bottomNav.parentElement !== document.body
	) {
		document.body.appendChild(bottomNav);
	}


	/* ========================================================
	   More state
	======================================================== */

	const setMoreState =
		(open: boolean): void => {

			if (
				!moreButton ||
				!morePanel ||
				!bottomNav
			) {
				return;
			}

			moreButton.setAttribute(
				"aria-expanded",
				String(open)
			);

			morePanel.setAttribute(
				"aria-hidden",
				String(!open)
			);

			bottomNav.classList.toggle(
				"is-more-open",
				open
			);

			morePanel.classList.toggle(
				"is-open",
				open
			);

			document.documentElement.classList.toggle(
				"nug-bottom-nav-expanded",
				open
			);
		};


	/* ========================================================
	   More button
	======================================================== */

	moreButton?.addEventListener(
		"click",
		() => {

			const open =
				moreButton.getAttribute(
					"aria-expanded"
				) === "true";

			setMoreState(!open);
		}
	);


	/* ========================================================
	   Close button
	======================================================== */

	moreClose?.addEventListener(
		"click",
		() => {

			setMoreState(false);

			moreButton?.focus();
		}
	);


	/* ========================================================
	   Close after navigation
	======================================================== */

	morePanel
		?.querySelectorAll<HTMLAnchorElement>("a")
		.forEach((link) => {

			link.addEventListener(
				"click",
				() => {
					setMoreState(false);
				}
			);

		});


	/* ========================================================
	   Outside click
	======================================================== */

	document.addEventListener(
		"click",
		(event) => {

			const target =
				event.target;

			if (
				!(target instanceof Node)
			) {
				return;
			}

			if (
				bottomNav &&
				!bottomNav.contains(target)
			) {
				setMoreState(false);
			}

		}
	);


	/* ========================================================
	   Escape
	======================================================== */

	document.addEventListener(
		"keydown",
		(event) => {

			if (
				event.key === "Escape"
			) {
				setMoreState(false);
			}

		}
	);


	/* ========================================================
	   Swipe down to close
	======================================================== */

	if (morePanel) {

		let startX = 0;
		let startY = 0;

		morePanel.addEventListener(
			"touchstart",
			(event) => {

				const touch =
					event.touches[0];

				if (!touch) {
					return;
				}

				startX =
					touch.clientX;

				startY =
					touch.clientY;

			},
			{
				passive: true,
			}
		);


		morePanel.addEventListener(
			"touchend",
			(event) => {

				const touch =
					event.changedTouches[0];

				if (!touch) {
					return;
				}

				const deltaX =
					touch.clientX -
					startX;

				const deltaY =
					touch.clientY -
					startY;

				if (
					deltaY > 45 &&
					Math.abs(deltaY) >
						Math.abs(deltaX) * 1.2
				) {
					setMoreState(false);
				}

			},
			{
				passive: true,
			}
		);
	}


	/* ========================================================
	   Desktop resize
	======================================================== */

	const mediaQuery =
		window.matchMedia(
			"(min-width: 1024px)"
		);

	const handleDesktop =
		(event: MediaQueryListEvent): void => {

			if (event.matches) {
				setMoreState(false);
			}

		};

	mediaQuery.addEventListener(
		"change",
		handleDesktop
	);
</script>


<style>

/* =========================================================
   NUGBASE MOBILE BOTTOM NAV
   ---------------------------------------------------------
   Design specification
   ---------------------------------------------------------
   • Minecraft / BSL inspired
   • Block / square UI
   • Grass green = active / primary
   • Gold = NUGBASE accent
   • Stone = borders / structure
   • Hard lower shadow
   • Minimal rounded geometry
   • Information hierarchy is visible at a glance
========================================================= */


/* =========================================================
   Shape
========================================================= */

.mobile-bottom-nav,
.mobile-bottom-nav *,
.mobile-bottom-nav *::before,
.mobile-bottom-nav *::after {

	border-radius: 0 !important;
}


/* =========================================================
   Desktop
========================================================= */

.mobile-bottom-nav {

	display: none;
}


/* =========================================================
   Tablet / Mobile
========================================================= */

@media (max-width: 1023px) {

	/* ======================================================
	   Shell
	====================================================== */

	.mobile-bottom-nav {

		--nav-height: 64px;

		position: fixed !important;

		left: 0 !important;
		right: 0 !important;
		bottom: 0 !important;
		top: auto !important;

		z-index: 10000 !important;

		display: flex;

		flex-direction: column;

		width: 100%;

		box-sizing: border-box;

		padding:
			5px
			8px
			calc(
				5px +
				env(safe-area-inset-bottom)
			);

		background:
			linear-gradient(
				180deg,
				var(--color-surface),
				var(--color-background)
			);

		border-top:
			2px solid
			var(--color-border-strong);

		box-shadow:
			0 -4px 0
			var(--color-border),
			0 -10px 28px
			var(--color-shadow);

		transition:
			padding 0.25s
			cubic-bezier(
				0.22,
				1,
				0.36,
				1
			);
	}


	/* ======================================================
	   Track
	====================================================== */

	.mobile-bottom-nav-track {

		position: relative;

		display: grid;

		grid-template-columns:
			repeat(
				5,
				minmax(0, 1fr)
			);

		width: 100%;

		height: var(--nav-height);

		box-sizing: border-box;
	}


	/* ======================================================
	   Active Indicator
	====================================================== */

	.bottom-nav-indicator {

		position: absolute;

		z-index: 0;

		top: 0;
		bottom: 0;

		left:
			var(--active-offset);

		width: 20%;

		padding: 0 2px;

		box-sizing: border-box;

		pointer-events: none;

		transition:
			left 0.28s
			cubic-bezier(
				0.22,
				1,
				0.36,
				1
			);
	}


	.bottom-nav-indicator::before {

		content: "";

		position: absolute;

		inset: 0 2px;

		border:
			1px solid
			var(--color-border);

		border-top:
			3px solid
			var(--color-grass);

		background:
			linear-gradient(
				180deg,
				var(--color-accent-soft),
				transparent
			);

		box-shadow:
			0 3px 0
			var(--color-border);
	}


	/* ======================================================
	   Grass highlight
	====================================================== */

	.bottom-nav-indicator-top {

		position: absolute;

		z-index: 2;

		top: 4px;
		left: 10px;
		right: 10px;

		height: 2px;

		background:
			linear-gradient(
				90deg,
				transparent,
				var(--color-grass-light),
				transparent
			);
	}


	/* ======================================================
	   Item
	====================================================== */

	.bottom-nav-item {

		position: relative;

		z-index: 1;

		display: flex;

		flex-direction: column;

		align-items: center;

		justify-content: center;

		gap: 4px;

		min-width: 0;

		height: var(--nav-height);

		padding:
			5px 2px;

		box-sizing: border-box;

		border: 1px solid transparent;

		background: transparent;

		color:
			var(--color-text-secondary);

		font: inherit;

		font-size: 10px;

		font-weight: 800;

		line-height: 1;

		text-decoration: none;

		cursor: pointer;

		-webkit-tap-highlight-color: transparent;

		touch-action: manipulation;

		transition:
			color 0.18s ease,
			background-color 0.18s ease,
			transform 0.12s ease;
	}


	/* ======================================================
	   Icon
	====================================================== */

	.bottom-nav-icon {

		display: grid;

		place-items: center;

		width: 24px;
		height: 24px;

		flex-shrink: 0;
	}


	.bottom-nav-icon svg {

		width: 22px;
		height: 22px;

		fill: none;

		stroke:
			currentColor;

		stroke-width: 1.8;

		stroke-linecap: square;
		stroke-linejoin: miter;

		transition:
			transform 0.18s ease;
	}


	.bottom-nav-more
	.bottom-nav-icon svg {

		fill:
			currentColor;

		stroke: none;
	}


	/* ======================================================
	   Active
	====================================================== */

	.bottom-nav-item.is-active {

		color:
			var(--color-grass);
	}


	.bottom-nav-item.is-active
	.bottom-nav-icon svg {

		transform:
			translateY(-1px);
	}


	.bottom-nav-item.is-active
	.bottom-nav-label {

		font-weight: 900;
	}


	/* ======================================================
	   Hover
	====================================================== */

	.bottom-nav-item:hover {

		color:
			var(--color-text);
	}


	.bottom-nav-item:hover
	.bottom-nav-icon svg {

		transform:
			translateY(-1px);
	}


	/* ======================================================
	   Focus
	====================================================== */

	.bottom-nav-item:focus-visible {

		outline:
			2px solid
			var(--color-grass);

		outline-offset:
			-2px;
	}


	/* ======================================================
	   Press
	====================================================== */

	.bottom-nav-item:active {

		transform:
			translateY(2px);
	}


	/* ======================================================
	   More panel
	====================================================== */

	.mobile-more-panel {

		order: -1;

		display: grid;

		grid-template-rows: 0fr;

		width: 100%;

		overflow: hidden;

		opacity: 0;

		border-bottom:
			0 solid
			var(--color-border);

		transition:
			grid-template-rows 0.28s
			cubic-bezier(
				0.22,
				1,
				0.36,
				1
			),
			opacity 0.18s ease,
			border-bottom-width 0.18s ease;
	}


	.mobile-more-panel.is-open {

		grid-template-rows: 1fr;

		opacity: 1;

		border-bottom-width: 1px;
	}


	/* ======================================================
	   More panel inner
	====================================================== */

	.mobile-more-panel-inner {

		min-height: 0;

		display: grid;

		grid-template-columns:
			minmax(0, 1fr)
			minmax(0, 1fr)
			52px;

		align-items: center;

		gap: 8px;

		padding:
			8px 0;

		box-sizing: border-box;
	}


	/* ======================================================
	   More item
	====================================================== */

	.mobile-more-item {

		min-width: 0;

		height: 52px;

		display: flex;

		align-items: center;

		gap: 9px;

		padding:
			5px 9px;

		box-sizing: border-box;

		border:
			1px solid
			var(--color-border);

		border-left:
			3px solid
			var(--color-grass);

		background:
			var(--color-surface);

		color:
			var(--color-text);

		text-decoration: none;

		box-shadow:
			3px 3px 0
			var(--color-border);

		transition:
			background-color 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.12s ease;
	}


	.mobile-more-item.is-active {

		border-left-color:
			var(--color-gold);

	}


	.mobile-more-item:hover,
	.mobile-more-item:focus-visible {

		background:
			var(--color-surface-hover);

		border-color:
			var(--color-grass);

		outline: none;

		box-shadow:
			4px 4px 0
			var(--color-grass);
	}


	.mobile-more-item:active {

		transform:
			translate(
				2px,
				2px
			);

		box-shadow:
			1px 1px 0
			var(--color-border);
	}


	/* ======================================================
	   More icon
	====================================================== */

	.mobile-more-item-icon {

		display: grid;

		place-items: center;

		width: 30px;
		height: 30px;

		flex-shrink: 0;

		border:
			1px solid
			var(--color-border);

		background:
			var(--color-accent-soft);

		color:
			var(--color-grass);
	}


	.mobile-more-item-icon svg {

		width: 16px;
		height: 16px;

		fill: none;

		stroke:
			currentColor;

		stroke-width: 1.8;

		stroke-linecap: square;
		stroke-linejoin: miter;
	}


	/* ======================================================
	   More text
	====================================================== */

	.mobile-more-item-text {

		display: flex;

		flex-direction: column;

		justify-content: center;

		gap: 2px;

		min-width: 0;
	}


	.mobile-more-item-text strong {

		overflow: hidden;

		font-size: 12px;

		font-weight: 900;

		line-height: 1.2;

		white-space: nowrap;

		text-overflow: ellipsis;
	}


	.mobile-more-item-text small {

		overflow: hidden;

		color:
			var(--color-text-secondary);

		font-size: 8px;

		line-height: 1.2;

		white-space: nowrap;

		text-overflow: ellipsis;
	}


	/* ======================================================
	   Arrow
	====================================================== */

	.mobile-more-item-arrow {

		width: 16px;
		height: 16px;

		margin-left: auto;

		flex-shrink: 0;

		fill: none;

		stroke:
			var(--color-text-secondary);

		stroke-width: 1.8;

		stroke-linecap: square;
		stroke-linejoin: miter;
	}


	/* ======================================================
	   Close
	====================================================== */

	.mobile-more-close {

