---
import Search from '@astrojs/starlight/components/Search.astro';
---

<header class="site-header">
	<div class="header-inner">

		<!-- ========================================
		     Logo
		======================================== -->

		<a
			href="/"
			class="logo"
			aria-label="NUG ホーム"
		>
			<span class="logo-main">NUG</span>

			<span class="logo-sub">
				Nekozouneko Unofficial Guide
			</span>
		</a>


		<!-- ========================================
		     Desktop Navigation
		======================================== -->

		<nav
			class="desktop-nav"
			aria-label="メインナビゲーション"
		>
			<a href="/guide/">攻略</a>
			<a href="/docs/">Wiki</a>
			<a href="/news/">ニュース</a>
			<a href="/tool/">ツール</a>
			<a href="/about/">NUGについて</a>
		</nav>


		<!-- ========================================
		     Header Actions
		======================================== -->

		<div class="header-actions">

			<!-- Dark Mode -->
			<button
				type="button"
				class="theme-toggle"
				aria-label="ダークモードに切り替え"
				title="テーマを切り替える"
			>
				<svg
					class="theme-icon theme-icon-sun"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="12"
						cy="12"
						r="4"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
					/>

					<path
						d="M12 2v2"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>

					<path
						d="M12 20v2"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>

					<path
						d="M4.93 4.93l1.41 1.41"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>

					<path
						d="M17.66 17.66l1.41 1.41"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>

					<path
						d="M2 12h2"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>

					<path
						d="M20 12h2"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>

					<path
						d="M4.93 19.07l1.41-1.41"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>

					<path
						d="M17.66 6.34l1.41-1.41"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
					/>
				</svg>

				<svg
					class="theme-icon theme-icon-moon"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path
						d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linejoin="round"
					/>
				</svg>
			</button>


			<!-- Search -->
			<div class="header-search">
				<Search />
			</div>


			<!-- Mobile NUG Menu -->
			<button
				type="button"
				class="mobile-menu-button"
				aria-label="メニューを開く"
				aria-expanded="false"
				aria-controls="nug-mobile-menu"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>

		</div>
	</div>
</header>


<!-- ========================================
     Mobile NUG Menu
======================================== -->

<div
	id="nug-mobile-menu"
	class="mobile-menu"
	aria-hidden="true"
>
	<nav aria-label="モバイルナビゲーション">

		<a href="/guide/">
			<span>攻略</span>
		</a>

		<a href="/docs/">
			<span>Wiki</span>
		</a>

		<a href="/news/">
			<span>ニュース</span>
		</a>

		<a href="/tool/">
			<span>ツール</span>
		</a>

		<a href="/about/">
			<span>NUGについて</span>
		</a>

	</nav>
</div>


<script>
	/* ========================================
	   Theme
	======================================== */

	const themeButton =
		document.querySelector<HTMLButtonElement>('.theme-toggle');

	const storageKey = 'nug-theme';

	const applyTheme = (theme: 'light' | 'dark') => {
		document.documentElement.dataset.theme = theme;

		if (themeButton) {
			themeButton.setAttribute(
				'aria-label',
				theme === 'dark'
					? 'ライトモードに切り替え'
					: 'ダークモードに切り替え'
			);
		}
	};


	const getCurrentTheme = (): 'light' | 'dark' => {
		const current =
			document.documentElement.dataset.theme;

		if (current === 'dark') {
			return 'dark';
		}

		return 'light';
	};


	themeButton?.addEventListener('click', () => {
		const currentTheme = getCurrentTheme();

		const nextTheme =
			currentTheme === 'dark'
				? 'light'
				: 'dark';

		localStorage.setItem(storageKey, nextTheme);

		applyTheme(nextTheme);
	});


	/* ========================================
	   Mobile NUG Menu
	======================================== */

	const mobileMenuButton =
		document.querySelector<HTMLButtonElement>(
			'.mobile-menu-button'
		);

	const mobileMenu =
		document.querySelector<HTMLElement>(
			'#nug-mobile-menu'
		);


	const setMobileMenu =
		(open: boolean) => {

			if (!mobileMenuButton || !mobileMenu) {
				return;
			}

			mobileMenuButton.setAttribute(
				'aria-expanded',
				String(open)
			);

			mobileMenuButton.setAttribute(
				'aria-label',
				open
					? 'メニューを閉じる'
					: 'メニューを開く'
			);

			mobileMenu.setAttribute(
				'aria-hidden',
				String(!open)
			);

			mobileMenu.classList.toggle(
				'is-open',
				open
			);

			document.body.classList.toggle(
				'nug-menu-open',
				open
			);
		};


	mobileMenuButton?.addEventListener(
		'click',
		() => {

			const isOpen =
				mobileMenuButton.getAttribute(
					'aria-expanded'
				) === 'true';

			setMobileMenu(!isOpen);
		}
	);


	/* ========================================
	   Close Mobile Menu
	======================================== */

	mobileMenu?.querySelectorAll('a').forEach((link) => {

		link.addEventListener('click', () => {
			setMobileMenu(false);
		});

	});


	document.addEventListener('keydown', (event) => {

		if (event.key === 'Escape') {
			setMobileMenu(false);
		}

	});


	/* ========================================
	   Resize
	======================================== */

	window.addEventListener('resize', () => {

		if (window.innerWidth > 850) {
			setMobileMenu(false);
		}

	});
</script>


<style>
	/* ========================================
	   Header
	======================================== */

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;

		width: 100%;
		height: 60px;

		background: var(--nug-background);
		border-bottom: 1px solid var(--nug-border);

		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
	}


	.header-inner {
		width: min(
			var(--nug-content-width),
			calc(100% - 48px)
		);

		height: 100%;
		margin: 0 auto;

		display: flex;
		align-items: center;
		justify-content: space-between;

		gap: 24px;
	}


	/* ========================================
	   Logo
	======================================== */

	.logo {
		display: inline-flex;
		align-items: baseline;

		gap: 10px;

		color: var(--nug-text);
		text-decoration: none;

		white-space: nowrap;

		flex-shrink: 0;
	}


	.logo-main {
		font-size: 21px;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
	}


	.logo-sub {
		color: var(--nug-text-secondary);

		font-size: 11px;
		font-weight: 500;

		letter-spacing: 0;

		line-height: 1;
	}


	.logo:hover {
		color: var(--nug-text);
	}


	/* ========================================
	   Desktop Navigation
	======================================== */

	.desktop-nav {
		display: flex;
		align-items: center;

		gap: 24px;

		margin-left: auto;
	}


	.desktop-nav a {
		position: relative;

		display: inline-flex;
		align-items: center;

		height: 60px;

		color: var(--nug-text-secondary);

		font-size: 14px;
		font-weight: 600;

		text-decoration: none;

		white-space: nowrap;

		transition:
			color 0.18s ease,
			opacity 0.18s ease;
	}


	.desktop-nav a:hover {
		color: var(--nug-text);
	}


	/* ========================================
	   Header Actions
	======================================== */

	.header-actions {
		display: flex;
		align-items: center;

		gap: 8px;

		flex-shrink: 0;
	}


	/* ========================================
	   Theme Button
	======================================== */

	.theme-toggle {
		width: 36px;
		height: 36px;

		display: inline-flex;
		align-items: center;
		justify-content: center;

		padding: 0;

		border: 0;
		border-radius: 10px;

		background: transparent;
		color: var(--nug-text-secondary);

		cursor: pointer;

		transition:
			background 0.18s ease,
			color 0.18s ease;
	}


	.theme-toggle:hover {
		background: var(--nug-surface-hover);
		color: var(--nug-text);
	}


	.theme-icon {
		width: 19px;
		height: 19px;
	}


	.theme-icon-sun {
		display: none;
	}


	.theme-icon-moon {
		display: block;
	}


	:global(html[data-theme='dark']) .theme-icon-sun {
		display: block;
	}


	:global(html[data-theme='dark']) .theme-icon-moon {
		display: none;
	}


	/* ========================================
	   Search
	======================================== */

	.header-search {
		display: flex;
		align-items: center;
	}


	/* ========================================
	   Mobile Menu Button
	======================================== */

	.mobile-menu-button {
		display: none;

		width: 36px;
		height: 36px;

		padding: 0;

		border: 0;
		border-radius: 10px;

		background: transparent;

		cursor: pointer;

		align-items: center;
		justify-content: center;

		flex-direction: column;

		gap: 4px;
	}


	.mobile-menu-button:hover {
		background: var(--nug-surface-hover);
	}


	.mobile-menu-button span {
		display: block;

		width: 18px;
		height: 1.5px;

		border-radius: 999px;

		background: var(--nug-text);
	}


	/* ========================================
	   Mobile Menu
	======================================== */

	.mobile-menu {
		display: none;

		position: fixed;

		top: 60px;
		left: 0;
		right: 0;

		z-index: 99;

		background: var(--nug-background);

		border-bottom: 1px solid var(--nug-border);

		box-shadow:
			0 12px 30px rgba(0, 0, 0, 0.08);

		opacity: 0;
		transform: translateY(-8px);

		pointer-events: none;

		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}


	.mobile-menu.is-open {
		display: block;

		opacity: 1;
		transform: translateY(0);

		pointer-events: auto;
	}


	.mobile-menu nav {
		display: flex;
		flex-direction: column;

		padding: 8px 16px 16px;
	}


	.mobile-menu a {
		display: flex;
		align-items: center;

		min-height: 48px;

		padding: 0 12px;

		border-radius: 10px;

		color: var(--nug-text);

		font-size: 15px;
		font-weight: 600;

		text-decoration: none;
	}


	.mobile-menu a:hover {
		background: var(--nug-surface-hover);
	}


	/* ========================================
	   Mobile
	======================================== */

	@media (max-width: 850px) {

		.site-header {
			height: 60px;
		}


		.header-inner {
			width: calc(100% - 24px);

			gap: 8px;
		}


		.logo {
			gap: 7px;
		}


		.logo-main {
			font-size: 20px;
		}


		.logo-sub {
			display: none;
		}


		.desktop-nav {
			display: none;
		}


		.header-actions {
			margin-left: auto;

			gap: 4px;
		}


		.mobile-menu-button {
			display: inline-flex;
		}


		.header-search {
			display: flex;
		}

	}


	/* ========================================
	   Small Mobile
	======================================== */

	@media (max-width: 480px) {

		.header-inner {
			width: calc(100% - 16px);
		}


		.theme-toggle,
		.mobile-menu-button {
			width: 34px;
			height: 34px;
		}

	}
</style>