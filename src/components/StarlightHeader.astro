---
import Search from '@astrojs/starlight/components/Search.astro';
---

<header class="site-header">
	<div class="header-inner">
		<a href="/" class="logo" aria-label="NUG ホーム">
			<span class="logo-main">NUG</span>
			<span class="logo-sub">Nekozouneko Unofficial Guide</span>
		</a>

		<nav class="desktop-nav" aria-label="メインナビゲーション">
			<a href="/guide/">攻略</a>
			<a href="/docs/" class="active">Wiki</a>
			<a href="/news/">ニュース</a>
			<a href="/tool/">ツール</a>
			<a href="/about/">NUGについて</a>
		</nav>

		<div class="header-actions">
			<div class="search-wrapper" aria-label="検索">
				<Search />
			</div>
			<button class="menu-button" type="button" aria-label="メニューを開く" aria-expanded="false">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>

	<div class="mobile-menu">
		<nav aria-label="モバイルナビゲーション">
			<a href="/guide/">📖 攻略</a>
			<a href="/docs/">📚 Wiki</a>
			<a href="/news/">📰 ニュース</a>
			<a href="/tool/">🛠️ ツール</a>
			<a href="/about/">ℹ️ NUGについて</a>
		</nav>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>('.site-header .menu-button');
	const menu = document.querySelector<HTMLElement>('.site-header .mobile-menu');

	button?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('open') ?? false;
		button.setAttribute('aria-expanded', String(isOpen));
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			menu?.classList.remove('open');
			button?.setAttribute('aria-expanded', 'false');
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		background: color-mix(in srgb, var(--nug-background) 92%, transparent);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--nug-border);
	}

	.header-inner {
		width: min(var(--nug-content-width), calc(100% - 48px));
		min-height: 68px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.logo {
		display: flex;
		align-items: baseline;
		gap: 10px;
		flex-shrink: 0;
		color: var(--nug-text);
	}

	.logo-main {
		font-size: 23px;
		font-weight: 800;
		letter-spacing: -0.05em;
	}

	.logo-sub {
		font-size: 11px;
		color: var(--nug-text-secondary);
		white-space: nowrap;
	}

	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 4px;
		margin-left: auto;
	}

	.desktop-nav a {
		display: flex;
		align-items: center;
		min-height: 40px;
		padding: 0 14px;
		border-radius: 10px;
		font-size: 14px;
		font-weight: 500;
		color: var(--nug-text-secondary);
		transition: background 150ms ease, color 150ms ease, transform 150ms ease;
	}

	.desktop-nav a:hover,
	.desktop-nav a.active {
		background: var(--nug-surface);
		color: var(--nug-text);
	}

	.desktop-nav a.active {
		font-weight: 600;
	}

	.desktop-nav a:active {
		transform: scale(0.96);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-left: 4px;
	}

	.search-wrapper,
	.search-wrapper site-search :global(button[data-open-modal]) {
		width: 40px;
		height: 40px;
	}

	.search-wrapper site-search :global(button[data-open-modal]) {
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		color: var(--nug-text);
		transition: background 150ms ease, transform 150ms ease;
	}

	.search-wrapper site-search :global(button[data-open-modal]):hover {
		background: var(--nug-surface);
	}

	.search-wrapper site-search :global(button[data-open-modal]):active {
		transform: scale(0.92);
	}

	.search-wrapper site-search :global(button[data-open-modal]) :global(svg) {
		width: 19px;
		height: 19px;
		color: currentColor;
	}

	.menu-button {
		display: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 4px;
		background: transparent;
		color: var(--nug-text);
		transition: background 150ms ease, transform 150ms ease;
	}

	.menu-button:hover,
	.menu-button[aria-expanded='true'] {
		background: var(--nug-surface);
	}

	.menu-button:active {
		transform: scale(0.92);
	}

	.menu-button span {
		width: 18px;
		height: 1.5px;
		background: currentColor;
		border-radius: 999px;
	}

	.mobile-menu {
		display: none;
	}

	@media (max-width: 850px) {
		.header-inner {
			min-height: 60px;
			width: calc(100% - 32px);
		}

		.logo-sub,
		.desktop-nav {
			display: none;
		}

		.header-actions {
			margin-left: auto;
			padding-right: 48px;
		}

		.menu-button {
			display: flex;
		}

		.mobile-menu {
			position: fixed;
			top: 60px;
			left: 16px;
			right: 16px;
			z-index: 99;
			display: block;
			padding: 10px;
			background: color-mix(in srgb, var(--nug-background) 96%, transparent);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border: 1px solid var(--nug-border);
			border-radius: 16px;
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
			opacity: 0;
			transform: translateY(-8px);
			pointer-events: none;
			transition: opacity 150ms ease, transform 150ms ease;
		}

		.mobile-menu.open {
			opacity: 1;
			transform: translateY(0);
			pointer-events: auto;
		}

		.mobile-menu nav {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}

		.mobile-menu a {
			display: block;
			padding: 13px 14px;
			border-radius: 10px;
			font-size: 14px;
		}

		.mobile-menu a:hover {
			background: var(--nug-surface);
		}
	}

	@media (min-width: 50rem) and (max-width: 850px) {
		.header-actions {
			padding-right: 0;
		}
	}
</style>
