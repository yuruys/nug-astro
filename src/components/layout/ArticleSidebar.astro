---
interface ArticleLink {
	title: string;
	href: string;
	category?: string;
}

interface Props {
	contentType: 'guide' | 'news';
	categoryArticles: ArticleLink[];
	relatedArticles: ArticleLink[];
	tags: string[];
}

const { contentType, categoryArticles, relatedArticles, tags } = Astro.props;
const listingPath = contentType === 'guide' ? '/guide/' : '/news/';
const listingLabel = contentType === 'guide' ? '攻略一覧へ戻る' : 'ニュース一覧へ戻る';
---

<aside class="article-sidebar" aria-label="記事ナビゲーション">
	<section class="sidebar-section search-section">
		<h2>記事を検索</h2>
		<button
			class="search-trigger"
			type="button"
			aria-label="サイト内検索を開く"
			aria-controls="nug-search-overlay"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
				<circle cx="11" cy="11" r="6.5"></circle>
				<path d="M16 16l5 5"></path>
			</svg>
			<span>サイト内を検索</span>
		</button>
	</section>

	{categoryArticles.length > 0 && (
		<section class="sidebar-section category-section">
			<h2>同じカテゴリの記事</h2>
			<ul>
				{categoryArticles.map((article) => (
					<li><a href={article.href}>{article.title}</a></li>
				))}
			</ul>
		</section>
	)}

	{tags.length > 0 && (
		<section class="sidebar-section tags-section">
			<h2>関連タグ</h2>
			<div class="tag-links">
				{tags.map((tag) => (
					<a href={`${listingPath}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
				))}
			</div>
		</section>
	)}

	{relatedArticles.length > 0 && (
		<section class="sidebar-section related-section">
			<h2>関連記事</h2>
			<ul>
				{relatedArticles.map((article) => (
					<li><a href={article.href}>{article.title}</a></li>
				))}
			</ul>
		</section>
	)}

	<a class="back-link" href={listingPath}>← {listingLabel}</a>
</aside>

<script>
	const searchTrigger = document.querySelector<HTMLButtonElement>('.search-trigger');
	searchTrigger?.addEventListener('click', () => {
		document.dispatchEvent(new CustomEvent('nug:open-search'));
	});
</script>

<style>
	.article-sidebar {
		display: flex;
		flex-direction: column;
		gap: 18px;
		min-width: 0;
		padding-top: 40px;
	}

	.sidebar-section {
		min-width: 0;
		padding: 16px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.sidebar-section h2 {
		margin: 0 0 12px;
		font-size: 13px;
		font-weight: 800;
	}

	.sidebar-section ul {
		display: grid;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sidebar-section li a {
		display: block;
		color: var(--color-text-secondary);
		font-size: 12px;
		line-height: 1.55;
		overflow-wrap: anywhere;
	}

	.sidebar-section li a:hover,
	.back-link:hover {
		color: var(--color-accent);
	}

	.search-trigger {
		display: flex;
		align-items: center;
		gap: 10px;
		width: 100%;
		min-height: 44px;
		padding: 0 12px;
		border: 1px solid var(--color-border);
		background: var(--color-background);
		color: var(--color-text-secondary);
		font-size: 12px;
		text-align: left;
		cursor: pointer;
	}

	.search-trigger svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.tag-links {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.tag-links a {
		max-width: 100%;
		padding: 5px 8px;
		border: 1px solid var(--color-border);
		color: var(--color-text-secondary);
		font-size: 11px;
		overflow-wrap: anywhere;
	}

	.tag-links a:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.back-link {
		min-height: 44px;
		display: flex;
		align-items: center;
		color: var(--color-text-secondary);
		font-size: 12px;
		font-weight: 700;
	}

	.search-trigger:focus-visible,
	.sidebar-section a:focus-visible,
	.back-link:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	@media (max-width: 1023px) {
		.article-sidebar {
			display: flex;
			padding-top: 0;
		}

		.related-section { order: 2; }
		.tags-section { order: 3; }
		.category-section { order: 4; }
		.back-link { order: 5; }
	}
</style>
