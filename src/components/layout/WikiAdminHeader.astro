---
interface Props {
	active?: 'wiki' | 'requests' | 'editor';
}

const { active } = Astro.props;

const navigation = [
	{ label: 'Wikiトップ', href: '/docs/', key: 'wiki' },
	{ label: '申請一覧', href: '/wiki/requests/', key: 'requests' },
	{ label: 'アカウント', href: '/account/', key: 'account' },
] as const;

const isActive = (key: string): boolean =>
	active === key || (active === 'editor' && key === 'requests');
---

<header class="wiki-admin-header">
	<div class="wiki-admin-header-inner">
		<a href="/" class="wiki-admin-brand" aria-label="NUGBASEホーム">
			<span class="wiki-admin-brand-mark">NUG</span>
			<span class="wiki-admin-brand-copy">
				<strong>NUGBASE Wiki</strong>
				<small>編集管理</small>
			</span>
		</a>

		<nav class="wiki-admin-nav" aria-label="Wiki管理ナビゲーション">
			{navigation.map((item) => (
				<a
					href={item.href}
					class:list={[
						'wiki-admin-nav-link',
						{ active: isActive(item.key) },
					]}
					aria-current={active === item.key ? 'page' : undefined}
				>
						{item.label}
				</a>
			))}
		</nav>
	</div>
</header>

<style>
	.wiki-admin-header {
		position: sticky;
		top: 0;
		z-index: 30;
		border-bottom: 1px solid #252c2f;
		background:
			linear-gradient(180deg, rgba(57, 64, 67, 0.98), rgba(29, 34, 37, 0.98));
		box-shadow: 0 3px 0 rgba(0, 0, 0, 0.28), 0 8px 20px rgba(0, 0, 0, 0.2);
		backdrop-filter: blur(12px);
		color: #eff3ef;
	}

	.wiki-admin-header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: min(1240px, calc(100% - 40px));
		min-height: 68px;
		margin: 0 auto;
	}

	.wiki-admin-brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		min-width: 0;
		color: inherit;
		text-decoration: none;
	}

	.wiki-admin-brand-mark {
		display: grid;
		place-items: center;
		width: 52px;
		min-width: 52px;
		height: 38px;
		border: 1px solid #66736a;
		background: linear-gradient(145deg, #4b5650, #30383a);
		box-shadow: 0 3px 0 #111516, inset 0 1px 0 rgba(255, 255, 255, 0.1);
		color: #f5f8f2;
		font-size: 17px;
		font-weight: 950;
	}

	.wiki-admin-brand-copy {
		display: grid;
		gap: 1px;
		min-width: 0;
	}

	.wiki-admin-brand-copy strong {
		font-size: 14px;
		line-height: 1.35;
	}

	.wiki-admin-brand-copy small {
		color: #a8b3ac;
		font-size: 11px;
		line-height: 1.3;
	}

	.wiki-admin-nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 6px;
	}

	.wiki-admin-nav-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 40px;
		padding: 0 13px;
		border: 1px solid transparent;
		border-radius: 3px;
		color: #c2cbc5;
		font-size: 13px;
		font-weight: 800;
		text-decoration: none;
		transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
	}

	.wiki-admin-nav-link:hover,
	.wiki-admin-nav-link.active {
		border-color: #4d6650;
		background: linear-gradient(180deg, rgba(90, 151, 79, 0.3), rgba(50, 96, 53, 0.2));
		color: #f1f7ed;
	}

	.wiki-admin-nav-link:focus-visible,
	.wiki-admin-brand:focus-visible {
		outline: 2px solid #e3c66a;
		outline-offset: 3px;
	}

	@media (max-width: 620px) {
		.wiki-admin-header-inner {
			flex-wrap: wrap;
			gap: 8px 12px;
			width: calc(100% - 24px);
			padding: 10px 0;
		}

		.wiki-admin-brand-mark {
			width: 46px;
			min-width: 46px;
			height: 36px;
		}

		.wiki-admin-brand-copy strong {
			font-size: 13px;
		}

		.wiki-admin-nav {
			width: 100%;
			justify-content: stretch;
			gap: 5px;
		}

		.wiki-admin-nav-link {
			flex: 1 1 0;
			min-width: 0;
			min-height: 40px;
			padding: 0 6px;
			font-size: 12px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wiki-admin-nav-link {
			transition: none;
		}
	}
</style>