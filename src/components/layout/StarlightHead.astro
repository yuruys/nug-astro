---
const { entry, head } = Astro.locals.starlightRoute;
const title = entry.data.title;
const description = entry.data.description;
const ogImageURL = new URL("/images/mein.webp", Astro.site ?? Astro.url).href;
const retainedHead = head.filter(
	({ tag, attrs }) => !(tag === "meta" && attrs.property === "og:locale"),
);
---

{retainedHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<meta property="og:locale" content="ja_JP" />
<meta property="og:image" content={ogImageURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />