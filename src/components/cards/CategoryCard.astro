---
interface Props {
	title: string;
	description: string;
	icon: string;
	href: string;
}

const {
	title,
	description,
	icon,
	href,
} = Astro.props;

const accentClass =
	title === "攻略"
		? "category-guide"
		: title === "Wiki"
			? "category-wiki"
			: title === "ニュース"
				? "category-news"
				: title === "ツール"
					? "category-tool"
					: "category-about";

const label =
	title === "攻略"
		? "GUIDE"
		: title === "Wiki"
			? "WIKI"
			: title === "ニュース"
				? "NEWS"
				: title === "ツール"
					? "TOOLS"
					: "NUGBASE";
---

<a
	href={href}
	class={`category-card ${accentClass}`}
>

	<!-- ========================================
	     Directional Light
	======================================== -->

	<div
		class="card-light"
		aria-hidden="true"
	></div>


	<!-- ========================================
	     Block Top Highlight
	======================================== -->

	<div
		class="card-top-highlight"
		aria-hidden="true"
	></div>


	<!-- ========================================
	     Card Top
	======================================== -->

	<div class="card-top">

		<div class="card-icon">

			<span>
				{icon}
			</span>

		</div>


		<span class="card-arrow">
			→
		</span>

	</div>


	<!-- ========================================
	     Card Content
	======================================== -->

	<div class="card-content">

		<p class="card-label">
			{label}
		</p>

		<h3>
			{title}
		</h3>

		<p class="card-description">
			{description}
		</p>

	</div>


	<!-- ========================================
	     Block Decoration
	======================================== -->

	<div
		class="card-block"
		aria-hidden="true"
	>

		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>
		<span></span>

	</div>

</a>


<style>

/* =========================================================
   Category Card
========================================================= */

.category-card {

	position:
		relative;

	display:
		flex;

	flex-direction:
		column;

	min-height:
		216px;

	padding:
		var(--space-6);

	overflow:
		hidden;

	border:
		var(--border-width-strong) solid var(--color-border);

	border-radius:
		0;

	background:
		var(--color-surface);

	color:
		var(--color-text);

	box-shadow:
		var(--block-shadow),
		var(--shadow-soft);

	transition:
		transform var(--transition-normal),
		border-color var(--transition-normal),
		background-color var(--transition-normal),
		box-shadow var(--transition-normal);

}


/* =========================================================
   Directional Light
========================================================= */

.card-light {

	position:
		absolute;

	top:
		-150px;

	left:
		-150px;

	width:
		380px;

	height:
		380px;

	background:
		radial-gradient(
			circle,
			rgba(255, 247, 214, 0.32),
			rgba(255, 255, 255, 0.10) 32%,
			transparent 70%
		);

	opacity:
		0.55;

	pointer-events:
		none;

	transition:
		opacity var(--transition-normal),
		transform var(--transition-normal);

}


.category-card:hover .card-light {

	opacity:
		0.90;

	transform:
		translate(8px, 8px);

}


/* =========================================================
   Top Highlight
========================================================= */

.card-top-highlight {

	position:
		absolute;

	top:
		0;

	left:
		0;

	width:
		72%;

	height:
		3px;

	background:
		linear-gradient(
			90deg,
			var(--category-accent),
			var(--color-gold-light),
			transparent
		);

	opacity:
		0.75;

	pointer-events:
		none;

}


/* =========================================================
   Category Accent
========================================================= */

.category-guide {

	--category-accent:
		var(--color-grass);

	--category-accent-dark:
		var(--color-grass-dark);

}


.category-wiki {

	--category-accent:
		var(--color-stone);

	--category-accent-dark:
		var(--color-stone-dark);

}


.category-news {

	--category-accent:
		var(--color-gold);

	--category-accent-dark:
		#9f7427;

}


.category-tool {

	--category-accent:
		var(--color-water);

	--category-accent-dark:
		var(--color-water-dark);

}


.category-about {

	--category-accent:
		#9a7050;

	--category-accent-dark:
		#68472f;

}


/* =========================================================
   Hover
========================================================= */

.category-card:hover {

	transform:
		translateY(-4px);

	border-color:
		var(--category-accent);

	background:
		var(--color-surface-hover);

	box-shadow:
		0 6px 0 var(--category-accent-dark),
		0 18px 34px var(--color-shadow-strong);

}


/* =========================================================
   Active / Pressed
========================================================= */

.category-card:active {

	transform:
		translateY(2px);

	box-shadow:
		0 1px 0 var(--category-accent-dark),
		0 5px 12px var(--color-shadow);

}


/* =========================================================
   Card Top
========================================================= */

.card-top {

	position:
		relative;

	z-index:
		2;

	display:
		flex;

	align-items:
		flex-start;

	justify-content:
		space-between;

}


/* =========================================================
   Inventory Slot
========================================================= */

.card-icon {

	position:
		relative;

	display:
		flex;

	align-items:
		center;

	justify-content:
		center;

	width:
		56px;

	height:
		56px;

	flex-shrink:
		0;

	border:
		var(--border-width) solid var(--color-border-strong);

	border-radius:
		0;

	background:
		linear-gradient(
			135deg,
			var(--color-surface-strong),
			var(--color-surface)
		);

	box-shadow:
		inset 3px 3px 0 rgba(255, 255, 255, 0.25),
		inset -3px -3px 0 rgba(0, 0, 0, 0.10),
		0 3px 0 var(--color-border-strong);

	font-size:
		24px;

	transition:
		transform var(--transition-normal),
		background-color var(--transition-normal),
		border-color var(--transition-normal),
		box-shadow var(--transition-normal);

}


.card-icon::before {

	content:
		"";

	position:
		absolute;

	top:
		0;

	left:
		0;

	width:
		65%;

	height:
		2px;

	background:
		rgba(255, 255, 255, 0.48);

	pointer-events:
		none;

}


.card-icon span {

	position:
		relative;

	z-index:
		1;

	line-height:
		1;

	filter:
		saturate(0.92);

}


.category-card:hover .card-icon {

	transform:
		translateY(-2px);

	border-color:
		var(--category-accent);

	background:
		linear-gradient(
			135deg,
			color-mix(
				in srgb,
				var(--category-accent) 18%,
				var(--color-surface-strong)
			),
			var(--color-surface)
		);

	box-shadow:
		inset 3px 3px 0 rgba(255, 255, 255, 0.32),
		inset -3px -3px 0 rgba(0, 0, 0, 0.10),
		0 4px 0 var(--category-accent-dark);

}


/* =========================================================
   Arrow Slot
========================================================= */

.card-arrow {

	display:
		flex;

	align-items:
		center;

	justify-content:
		center;

	width:
		36px;

	height:
		36px;

	flex-shrink:
		0;

	border:
		var(--border-width) solid var(--color-border);

	border-radius:
		0;

	background:
		var(--color-surface-subtle);

	color:
		var(--color-text-secondary);

	font-size:
		18px;

	line-height:
		1;

	box-shadow:
		0 2px 0 var(--color-border-strong);

	transition:
		transform var(--transition-fast),
		background-color var(--transition-fast),
		color var(--transition-fast),
		border-color var(--transition-fast),
		box-shadow var(--transition-fast);

}


.category-card:hover .card-arrow {

	transform:
		translateX(5px);

	border-color:
		var(--category-accent);

	background:
		var(--category-accent);

	color:
		#ffffff;

	box-shadow:
		0 3px 0 var(--category-accent-dark);

}


.category-card:active .card-arrow {

	transform:
		translateX(3px)
		translateY(1px);

}


/* =========================================================
   Content
========================================================= */

.card-content {

	position:
		relative;

	z-index:
		2;

	margin-top:
		auto;

	padding-top:
		var(--space-8);

	padding-right:
		40px;

}


.card-label {

	margin-bottom:
		var(--space-1);

	font-family:
		var(--font-mono);

	font-size:
		9px;

	font-weight:
		800;

	line-height:
		1.4;

	letter-spacing:
		0.17em;

	color:
		var(--category-accent);

}


.category-card h3 {

	font-size:
		21px;

	font-weight:
		850;

	line-height:
		1.3;

	letter-spacing:
		-0.03em;

}


.card-description {

	margin-top:
		7px;

	font-size:
		13px;

	line-height:
		1.7;

	color:
		var(--color-text-secondary);

}


/* =========================================================
   Block Decoration
========================================================= */

.card-block {

	position:
		absolute;

	right:
		-14px;

	bottom:
		-20px;

	display:
		grid;

	grid-template-columns:
		repeat(3, 30px);

	grid-template-rows:
		repeat(2, 30px);

	gap:
		2px;

	opacity:
		0.13;

	transform:
		rotate(-8deg);

	transition:
		transform var(--transition-normal),
		opacity var(--transition-normal);

}


/* Individual blocks */

.card-block span {

	display:
		block;

	border:
		1px solid var(--category-accent-dark);

	background:
		linear-gradient(
			135deg,
			var(--category-accent),
			var(--category-accent-dark)
		);

	box-shadow:
		inset 0 4px 0 rgba(255, 255, 255, 0.22),
		inset 0 -4px 0 rgba(0, 0, 0, 0.14);

}


/* Slight variation creates terrain-like depth */

.card-block span:nth-child(1) {
	transform:
		translateY(4px);
}

.card-block span:nth-child(2) {
	transform:
		translateY(1px);
}

.card-block span:nth-child(3) {
	transform:
		translateY(7px);
}

.card-block span:nth-child(4) {
	transform:
		translateY(0);
}

.card-block span:nth-child(5) {
	transform:
		translateY(4px);
}

.card-block span:nth-child(6) {
	transform:
		translateY(-2px);
}


.category-card:hover .card-block {

	opacity:
		0.22;

	transform:
		rotate(-5deg)
		scale(1.06)
		translate(-4px, -4px);

}


/* =========================================================
   Dark Theme
========================================================= */

:global(html[data-theme="dark"]) .category-card {

	box-shadow:
		var(--block-shadow),
		0 14px 30px rgba(0, 0, 0, 0.28);

}


:global(html[data-theme="dark"]) .card-light {

	opacity:
		0.24;

}


:global(html[data-theme="dark"]) .category-card:hover {

	background:
		var(--color-surface-hover);

	box-shadow:
		0 6px 0 var(--category-accent-dark),
		0 20px 38px rgba(0, 0, 0, 0.46);

}


:global(html[data-theme="dark"]) .card-icon {

	box-shadow:
		inset 3px 3px 0 rgba(255, 255, 255, 0.08),
		inset -3px -3px 0 rgba(0, 0, 0, 0.28),
		0 3px 0 rgba(0, 0, 0, 0.42);

}


:global(html[data-theme="dark"]) .card-icon::before {

	background:
		rgba(255, 255, 255, 0.10);

}


:global(html[data-theme="dark"]) .card-block {

	opacity:
		0.10;

}


:global(html[data-theme="dark"]) .category-card:hover .card-block {

	opacity:
		0.17;

}


/* =========================================================
   Mobile
========================================================= */

@media (max-width: 768px) {

	.category-card {

		min-height:
			192px;

		padding:
			var(--space-5);

	}


	.card-icon {

		width:
			50px;

		height:
			50px;

		font-size:
			21px;

	}


	.card-content {

		padding-top:
			var(--space-6);

		padding-right:
			32px;

	}


	.category-card h3 {

		font-size:
			19px;

	}


	.card-description {

		font-size:
			12px;

	}


	.card-block {

		right:
			-10px;

		bottom:
			-14px;

		grid-template-columns:
			repeat(3, 24px);

		grid-template-rows:
			repeat(2, 24px);

	}

}


/* =========================================================
   Small Mobile
========================================================= */

@media (max-width: 480px) {

	.category-card {

		min-height:
			180px;

		padding:
			18px;

	}


	.card-arrow {

		width:
			32px;

		height:
			32px;

		font-size:
			16px;

	}


	.card-content {

		padding-right:
			24px;

	}

}

</style>