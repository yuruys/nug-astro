---
interface Props {
	title: string;
	description?: string;
	category?: string;
	date?: Date;
	image?: string;
	sourceUrl?: string;
	icon?: string;
	tags?: string[];
	href: string;
	number?: string;
}

const {
	title,
	description,
	category,
	date,
	image,
	sourceUrl,
	icon = "📖",
	tags = [],
	href,
	number,
} = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("ja-JP", {
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		})
	: null;
---

<a
	href={href}
	class="article-card"
>

	<!-- ========================================
	     Image
	======================================== -->

	<div class="article-image">

		{image ? (
			<img
				src={image}
				alt=""
				loading="lazy"
			/>
		) : (
			<div
				class="article-image-placeholder"
				aria-hidden="true"
			>
				<span>{icon}</span>
			</div>
		)}

		<div
			class="article-image-overlay"
			aria-hidden="true"
		></div>

		{number && <span class="article-number">{number}</span>}

	</div>


	<!-- ========================================
	     Content
	======================================== -->

	<div class="article-content">

		<h3 class="article-title">
			{title}
		</h3>

		{description && (
			<p class="article-description">
				{description}
			</p>
		)}


		<div class="article-meta">

			{category && (
				<span class="article-category">
					{category}
				</span>
			)}

			<span class="article-meta-arrow" aria-hidden="true">→</span>

		</div>

		{tags.length > 0 && (
			<ul class="article-tags" aria-label="タグ">
				{tags.map((tag) => <li>{tag}</li>)}
			</ul>
		)}

		{sourceUrl && (
			<p class="article-source">出典：SCBNEWS</p>
		)}

		{formattedDate && (
			<time class="article-date" datetime={date?.toISOString()}>
				{formattedDate}
			</time>
		)}

	</div>

</a>


<style>

/* =========================================================
   Article Card
========================================================= */

.article-card {
	position: relative;
	display: flex;
	height: 100%;
	flex-direction: column;
	padding: 10px;
	border: 1px solid var(--color-border);
	border-radius: 10px;
	background: var(--color-surface);
	color: var(--color-text);
	text-decoration: none;
	transition:
		transform var(--transition-fast),
		background-color var(--transition-fast),
		border-color var(--transition-fast),
		box-shadow var(--transition-fast);
}

.article-card:hover {
	transform: translateY(-2px);
	border-color: var(--color-border-accent);
	background: var(--color-surface-hover);
	box-shadow: 0 3px 0 var(--color-border);
}

.article-card:focus-visible {
	outline: 3px solid var(--color-accent);
	outline-offset: 3px;
}

.article-image {
	position: relative;
	aspect-ratio: 16 / 9;
	overflow: hidden;
	border: 1px solid var(--color-border);
	border-radius: 6px;
	background: var(--color-surface-strong);
}

.article-image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform var(--transition-normal);
}

.article-card:hover .article-image img {
	transform: scale(1.03);
}

.article-image-placeholder {
	display: flex;
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
	background: linear-gradient(135deg, var(--color-grass), var(--color-dirt));
}

.article-image-placeholder span {
	font-size: 44px;
	filter: drop-shadow(2px 2px 0 rgba(0, 0, 0, .25));
}

.article-image-overlay {
	position: absolute;
	inset: 0;
	background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, .28));
	pointer-events: none;
}

.article-number {
	position: absolute;
	top: 8px;
	left: 8px;
	display: flex;
	min-width: 27px;
	height: 23px;
	align-items: center;
	justify-content: center;
	padding: 0 5px;
	border: 1px solid rgba(0, 0, 0, .55);
	border-radius: 4px;
	background: rgba(255, 255, 255, .90);
	color: #111;
	font-family: var(--font-mono);
	font-size: 9px;
	font-weight: 800;
	letter-spacing: .08em;
	box-shadow: 2px 2px 0 rgba(0, 0, 0, .25);
}

.article-content {
	display: flex;
	flex: 1;
	flex-direction: column;
	padding: 12px 3px 3px;
}

.article-title {
	color: var(--color-text);
	font-size: 16px;
	font-weight: 800;
	line-height: 1.55;
	letter-spacing: -0.025em;
}

.article-description {
	display: -webkit-box;
	overflow: hidden;
	margin-top: 7px;
	color: var(--color-text-secondary);
	font-size: 12px;
	line-height: 1.65;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
}

.article-meta {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
	margin-top: auto;
	padding-top: 12px;
}

.article-category {
	display: inline-flex;
	min-height: 27px;
	align-items: center;
	padding: 0 10px;
	border: 1px solid var(--color-border-accent);
	border-radius: 999px;
	background: var(--color-accent-soft);
	color: var(--color-accent);
	font-size: 10px;
	font-weight: 700;
}

.article-meta-arrow {
	color: var(--color-text-secondary);
	font-size: 16px;
	transition: transform var(--transition-fast), color var(--transition-fast);
}

.article-card:hover .article-meta-arrow {
	transform: translateX(3px);
	color: var(--color-accent);
}

.article-date {
	margin-top: 8px;
	color: var(--color-text-secondary);
	font-family: var(--font-mono);
	font-size: 10px;
	letter-spacing: .04em;
}

.article-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 5px;
	margin-top: 9px;
}

.article-tags li {
	padding: 3px 7px;
	border: 1px solid var(--color-border);
	border-radius: 999px;
	background: var(--color-surface-subtle);
	color: var(--color-text-secondary);
	font-size: 10px;
	line-height: 1.4;
}

.article-source {
	margin-top: 8px;
	color: var(--color-text-secondary);
	font-size: 10px;
}

@media (prefers-reduced-motion: reduce) {
	.article-card,
	.article-image img,
	.article-meta-arrow {
		transition: none;
	}
}

:global(html[data-theme="dark"]) .article-number {
	background: rgba(25, 29, 27, .92);
	color: #ffffff;
	border-color: rgba(255, 255, 255, .25);
}

@media (max-width: 768px) {
	.article-title { font-size: 15px; }
	.article-description { font-size: 11px; }
}

</style>