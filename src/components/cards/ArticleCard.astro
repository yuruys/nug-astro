---
interface Props {
	title: string;
	description?: string;
	category?: string;
	date?: Date;
	image?: string;
	icon?: string;
	href: string;
	number?: string;
}

const {
	title,
	description,
	category,
	date,
	image,
	icon = "📖",
	href,
	number = "01",
} = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("ja-JP", {
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		})
	: null;
---

<a
	href={href}
	class="article-card"
>

	<!-- ========================================
	     Image
	======================================== -->

	<div class="article-image">

		{image ? (
			<img
				src={image}
				alt=""
				loading="lazy"
			/>
		) : (
			<div
				class="article-image-placeholder"
				aria-hidden="true"
			>
				<span>{icon}</span>
			</div>
		)}

		<div
			class="article-image-overlay"
			aria-hidden="true"
		></div>

		<span class="article-number">
			{number}
		</span>

	</div>


	<!-- ========================================
	     Content
	======================================== -->

	<div class="article-content">

		<h3 class="article-title">
			{title}
		</h3>

		{description && (
			<p class="article-description">
				{description}
			</p>
		)}


		<div class="article-meta">

			{category && (
				<span class="article-category">
					{category}
				</span>
			)}

			<span class="article-meta-arrow">
				→
			</span>

		</div>


		{formattedDate && (
			<p class="article-date">
				{formattedDate}
			</p>
		)}

	</div>

</a>


<style>

/* =========================================================
   Article Card
========================================================= */

.article-card {

	position:
		relative;

	display:
		block;

	color:
		var(--color-text);

	text-decoration:
		none;

}


/* =========================================================
   Image
========================================================= */

.article-image {

	position:
		relative;

	aspect-ratio:
		16 / 9;

	overflow:
		hidden;

	border:
		1px solid var(--color-border-strong);

	border-radius:
		0;

	background:
		var(--color-surface-strong);

	box-shadow:
		3px 3px 0 var(--color-border-strong);

}


/* =========================================================
   Image
========================================================= */

.article-image img {

	width:
		100%;

	height:
		100%;

	display:
		block;

	object-fit:
		cover;

	transition:
		transform var(--transition-normal),
		filter var(--transition-normal);

}


/* =========================================================
   Placeholder
========================================================= */

.article-image-placeholder {

	width:
		100%;

	height:
		100%;

	display:
		flex;

	align-items:
		center;

	justify-content:
		center;

	background:
		linear-gradient(
			135deg,
			var(--color-grass),
			var(--color-dirt)
		);

}


.article-image-placeholder span {

	font-size:
		44px;

	filter:
		drop-shadow(2px 2px 0 rgba(0, 0, 0, .25));

}


/* =========================================================
   Image Overlay
========================================================= */

.article-image-overlay {

	position:
		absolute;

	inset:
		0;

	background:
		linear-gradient(
			180deg,
			transparent 55%,
			rgba(0, 0, 0, .28)
		);

	pointer-events:
		none;

}


/* =========================================================
   Number
========================================================= */

.article-number {

	position:
		absolute;

	top:
		8px;

	left:
		8px;

	display:
		flex;

	align-items:
		center;

	justify-content:
		center;

	min-width:
		27px;

	height:
		23px;

	padding:
		0 5px;

	border:
		1px solid rgba(0, 0, 0, .55);

	background:
		rgba(255, 255, 255, .90);

	color:
		#111;

	font-family:
		var(--font-mono);

	font-size:
		9px;

	font-weight:
		800;

	letter-spacing:
		.08em;

	box-shadow:
		2px 2px 0 rgba(0, 0, 0, .25);

}


/* =========================================================
   Content
========================================================= */

.article-content {

	padding:
		13px 2px 0;

}


/* =========================================================
   Title
========================================================= */

.article-title {

	font-size:
		16px;

	font-weight:
		850;

	line-height:
		1.55;

	letter-spacing:
		-0.025em;

}


/* =========================================================
   Description
========================================================= */

.article-description {

	margin-top:
		7px;

	color:
		var(--color-text-secondary);

	font-size:
		12px;

	line-height:
		1.65;

	display:
		-webkit-box;

	-webkit-line-clamp:
		2;

	-webkit-box-orient:
		vertical;

	overflow:
		hidden;

}


/* =========================================================
   Meta
========================================================= */

.article-meta {

	display:
		flex;

	align-items:
		center;

	justify-content:
		space-between;

	gap:
		8px;

	margin-top:
		11px;

}


/* =========================================================
   Category
========================================================= */

.article-category {

	display:
		inline-flex;

	align-items:
		center;

	min-height:
		27px;

	padding:
		0 11px;

	border:
		1px solid var(--color-border);

	border-radius:
		999px;

	background:
		var(--color-surface);

	color:
		var(--color-text-secondary);

	font-size:
		10px;

	font-weight:
		800;

}


/* =========================================================
   Arrow
========================================================= */

.article-meta-arrow {

	display:
		flex;

	align-items:
		center;

	justify-content:
		center;

	width:
		27px;

	height:
		27px;

	border:
		1px solid var(--color-border);

	background:
		var(--color-surface);

	color:
		var(--color-text-secondary);

	font-size:
		14px;

	box-shadow:
		2px 2px 0 var(--color-border-strong);

	transition:
		transform var(--transition-fast),
		background-color var(--transition-fast),
		color var(--transition-fast),
		border-color var(--transition-fast);

}


/* =========================================================
   Date
========================================================= */

.article-date {

	margin-top:
		8px;

	color:
		var(--color-text-tertiary);

	font-family:
		var(--font-mono);

	font-size:
		9px;

	letter-spacing:
		.06em;

}


/* =========================================================
   Hover
========================================================= */

.article-card:hover .article-image img {

	transform:
		scale(1.045);

	filter:
		saturate(1.05);

}


.article-card:hover .article-image {

	border-color:
		var(--color-accent);

}


.article-card:hover .article-meta-arrow {

	transform:
		translateX(4px);

	background:
		var(--color-accent);

	border-color:
		var(--color-accent);

	color:
		#ffffff;

}


/* =========================================================
   Dark Mode
========================================================= */

:global(html[data-theme="dark"]) .article-number {

	background:
		rgba(25, 29, 27, .92);

	color:
		#ffffff;

	border-color:
		rgba(255, 255, 255, .25);

}


:global(html[data-theme="dark"]) .article-image {

	box-shadow:
		3px 3px 0 rgba(0, 0, 0, .48);

}


/* =========================================================
   Mobile
========================================================= */

@media (max-width: 768px) {

	.article-title {

		font-size:
			15px;

	}


	.article-description {

		font-size:
			11px;

	}

}

</style>