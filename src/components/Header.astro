<header class="site-header">

	<div class="header-light"></div>

	<div class="header-inner">

		<!-- ========================================
		     Logo
		======================================== -->

		<a
			href="/"
			class="logo"
			aria-label="NUG ホーム"
		>

			<span class="logo-main">
				NUG
			</span>

			<span class="logo-sub">
				Nekozouneko Unofficial Guide
			</span>

		</a>


		<!-- ========================================
		     Desktop Navigation
		======================================== -->

		<nav
			class="desktop-nav"
			aria-label="メインナビゲーション"
		>

			<a href="/guide/" class="nav-link">
				<span class="nav-link-inner">
					攻略
				</span>
			</a>

			<a href="/docs/" class="nav-link">
				<span class="nav-link-inner">
					Wiki
				</span>
			</a>

			<a href="/news/" class="nav-link">
				<span class="nav-link-inner">
					ニュース
				</span>
			</a>

			<a href="/tool/" class="nav-link">
				<span class="nav-link-inner">
					ツール
				</span>
			</a>

			<a href="/about/" class="nav-link">
				<span class="nav-link-inner">
					NUGについて
				</span>
			</a>

		</nav>


		<!-- ========================================
		     Header Actions
		======================================== -->

		<div class="header-actions">

			<button
				class="icon-button theme-button"
				type="button"
				aria-label="テーマを切り替える"
				title="テーマを切り替える"
			>

				<svg
					class="theme-icon theme-icon-sun"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>

					<circle
						cx="12"
						cy="12"
						r="4"
					></circle>

					<path
						d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
					></path>

				</svg>

				<svg
					class="theme-icon theme-icon-moon"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>

					<path
						d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"
					></path>

				</svg>

			</button>


			<button
				class="icon-button search-button"
				type="button"
				aria-label="検索"
				aria-expanded="false"
			>

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>

					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>

					<path
						d="M16 16L21 21"
					></path>

				</svg>

			</button>


			<button
				class="menu-button"
				type="button"
				aria-label="メニューを開く"
				aria-expanded="false"
			>

				<span></span>
				<span></span>
				<span></span>

			</button>

		</div>

	</div>


	<!-- ========================================
	     Search Overlay
	======================================== -->

	<div
		class="search-overlay"
		aria-hidden="true"
	>

		<div class="search-overlay-backdrop"></div>

		<div class="search-dialog">

			<div class="search-dialog-header">

				<div>

					<p class="search-label">
						SEARCH
					</p>

					<h2>
						NUGを検索
					</h2>

				</div>


				<button
					class="search-close"
					type="button"
					aria-label="検索を閉じる"
				>
					×
				</button>

			</div>


			<div class="search-input-wrapper">

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>

					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>

					<path
						d="M16 16L21 21"
					></path>

				</svg>


				<input
					id="nug-search-input"
					type="search"
					placeholder="攻略・プラグイン・コマンドなどを検索"
					aria-label="サイト内検索"
					autocomplete="off"
				/>

			</div>


			<div
				id="nug-search-results"
				class="search-results"
			></div>

		</div>

	</div>


	<!-- ========================================
	     Mobile Menu Overlay
	======================================== -->

	<div
		class="mobile-menu-overlay"
		aria-hidden="true"
	>

		<div class="mobile-menu-backdrop"></div>

		<nav
			class="mobile-menu"
			aria-label="モバイルナビゲーション"
		>

			<div class="mobile-menu-header">

				<div>

					<span class="mobile-menu-title">
						NUGBASE
					</span>

					<span class="mobile-menu-subtitle">
						MENU
					</span>

				</div>

				<button
					class="mobile-menu-close"
					type="button"
					aria-label="メニューを閉じる"
				>
					×
				</button>

			</div>


			<div class="mobile-menu-links">

				<a href="/guide/">
					<span class="mobile-icon">📖</span>
					<span>攻略</span>
					<span class="mobile-arrow">→</span>
				</a>

				<a href="/docs/">
					<span class="mobile-icon">📚</span>
					<span>Wiki</span>
					<span class="mobile-arrow">→</span>
				</a>

				<a href="/news/">
					<span class="mobile-icon">📰</span>
					<span>ニュース</span>
					<span class="mobile-arrow">→</span>
				</a>

				<a href="/tool/">
					<span class="mobile-icon">🛠</span>
					<span>ツール</span>
					<span class="mobile-arrow">→</span>
				</a>

				<a href="/about/">
					<span class="mobile-icon">ℹ</span>
					<span>NUGについて</span>
					<span class="mobile-arrow">→</span>
				</a>

			</div>

		</nav>

	</div>

</header>


<script>

	/* ========================================
	   Elements
	======================================== */

	const header =
		document.querySelector<HTMLElement>(
			".site-header"
		);

	const searchButton =
		document.querySelector<HTMLButtonElement>(
			".search-button"
		);

	const searchOverlay =
		document.querySelector<HTMLElement>(
			".search-overlay"
		);

	const searchClose =
		document.querySelector<HTMLButtonElement>(
			".search-close"
		);

	const searchInput =
		document.querySelector<HTMLInputElement>(
			"#nug-search-input"
		);

	const searchResults =
		document.querySelector<HTMLElement>(
			"#nug-search-results"
		);

	const searchBackdrop =
		document.querySelector<HTMLElement>(
			".search-overlay-backdrop"
		);

	const menuButton =
		document.querySelector<HTMLButtonElement>(
			".menu-button"
		);

	const themeButton =
		document.querySelector<HTMLButtonElement>(
			".theme-button"
		);

	const themeStorageKey = "nug-theme";


	/* ========================================
	   Theme
	======================================== */

	const getTheme = (): "light" | "dark" => {

		const theme =
			document.documentElement.dataset.theme;

		return theme === "dark"
			? "dark"
			: "light";

	};


	const getSystemTheme = (): "light" | "dark" => {

		return window.matchMedia(
			"(prefers-color-scheme: dark)"
		).matches
			? "dark"
			: "light";

	};


	const updateThemeButton = (): void => {

		if (!themeButton) return;

		const nextTheme =
			getTheme() === "dark"
				? "light"
				: "dark";

		const label =
			nextTheme === "dark"
				? "ダークモードに切り替える"
				: "ライトモードに切り替える";

		themeButton.setAttribute(
			"aria-label",
			label
		);

		themeButton.setAttribute(
			"title",
			label
		);

	};


	const setTheme = (
		theme: "light" | "dark",
		save = true
	) => {

		document.documentElement.dataset.theme =
			theme;

		document.documentElement.style.colorScheme =
			theme;

		if (save) {

			localStorage.setItem(
				themeStorageKey,
				theme
			);

		}

		updateThemeButton();

	};


	themeButton?.addEventListener(
		"click",
		() => {

			const currentTheme =
				getTheme();

			const nextTheme =
				currentTheme === "dark"
					? "light"
					: "dark";

			setTheme(
				nextTheme,
				true
			);

		}
	);


	const systemThemeQuery =
		window.matchMedia(
			"(prefers-color-scheme: dark)"
		);


	systemThemeQuery.addEventListener(
		"change",
		() => {

			const savedTheme =
				localStorage.getItem(
					themeStorageKey
				);

			if (
				savedTheme === "light" ||
				savedTheme === "dark"
			) {
				return;
			}

			setTheme(
				getSystemTheme(),
				false
			);

		}
	);


	updateThemeButton();


	/* ========================================
	   Mobile Menu Elements
	======================================== */

	const mobileMenuOverlay =
		document.querySelector<HTMLElement>(
			".mobile-menu-overlay"
		);

	const mobileMenuClose =
		document.querySelector<HTMLButtonElement>(
			".mobile-menu-close"
		);

	const mobileMenuBackdrop =
		document.querySelector<HTMLElement>(
			".mobile-menu-backdrop"
		);


	/* ========================================
	   Pagefind
	======================================== */

	type PagefindResultData = {
		title?: string;
		url?: string;
		excerpt?: string;
		meta?: Record<string, string>;
	};


	type PagefindSearch = {
		results: Array<{
			data: () => Promise<PagefindResultData>
		}>;
	};


	type PagefindModule = {
		search: (
			query: string
		) => Promise<PagefindSearch>;
	};


	let pagefind: PagefindModule | null = null;

	let searchRequest = 0;


	async function loadPagefind(): Promise<PagefindModule> {

		if (!pagefind) {

			const pagefindUrl =
				new URL(
					"/pagefind/pagefind.js",
					window.location.origin
				).href;


			const loadModule =
				new Function(
					"url",
					"return import(url)"
				) as (
					url: string
				) => Promise<PagefindModule>;


			pagefind =
				await loadModule(
					pagefindUrl
				);

		}


		return pagefind;

	}


	function getCategory(
		url: string
	): string {

		if (url.startsWith("/docs/")) {
			return "Wiki";
		}

		if (url.startsWith("/guide/")) {
			return "攻略";
		}

		if (url.startsWith("/news/")) {
			return "ニュース";
		}

		if (url.startsWith("/tool/")) {
			return "ツール";
		}

		return "サイト";

	}


	function appendText(
		parent: HTMLElement,
		className: string,
		text: string
	): void {

		const element =
			document.createElement("span");

		element.className =
			className;

		element.textContent =
			text;

		parent.append(
			element
		);

	}


	function clearSearchResults(): void {

		searchResults?.replaceChildren();

		searchResults?.classList.remove(
			"has-results"
		);

	}


	async function performSearch(
		query: string
	): Promise<void> {

		if (!searchResults) return;


		const keyword =
			query.trim();

		const requestId =
			++searchRequest;


		if (!keyword) {

			clearSearchResults();

			return;

		}


		try {

			const result =
				await (
					await loadPagefind()
				).search(
					keyword
				);


			const items =
				await Promise.all(
					result.results
						.slice(0, 5)
						.map(
							(item) => item.data()
						)
				);


			if (
				requestId !== searchRequest
			) {
				return;
			}


			searchResults.replaceChildren();


			if (items.length === 0) {

				const empty =
					document.createElement(
						"div"
					);

				empty.className =
					"search-empty";

				appendText(
					empty,
					"",
					"検索結果がありません"
				);

				searchResults.append(
					empty
				);

			} else {

				for (
					const item of items
				) {

					const url =
						item.url ?? "/";


					const link =
						document.createElement(
							"a"
						);

					link.className =
						"search-result";

					link.href =
						url.startsWith("/")
							? url
							: "/";


					const content =
						document.createElement(
							"div"
						);

					content.className =
						"search-result-content";


					appendText(
						content,
						"search-result-category",
						getCategory(url)
					);


					appendText(
						content,
						"search-result-title",
						item.meta?.title ??
							item.title ??
							"無題の記事"
					);


					const excerpt =
						document.createElement(
							"p"
						);


					const parsedExcerpt =
						new DOMParser()
							.parseFromString(
								item.excerpt ?? "",
								"text/html"
							);


					excerpt.textContent =
						parsedExcerpt
							.body
							.textContent ?? "";


					content.append(
						excerpt
					);


					appendText(
						link,
						"search-result-arrow",
						"→"
					);


					link.insertBefore(
						content,
						link.lastElementChild
					);


					searchResults.append(
						link
					);

				}

			}


			searchResults.classList.add(
				"has-results"
			);

		} catch (error) {

			if (
				requestId === searchRequest
			) {

				console.error(
					"NUG Pagefind Error:",
					error
				);

			}

		}

	}


	/* ========================================
	   Search State
	======================================== */

	function setSearchState(
		isOpen: boolean
	): void {

		if (
			!header ||
			!searchButton ||
			!searchOverlay
		) {
			return;
		}


		header.classList.toggle(
			"search-open",
			isOpen
		);


		searchButton.setAttribute(
			"aria-expanded",
			String(isOpen)
		);


		searchOverlay.setAttribute(
			"aria-hidden",
			String(!isOpen)
		);


		if (isOpen) {

			document.body.classList.add(
				"overlay-open"
			);


			requestAnimationFrame(
				() => searchInput?.focus()
			);

		} else {

			document.body.classList.remove(
				"overlay-open"
			);


			if (searchInput) {

				searchInput.value = "";

			}


			clearSearchResults();

		}

	}


	/* ========================================
	   Menu State
	======================================== */

	function setMenuState(
		isOpen: boolean
	): void {

		if (
			!header ||
			!menuButton ||
			!mobileMenuOverlay
		) {
			return;
		}


		header.classList.toggle(
			"menu-open",
			isOpen
		);


		menuButton.setAttribute(
			"aria-expanded",
			String(isOpen)
		);


		mobileMenuOverlay.setAttribute(
			"aria-hidden",
			String(!isOpen)
		);


		if (isOpen) {

			document.body.classList.add(
				"overlay-open"
			);

		} else {

			document.body.classList.remove(
				"overlay-open"
			);

		}

	}


	/* ========================================
	   Search Button
	======================================== */

	searchButton?.addEventListener(
		"click",
		() => {

			const isOpen =
				header?.classList.contains(
					"search-open"
				) ?? false;


			setMenuState(false);

			setSearchState(
				!isOpen
			);

		}
	);


	/* ========================================
	   External Search Event
	======================================== */

	document.addEventListener(
		"nug:open-search",
		() => {

			setMenuState(false);

			setSearchState(true);

		}
	);


	/* ========================================
	   Search Close
	======================================== */

	searchClose?.addEventListener(
		"click",
		() => {

			setSearchState(false);

			searchButton?.focus();

		}
	);


	searchBackdrop?.addEventListener(
		"click",
		() => {

			setSearchState(false);

		}
	);


	/* ========================================
	   Search Input
	======================================== */

	searchInput?.addEventListener(
		"input",
		() => {

			performSearch(
				searchInput.value
			);

		}
	);


	/* ========================================
	   Search Enter
	======================================== */

	searchInput?.addEventListener(
		"keydown",
		(event) => {

			if (
				event.key !== "Enter"
			) {
				return;
			}


			const firstResult =
				searchResults?.querySelector<HTMLAnchorElement>(
					".search-result"
				);


			firstResult?.click();

		}
	);


	/* ========================================
	   Mobile Menu
	======================================== */

	menuButton?.addEventListener(
		"click",
		() => {

			const isOpen =
				header?.classList.contains(
					"menu-open"
				) ?? false;


			setSearchState(false);

			setMenuState(
				!isOpen
			);

		}
	);


	mobileMenuClose?.addEventListener(
		"click",
		() => {

			setMenuState(false);

			menuButton?.focus();

		}
	);


	mobileMenuBackdrop?.addEventListener(
		"click",
		() => {

			setMenuState(false);

		}
	);


	/* ========================================
	   Escape
	======================================== */

	document.addEventListener(
		"keydown",
		(event) => {

			if (
				event.key !== "Escape"
			) {
				return;
			}


			if (
				header?.classList.contains(
					"search-open"
				)
			) {

				setSearchState(false);

				searchButton?.focus();

				return;

			}


			if (
				header?.classList.contains(
					"menu-open"
				)
			) {

				setMenuState(false);

				menuButton?.focus();

			}

		}
	);

</script>


<style>

	/* ========================================
	   Base
	======================================== */

	.site-header {

		position: sticky;

		top: 0;

		z-index: 1000;

		width: 100%;

		background:
			var(--color-background);

		border-bottom:
			2px solid var(--color-border-strong);

		box-shadow:
			0 4px 0 var(--color-shadow);

		isolation: isolate;

	}


	.header-light {

		position: absolute;

		top: 0;

		left: 0;

		width: 42%;

		height: 2px;

		background:
			linear-gradient(
				90deg,
				var(--color-gold-light),
				var(--color-grass-light),
				transparent
			);

		opacity: 0.9;

		pointer-events: none;

	}


	.header-inner {

		position: relative;

		width: min(
			var(--content-width),
			calc(100% - 48px)
		);

		min-height: 68px;

		margin: 0 auto;

		display: flex;

		align-items: center;

		gap: 24px;

	}


	/* ========================================
	   Logo
	======================================== */

	.logo {

		position: relative;

		display: flex;

		align-items: baseline;

		gap: 10px;

		flex-shrink: 0;

		padding: 6px 0;

		transition:
			opacity var(--transition-fast),
			transform var(--transition-fast);

	}


	.logo::before {

		content: "";

		position: absolute;

		left: 0;

		right: 0;

		bottom: 0;

		height: 2px;

		background:
			var(--color-grass);

		transform:
			scaleX(0);

		transform-origin: left;

		transition:
			transform var(--transition-normal);

	}


	.logo:hover {

		opacity: 1;

	}


	.logo:hover::before {

		transform:
			scaleX(1);

	}


	.logo:active {

		transform:
			translateY(2px);

	}


	.logo-main {

		font-family:
			var(--font-display);

		font-size: 25px;

		font-weight: 900;

		letter-spacing: -0.06em;

		color:
			var(--color-text);

		text-shadow:
			1px 1px 0 var(--color-shadow);

	}


	.logo-sub {

		font-size: 10px;

		font-weight: 600;

		letter-spacing: 0.02em;

		color:
			var(--color-text-secondary);

		white-space: nowrap;

	}


	/* ========================================
	   Desktop Navigation
	======================================== */

	.desktop-nav {

		display: flex;

		align-items: stretch;

		gap: 4px;

		margin-left: auto;

		height: 42px;

	}


	.nav-link {

		position: relative;

		display: flex;

		align-items: stretch;

		min-width: 64px;

		border:
			1px solid var(--color-border);

		background:
			var(--color-surface);

		color:
			var(--color-text-secondary);

		box-shadow:
			0 3px 0 var(--color-border-strong);

		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			border-color var(--transition-fast),
			box-shadow var(--transition-fast),
			transform var(--transition-fast);

	}


	.nav-link::before {

		content: "";

		position: absolute;

		top: 0;

		left: 0;

		right: 0;

		height: 2px;

		background:
			linear-gradient(
				90deg,
				var(--color-gold-light),
				var(--color-grass-light)
			);

		opacity: 0;

		transition:
			opacity var(--transition-fast);

	}


	.nav-link-inner {

		display: flex;

		align-items: center;

		justify-content: center;

		padding:
			0 13px;

		font-size: 13px;

		font-weight: 700;

		white-space: nowrap;

	}


	.nav-link:hover {

		background:
			var(--color-surface-hover);

		color:
			var(--color-text);

		border-color:
			var(--color-border-strong);

		box-shadow:
			0 4px 0 var(--color-border-strong);

		transform:
			translateY(-1px);

	}


	.nav-link:hover::before {

		opacity: 1;

	}


