---
import MobileBottomNav from "./MobileBottomNav.astro";

const pathname = Astro.url.pathname;

const isWiki =
	pathname === "/docs" ||
	pathname.startsWith("/docs/");

const navItems = [
	{ label: "攻略", href: "/guide/" },
	{ label: "Wiki", href: "/docs/" },
	{ label: "ニュース", href: "/news/" },
	{ label: "ツール", href: "/tool/" },
	{ label: "NUGについて", href: "/about/" },
];

const wikiSections = [
	{
		label: "サーバー",
		items: [
			{
				label: "サーバー一覧",
				href: "/docs/servers/",
			},
			{
				label: "NEarth",
				href: "/docs/servers/nearth/",
			},
			{
				label: "Life",
				href: "/docs/servers/life/",
			},
			{
				label: "Cho",
				href: "/docs/servers/cho/",
			},
		],
	},
	{
		label: "プラグイン",
		items: [
			{
				label: "Lands",
				href: "/docs/plugins/lands/",
			},
			{
				label: "QuickShop",
				href: "/docs/plugins/quickshop/",
			},
			{
				label: "Jobs",
				href: "/docs/plugins/jobs/",
			},
			{
				label: "mcMMO",
				href: "/docs/plugins/mcmmo/",
			},
			{
				label: "Bolt",
				href: "/docs/plugins/bolt/",
			},
			{
				label: "PlayerGuard",
				href: "/docs/plugins/playerguard/",
			},
			{
				label: "LWC",
				href: "/docs/plugins/lwc/",
			},
		],
	},
	{
		label: "Mod",
		items: [
			{
				label: "使用可能なMod",
				href: "/docs/mods/allowed-mods/",
			},
		],
	},
];

const isActive = (href: string): boolean => {
	if (href === "/") {
		return pathname === "/";
	}

	return (
		pathname === href ||
		pathname.startsWith(href)
	);
};
---

<header
	class:list={[
		"site-header",
		{ "is-wiki": isWiki },
	]}
>
	<div class="header-light"></div>

	<div class="header-inner">
		<a
			href="/"
			class="logo"
			aria-label="NUG ホーム"
		>
			<span class="logo-main">NUG</span>

			<span class="logo-sub">
				Nekozouneko Unofficial Guide
			</span>
		</a>

		<nav
			class="desktop-nav"
			aria-label="メインナビゲーション"
		>
			{navItems.map((item) => {
				const active = isActive(item.href);

				return (
					<a
						href={item.href}
						class:list={[
							"nav-link",
							{ active },
						]}
						aria-current={
							active ? "page" : undefined
						}
					>
						<span class="nav-link-inner">
							{item.label}
						</span>
					</a>
				);
			})}
		</nav>

		<div class="header-actions">
			<!-- ========================================
			     Search
			======================================== -->

			<button
				class="icon-button search-button"
				type="button"
				aria-label="サイト内検索を開く"
				aria-expanded="false"
				aria-controls="nug-search-overlay"
			>
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>
					<path d="M16 16L21 21"></path>
				</svg>
			</button>

			<!-- ========================================
			     Theme
			======================================== -->

			<button
				class="icon-button theme-button"
				type="button"
				aria-label="テーマを切り替える"
				title="テーマを切り替える"
			>
				<svg
					class="theme-icon theme-icon-sun"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="12"
						cy="12"
						r="4"
					></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
				</svg>

				<svg
					class="theme-icon theme-icon-moon"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"></path>
				</svg>
			</button>

			<!-- ========================================
			     Wiki Navigation
			     Wiki pages only
			======================================== -->

			{isWiki && (
				<button
					class="icon-button wiki-nav-button"
					type="button"
					aria-label="Wikiナビゲーションを開く"
					aria-expanded="false"
					aria-controls="nug-wiki-navigation"
				>
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			)}
		</div>
	</div>

	<!-- ============================================
	     Search Overlay
	============================================ -->

	<div
		id="nug-search-overlay"
		class="search-overlay"
		aria-hidden="true"
	>
		<div
			class="search-overlay-backdrop"
			data-search-close
		></div>

		<div
			class="search-dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="nug-search-title"
		>
			<div class="search-dialog-header">
				<div>
					<p class="search-label">
						SEARCH
					</p>

					<h2 id="nug-search-title">
						NUGを検索
					</h2>
				</div>

				<button
					class="search-close"
					type="button"
					aria-label="検索を閉じる"
				>
					×
				</button>
			</div>

			<div class="search-input-wrapper">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>
					<path d="M16 16L21 21"></path>
				</svg>

				<input
					id="nug-search-input"
					type="search"
					placeholder="攻略・プラグイン・コマンドなどを検索"
					aria-label="サイト内検索"
					autocomplete="off"
					spellcheck="false"
				/>
			</div>

			<div
				class="search-status"
				id="nug-search-status"
				aria-live="polite"
			></div>

			<div
				id="nug-search-results"
				class="search-results"
				aria-live="polite"
			></div>
		</div>
	</div>

	<!-- ============================================
	     NUGBASE Wiki Navigation
	============================================ -->

	{isWiki && (
		<div
			id="nug-wiki-navigation"
			class="wiki-navigation"
			aria-hidden="true"
		>
			<div
				class="wiki-navigation-backdrop"
				data-wiki-nav-close
			></div>

			<div
				class="wiki-navigation-panel"
				role="dialog"
				aria-modal="true"
				aria-label="Wikiナビゲーション"
			>
				<div class="wiki-navigation-header">
					<div>
						<p class="wiki-navigation-label">
							WIKI NAVIGATION
						</p>

						<h2>Wikiナビ</h2>
					</div>

					<button
						class="wiki-navigation-close"
						type="button"
						aria-label="Wikiナビゲーションを閉じる"
					>
						×
					</button>
				</div>

				<nav
					class="wiki-navigation-content"
					aria-label="Wikiナビゲーション"
				>
					{wikiSections.map((section) => (
						<section
							class="wiki-navigation-section"
						>
							<h3>{section.label}</h3>

							<div class="wiki-navigation-links">
								{section.items.map((item) => {
									const active =
										pathname === item.href ||
										pathname.startsWith(
											item.href
										);

									return (
										<a
											href={item.href}
											class:list={[
												"wiki-navigation-link",
												{ active },
											]}
											aria-current={
												active
													? "page"
													: undefined
											}
										>
											<span>
												{item.label}
											</span>

											<span
												class="wiki-navigation-arrow"
												aria-hidden="true"
											>
												›
											</span>
										</a>
									);
								})}
							</div>
						</section>
					))}
				</nav>
			</div>
		</div>
	)}
</header>

<MobileBottomNav />

<script>
	type Theme = "light" | "dark";

	type PagefindResultData = {
		title?: string;
		url?: string;
		excerpt?: string;
		meta?: Record<string, string>;
	};

	type PagefindSearchResult = {
		data: () => Promise<PagefindResultData>;
	};

	type PagefindSearchResponse = {
		results: PagefindSearchResult[];
	};

	type PagefindModule = {
		search: (
			query: string
		) => Promise<PagefindSearchResponse>;
	};

	const header =
		document.querySelector<HTMLElement>(
			".site-header"
		);

	/* ============================================
	   Search
	============================================ */

	const searchButton =
		document.querySelector<HTMLButtonElement>(
			".search-button"
		);

	const searchOverlay =
		document.querySelector<HTMLElement>(
			"#nug-search-overlay"
		);

	const searchClose =
		document.querySelector<HTMLButtonElement>(
			".search-close"
		);

	const searchBackdrop =
		document.querySelector<HTMLElement>(
			"[data-search-close]"
		);

	const searchInput =
		document.querySelector<HTMLInputElement>(
			"#nug-search-input"
		);

	const searchResults =
		document.querySelector<HTMLElement>(
			"#nug-search-results"
		);

	const searchStatus =
		document.querySelector<HTMLElement>(
			"#nug-search-status"
		);

	/* ============================================
	   Theme
	============================================ */

	const themeButton =
		document.querySelector<HTMLButtonElement>(
			".theme-button"
		);

	/* ============================================
	   Wiki Navigation
	============================================ */

	const wikiNavButton =
		document.querySelector<HTMLButtonElement>(
			".wiki-nav-button"
		);

	const wikiNavigation =
		document.querySelector<HTMLElement>(
			"#nug-wiki-navigation"
		);

	const wikiNavigationClose =
		document.querySelector<HTMLButtonElement>(
			".wiki-navigation-close"
		);

	const wikiNavigationBackdrop =
		document.querySelector<HTMLElement>(
			"[data-wiki-nav-close]"
		);

	const themeStorageKey = "nug-theme";

	let pagefind: PagefindModule | null = null;
	let searchRequest = 0;

	/* ============================================
	   Theme Functions
	============================================ */

	const getSystemTheme = (): Theme => {
		return window.matchMedia(
			"(prefers-color-scheme: dark)"
		).matches
			? "dark"
			: "light";
	};

	const getTheme = (): Theme => {
		return document.documentElement.dataset.theme ===
			"dark"
			? "dark"
			: "light";
	};

	const updateThemeButton = (): void => {
		if (!themeButton) {
			return;
		}

		const nextTheme =
			getTheme() === "dark"
				? "light"
				: "dark";

		const label =
			nextTheme === "dark"
				? "ダークモードに切り替える"
				: "ライトモードに切り替える";

		themeButton.setAttribute(
			"aria-label",
			label
		);

		themeButton.setAttribute(
			"title",
			label
		);
	};

	const setTheme = (
		theme: Theme,
		save = true
	): void => {
		document.documentElement.dataset.theme =
			theme;

		document.documentElement.style.colorScheme =
			theme;

		if (save) {
			localStorage.setItem(
				themeStorageKey,
				theme
			);
		}

		updateThemeButton();
	};

	const savedTheme =
		localStorage.getItem(
			themeStorageKey
		);

	if (
		savedTheme === "light" ||
		savedTheme === "dark"
	) {
		setTheme(savedTheme, false);
	} else {
		setTheme(getSystemTheme(), false);
	}

	themeButton?.addEventListener(
		"click",
		() => {
			setTheme(
				getTheme() === "dark"
					? "light"
					: "dark",
				true
			);
		}
	);

	window
		.matchMedia("(prefers-color-scheme: dark)")
		.addEventListener(
			"change",
			() => {
				const saved =
					localStorage.getItem(
						themeStorageKey
					);

				if (
					saved === "light" ||
					saved === "dark"
				) {
					return;
				}

				setTheme(
					getSystemTheme(),
					false
				);
			}
		);

	updateThemeButton();

	/* ============================================
	   Wiki Navigation Functions
	============================================ */

	const setWikiNavigationState = (
		isOpen: boolean
	): void => {
		if (
			!wikiNavButton ||
			!wikiNavigation
		) {
			return;
		}

		wikiNavigation.classList.toggle(
			"is-open",
			isOpen
		);

		wikiNavButton.setAttribute(
			"aria-expanded",
			String(isOpen)
		);

		wikiNavigation.setAttribute(
			"aria-hidden",
			String(!isOpen)
		);

		document.body.classList.toggle(
			"wiki-navigation-open",
			isOpen
		);

		if (isOpen) {
			wikiNavigationClose?.focus();
		}
	};

	wikiNavButton?.addEventListener(
		"click",
		() => {
			const isOpen =
				wikiNavigation?.classList.contains(
					"is-open"
				) ?? false;

			setWikiNavigationState(
				!isOpen
			);
		}
	);

	wikiNavigationClose?.addEventListener(
		"click",
		() => {
			setWikiNavigationState(false);
			wikiNavButton?.focus();
		}
	);

	wikiNavigationBackdrop?.addEventListener(
		"click",
		() => {
			setWikiNavigationState(false);
			wikiNavButton?.focus();
		}
	);

	/* ============================================
	   Pagefind
	============================================ */

	async function loadPagefind(): Promise<PagefindModule> {
		if (pagefind) {
			return pagefind;
		}

		const pagefindUrl =
			new URL(
				"/pagefind/pagefind.js",
				window.location.origin
			).href;

		const loadModule =
			new Function(
				"url",
				"return import(url)"
			) as (
				url: string
			) => Promise<PagefindModule>;

		pagefind =
			await loadModule(
				pagefindUrl
			);

		return pagefind;
	}

	const getCategory = (
		url: string
	): string => {
		if (
			url === "/docs" ||
			url.startsWith("/docs/")
		) {
			return "Wiki";
		}

		if (
			url === "/guide" ||
			url.startsWith("/guide/")
		) {
			return "攻略";
		}

		if (
			url === "/news" ||
			url.startsWith("/news/")
		) {
			return "ニュース";
		}

		if (
			url === "/tool" ||
			url.startsWith("/tool/")
		) {
			return "ツール";
		}

		if (
			url === "/about" ||
			url.startsWith("/about/")
		) {
			return "NUGについて";
		}

		return "サイト";
	};

	const getTitle = (
		item: PagefindResultData
	): string => {
		return (
			item.meta?.title ??
			item.title ??
			"無題のページ"
		);
	};

	const getExcerptText = (
		excerpt: string
	): string => {
		const parsed =
			new DOMParser().parseFromString(
				excerpt,
				"text/html"
			);

		return (
			parsed.body.textContent ??
			""
		).trim();
	};

	const appendText = (
		parent: HTMLElement,
		className: string,
		text: string
	): void => {
		const element =
			document.createElement("span");

		element.className = className;
		element.textContent = text;

		parent.append(element);
	};

	const clearSearchResults = (): void => {
		searchResults?.replaceChildren();

		searchResults?.classList.remove(
			"has-results"
		);

		if (searchStatus) {
			searchStatus.textContent = "";

			searchStatus.classList.remove(
				"visible",
				"loading",
				"error"
			);
		}
	};

	const setSearchStatus = (
		text: string,
		className = ""
	): void => {
		if (!searchStatus) {
			return;
		}

		searchStatus.className =
			`search-status visible ${className}`.trim();

		searchStatus.textContent = text;
	};

	const createSearchResult = (
		item: PagefindResultData
	): HTMLAnchorElement => {
		const url =
			item.url?.startsWith("/")
				? item.url
				: "/";

		const link =
			document.createElement("a");

		link.className =
			"search-result";

		link.href = url;

		const content =
			document.createElement("div");

		content.className =
			"search-result-content";

		appendText(
			content,
			"search-result-category",
			getCategory(url)
		);

		appendText(
			content,
			"search-result-title",
			getTitle(item)
		);

		const excerpt =
			document.createElement("p");

		excerpt.textContent =
			getExcerptText(
				item.excerpt ?? ""
			);

		content.append(excerpt);

		const arrow =
			document.createElement("span");

		arrow.className =
			"search-result-arrow";

		arrow.setAttribute(
			"aria-hidden",
			"true"
		);

		arrow.textContent = "→";

		link.append(
			content,
			arrow
		);

		return link;
	};

	async function performSearch(
		query: string
	): Promise<void> {
		if (!searchResults) {
			return;
		}

		const keyword =
			query.trim();

		const requestId =
			++searchRequest;

		if (!keyword) {
			clearSearchResults();
			return;
		}

		setSearchStatus(
			"検索中…",
			"loading"
		);

		searchResults.replaceChildren();

		searchResults.classList.remove(
			"has-results"
		);

		try {
			const search =
				await loadPagefind();

			const result =
				await search.search(
					keyword
				);

			const total =
				result.results.length;

			const items =
				await Promise.all(
					result.results
						.slice(0, 20)
						.map(
							(item) =>
								item.data()
						)
				);

			if (
				requestId !== searchRequest
			) {
				return;
			}

			if (total === 0) {
				setSearchStatus(
					"検索結果がありません"
				);

				const empty =
					document.createElement(
						"div"
					);

				empty.className =
					"search-empty";

				appendText(
					empty,
					"search-empty-title",
					"一致するページが見つかりませんでした"
				);

				appendText(
					empty,
					"search-empty-description",
					"別のキーワードを試してください。"
				);

				searchResults.append(
					empty
				);

				searchResults.classList.add(
					"has-results"
				);

				return;
			}

			setSearchStatus(
				`${total}件の検索結果`
			);

			for (const item of items) {
				searchResults.append(
					createSearchResult(item)
				);
			}

			searchResults.classList.add(
				"has-results"
			);
		} catch (error) {
			if (
				requestId !== searchRequest
			) {
				return;
			}

			console.error(
				"NUG Pagefind Error:",
				error
			);

			setSearchStatus(
				"検索を読み込めませんでした",
				"error"
			);

			const errorElement =
				document.createElement(
					"div"
				);

			errorElement.className =
				"search-empty search-error";

			appendText(
				errorElement,
				"search-empty-title",
				"検索に失敗しました"
			);

			appendText(
				errorElement,
				"search-empty-description",
				"ページを再読み込みして、もう一度お試しください。"
			);

			searchResults.append(
				errorElement
			);

			searchResults.classList.add(
				"has-results"
			);
		}
	}

	/* ============================================
	   Search State
	============================================ */

	const setSearchState = (
		isOpen: boolean
	): void => {
		if (
			!header ||
			!searchButton ||
			!searchOverlay
		) {
			return;
		}

		header.classList.toggle(
			"search-open",
			isOpen
		);

		searchButton.setAttribute(
			"aria-expanded",
			String(isOpen)
		);

		searchOverlay.setAttribute(
			"aria-hidden",
			String(!isOpen)
		);

		if (isOpen) {
			document.body.classList.add(
				"overlay-open"
			);

			requestAnimationFrame(() => {
				searchInput?.focus();
			});

			return;
		}

		document.body.classList.remove(
			"overlay-open"
		);

		if (searchInput) {
			searchInput.value = "";
		}

		clearSearchResults();
	};

	searchButton?.addEventListener(
		"click",
		() => {
			setSearchState(
				!(
					header?.classList.contains(
						"search-open"
					) ?? false
				)
			);
		}
	);

	searchClose?.addEventListener(
		"click",
		() => {
			setSearchState(false);
			searchButton?.focus();
		}
	);

	searchBackdrop?.addEventListener(
		"click",
		() => {
			setSearchState(false);
		}
	);

	document.addEventListener(
		"nug:open-search",
		() => {
			setSearchState(true);
		}
	);

	searchInput?.addEventListener(
		"input",
		() => {
			performSearch(
				searchInput.value
			);
		}
	);

	searchInput?.addEventListener(
		"keydown",
		(event) => {
			if (event.key !== "Enter") {
				return;
			}

			const firstResult =
				searchResults?.querySelector<HTMLAnchorElement>(
					".search-result"
				);

			if (firstResult) {
				event.preventDefault();
				firstResult.click();
			}
		}
	);

	/* ============================================
	   Keyboard
	============================================ */

	document.addEventListener(
		"keydown",
		(event) => {
			if (event.key !== "Escape") {
				return;
			}

			if (
				header?.classList.contains(
					"search-open"
				)
			) {
				setSearchState(false);
				searchButton?.focus();
				return;
			}

			if (
				wikiNavigation?.classList.contains(
					"is-open"
				)
			) {
				setWikiNavigationState(false);
				wikiNavButton?.focus();
			}
		}
	);
</script>

