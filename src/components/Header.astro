---
import MobileBottomNav from "./MobileBottomNav.astro";

const pathname = Astro.url.pathname;

const isWiki =
	pathname === "/docs" ||
	pathname.startsWith("/docs/");

const navItems = [
	{ label: "攻略", href: "/guide/" },
	{ label: "Wiki", href: "/docs/" },
	{ label: "ニュース", href: "/news/" },
	{ label: "ツール", href: "/tool/" },
	{ label: "NUGについて", href: "/about/" },
];

const wikiSections = [
	{
		label: "サーバー",
		items: [
			{
				label: "サーバー一覧",
				href: "/docs/server/",
			},
			{
				label: "NEarth",
				href: "/docs/server/nearth/",
			},
			{
				label: "Life",
				href: "/docs/server/life/",
			},
			{
				label: "Cho",
				href: "/docs/server/cho/",
			},
		],
	},
	{
		label: "プラグイン",
		items: [
			{
				label: "Lands",
				href: "/docs/plugin/lands/",
			},
			{
				label: "QuickShop",
				href: "/docs/plugin/quickshop/",
			},
			{
				label: "Jobs",
				href: "/docs/plugin/jobs/",
			},
			{
				label: "mcMMO",
				href: "/docs/plugin/mcmmo/",
			},
			{
				label: "Bolt",
				href: "/docs/plugin/bolt/",
			},
			{
				label: "PlayerGuard",
				href: "/docs/plugin/playerguard/",
			},
			{
				label: "LWC",
				href: "/docs/plugin/lwc/",
			},
		],
	},
	{
		label: "Mod",
		items: [
			{
				label: "使用可能なMod",
				href: "/docs/mod/",
			},
		],
	},
];

const isActive = (href: string): boolean => {
	if (href === "/") {
		return pathname === "/";
	}

	return (
		pathname === href ||
		pathname.startsWith(href)
	);
};
---

<header
	class:list={[
		"site-header",
		{ "is-wiki": isWiki },
	]}
>
	<div class="header-light"></div>
	<div class="header-noise"></div>

	<div class="header-inner">
		<!-- =====================================================
		     Logo
		===================================================== -->

		<a
			href="/"
			class="logo"
			aria-label="NUG ホーム"
		>
			<span class="logo-mark">
				NUG
			</span>

			<span class="logo-sub">
				Nekozouneko Unofficial Guide
			</span>
		</a>

		<!-- =====================================================
		     Desktop Navigation
		===================================================== -->

		<nav
			class="desktop-nav"
			aria-label="メインナビゲーション"
		>
			{navItems.map((item) => {
				const active = isActive(item.href);

				return (
					<a
						href={item.href}
						class:list={[
							"nav-link",
							{ active },
						]}
						aria-current={
							active ? "page" : undefined
						}
					>
						<span class="nav-link-inner">
							{item.label}
						</span>
					</a>
				);
			})}
		</nav>

		<!-- =====================================================
		     Header Actions
		===================================================== -->

		<div class="header-actions">
			<!-- Authentication -->

			<a
				id="nug-auth-button"
				class="auth-button"
				href="/api/auth/google"
				aria-label="Googleでログイン"
				title="Googleでログイン"
			>
				<span
					class="auth-button-icon"
					aria-hidden="true"
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M20 21a8 8 0 0 0-16 0" />
						<circle cx="12" cy="7" r="4" />
					</svg>
				</span>

				<span class="auth-button-label">
					ログイン
				</span>
			</a>

			<!-- Search -->

			<button
				class="icon-button search-button"
				type="button"
				aria-label="サイト内検索を開く"
				aria-expanded="false"
				aria-controls="nug-search-overlay"
			>
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>

					<path d="M16 16L21 21"></path>
				</svg>
			</button>

			<!-- Theme -->

			<button
				class="icon-button theme-button"
				type="button"
				aria-label="テーマを切り替える"
				title="テーマを切り替える"
			>
				<svg
					class="theme-icon theme-icon-sun"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="12"
						cy="12"
						r="4"
					></circle>

					<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
				</svg>

				<svg
					class="theme-icon theme-icon-moon"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"></path>
				</svg>
			</button>

			<!-- Wiki Navigation -->

			{isWiki && (
				<button
					class="icon-button wiki-nav-button"
					type="button"
					aria-label="Wikiナビゲーションを開く"
					aria-expanded="false"
					aria-controls="nug-wiki-navigation"
				>
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			)}
		</div>
	</div>

	<!-- =========================================================
	     Search Overlay
	========================================================= -->

	<div
		id="nug-search-overlay"
		class="search-overlay"
		aria-hidden="true"
	>
		<div
			class="search-overlay-backdrop"
			data-search-close
		></div>

		<div
			class="search-dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="nug-search-title"
		>
			<div class="search-dialog-header">
				<div>
					<p class="search-label">
						SEARCH
					</p>

					<h2 id="nug-search-title">
						NUGを検索
					</h2>
				</div>

				<button
					class="search-close"
					type="button"
					aria-label="検索を閉じる"
				>
					×
				</button>
			</div>

			<div class="search-input-wrapper">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>

					<path d="M16 16L21 21"></path>
				</svg>

				<input
					id="nug-search-input"
					type="search"
					placeholder="攻略・プラグイン・コマンドなどを検索"
					aria-label="サイト内検索"
					autocomplete="off"
					spellcheck="false"
				/>
			</div>

			<div
				class="search-status"
				id="nug-search-status"
				aria-live="polite"
			></div>

			<div
				id="nug-search-results"
				class="search-results"
				aria-live="polite"
			></div>
		</div>
	</div>

	<!-- =========================================================
	     Wiki Navigation
	========================================================= -->

	{isWiki && (
		<div
			id="nug-wiki-navigation"
			class="wiki-navigation"
			aria-hidden="true"
		>
			<div
				class="wiki-navigation-backdrop"
				data-wiki-nav-close
			></div>

			<div
				class="wiki-navigation-panel"
				role="dialog"
				aria-modal="true"
				aria-label="Wikiナビゲーション"
			>
				<div class="wiki-navigation-header">
					<div>
						<p class="wiki-navigation-label">
							WIKI NAVIGATION
						</p>

						<h2>Wikiナビ</h2>
					</div>

					<button
						class="wiki-navigation-close"
						type="button"
						aria-label="Wikiナビゲーションを閉じる"
					>
						×
					</button>
				</div>

				<nav
					class="wiki-navigation-content"
					aria-label="Wikiナビゲーション"
				>
					{wikiSections.map((section) => (
						<section
							class="wiki-navigation-section"
						>
							<h3>
								<span class="section-marker"></span>
								{section.label}
							</h3>

							<div class="wiki-navigation-links">
								{section.items.map((item) => {
									const active =
										pathname === item.href ||
										pathname.startsWith(
											item.href
										);

									return (
										<a
											href={item.href}
											class:list={[
												"wiki-navigation-link",
												{ active },
											]}
											aria-current={
												active
													? "page"
													: undefined
											}
										>
											<span class="wiki-link-label">
												{item.label}
											</span>

											<span
												class="wiki-navigation-arrow"
												aria-hidden="true"
											>
												›
											</span>
										</a>
									);
								})}
							</div>
						</section>
					))}
				</nav>
			</div>
		</div>
	)}
</header>

<MobileBottomNav />

<script>
	type Theme = "light" | "dark";

	type PagefindResultData = {
		title?: string;
		url?: string;
		excerpt?: string;
		meta?: Record<string, string>;
	};

	type PagefindSearchResult = {
		data: () => Promise<PagefindResultData>;
	};

	type PagefindSearchResponse = {
		results: PagefindSearchResult[];
	};

	type PagefindModule = {
		search: (
			query: string
		) => Promise<PagefindSearchResponse>;
	};

	type AuthUser = {
		id?: string;
		display_name?: string;
		email?: string;
		avatar_url?: string;
		role?: string;
		expires_at?: string;
	};

	type AuthResponse = {
		ok?: boolean;
		loggedIn?: boolean;
		user?: AuthUser | null;
	};

	const header =
		document.querySelector<HTMLElement>(
			".site-header"
		);

	/* =========================================================
	   Authentication
	========================================================= */

	const authButton =
		document.querySelector<HTMLAnchorElement>(
			"#nug-auth-button"
		);

	let currentAuthUser: AuthUser | null = null;

	/* =========================================================
	   Wiki Edit Button
	========================================================= */

	const addWikiEditButton = (): void => {
		if (!isWiki) {
			return;
		}

		if (!currentAuthUser) {
			return;
		}

		const role =
			currentAuthUser.role;

		/*
		 * Wiki編集が可能なのは editor / admin のみ。
		 */
		if (
			role !== "editor" &&
			role !== "admin"
		) {
			return;
		}

		/*
		 * StarlightのWiki本文にある
		 * ページタイトルを取得する。
		 */
		const title =
			document.querySelector<HTMLElement>(
				"main h1"
			);

		if (!title) {
			return;
		}

		/*
		 * すでにボタンがある場合は
		 * 二重生成しない。
		 */
		if (
			document.querySelector(
				".nug-wiki-edit-button"
			)
		) {
			return;
		}

		const titleParent =
			title.parentElement;

		if (!titleParent) {
			return;
		}

		/*
		 * タイトルと編集ボタンを
		 * 横並びにする。
		 */
		titleParent.classList.add(
			"nug-wiki-title-row"
		);

		/*
		 * 現在のWikiページURLを取得。
		 *
		 * 例:
		 * /docs/plugin/lands/
		 *
		 * ↓
		 *
		 * /wiki/edit?path=%2Fdocs%2Fplugin%2Flands%2F
		 */
		const currentPath =
			window.location.pathname;

		const editButton =
			document.createElement("a");

		editButton.className =
			"nug-wiki-edit-button";

		editButton.href =
			`/wiki/edit?path=${encodeURIComponent(
				currentPath
			)}`;

		editButton.setAttribute(
			"aria-label",
			"このWikiページを編集"
		);

		editButton.title =
			"このWikiページを編集";

		editButton.innerHTML = `
			<svg
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<path d="M12 20h9"></path>
				<path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
			</svg>

			<span>編集</span>
		`;

		titleParent.appendChild(
			editButton
		);
	};

	const updateAuthButton =
		async (): Promise<void> => {
			if (!authButton) {
				return;
			}

			try {
				const response =
					await fetch("/me", {
						method: "GET",
						credentials:
							"same-origin",
						headers: {
							Accept:
								"application/json",
						},
					});

				if (!response.ok) {
					return;
				}

				const data =
					(await response.json()) as AuthResponse;

				if (
					data.ok &&
					data.loggedIn &&
					data.user
				) {
					currentAuthUser =
						data.user;

					const displayName =
						data.user.display_name ||
						"アカウント";

					const label =
						authButton.querySelector<HTMLElement>(
							".auth-button-label"
						);

					if (label) {
						label.textContent =
							displayName;
					}

					authButton.href =
						"/account/";

					authButton.setAttribute(
						"aria-label",
						`${displayName}としてログイン中`
					);

					authButton.setAttribute(
						"title",
						`${displayName}としてログイン中`
					);

					authButton.classList.add(
						"is-logged-in"
					);

					/*
					 * 認証情報を取得した後で
					 * Wiki編集ボタンを生成する。
					 */
					addWikiEditButton();
				}
			} catch (error) {
				console.error(
					"NUG Auth Error:",
					error
				);
			}
		};

	/*
	 * 認証状態の取得開始。
	 */
	void updateAuthButton();

	/* =========================================================
	   Search
	========================================================= */

	const searchButton =
		document.querySelector<HTMLButtonElement>(
			".search-button"
		);

	const searchOverlay =
		document.querySelector<HTMLElement>(
			"#nug-search-overlay"
		);

	const searchClose =
		document.querySelector<HTMLButtonElement>(
			".search-close"
		);

	const searchBackdrop =
		document.querySelector<HTMLElement>(
			"[data-search-close]"
		);

	const searchInput =
		document.querySelector<HTMLInputElement>(
			"#nug-search-input"
		);

	const searchResults =
		document.querySelector<HTMLElement>(
			"#nug-search-results"
		);

	const searchStatus =
		document.querySelector<HTMLElement>(
			"#nug-search-status"
		);

	/* =========================================================
	   Theme
	========================================================= */

	const themeButton =
		document.querySelector<HTMLButtonElement>(
			".theme-button"
		);

	const themeStorageKey =
		"nug-theme";

	let pagefind: PagefindModule | null =
		null;

	let searchRequest = 0;

	const getSystemTheme =
		(): Theme => {
			return window.matchMedia(
				"(prefers-color-scheme: dark)"
			).matches
				? "dark"
				: "light";
		};

	const getTheme =
		(): Theme => {
			return document.documentElement
				.dataset.theme === "dark"
				? "dark"
				: "light";
		};

	const updateThemeButton =
		(): void => {
			if (!themeButton) {
				return;
			}

			const nextTheme =
				getTheme() === "dark"
					? "light"
					: "dark";

			const label =
				nextTheme === "dark"
					? "ダークモードに切り替える"
					: "ライトモードに切り替える";

			themeButton.setAttribute(
				"aria-label",
				label
			);

			themeButton.setAttribute(
				"title",
				label
			);
		};

	const setTheme =
		(
			theme: Theme,
			save = true
		): void => {
			document.documentElement
				.dataset.theme = theme;

			document.documentElement.style
				.colorScheme = theme;

			if (save) {
				localStorage.setItem(
					themeStorageKey,
					theme
				);
			}

			updateThemeButton();
		};

	const savedTheme =
		localStorage.getItem(
			themeStorageKey
		);

	if (
		savedTheme === "light" ||
		savedTheme === "dark"
	) {
		setTheme(
			savedTheme,
			false
		);
	} else {
		setTheme(
			getSystemTheme(),
			false
		);
	}

	themeButton?.addEventListener(
		"click",
		() => {
			setTheme(
				getTheme() === "dark"
					? "light"
					: "dark",
				true
			);
		}
	);

	window
		.matchMedia(
			"(prefers-color-scheme: dark)"
		)
		.addEventListener(
			"change",
			() => {
				const saved =
					localStorage.getItem(
						themeStorageKey
					);

				if (
					saved === "light" ||
					saved === "dark"
				) {
					return;
				}

				setTheme(
					getSystemTheme(),
					false
				);
			}
		);

	updateThemeButton();

	/* =========================================================
	   Wiki Navigation
	========================================================= */

	const wikiNavButton =
		document.querySelector<HTMLButtonElement>(
			".wiki-nav-button"
		);

	const wikiNavigation =
		document.querySelector<HTMLElement>(
			"#nug-wiki-navigation"
		);

	const wikiNavigationClose =
		document.querySelector<HTMLButtonElement>(
			".wiki-navigation-close"
		);

	const wikiNavigationBackdrop =
		document.querySelector<HTMLElement>(
			"[data-wiki-nav-close]"
		);

	const setWikiNavigationState =
		(
			isOpen: boolean
		): void => {
			if (
				!wikiNavButton ||
				!wikiNavigation
			) {
				return;
			}

			wikiNavigation.classList.toggle(
				"is-open",
				isOpen
			);

			wikiNavButton.setAttribute(
				"aria-expanded",
				String(isOpen)
			);

			wikiNavigation.setAttribute(
				"aria-hidden",
				String(!isOpen)
			);

			document.body.classList.toggle(
				"wiki-navigation-open",
				isOpen
			);

			if (isOpen) {
				requestAnimationFrame(
					() => {
						wikiNavigationClose?.focus();
					}
				);
			}
		};

	wikiNavButton?.addEventListener(
		"click",
		() => {
			const isOpen =
				wikiNavigation?.classList.contains(
					"is-open"
				) ?? false;

			setWikiNavigationState(
				!isOpen
			);
		}
	);

	wikiNavigationClose?.addEventListener(
		"click",
		() => {
			setWikiNavigationState(
				false
			);

			wikiNavButton?.focus();
		}
	);

	wikiNavigationBackdrop?.addEventListener(
		"click",
		() => {
			setWikiNavigationState(
				false
			);

			wikiNavButton?.focus();
		}
	);

	/* =========================================================
	   Pagefind
	========================================================= */

	async function loadPagefind(): Promise<PagefindModule> {
		if (pagefind) {
			return pagefind;
		}

		const pagefindUrl =
			new URL(
				"/pagefind/pagefind.js",
				window.location.origin
			).href;

		const loadModule =
			new Function(
				"url",
				"return import(url)"
			) as (
				url: string
			) => Promise<PagefindModule>;

		pagefind =
			await loadModule(
				pagefindUrl
			);

		return pagefind;
	}

	const getCategory =
		(
			url: string
		): string => {
			if (
				url === "/docs" ||
				url.startsWith("/docs/")
			) {
				return "Wiki";
			}

			if (
				url === "/guide" ||
				url.startsWith("/guide/")
			) {
				return "攻略";
			}

			if (
				url === "/news" ||
				url.startsWith("/news/")
			) {
				return "ニュース";
			}

			if (
				url === "/tool" ||
				url.startsWith("/tool/")
			) {
				return "ツール";
			}

			if (
				url === "/about" ||
				url.startsWith("/about/")
			) {
				return "NUGについて";
			}

			return "サイト";
		};

	const getTitle =
		(
			item: PagefindResultData
		): string => {
			return (
				item.meta?.title ??
				item.title ??
				"無題のページ"
			);
		};

	const getExcerptText =
		(
			excerpt: string
		): string => {
			const parsed =
				new DOMParser().parseFromString(
					excerpt,
					"text/html"
				);

			return (
				parsed.body.textContent ??
				""
			).trim();
		};

	const appendText =
		(
			parent: HTMLElement,
			className: string,
			text: string
		): void => {
			const element =
				document.createElement(
					"span"
				);

			element.className =
				className;

			element.textContent =
				text;

			parent.appendChild(
				element
			);
		};

	const clearSearchResults =
		(): void => {
			searchResults?.replaceChildren();

			searchResults?.classList.remove(
				"has-results"
			);

			if (searchStatus) {
				searchStatus.textContent =
					"";

				searchStatus.classList.remove(
					"visible",
					"loading",
					"error"
				);
			}
		};

	const setSearchStatus =
		(
			text: string,
			className = ""
		): void => {
			if (!searchStatus) {
				return;
			}

			searchStatus.className =
				`search-status visible ${className}`.trim();

			searchStatus.textContent =
				text;
		};

	const createSearchResult =
		(
			item: PagefindResultData
		): HTMLAnchorElement => {
			const url =
				item.url?.startsWith("/")
					? item.url
					: "/";

			const link =
				document.createElement(
					"a"
				);

			link.className =
				"search-result";

			link.href = url;

			const content =
				document.createElement(
					"div"
				);

			content.className =
				"search-result-content";

			appendText(
				content,
				"search-result-category",
				getCategory(url)
			);

			appendText(
				content,
				"search-result-title",
				getTitle(item)
			);

			const excerpt =
				document.createElement(
					"p"
				);

			excerpt.textContent =
				getExcerptText(
					item.excerpt ?? ""
				);

			content.appendChild(
				excerpt
			);

			const arrow =
				document.createElement(
					"span"
				);

			arrow.className =
				"search-result-arrow";

			arrow.setAttribute(
				"aria-hidden",
				"true"
			);

			arrow.textContent =
				"→";

			link.appendChild(
				content
			);

			link.appendChild(
				arrow
			);

			return link;
		};

	async function performSearch(
		query: string
	): Promise<void> {
		if (!searchResults) {
			return;
		}

		const keyword =
			query.trim();

		const requestId =
			++searchRequest;

		if (!keyword) {
			clearSearchResults();
			return;
		}

		setSearchStatus(
			"検索中…",
			"loading"
		);

		searchResults.replaceChildren();

		searchResults.classList.remove(
			"has-results"
		);

		try {
			const search =
				await loadPagefind();

			const result =
				await search.search(
					keyword
				);

			const total =
				result.results.length;

			const items =
				await Promise.all(
					result.results
						.slice(0, 20)
						.map(
							(item) =>
								item.data()
						)
				);

			if (
				requestId !==
				searchRequest
			) {
				return;
			}

			if (total === 0) {
				setSearchStatus(
					"検索結果がありません"
				);

				const empty =
					document.createElement(
						"div"
					);

				empty.className =
					"search-empty";

				appendText(
					empty,
					"search-empty-title",
					"一致するページが見つかりませんでした"
				);

				appendText(
					empty,
					"search-empty-description",
					"別のキーワードを試してください。"
				);

				searchResults.appendChild(
					empty
				);

				searchResults.classList.add(
					"has-results"
				);

				return;
			}

			setSearchStatus(
				`${total}件の検索結果`
			);

			for (
				const item of items
			) {
				searchResults.appendChild(
					createSearchResult(
						item
					)
				);
			}

			searchResults.classList.add(
				"has-results"
			);
		} catch (error) {
			if (
				requestId !==
				searchRequest
			) {
				return;
			}

			console.error(
				"NUG Pagefind Error:",
				error
			);

			setSearchStatus(
				"検索を読み込めませんでした",
				"error"
			);

			const errorElement =
				document.createElement(
					"div"
				);

			errorElement.className =
				"search-empty search-error";

			appendText(
				errorElement,
				"search-empty-title",
				"検索に失敗しました"
			);

			appendText(
				errorElement,
				"search-empty-description",
				"ページを再読み込みして、もう一度お試しください。"
			);

			searchResults.appendChild(
				errorElement
			);

			searchResults.classList.add(
				"has-results"
			);
		}
	}

	/* =========================================================
	   Search State
	========================================================= */

	const setSearchState =
		(
			isOpen: boolean
		): void => {
			if (
				!header ||
				!searchButton ||
				!searchOverlay
			) {
				return;
			}

			header.classList.toggle(
				"search-open",
				isOpen
			);

			searchButton.setAttribute(
				"aria-expanded",
				String(isOpen)
			);

			searchOverlay.setAttribute(
				"aria-hidden",
				String(!isOpen)
			);

			if (isOpen) {
				document.body.classList.add(
					"overlay-open"
				);

				requestAnimationFrame(
					() => {
						searchInput?.focus();
					}
				);

				return;
			}

			document.body.classList.remove(
				"overlay-open"
			);

			if (searchInput) {
				searchInput.value =
					"";
			}

			clearSearchResults();
		};

	searchButton?.addEventListener(
		"click",
		() => {
			setSearchState(
				!(
					header?.classList.contains(
						"search-open"
					) ?? false
				)
			);
		}
	);

	searchClose?.addEventListener(
		"click",
		() => {
			setSearchState(
				false
			);

			searchButton?.focus();
		}
	);

	searchBackdrop?.addEventListener(
		"click",
		() => {
			setSearchState(
				false
			);
		}
	);

	document.addEventListener(
		"nug:open-search",
		() => {
			setSearchState(
				true
			);
		}
	);

	searchInput?.addEventListener(
		"input",
		() => {
			performSearch(
				searchInput.value
			);
		}
	);

	searchInput?.addEventListener(
		"keydown",
		(event) => {
			if (
				event.key !== "Enter"
			) {
				return;
			}

			const firstResult =
				searchResults?.querySelector<HTMLAnchorElement>(
					".search-result"
				);

			if (firstResult) {
				event.preventDefault();

				firstResult.click();
			}
		}
	);

	/* =========================================================
	   Keyboard
	========================================================= */

	document.addEventListener(
		"keydown",
		(event) => {
			if (
				event.key !== "Escape"
			) {
				return;
			}

			if (
				header?.classList.contains(
					"search-open"
				)
			) {
				setSearchState(
					false
				);

				searchButton?.focus();

				return;
			}

			if (
				wikiNavigation?.classList.contains(
					"is-open"
				)
			) {
				setWikiNavigationState(
					false
				);

				wikiNavButton?.focus();
			}
		}
	);
</script>

