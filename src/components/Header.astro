<header class="site-header">

	<div class="header-inner">

		<!-- ========================================
		     Logo
		======================================== -->

		<a
			href="/"
			class="logo"
			aria-label="NUG ホーム"
		>

			<span class="logo-main">
				NUG
			</span>

			<span class="logo-sub">
				Nekozouneko Unofficial Guide
			</span>

		</a>


		<!-- ========================================
		     Desktop Navigation
		======================================== -->

		<nav
			class="desktop-nav"
			aria-label="メインナビゲーション"
		>

			<a href="/guide/" class="nav-link">
				攻略
			</a>

			<a href="/docs/" class="nav-link">
				Wiki
			</a>

			<a href="/news/" class="nav-link">
				ニュース
			</a>

			<a href="/tool/" class="nav-link">
				ツール
			</a>

			<a href="/about/" class="nav-link">
				NUGについて
			</a>

		</nav>


		<!-- ========================================
		     Header Actions
		======================================== -->

		<div class="header-actions">

			<button
				class="icon-button search-button"
				type="button"
				aria-label="検索"
				aria-expanded="false"
			>

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>

					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>

					<path
						d="M16 16L21 21"
					></path>

				</svg>

			</button>


			<button
				class="menu-button"
				type="button"
				aria-label="メニューを開く"
				aria-expanded="false"
			>

				<span></span>
				<span></span>
				<span></span>

			</button>

		</div>

	</div>


	<!-- ========================================
	     Search Overlay
	======================================== -->

	<div
		class="search-overlay"
		aria-hidden="true"
	>

		<div class="search-overlay-backdrop"></div>

		<div class="search-dialog">

			<div class="search-dialog-header">

				<div>

					<p class="search-label">
						SEARCH
					</p>

					<h2>
						NUGを検索
					</h2>

				</div>


				<button
					class="search-close"
					type="button"
					aria-label="検索を閉じる"
				>
					×
				</button>

			</div>


			<div class="search-input-wrapper">

				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>

					<circle
						cx="11"
						cy="11"
						r="6.5"
					></circle>

					<path
						d="M16 16L21 21"
					></path>

				</svg>


				<input
					id="nug-search-input"
					type="search"
					placeholder="攻略・プラグイン・コマンドなどを検索"
					aria-label="サイト内検索"
					autocomplete="off"
				/>

			</div>


			<div
				id="nug-search-results"
				class="search-results"
			></div>

		</div>

	</div>


	<!-- ========================================
	     Mobile Menu Overlay
	======================================== -->

	<div
		class="mobile-menu-overlay"
		aria-hidden="true"
	>

		<div class="mobile-menu-backdrop"></div>

		<nav
			class="mobile-menu"
			aria-label="モバイルナビゲーション"
		>

			<div class="mobile-menu-header">

				<span class="mobile-menu-title">
					MENU
				</span>

				<button
					class="mobile-menu-close"
					type="button"
					aria-label="メニューを閉じる"
				>
					×
				</button>

			</div>


			<div class="mobile-menu-links">

				<a href="/guide/">
					<span class="mobile-icon">📖</span>
					<span>攻略</span>
				</a>

				<a href="/docs/">
					<span class="mobile-icon">📚</span>
					<span>Wiki</span>
				</a>

				<a href="/news/">
					<span class="mobile-icon">📰</span>
					<span>ニュース</span>
				</a>

				<a href="/tool/">
					<span class="mobile-icon">🛠️</span>
					<span>ツール</span>
				</a>

				<a href="/about/">
					<span class="mobile-icon">ℹ️</span>
					<span>NUGについて</span>
				</a>

			</div>

		</nav>

	</div>

</header>


<script>

	/* ========================================
	   Elements
	======================================== */

	const header =
		document.querySelector<HTMLElement>(
			".site-header"
		);

	const searchButton =
		document.querySelector<HTMLButtonElement>(
			".search-button"
		);

	const searchOverlay =
		document.querySelector<HTMLElement>(
			".search-overlay"
		);

	const searchClose =
		document.querySelector<HTMLButtonElement>(
			".search-close"
		);

	const searchInput =
		document.querySelector<HTMLInputElement>(
			"#nug-search-input"
		);

	const searchResults =
		document.querySelector<HTMLElement>(
			"#nug-search-results"
		);

	const searchBackdrop =
		document.querySelector<HTMLElement>(
			".search-overlay-backdrop"
		);

	const menuButton =
		document.querySelector<HTMLButtonElement>(
			".menu-button"
		);

	const mobileMenuOverlay =
		document.querySelector<HTMLElement>(
			".mobile-menu-overlay"
		);

	const mobileMenuClose =
		document.querySelector<HTMLButtonElement>(
			".mobile-menu-close"
		);

	const mobileMenuBackdrop =
		document.querySelector<HTMLElement>(
			".mobile-menu-backdrop"
		);


	/* ========================================
	   Pagefind
	======================================== */

	type PagefindResultData = {
		title?: string;
		url?: string;
		excerpt?: string;
		meta?: Record<string, string>;
	};

	type PagefindSearch = {
		results: Array<{
			data: () => Promise<PagefindResultData>
		}>;
	};

	type PagefindModule = {
		search: (
			query: string
		) => Promise<PagefindSearch>;
	};

	let pagefind: PagefindModule | null = null;

	let searchRequest = 0;


	async function loadPagefind(): Promise<PagefindModule> {

		if (!pagefind) {

			const pagefindUrl =
				new URL(
					"/pagefind/pagefind.js",
					window.location.origin
				).href;

			const loadModule =
				new Function(
					"url",
					"return import(url)"
				) as (
					url: string
				) => Promise<PagefindModule>;

			pagefind =
				await loadModule(
					pagefindUrl
				);

		}

		return pagefind;

	}


	function getCategory(url: string): string {

		if (url.startsWith("/wiki/")) {
			return "Wiki";
		}

		if (url.startsWith("/guide/")) {
			return "攻略";
		}

		if (url.startsWith("/news/")) {
			return "ニュース";
		}

		if (url.startsWith("/tool/")) {
			return "ツール";
		}

		return "サイト";

	}


	function appendText(
		parent: HTMLElement,
		className: string,
		text: string
	): void {

		const element =
			document.createElement("span");

		element.className =
			className;

		element.textContent =
			text;

		parent.append(element);

	}


	function clearSearchResults(): void {

		searchResults?.replaceChildren();

		searchResults?.classList.remove(
			"has-results"
		);

	}


	async function performSearch(
		query: string
	): Promise<void> {

		if (!searchResults) return;

		const keyword =
			query.trim();

		const requestId =
			++searchRequest;


		if (!keyword) {

			clearSearchResults();

			return;

		}


		try {

			const result =
				await (
					await loadPagefind()
				).search(keyword);


			const items =
				await Promise.all(
					result.results
						.slice(0, 5)
						.map(
							(item) => item.data()
						)
				);


			if (
				requestId !== searchRequest
			) {
				return;
			}


			searchResults.replaceChildren();


			if (items.length === 0) {

				const empty =
					document.createElement("div");

				empty.className =
					"search-empty";

				appendText(
					empty,
					"",
					"検索結果がありません"
				);

				searchResults.append(
					empty
				);

			} else {

				for (const item of items) {

					const url =
						item.url ?? "/";


					const link =
						document.createElement("a");

					link.className =
						"search-result";

					link.href =
						url.startsWith("/")
							? url
							: "/";


					const content =
						document.createElement("div");

					content.className =
						"search-result-content";


					appendText(
						content,
						"search-result-category",
						getCategory(url)
					);


					appendText(
						content,
						"search-result-title",
						item.meta?.title ??
							item.title ??
							"無題の記事"
					);


					const excerpt =
						document.createElement("p");


					const parsedExcerpt =
						new DOMParser()
							.parseFromString(
								item.excerpt ?? "",
								"text/html"
							);


					excerpt.textContent =
						parsedExcerpt
							.body
							.textContent ?? "";


					content.append(
						excerpt
					);


					appendText(
						link,
						"search-result-arrow",
						"→"
					);


					link.insertBefore(
						content,
						link.lastElementChild
					);


					searchResults.append(
						link
					);

				}

			}


			searchResults.classList.add(
				"has-results"
			);

		} catch (error) {

			if (
				requestId === searchRequest
			) {

				console.error(
					"NUG Pagefind Error:",
					error
				);

			}

		}

	}


	/* ========================================
	   Search State
	======================================== */

	function setSearchState(
		isOpen: boolean
	): void {

		if (
			!header ||
			!searchButton ||
			!searchOverlay
		) {
			return;
		}


		header.classList.toggle(
			"search-open",
			isOpen
		);


		searchButton.setAttribute(
			"aria-expanded",
			String(isOpen)
		);


		searchOverlay.setAttribute(
			"aria-hidden",
			String(!isOpen)
		);


		if (isOpen) {

			document.body.classList.add(
				"overlay-open"
			);


			requestAnimationFrame(
				() => searchInput?.focus()
			);

		} else {

			document.body.classList.remove(
				"overlay-open"
			);


			if (searchInput) {
				searchInput.value = "";
			}


			clearSearchResults();

		}

	}


	/* ========================================
	   Menu State
	======================================== */

	function setMenuState(
		isOpen: boolean
	): void {

		if (
			!header ||
			!menuButton ||
			!mobileMenuOverlay
		) {
			return;
		}


		header.classList.toggle(
			"menu-open",
			isOpen
		);


		menuButton.setAttribute(
			"aria-expanded",
			String(isOpen)
		);


		mobileMenuOverlay.setAttribute(
			"aria-hidden",
			String(!isOpen)
		);


		if (isOpen) {

			document.body.classList.add(
				"overlay-open"
			);

		} else {

			document.body.classList.remove(
				"overlay-open"
			);

		}

	}


	/* ========================================
	   Search Button
	======================================== */

	searchButton?.addEventListener(
		"click",
		() => {

			const isOpen =
				header?.classList.contains(
					"search-open"
				) ?? false;


			setMenuState(false);

			setSearchState(
				!isOpen
			);

		}
	);


	/* ========================================
	   External Search Event
	======================================== */

	document.addEventListener(
		"nug:open-search",
		() => {

			setMenuState(false);

			setSearchState(true);

		}
	);


	/* ========================================
	   Search Close
	======================================== */

	searchClose?.addEventListener(
		"click",
		() => {

			setSearchState(false);

			searchButton?.focus();

		}
	);


	searchBackdrop?.addEventListener(
		"click",
		() => {

			setSearchState(false);

		}
	);


	/* ========================================
	   Search Input
	======================================== */

	searchInput?.addEventListener(
		"input",
		() => {

			performSearch(
				searchInput.value
			);

		}
	);


	/* ========================================
	   Search Enter
	======================================== */

	searchInput?.addEventListener(
		"keydown",
		(event) => {

			if (
				event.key !== "Enter"
			) {
				return;
			}


			const firstResult =
				searchResults?.querySelector<HTMLAnchorElement>(
					".search-result"
				);


			firstResult?.click();

		}
	);


	/* ========================================
	   Mobile Menu
	======================================== */

	menuButton?.addEventListener(
		"click",
		() => {

			const isOpen =
				header?.classList.contains(
					"menu-open"
				) ?? false;


			setSearchState(false);

			setMenuState(
				!isOpen
			);

		}
	);


	mobileMenuClose?.addEventListener(
		"click",
		() => {

			setMenuState(false);

			menuButton?.focus();

		}
	);


	mobileMenuBackdrop?.addEventListener(
		"click",
		() => {

			setMenuState(false);

		}
	);


	/* ========================================
	   Escape
	======================================== */

	document.addEventListener(
		"keydown",
		(event) => {

			if (
				event.key !== "Escape"
			) {
				return;
			}


			if (
				header?.classList.contains(
					"search-open"
				)
			) {

				setSearchState(false);

				searchButton?.focus();

				return;

			}


			if (
				header?.classList.contains(
					"menu-open"
				)
			) {

				setMenuState(false);

				menuButton?.focus();

			}

		}
	);

</script>


<style>

	/* ========================================
	   Base
	======================================== */

	.site-header {

		position: sticky;

		top: 0;

		z-index: 1000;

		width: 100%;

		background:
			var(--color-background);

		border-bottom:
			1px solid var(--color-border);

	}


	.header-inner {

		width: min(
			var(--content-width),
			calc(100% - 48px)
		);

		min-height: 68px;

		margin: 0 auto;

		display: flex;

		align-items: center;

		gap: 32px;

	}


	/* ========================================
	   Logo
	======================================== */

	.logo {

		display: flex;

		align-items: baseline;

		gap: 10px;

		flex-shrink: 0;

		transition:
			opacity var(--transition-fast),
			transform var(--transition-fast);

	}


	.logo:hover {

		opacity: 0.8;

	}


	.logo:active {

		transform:
			scale(0.97);

	}


	.logo-main {

		font-size: 23px;

		font-weight: 800;

		letter-spacing: -0.05em;

	}


	.logo-sub {

		font-size: 11px;

		color:
			var(--color-text-secondary);

		white-space: nowrap;

	}


	/* ========================================
	   Desktop Navigation
	======================================== */

	.desktop-nav {

		display: flex;

		align-items: center;

		gap: 4px;

		margin-left: auto;

	}


	.nav-link {

		display: flex;

		align-items: center;

		min-height: 40px;

		padding:
			0 14px;

		border-radius: 10px;

		font-size: 14px;

		font-weight: 500;

		color:
			var(--color-text-secondary);

		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);

	}


	.nav-link:hover {

		background:
			var(--color-surface);

		color:
			var(--color-text);

	}


	.nav-link:active {

		transform:
			scale(0.96);

	}


	/* ========================================
	   Header Actions
	======================================== */

	.header-actions {

		display: flex;

		align-items: center;

		gap: 6px;

		margin-left: 4px;

	}


	.icon-button,
	.menu-button {

		display: flex;

		align-items: center;

		justify-content: center;

		width: 40px;

		height: 40px;

		border-radius: 50%;

		color:
			var(--color-text);

		transition:
			background var(--transition-fast),
			transform var(--transition-fast);

	}


	.icon-button:hover,
	.menu-button:hover {

		background:
			var(--color-surface);

	}


	.icon-button:active,
	.menu-button:active {

		transform:
			scale(0.92);

	}


	.icon-button svg {

		width: 19px;

		height: 19px;

		fill: none;

		stroke: currentColor;

		stroke-width: 1.8;

		stroke-linecap: round;

		stroke-linejoin: round;

	}


	/* ========================================
	   Menu Button
	======================================== */

	.menu-button {

		display: none;

		flex-direction: column;

		gap: 4px;

	}


	.menu-button span {

		width: 18px;

		height: 1.5px;

		background:
			currentColor;

		border-radius: 999px;

		transition:
			transform var(--transition-normal),
			opacity var(--transition-normal);

	}


	.menu-open .menu-button span:nth-child(1) {

		transform:
			translateY(5.5px)
			rotate(45deg);

	}


	.menu-open .menu-button span:nth-child(2) {

		opacity: 0;

	}


	.menu-open .menu-button span:nth-child(3) {

		transform:
			translateY(-5.5px)
			rotate(-45deg);

	}


	/* ========================================
	   Search Overlay
	======================================== */

	.search-overlay {

		position: fixed;

		inset: 0;

		z-index: 2000;

		display: flex;

		align-items: flex-start;

		justify-content: center;

		padding:
			96px 24px 40px;

		opacity: 0;

		visibility: hidden;

		pointer-events: none;

		transition:
			opacity 200ms ease,
			visibility 200ms ease;

	}


	.search-open .search-overlay {

		opacity: 1;

		visibility: visible;

		pointer-events: auto;

	}


	.search-overlay-backdrop {

		position: absolute;

		inset: 0;

		background:
			rgba(0, 0, 0, 0.28);

		backdrop-filter:
			blur(4px);

	}


	.search-dialog {

		position: relative;

		z-index: 1;

		width: min(
			760px,
			100%
		);

		max-height:
			calc(100vh - 136px);

		overflow-y: auto;

		padding:
			28px;

		border:
			1px solid var(--color-border);

		border-radius: 20px;

		background:
			var(--color-background);

		box-shadow:
			0 20px 60px
			rgba(0, 0, 0, 0.14);

		transform:
			translateY(-10px)
			scale(0.98);

		transition:
			transform 200ms ease;

	}


	.search-open .search-dialog {

		transform:
			translateY(0)
			scale(1);

	}


	.search-dialog-header {

		display: flex;

		align-items: flex-start;

		justify-content: space-between;

		gap: 20px;

	}


	.search-label {

		font-size: 11px;

		font-weight: 700;

		letter-spacing: 0.14em;

		color:
			var(--color-text-secondary);

	}


	.search-dialog h2 {

		margin-top: 4px;

		font-size: 24px;

	}


	.search-close,
	.mobile-menu-close {

		display: flex;

		align-items: center;

		justify-content: center;

		width: 36px;

		height: 36px;

		flex-shrink: 0;

		border-radius: 50%;

		font-size: 25px;

		line-height: 1;

		color:
			var(--color-text-secondary);

		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);

	}


	.search-close:hover,
	.mobile-menu-close:hover {

		background:
			var(--color-surface);

		color:
			var(--color-text);

	}


	.search-close:active,
	.mobile-menu-close:active {

		transform:
			scale(0.9);

	}


	/* ========================================
	   Search Input
	======================================== */

	.search-input-wrapper {

		display: flex;

		align-items: center;

		gap: 12px;

		margin-top: 18px;

		padding:
			0 16px;

		height: 52px;

		border:
			1px solid var(--color-border);

		border-radius: 14px;

		background:
			var(--color-surface);

		transition:
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);

	}


	.search-input-wrapper:focus-within {

		border-color:
			var(--color-accent);

		box-shadow:
			0 0 0 3px
			rgba(0, 122, 255, 0.08);

	}


	.search-input-wrapper svg {

		width: 18px;

		height: 18px;

		flex-shrink: 0;

		fill: none;

		stroke:
			var(--color-text-secondary);

		stroke-width: 1.8;

		stroke-linecap: round;

		stroke-linejoin: round;

	}


	.search-input-wrapper input {

		width: 100%;

		border: 0;

		outline: 0;

		background: transparent;

		color:
			var(--color-text);

		font-size: 14px;

	}


	.search-input-wrapper input::placeholder {

		color:
			var(--color-text-secondary);

	}


	/* ========================================
	   Search Results
	======================================== */

	.search-results {

		max-height: 0;

		overflow: hidden;

		opacity: 0;

		transition:
			max-height 250ms ease,
			opacity 200ms ease;

	}


	.search-results.has-results {

		max-height: 500px;

		margin-top: 16px;

		opacity: 1;

		overflow-y: auto;

	}


	.search-result {

		position: relative;

		display: flex;

		align-items: center;

		gap: 20px;

		padding:
