---
interface Props { contentType: 'guide' | 'news' }
const { contentType } = Astro.props;
const isGuide = contentType === 'guide';
const title = isGuide ? '攻略を新規作成' : 'ニュースを新規作成';
const categories = isGuide
	? ['初心者向け', '基本情報', '経済', '土地・建築', '国家・外交', '戦闘', '採掘・資源', '農業・生活', 'プラグイン', 'ワールド', '便利機能', '困ったとき']
	: ['マイクラアプデ', 'サーバーアプデ', 'マイクライベント', 'サーバーイベント', 'NUGBASEおしらせ'];
---
<!doctype html>
<html lang="ja">
	<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>{title} | NUGBASE 管理画面</title></head>
	<body data-content-type={contentType} data-guide={String(isGuide)}>
		<header class="topbar">
			<a class="brand" href="/admin/" aria-label="管理画面トップ"><span class="brand-mark">NUG</span><span><strong>NUGBASE</strong><small>管理画面</small></span></a>
			<button class="menu-toggle" id="menu-toggle" type="button" aria-controls="admin-nav" aria-expanded="false" aria-label="メニューを開く"><span></span><span></span><span></span></button>
			<a class="site-link" href="/">サイトを見る ↗</a>
		</header>
		<div class="shell">
			<aside class="sidebar" id="admin-nav" aria-label="管理メニュー"><p class="nav-label">管理メニュー</p><nav>
				<a href="/admin/" class="nav-link">▦ ダッシュボード</a>
				<a href="/admin/guide/" class:list={['nav-link', { active: isGuide }]} aria-current={isGuide ? 'page' : undefined}>▤ 攻略管理</a>
				<a href="/admin/news/" class:list={['nav-link', { active: !isGuide }]} aria-current={!isGuide ? 'page' : undefined}>◷ ニュース管理</a>
				<a href="/admin/servers/" class="nav-link">◈ サーバー管理</a>
				<a href="/admin/review/" class="nav-link">✓ Wikiレビュー</a>
			</nav><div class="sidebar-note"><span class="live-dot"></span> 管理者セッションで保護されています</div></aside>
			<main class="main">
				<div class="page-heading"><div><p class="eyebrow">NEW ARTICLE</p><h1>{title}</h1><p class="intro">入力した内容はこの画面では保存・公開されません。記事IDを予約します。</p></div><a class="button secondary back-button" href={`/admin/${contentType}/`}>一覧へ戻る</a></div>
				<div class="notice" id="notice" role="alert" aria-live="polite" hidden></div>
				<section class="panel form-panel" aria-labelledby="form-title">
					<div class="panel-heading"><div><p class="eyebrow">ARTICLE DETAILS</p><h2 id="form-title">記事情報</h2></div></div>
					<form id="article-form" novalidate><div class="form-grid">
						{isGuide && <label class="field" for="server-id"><span>サーバー <em>必須</em></span><select id="server-id" name="server_id" required><option value="">読み込み中…</option></select><small>D1に登録された有効なサーバーを選択します。</small></label>}
						<label class="field" for="format"><span>本文形式 <em>必須</em></span><select id="format" name="format" required><option value="md">Markdown (.md)</option><option value="mdx">MDX (.mdx)</option></select><small>予約後に拡張子は変更できません。</small></label>
						<label class="field full" for="title"><span>タイトル <em>必須</em></span><input id="title" name="title" type="text" required maxlength="160" /></label>
						<label class="field full" for="description"><span>説明 <em>必須</em></span><textarea id="description" name="description" rows="3" required maxlength="500"></textarea></label>
						<label class="field" for="category"><span>カテゴリ <em>必須</em></span><select id="category" name="category" required><option value="">選択してください</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
						<label class="field" for="date"><span>投稿日 <em>必須</em></span><input id="date" name="date" type="date" required /></label>
						<label class="field" for="icon"><span>アイコン <small>任意・emoji</small></span><input id="icon" name="icon" type="text" maxlength="32" placeholder="🌱" /></label>
						<label class="field" for="image"><span>画像 <small>任意</small></span><input id="image" name="image" type="text" maxlength="300" placeholder="/images/example.webp" /></label>
						<label class="field full" for="featured"><span>NUGBASE PICKUP</span><span class="check-row"><input id="featured" name="featured" type="checkbox" /> NUGBASE PICKUPに掲載する</span></label>
						<label class="field full" for="body"><span>Markdown / MDX本文 <em>必須</em></span><textarea id="body" name="body" rows="12" required placeholder="記事本文を入力してください"></textarea></label>
					</div><div class="form-actions"><a class="button secondary" href={`/admin/${contentType}/`}>戻る</a><button class="button primary" id="submit-button" type="submit">記事IDを予約する</button></div></form>
				</section>
				<section class="panel success-panel" id="success-panel" aria-live="polite" hidden><div class="success-mark" aria-hidden="true">✓</div><p class="eyebrow">ID RESERVED</p><h2>記事IDを予約しました</h2><dl class="reservation-details"><div><dt>記事ID</dt><dd id="reserved-article-id"></dd></div><div><dt>公開状態</dt><dd>公開待ち</dd></div><div><dt>source path</dt><dd id="reserved-source-path"></dd></div></dl><p class="success-note">本文の保存・公開はまだ行われていません。次の編集画面から続けられます。</p><div class="success-actions"><a class="button secondary" href={`/admin/${contentType}/`}>一覧へ戻る</a><a class="button primary" id="continue-link" href={`/admin/${contentType}/edit/`}>編集画面へ進む</a></div></section>
			</main>
		</div>
		<script>
			type Server = { id: number; name: string; enabled: number | boolean };
			type Article = { id: number; article_id: string; source_path: string; status: string };
			type ApiResult = { ok?: boolean; error?: string; servers?: Server[]; article?: Article };
			const contentType = document.body.dataset.contentType as 'guide' | 'news';
			const isGuide = document.body.dataset.guide === 'true';
			const form = document.getElementById('article-form') as HTMLFormElement;
			const notice = document.getElementById('notice') as HTMLElement;
			const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
			const serverSelect = document.getElementById('server-id') as HTMLSelectElement | null;
			function showError(message: string) { notice.textContent = message; notice.className = 'notice error'; notice.hidden = false; notice.focus(); }
			function localDate() { const now = new Date(); return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`; }
			async function responseData(response: Response): Promise<ApiResult> {
				let data: ApiResult = {}; try { data = await response.json() as ApiResult; } catch { /* explain via status */ }
				if (!response.ok || !data.ok) {
					if (response.status === 401) throw new Error('未認証です（401）。管理者として再ログインしてください。');
					if (response.status === 403) throw new Error('操作権限がありません（403）。管理者アカウントでログインしてください。');
					throw new Error(data.error || `APIとの通信に失敗しました（${response.status || 'ネットワーク'}）。`);
				}
				return data;
			}
			async function loadServers() {
				if (!serverSelect) return;
				try {
					const data = await responseData(await fetch('/api/admin/servers', { credentials: 'same-origin' }));
					const servers = (data.servers ?? []).filter((server) => server.enabled === 1 || server.enabled === true);
					serverSelect.replaceChildren(new Option('選択してください', ''));
					for (const server of servers) serverSelect.add(new Option(server.name, String(server.id)));
					if (!servers.length) { serverSelect.disabled = true; showError('有効なサーバーがありません。先にサーバー管理で登録してください。'); }
				} catch (error) {
					serverSelect.replaceChildren(new Option('読み込めませんでした', ''));
					showError(error instanceof Error ? error.message : 'サーバー一覧を読み込めませんでした。');
				}
			}
			form.addEventListener('submit', async (event) => {
				event.preventDefault(); notice.hidden = true;
				if (!form.reportValidity()) return;
				if (isGuide && !serverSelect?.value) { showError('サーバーを選択してください。'); serverSelect?.focus(); return; }
				submitButton.disabled = true; submitButton.textContent = 'IDを予約しています…';
				const payload: { content_type: 'guide' | 'news'; format: 'md' | 'mdx'; server_id?: number } = { content_type: contentType, format: (document.getElementById('format') as HTMLSelectElement).value as 'md' | 'mdx' };
				if (isGuide) payload.server_id = Number(serverSelect?.value);
				try {
					const data = await responseData(await fetch('/api/admin/articles', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }));
					const article = data.article;
					if (!article || !Number.isSafeInteger(article.id) || !article.article_id || !article.source_path) throw new Error('予約応答に必要な情報がありません。予約状態を確認してください。');
					form.hidden = true;
					(document.getElementById('reserved-article-id') as HTMLElement).textContent = article.article_id;
					(document.getElementById('reserved-source-path') as HTMLElement).textContent = article.source_path;
					(document.getElementById('continue-link') as HTMLAnchorElement).href = `/admin/${contentType}/edit/?id=${encodeURIComponent(String(article.id))}`;
					const success = document.getElementById('success-panel') as HTMLElement; success.hidden = false; success.scrollIntoView({ behavior: 'smooth', block: 'start' });
				} catch (error) { showError(error instanceof Error ? error.message : '記事IDを予約できませんでした。'); }
				finally { submitButton.disabled = false; submitButton.textContent = '記事IDを予約する'; }
			});
			(document.getElementById('date') as HTMLInputElement).value = localDate();
			const menuButton = document.getElementById('menu-toggle') as HTMLButtonElement;
			menuButton.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') !== 'true'; menuButton.setAttribute('aria-expanded', String(open)); menuButton.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く'); (document.getElementById('admin-nav') as HTMLElement).classList.toggle('is-open', open); });
			void loadServers();
		</script>
	</body>
</html>

<style is:global>
	:root{color-scheme:dark;--bg:#111416;--panel:#202529;--line:#41494d;--line2:#586267;--text:#f1f4f2;--soft:#c4ccc7;--muted:#929d96;--green:#72ad55;--green2:#8bc96d;--red:#e27b78;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Yu Gothic",Meiryo,sans-serif;background:var(--bg);color:var(--text)}
	*{box-sizing:border-box}html,body{margin:0;min-height:100%;max-width:100%;overflow-x:hidden}body{background:radial-gradient(ellipse at 65% -10%,#72ad551f,transparent 45%),linear-gradient(180deg,#151a1c,var(--bg) 450px);line-height:1.55}button,input,textarea,select{font:inherit}a{color:inherit;text-decoration:none}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--green2);outline-offset:3px}[hidden]{display:none!important}
	.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:20px;height:72px;padding:0 clamp(16px,3vw,40px);border-bottom:1px solid #343c3e;background:#111416f2;backdrop-filter:blur(14px)}.brand{display:flex;align-items:center;gap:12px;min-width:0}.brand-mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid #568f43;border-radius:4px;background:linear-gradient(145deg,#6ea95a,#38642f);font-size:12px;font-weight:950}.brand strong,.brand small{display:block}.brand strong{font-size:14px}.brand small{color:var(--muted);font-size:10px}.site-link{display:inline-flex;align-items:center;justify-content:center;min-height:44px;margin-left:auto;padding:0 14px;border:1px solid var(--line);border-radius:3px;background:var(--panel);color:var(--soft);font-size:12px;font-weight:750}.menu-toggle{display:none}.shell{display:grid;grid-template-columns:236px minmax(0,1fr);width:min(1440px,100%);min-height:calc(100vh - 72px);margin:auto}.sidebar{position:sticky;top:72px;display:flex;flex-direction:column;align-self:start;min-height:calc(100vh - 72px);padding:30px 16px 20px;border-right:1px solid #30373a}.nav-label,.eyebrow{margin:0;color:#88bf70;font-size:10px;font-weight:900;letter-spacing:.13em}.nav-label{padding:0 12px 12px;color:var(--muted)}.sidebar nav{display:grid;gap:5px}.nav-link{display:flex;align-items:center;gap:10px;min-height:46px;padding:0 12px;border:1px solid transparent;border-radius:3px;color:#b7c0ba;font-size:13px;font-weight:750}.nav-link:hover{background:#ffffff08;color:white}.nav-link.active{border-color:#456043;background:#42653a33;color:#f3f8f0}.sidebar-note{display:flex;align-items:flex-start;gap:9px;margin-top:auto;padding:15px 10px 0;border-top:1px solid #30373a;color:var(--muted);font-size:10px}.live-dot{width:7px;height:7px;flex:0 0 7px;margin-top:5px;border-radius:50%;background:var(--green)}.main{width:min(1000px,100%);min-width:0;margin:auto;padding:42px clamp(18px,4vw,56px) 48px}.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px}.page-heading h1{margin:7px 0 0;font-size:clamp(27px,3vw,36px);font-weight:900;line-height:1.2}.intro{margin:10px 0 0;color:var(--muted);font-size:13px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 15px;border:1px solid;border-radius:3px;font-size:12px;font-weight:850;cursor:pointer}.button:disabled{opacity:.6;cursor:wait}.primary{border-color:#568f43;background:linear-gradient(180deg,#7dbd5f,#609c49);color:white}.secondary{border-color:var(--line2);background:linear-gradient(180deg,#333a3e,#272d30);color:var(--soft)}.panel{min-width:0;border:1px solid var(--line);border-radius:4px;background:#202529;box-shadow:0 4px #0004,0 10px 24px #0002}.panel-heading{padding:20px 22px;border-bottom:1px solid #ffffff0c}.panel-heading h2,.success-panel h2{margin:4px 0 0;font-size:19px}.form-panel form{padding:22px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.field{display:grid;align-content:start;gap:8px;min-width:0;color:var(--soft);font-size:12px;font-weight:750}.field>span:first-child{display:flex;align-items:center;gap:8px}.field em{color:#e5ca7b;font-size:10px;font-style:normal}.field small{color:var(--muted);font-size:10px;font-weight:500}.field input:not([type=checkbox]),.field textarea,.field select{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--line2);border-radius:3px;background:#15191b;color:var(--text);font-size:13px}.field textarea{min-height:92px;resize:vertical}.field textarea[name=body]{min-height:260px}.full{grid-column:1/-1}.check-row{display:flex;align-items:center;gap:11px;min-height:44px;color:var(--text);font-weight:600}.check-row input{width:20px;height:20px;accent-color:var(--green)}.form-actions,.success-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:22px;padding-top:18px;border-top:1px solid #ffffff10}.notice{margin:0 0 18px;padding:13px 16px;border:1px solid #754543;border-left:4px solid var(--red);background:#301f20;color:#f2d0cd;font-size:13px;overflow-wrap:anywhere}.success-panel{margin-top:18px;padding:26px}.success-mark{display:grid;width:48px;height:48px;place-items:center;margin-bottom:14px;border:1px solid #568f43;background:#34512a55;color:#a7d891;font-size:25px}.reservation-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:20px 0}.reservation-details div{min-width:0;padding:13px;border:1px solid #ffffff12;background:#171b1e}.reservation-details div:last-child{grid-column:1/-1}.reservation-details dt{color:var(--muted);font-size:11px}.reservation-details dd{margin:4px 0 0;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:13px;overflow-wrap:anywhere}.success-note{color:var(--muted);font-size:12px}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
	@media(max-width:760px){.topbar{height:64px;gap:12px}.brand-mark{width:38px;height:38px}.menu-toggle{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:44px;height:44px;margin-left:auto;border:1px solid var(--line);border-radius:3px;background:var(--panel)}.menu-toggle span{width:18px;height:2px;background:#d5ddd7}.site-link{padding:0 10px;font-size:11px}.shell{display:block;min-height:calc(100vh - 64px)}.sidebar{position:fixed;top:64px;bottom:0;left:0;z-index:19;width:min(290px,86vw);min-height:0;padding:22px 16px 20px;border-right:1px solid var(--line);background:#15191bf7;transform:translateX(-105%);transition:transform .2s}.sidebar.is-open{transform:translateX(0)}.main{padding:30px 18px 38px}.page-heading{align-items:stretch;flex-direction:column;gap:16px;margin-bottom:22px}.back-button{width:100%}.form-grid{grid-template-columns:minmax(0,1fr);gap:17px}.full{grid-column:auto}.form-panel form{padding:18px}.form-actions,.success-actions{flex-direction:column-reverse}.form-actions .button,.success-actions .button{width:100%}.reservation-details{grid-template-columns:minmax(0,1fr)}.reservation-details div:last-child{grid-column:auto}}
	@media(max-width:380px){.site-link{padding:0 8px;font-size:10px}.brand{gap:8px}.brand strong{font-size:12px}.main{padding-right:13px;padding-left:13px}}
</style>
