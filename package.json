{
  "name": "nug-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:pagefind && astro dev",
    "build:astro": "astro build",
    "build": "astro build && pagefind --site dist",
    "prepare:pagefind": "node scripts/prepare-pagefind.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.41.10",
    "@milkdown/crepe": "^7.23.0",
    "@toast-ui/editor": "3.2.2",
    "astro": "^7.2.5",
    "dompurify": "^3.4.17",
    "marked": "^18.0.14"
  },
  "overrides": {
    "@toast-ui/editor": {
      "dompurify": "$dompurify"
    }
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.135.0"
  }
}
